@using VentasWeb.Helpers
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO -->
    <meta name="description" content="Sistema de gestión - Tienda Compu Space" />
    <meta name="keywords" content="ventas, compras, tienda, compu space, sistema" />
    <meta name="author" content="Compu Space" />

    <!-- Cache -->
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />

    <title>@ViewBag.Title - Tienda COMPU SPACE</title>

    @{
        var version = DateTime.Now.Ticks.ToString();
    }

    @Styles.RenderFormat("<link href=\"{0}?v=" + version + "\" rel=\"stylesheet\"/>", "~/Content/css")
    @Styles.RenderFormat("<link href=\"{0}?v=" + version + "\" rel=\"stylesheet\"/>", "~/Content/PluginsCSS")
    @Scripts.RenderFormat("<script src=\"{0}?v=" + version + "\"></script>", "~/bundles/modernizr")

    @RenderSection("estilos", required: false)

    <style>
        /* ══════════════════════════════════════════════════════
           VARIABLES CORPORATIVAS
        ══════════════════════════════════════════════════════ */
        :root {
            --corp-dark:    #0c1a35;
            --corp-primary: #1a3566;
            --corp-blue:    #2563eb;
            --corp-light:   #dbeafe;
            --corp-white:   #ffffff;
            --corp-bg:      #f4f7fb;
            --corp-border:  #e2e8f0;
            --corp-text:    #0f172a;
            --corp-muted:   #64748b;
            --corp-success: #059669;
            --corp-danger:  #dc2626;
            --corp-shadow:  0 4px 24px rgba(26,53,102,0.13);
        }

        /* ══════════════════════════════════════════════════════
           MODALES VER — evita overflow de textos largos
        ══════════════════════════════════════════════════════ */
        .ver-text {
            word-break: break-word;
            overflow-wrap: break-word;
            white-space: normal !important;
        }

        /* ══════════════════════════════════════════════════════
           NAVBAR CORPORATIVO
        ══════════════════════════════════════════════════════ */
        .navbar {
            background: linear-gradient(90deg, var(--corp-dark) 0%, var(--corp-primary) 100%) !important;
            box-shadow: 0 2px 16px rgba(12,26,53,0.45);
            padding: 0 1.4rem;
            min-height: 58px;
            border-bottom: 1px solid rgba(255,255,255,0.07);
        }

        .navbar-brand img {
            opacity: 0.96;
            transition: opacity 0.2s, transform 0.2s;
            filter: brightness(1.05);
        }

        .navbar-brand:hover img {
            opacity: 1;
            transform: scale(1.03);
        }

        /* Links principales */
        .navbar-nav .nav-link {
            color: rgba(255,255,255,0.82) !important;
            font-size: 0.83rem;
            font-weight: 600;
            letter-spacing: 0.02em;
            padding: 0.6rem 0.85rem !important;
            border-radius: 6px;
            transition: background 0.18s, color 0.18s;
            display: flex;
            align-items: center;
            gap: 7px;
        }

            .navbar-nav .nav-link:hover,
            .navbar-nav .nav-item.active .nav-link {
                background: rgba(255,255,255,0.1) !important;
                color: #fff !important;
            }

            .navbar-nav .nav-item.active .nav-link {
                background: rgba(37,99,235,0.55) !important;
                color: #fff !important;
                box-shadow: inset 0 -2px 0 rgba(255,255,255,0.3);
            }

        .navbar-nav .nav-item.dropdown.show .nav-link {
            background: rgba(255,255,255,0.12) !important;
            color: #fff !important;
        }

        /* ── DROPDOWN MENÚ ─────────────────────────────────── */
        .dropdown-menu.drop-menu {
            background: #fff;
            border: 1px solid var(--corp-border);
            border-top: 3px solid var(--corp-blue);
            border-radius: 0 0 10px 10px;
            box-shadow: 0 12px 36px rgba(12,26,53,0.16);
            padding: 6px 6px 8px;
            min-width: 220px;
            margin-top: 0 !important;
            animation: dropIn 0.16s cubic-bezier(0.16,1,0.3,1) both;
        }

        @@keyframes dropIn {
            from { opacity: 0; transform: translateY(-8px); }
            to   { opacity: 1; transform: translateY(0);    }
        }

        .dropdown-item {
            border-radius: 5px;
            font-size: 0.83rem;
            font-weight: 500;
            color: var(--corp-text);
            padding: 8px 12px;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: background 0.13s, color 0.13s;
            border-left: 2px solid transparent;
        }

            .dropdown-item i {
                width: 15px;
                text-align: center;
                color: var(--corp-blue);
                font-size: 0.8rem;
                flex-shrink: 0;
            }

            .dropdown-item:hover {
                background: var(--corp-light);
                color: var(--corp-blue);
                border-left-color: var(--corp-blue);
            }

                .dropdown-item:hover i {
                    color: var(--corp-blue);
                }

            .dropdown-item + .dropdown-item {
                border-top: 1px solid #f1f5f9;
            }

        /* ── BOTÓN SALIR ───────────────────────────────────── */
        .nav-salir .nav-link {
            background: rgba(220,38,38,0.15) !important;
            border: 1px solid rgba(220,38,38,0.35) !important;
            border-radius: 7px !important;
            color: #fca5a5 !important;
            padding: 0.42rem 1rem !important;
            font-size: 0.82rem;
            transition: background 0.18s, color 0.18s, border-color 0.18s !important;
        }

            .nav-salir .nav-link:hover {
                background: rgba(220,38,38,0.28) !important;
                border-color: rgba(220,38,38,0.55) !important;
                color: #fff !important;
            }

        /* ── USUARIO LOGUEADO ─────────────────────────────── */
        .nav-user-info {
            display: flex;
            align-items: center;
            gap: 9px;
            color: rgba(255,255,255,0.88);
            font-size: 0.81rem;
            font-weight: 600;
            padding: 0 0.5rem;
        }

        .nav-user-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--corp-blue), #60a5fa);
            border: 2px solid rgba(255,255,255,0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            color: #fff;
            font-weight: 700;
            letter-spacing: 0;
        }

        .nav-divider {
            width: 1px;
            height: 20px;
            background: rgba(255,255,255,0.18);
            margin: 0 4px;
        }

        /* ══════════════════════════════════════════════════════
           ÁREA DE CONTENIDO — fondo gris claro suave
        ══════════════════════════════════════════════════════ */
        body {
            background: var(--corp-bg);
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
            color: var(--corp-text);
        }

        /* ── Cards Bootstrap mejoradas ─────────────────────── */
        .card {
            border: 1px solid var(--corp-border) !important;
            border-radius: 10px !important;
            box-shadow: 0 2px 12px rgba(12,26,53,0.07) !important;
        }

        .card-header.bg-info {
            background: linear-gradient(90deg, var(--corp-primary) 0%, var(--corp-blue) 100%) !important;
            border-radius: 9px 9px 0 0 !important;
            font-weight: 600;
            letter-spacing: 0.02em;
        }

        .card.border-info {
            border-color: var(--corp-border) !important;
        }

        /* ── Breadcrumb ─────────────────────────────────────── */
        .breadcrumb {
            background: transparent;
            padding: 0;
            margin-bottom: 1.2rem;
            font-size: 0.82rem;
            color: var(--corp-muted);
        }

        .breadcrumb-item a {
            color: var(--corp-blue);
            text-decoration: none;
        }

        .breadcrumb-item.active {
            color: var(--corp-text);
            font-weight: 600;
        }

        .breadcrumb-item + .breadcrumb-item::before {
            color: var(--corp-muted);
        }

        /* ── Botones globales mejorados ─────────────────────── */
        .btn-primary {
            background-color: var(--corp-blue) !important;
            border-color: var(--corp-blue) !important;
        }

        .btn-primary:hover {
            background-color: #1d4ed8 !important;
            border-color: #1d4ed8 !important;
        }

        .btn-info {
            background-color: #0891b2 !important;
            border-color: #0891b2 !important;
            color: #fff !important;
        }

        .btn-info:hover {
            background-color: #0e7490 !important;
            border-color: #0e7490 !important;
        }

        /* ── Modales con header corporativo ────────────────── */
        .modal-header.bg-info {
            background: linear-gradient(90deg, var(--corp-primary) 0%, var(--corp-blue) 100%) !important;
        }

        .modal-content {
            border: none !important;
            border-radius: 12px !important;
            box-shadow: 0 20px 60px rgba(12,26,53,0.2) !important;
        }

        /* ── DataTable mejorado ─────────────────────────────── */
        table.dataTable thead th {
            background: var(--corp-bg);
            color: var(--corp-text);
            font-weight: 700;
            font-size: 0.8rem;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            border-bottom: 2px solid var(--corp-blue) !important;
        }

        table.dataTable tbody tr:hover {
            background: #eff6ff !important;
        }

        /* ── FOOTER ─────────────────────────────────────────── */
        footer {
            border-top: 1px solid var(--corp-border);
            padding-top: 0.8rem;
            margin-top: 2.5rem;
            color: var(--corp-muted);
            font-size: 0.78rem;
        }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark" style="font-weight:bold">
        <a class="navbar-brand" href="@Url.Action("Index", "Home")">
            <img src="@Url.Content("~/Imagenes/tiendalogo.png")" width="110" height="45" alt="Logo Tienda Compu Space" />
        </a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent"
                aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Alternar navegación">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <!-- Menú izquierdo -->
            <ul class="navbar-nav mr-auto">
                <li class="nav-item">
                    <a class="nav-link" name="Home" href="@Url.Action("Index", "Home")">
                        <i class="fas fa-home"></i> Inicio
                    </a>
                </li>
                @Html.ActionLinkAllow() <!-- Menús dinámicos -->
            </ul>

            <!-- Menú derecho -->
            <ul class="navbar-nav ml-auto align-items-center">
                @{
                    var usuarioNav = Session["Usuario"] as CapaModelo.Usuario;
                }
                @if (usuarioNav != null)
                {
                    <li class="nav-item">
                        <span class="nav-user-info">
                            <span class="nav-user-avatar">@(usuarioNav.Nombres.Length > 0 ? usuarioNav.Nombres.Substring(0,1).ToUpper() : "U")</span>
                            <span>@usuarioNav.Nombres</span>
                        </span>
                    </li>
                    <li><span class="nav-divider"></span></li>
                }
                <li class="nav-item nav-salir">
                    <a href="@Url.Action("Salir", "Home")" class="nav-link">
                        <i class="fas fa-sign-out-alt mr-1"></i> Salir
                    </a>
                </li>
            </ul>
        </div>
    </nav>

    <!-- CUERPO -->
    <div class="container-fluid mt-4">
        @RenderBody()
        <footer class="text-center">
            <p>&copy; @DateTime.Now.Year — Tienda Compu Space</p>
        </footer>
    </div>

    <!-- SCRIPTS -->
    @{
        var cacheVersion = DateTime.Now.Ticks.ToString();
    }

    @Scripts.RenderFormat("<script src=\"{0}?v=" + cacheVersion + "\"></script>", "~/bundles/jquery")
    @Scripts.RenderFormat("<script src=\"{0}?v=" + cacheVersion + "\"></script>", "~/bundles/bootstrap")
    @Scripts.RenderFormat("<script src=\"{0}?v=" + cacheVersion + "\"></script>", "~/Content/PluginsJS")
    <!-- SweetAlert2 — disponible globalmente -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Shim de compatibilidad: redirige llamadas toastr → Swal -->
    <script>
        var toastr = {
            success: function (msg) { Swal.fire({ icon: 'success', title: 'Éxito',    text: msg, timer: 2000, showConfirmButton: false }); },
            error:   function (msg) { Swal.fire({ icon: 'error',   title: 'Error',    text: msg, confirmButtonColor: '#0984e3' }); },
            warning: function (msg) { Swal.fire({ icon: 'warning', title: 'Atención', text: msg, confirmButtonColor: '#0984e3' }); },
            info:    function (msg) { Swal.fire({ icon: 'info',    title: 'Info',     text: msg, timer: 1800, showConfirmButton: false }); }
        };
    </script>

    <!-- Configuración de URLs centralizadas -->
    <script type="text/javascript">
        $.extend({
            MisUrls: {
                url: {},
                urls: function (a) { $.extend($.MisUrls.url, a); }
            }
        });

        // ── SESIÓN USUARIO — disponible globalmente en todo el JS ─
        var AppSession = {
            esSuperAdmin: @(Session["EsSuperAdmin"] != null && (bool)Session["EsSuperAdmin"] ? "true" : "false"),
            idTienda: @(Session["TiendaActiva"] != null ? Session["TiendaActiva"].ToString() : "0")
        };

        // ---- ROL ----
        $.MisUrls.urls({
            _ObtenerRoles: '@Url.Action("Obtener", "Rol")',
            _GuardarRol: '@Url.Action("Guardar", "Rol")',
            _DesactivarRol: '@Url.Action("Desactivar", "Rol")',
            _ListPermisosPorRol: '@Url.Action("ListPermisosPorRol", "Rol")',
            _GuardarRolConPermisos: '@Url.Action("GuardarRolConPermisos", "Rol")',
            _ListPermisosDisponibles: '@Url.Action("ListPermisosDisponibles", "Rol")'
        });

        // ---- PERMISOS ----
        $.MisUrls.urls({
            _ObtenerPermisos: '@Url.Action("Obtener", "Permisos")',
            _GuardarPermisos: '@Url.Action("Guardar", "Permisos")'
        });

        // ---- USUARIO ----
        $.MisUrls.urls({
            _ObtenerUsuarios: '@Url.Action("Obtener", "Usuario")',
            _GuardarUsuario: '@Url.Action("Guardar", "Usuario")',
            _EliminarUsuario: '@Url.Action("Eliminar", "Usuario")',
            _CambiarEstadoUsuario: '@Url.Action("CambiarEstadoUsuario", "Usuario")',
            _CrearUsuarioPendiente: '@Url.Action("CrearUsuarioPendiente", "Usuario")',
            _CambiarClave: '@Url.Action("CambioContraseña", "Usuario")',
            _DesbloquearUsuario: '@Url.Action("DesbloquearUsuario", "Usuario")'
        });

        // ---- EMPLEADO ----
        $.MisUrls.urls({
            _EsEmpleado: '@Url.Action("EsEmpleado", "Empleado")',
            _BuscarEmpleadoPorCI: '@Url.Action("BuscarEmpleadoPorCI", "Usuario")',
            _BuscarPorCI: '@Url.Action("BuscarPorCI", "Empleado")',
            _ObtenerTiendasActivas: '@Url.Action("ObtenerTiendasActivas", "Empleado")'
        });

        // ---- PROVEEDOR ----
        $.MisUrls.urls({
            _ObtenerProveedores: '@Url.Action("Obtener", "Proveedor")',
            _GuardarProveedor: '@Url.Action("Guardar", "Proveedor")',
            _EliminarProveedor: '@Url.Action("Eliminar", "Proveedor")',
            _TieneComprasProveedor: '@Url.Action("TieneCompras", "Proveedor")',
            _DesactivarProveedor: '@Url.Action("Desactivar", "Proveedor")',
            _ReactivarProveedor: '@Url.Action("Reactivar", "Proveedor")',
            _VerificarRucProveedor: '@Url.Action("VerificarRuc", "Proveedor")',
            _ObtenerHistorialPrecio: '@Url.Action("ObtenerHistorialPrecio", "Historial")'
        });

        // ---- CATEGORIA ----
        $.MisUrls.urls({
            _ObtenerCategorias: '@Url.Action("Obtener", "Categoria")',
            _GuardarCategoria: '@Url.Action("Guardar", "Categoria")',
            _EliminarCategoria: '@Url.Action("Eliminar", "Categoria")',
            _CambiarEstadoCategoria: '@Url.Action("CambiarEstado", "Categoria")'
        });

        // ---- PRODUCTO ----
        $.MisUrls.urls({
            _ObtenerProductos: '@Url.Action("Obtener", "Producto")',
            _ObtenerProductosPorTienda: '@Url.Action("ObtenerProductosPorTienda", "Producto")',
            _GuardarProducto: '@Url.Action("Guardar", "Producto")',
            _EliminarProducto: '@Url.Action("Eliminar", "Producto")',
            _CambiarEstadoProducto: '@Url.Action("CambiarEstado", "Producto")',
            _ObtenerAsignaciones: '@Url.Action("ObtenerAsignaciones", "Producto")',
            _RegistrarProductoTienda: '@Url.Action("RegistrarProductoTienda", "Producto")',
            _ModificarProductoTienda: '@Url.Action("ModificarProductoTienda", "Producto")',
            _EliminarProductoTienda: '@Url.Action("EliminarProductoTienda", "Producto")',
            _BuscarProductoPorCodigo: '@Url.Action("BuscarProductoPorCodigo", "Producto")'
        });

        // ---- TIENDA ----
        $.MisUrls.urls({
            _ObtenerTiendas: '@Url.Action("Obtener", "Tienda")',
            _GuardarTienda: '@Url.Action("Guardar", "Tienda")',
            _EliminarTienda: '@Url.Action("Eliminar", "Tienda")'
        });

        // ---- COMPRA ----
        $.MisUrls.urls({
            _ObtenerCompras: '@Url.Action("Obtener", "Compra")',
            _GuardarCompra: '@Url.Action("Guardar", "Compra")',
            _DocumentoCompra: '@Url.Action("Documento", "Compra")'
        });

        // ---- ORDEN COMPRA ----
        $.MisUrls.urls({
            _OC_Obtener:            '@Url.Action("Obtener", "OrdenCompra")',
            _OC_ObtenerOrden:       '@Url.Action("ObtenerOrden", "OrdenCompra")',
            _OC_ObtenerProveedores: '@Url.Action("ObtenerProveedores", "OrdenCompra")',
            _OC_Guardar:            '@Url.Action("Guardar", "OrdenCompra")',
            _OC_Aprobar:            '@Url.Action("Aprobar", "OrdenCompra")',
            _OC_Rechazar:           '@Url.Action("Rechazar", "OrdenCompra")',
            _OC_Anular:             '@Url.Action("Anular", "OrdenCompra")',
            _OC_Documento:          '@Url.Action("Documento", "OrdenCompra")',
            _OC_Consultar:          '@Url.Action("Consultar", "OrdenCompra")',
            _OC_ObtenerAprobadas:   '@Url.Action("ObtenerOrdenesAprobadas", "OrdenCompra")',
            _OC_ValidarStock:       '@Url.Action("ValidarStock",     "OrdenCompra")',
            _OC_ValidarStockItem:   '@Url.Action("ValidarStockItem", "OrdenCompra")'
        });

        // ---- COMPRA — RECEPCION ----
        $.MisUrls.urls({
            _Compra_Recepcion:          '@Url.Action("Recepcion",                 "Compra")',
            _Compra_LineasOC:           '@Url.Action("ObtenerLineasOC",           "Compra")',
            _Compra_RegistrarDesdeOC:   '@Url.Action("RegistrarRecepcionDesdeOC", "Compra")',
            _Compra_Confirmar:          '@Url.Action("ConfirmarCompra",           "Compra")',
            _Compra_NotaCredito:        '@Url.Action("GenerarNotaCredito",        "Compra")',
            _Compra_GenerarOP:          '@Url.Action("GenerarOP",                 "Compra")'
        });

        // ---- COMPRA — REVISION (segregación O&M) ----
        $.MisUrls.urls({
            _Compra_Documento:          '@Url.Action("Documento",         "Compra")',
            _Compra_Revision:           '@Url.Action("Revision",          "Compra")',
            _Compra_ObtenerRevision:    '@Url.Action("ObtenerRevision",   "Compra")',
            _Compra_Anular:             '@Url.Action("AnularCompra",      "Compra")',
            _Compra_ObtenerConsulta:    '@Url.Action("ObtenerConsulta",   "Compra")',
            _Compra_DetalleJson:        '@Url.Action("ObtenerDetalleJson","Compra")'
        });

        // ---- ORDEN PAGO ----
        $.MisUrls.urls({
            _OP_Obtener:   '@Url.Action("Obtener",   "OrdenPago")',
            _OP_Documento: '@Url.Action("Documento", "OrdenPago")',
            _OP_Consultar: '@Url.Action("Consultar", "OrdenPago")'
        });

        // ---- NOTA DE CRÉDITO ----
        $.MisUrls.urls({
            _NC_Index:             '@Url.Action("Index",             "NotaCredito")',
            _NC_Obtener:           '@Url.Action("Obtener",           "NotaCredito")',
            _NC_ConfirmarRecepcion:'@Url.Action("ConfirmarRecepcion","NotaCredito")',
            _NC_Rechazar:          '@Url.Action("Rechazar",          "NotaCredito")'
        });

        // ---- REPORTE GERENCIA ----
        $.MisUrls.urls({
            _RG_ObtenerDatos:  '@Url.Action("ObtenerDatos",  "ReporteGerencia")',
            _RG_DescargarPDF:  '@Url.Action("DescargarPDF",  "ReporteGerencia")'
        });

        // ---- VENTA DIRECTA ----
        $.MisUrls.urls({
            _Venta_Crear:                  '@Url.Action("Crear",                    "Venta")',
            _Venta_Consultar:              '@Url.Action("Consultar",                "Venta")',
            _Venta_Documento:              '@Url.Action("Documento",                "Venta")',
            _Venta_Obtener:                '@Url.Action("Obtener",                  "Venta")',
            _Venta_GuardarDirecta:         '@Url.Action("GuardarVentaDirecta",      "Venta")',
            _Venta_FacturarDesdeOV:        '@Url.Action("FacturarDesdeOV",          "Venta")',
            _Venta_Anular:                 '@Url.Action("Anular",                   "Venta")',
            _Venta_DatosTributarios:       '@Url.Action("ObtenerDatosTributarios",  "Venta")',
            _Venta_ProductoStock:          '@Url.Action("ObtenerProductoStockPorTienda","Venta")',
            _Venta_ObtenerClientes:        '@Url.Action("ObtenerClientes",           "Venta")',
            _Venta_FormasCobro:            '@Url.Action("ObtenerFormasCobro",        "Venta")'
        });

        // ---- PRE-VENTA (ORDEN DE VENTA) ----
        $.MisUrls.urls({
            _OV_Crear:        '@Url.Action("Crear",          "OrdenVenta")',
            _OV_Consultar:    '@Url.Action("Consultar",      "OrdenVenta")',
            _OV_Guardar:      '@Url.Action("Guardar",        "OrdenVenta")',
            _OV_Obtener:      '@Url.Action("Obtener",        "OrdenVenta")',
            _OV_Detalle:      '@Url.Action("ObtenerDetalle", "OrdenVenta")',
            _OV_Anular:       '@Url.Action("Anular",         "OrdenVenta")',
            _OV_UrlFacturar:  '@Url.Action("Facturar",       "Venta")'
        });

        // ---- COMPROBANTE DE COBRO ----
        $.MisUrls.urls({
            _CC_Index:   '@Url.Action("Index",   "ComprobanteCobro")',
            _CC_Obtener: '@Url.Action("Obtener", "ComprobanteCobro")'
        });

        // ---- NOTA DE CRÉDITO VENTA ----
