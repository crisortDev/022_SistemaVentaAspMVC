@using VentasWeb.Helpers
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO -->
    <meta name="description" content="Sistema de gestión - Tienda Compu Space" />
    <meta name="keywords" content="ventas, compras, tienda, compu space, sistema" />
    <meta name="author" content="Compu Space" />

    <!-- Cache -->
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />

    <title>@ViewBag.Title - Tienda COMPU SPACE</title>

    @{
        var version = DateTime.Now.Ticks.ToString();
    }

    @Styles.RenderFormat("<link href=\"{0}?v=" + version + "\" rel=\"stylesheet\"/>", "~/Content/css")
    @Styles.RenderFormat("<link href=\"{0}?v=" + version + "\" rel=\"stylesheet\"/>", "~/Content/PluginsCSS")
    @Scripts.RenderFormat("<script src=\"{0}?v=" + version + "\"></script>", "~/bundles/modernizr")

    @RenderSection("estilos", required: false)

    <style>
        /* ── NAVBAR ─────────────────────────────────────────── */
        .navbar {
            background: linear-gradient(90deg, #0984e3 0%, #00b4d8 100%) !important;
            box-shadow: 0 2px 12px rgba(9, 132, 227, 0.3);
            padding: 0 1.2rem;
            min-height: 56px;
        }

        .navbar-brand img {
            opacity: 0.95;
            transition: opacity 0.2s;
        }

        .navbar-brand:hover img {
            opacity: 1;
        }
        .navbar-brand:hover img { opacity: 1; }

        /* Links principales */
        .navbar-nav .nav-link {
            color: rgba(255,255,255,0.88) !important;
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 0.03em;
            padding: 0.65rem 0.9rem !important;
            border-radius: 6px;
            transition: background 0.18s, color 0.18s;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .navbar-nav .nav-link:hover,
        .navbar-nav .nav-item.active .nav-link {
            background: rgba(255,255,255,0.15) !important;
            color: #fff !important;
        }

        /* Dropdown toggle — quitar borde al abrir */
        .navbar-nav .nav-item.dropdown.show .nav-link {
            background: rgba(255,255,255,0.18) !important;
            color: #fff !important;
        }

        /* ── DROPDOWN MENU ──────────────────────────────────── */
        .dropdown-menu.drop-menu {
            background: #fff;
            border: none;
            border-radius: 10px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.13), 0 1px 4px rgba(0,0,0,0.06);
            padding: 6px;
            min-width: 210px;
            margin-top: 6px !important;
            animation: dropIn 0.18s cubic-bezier(0.16,1,0.3,1) both;
        }

       @@keyframes dropIn {
            from { opacity: 0; transform: translateY(-6px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .dropdown-item {
            border-radius: 6px;
            font-size: 0.84rem;
            font-weight: 500;
            color: #2d3748;
            padding: 8px 12px;
            display: flex;
            align-items: center;
            gap: 9px;
            transition: background 0.15s, color 0.15s;
        }

        .dropdown-item i {
            width: 16px;
            text-align: center;
            color: #0984e3;
            font-size: 0.82rem;
            flex-shrink: 0;
        }

        .dropdown-item:hover {
            background: #ebf5ff;
            color: #0984e3;
        }

        .dropdown-item:hover i { color: #0984e3; }

        /* Separador sutil entre items */
        .dropdown-item + .dropdown-item {
            border-top: 1px solid #f1f5f9;
        }

        /* ── BOTÓN SALIR ────────────────────────────────────── */
        .nav-salir .nav-link {
            background: rgba(255,255,255,0.12) !important;
            border: 1px solid rgba(255,255,255,0.25);
            border-radius: 7px !important;
            color: #fff !important;
            padding: 0.45rem 1rem !important;
            font-size: 0.83rem;
        }

        .nav-salir .nav-link:hover {
            background: rgba(255,255,255,0.22) !important;
            border-color: rgba(255,255,255,0.4);
        }

        /* ── USUARIO LOGUEADO (derecha) ─────────────────────── */
        .nav-user-info {
            display: flex;
            align-items: center;
            gap: 8px;
            color: rgba(255,255,255,0.88);
            font-size: 0.82rem;
            font-weight: 600;
            padding: 0 0.6rem;
        }

        .nav-user-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: rgba(255,255,255,0.2);
            border: 1.5px solid rgba(255,255,255,0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
        }

        /* ── FOOTER ─────────────────────────────────────────── */
        footer {
            border-top: 1px solid #e2e8f0;
            padding-top: 0.75rem;
            margin-top: 2rem;
            color: #94a3b8;
            font-size: 0.8rem;
        }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark" style="font-weight:bold">
        <a class="navbar-brand" href="@Url.Action("Index", "Home")">
            <img src="@Url.Content("~/Imagenes/tiendalogo.png")" width="110" height="45" alt="Logo Tienda Compu Space" />
        </a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent"
                aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Alternar navegación">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <!-- Menú izquierdo -->
            <ul class="navbar-nav mr-auto">
                <li class="nav-item">
                    <a class="nav-link" name="Home" href="@Url.Action("Index", "Home")">
                        <i class="fas fa-home"></i> Inicio
                    </a>
                </li>
                @Html.ActionLinkAllow() <!-- Menús dinámicos -->
            </ul>

            <!-- Menú derecho -->
            <ul class="navbar-nav ml-auto align-items-center">
                @{
                    var usuarioNav = Session["Usuario"] as CapaModelo.Usuario;
                }
                @if (usuarioNav != null)
                {
                    <li class="nav-item">
                        <span class="nav-user-info">
                            <span class="nav-user-avatar">👤</span>
                            <span>@usuarioNav.Nombres</span>
                        </span>
                    </li>
                }
                <li class="nav-item nav-salir">
                    <a href="@Url.Action("Salir", "Home")" class="nav-link">
                        <i class="fas fa-sign-out-alt"></i> Salir
                    </a>
                </li>
            </ul>
        </div>
    </nav>

    <!-- CUERPO -->
    <div class="container-fluid mt-4">
        @RenderBody()
        <footer class="text-center">
            <p>&copy; @DateTime.Now.Year — Tienda Compu Space</p>
        </footer>
    </div>

    <!-- SCRIPTS -->
    @{
        var cacheVersion = DateTime.Now.Ticks.ToString();
    }

    @Scripts.RenderFormat("<script src=\"{0}?v=" + cacheVersion + "\"></script>", "~/bundles/jquery")
    @Scripts.RenderFormat("<script src=\"{0}?v=" + cacheVersion + "\"></script>", "~/bundles/bootstrap")
    @Scripts.RenderFormat("<script src=\"{0}?v=" + cacheVersion + "\"></script>", "~/Content/PluginsJS")

    <!-- Configuración de URLs centralizadas -->
    <script type="text/javascript">
        $.extend({
            MisUrls: {
                url: {},
                urls: function (a) { $.extend($.MisUrls.url, a); }
            }
        });

        // ---- ROL ----
        $.MisUrls.urls({
            _ObtenerRoles: '@Url.Action("Obtener", "Rol")',
            _GuardarRol: '@Url.Action("Guardar", "Rol")',
            _DesactivarRol: '@Url.Action("Desactivar", "Rol")',
            _ListPermisosPorRol: '@Url.Action("ListPermisosPorRol", "Rol")',
            _GuardarRolConPermisos: '@Url.Action("GuardarRolConPermisos", "Rol")',
            _ListPermisosDisponibles: '@Url.Action("ListPermisosDisponibles", "Rol")'
        });

        // ---- PERMISOS ----
        $.MisUrls.urls({
            _ObtenerPermisos: '@Url.Action("Obtener", "Permisos")',
            _GuardarPermisos: '@Url.Action("Guardar", "Permisos")'
        });

        // ---- USUARIO ----
        $.MisUrls.urls({
            _ObtenerUsuarios: '@Url.Action("Obtener", "Usuario")',
            _GuardarUsuario: '@Url.Action("Guardar", "Usuario")',
            _EliminarUsuario: '@Url.Action("Eliminar", "Usuario")',
            _CambiarEstadoUsuario: '@Url.Action("CambiarEstadoUsuario", "Usuario")',
            _CrearUsuarioPendiente: '@Url.Action("CrearUsuarioPendiente", "Usuario")',
            _CambiarClave: '@Url.Action("CambioContraseña", "Usuario")'
        });

        // ---- EMPLEADO ----
        $.MisUrls.urls({
            _EsEmpleado: '@Url.Action("EsEmpleado", "Empleado")',
            _BuscarEmpleadoPorCI: '@Url.Action("BuscarEmpleadoPorCI", "Usuario")',
            _BuscarPorCI: '@Url.Action("BuscarPorCI", "Empleado")',
            _ObtenerTiendasActivas: '@Url.Action("ObtenerTiendasActivas", "Empleado")'
        });

        // ---- PROVEEDOR ----
        $.MisUrls.urls({
            _ObtenerProveedores: '@Url.Action("Obtener", "Proveedor")',
            _GuardarProveedor: '@Url.Action("Guardar", "Proveedor")',
            _EliminarProveedor: '@Url.Action("Eliminar", "Proveedor")',
            _ObtenerHistorialPrecio: '@Url.Action("ObtenerHistorialPrecio", "Historial")'
        });

        // ---- CATEGORIA ----
        $.MisUrls.urls({
            _ObtenerCategorias: '@Url.Action("Obtener", "Categoria")',
            _GuardarCategoria: '@Url.Action("Guardar", "Categoria")',
            _EliminarCategoria: '@Url.Action("Eliminar", "Categoria")'
        });

        // ---- PRODUCTO ----
        $.MisUrls.urls({
            _ObtenerProductos: '@Url.Action("Obtener", "Producto")',
            _ObtenerProductosPorTienda: '@Url.Action("ObtenerProductosPorTienda", "Producto")',
            _GuardarProducto: '@Url.Action("Guardar", "Producto")',
            _EliminarProducto: '@Url.Action("Eliminar", "Producto")',
            _ObtenerAsignaciones: '@Url.Action("ObtenerAsignaciones", "Producto")',
            _RegistrarProductoTienda: '@Url.Action("RegistrarProductoTienda", "Producto")',
            _ModificarProductoTienda: '@Url.Action("ModificarProductoTienda", "Producto")',
            _EliminarProductoTienda: '@Url.Action("EliminarProductoTienda", "Producto")',
            _BuscarProductoPorCodigo: '@Url.Action("BuscarProductoPorCodigo", "Producto")'
        });

        // ---- TIENDA ----
        $.MisUrls.urls({
            _ObtenerTiendas: '@Url.Action("Obtener", "Tienda")',
            _GuardarTienda: '@Url.Action("Guardar", "Tienda")',
            _EliminarTienda: '@Url.Action("Eliminar", "Tienda")'
        });

        // ---- COMPRA ----
        $.MisUrls.urls({
            _ObtenerCompras: '@Url.Action("Obtener", "Compra")',
            _GuardarCompra: '@Url.Action("Guardar", "Compra")',
            _DocumentoCompra: '@Url.Action("Documento", "Compra")'
        });

        // ---- VENTA ----
        $.MisUrls.urls({
            _ObtenerUsuario: '@Url.Action("ObtenerUsuario", "Venta")',
            _ObtenerProductoStockPorTienda: '@Url.Action("ObtenerProductoPorTienda", "Venta")',
            _ControlarStockProducto: '@Url.Action("ControlarStock", "Venta")',
            _RegistrarVenta: '@Url.Action("Guardar", "Venta")',
            _DocumentoVenta: '@Url.Action("Documento", "Venta")',
            _ObtenerVentas: '@Url.Action("Obtener", "Venta")'
        });

        // ---- PRECIOS VENTA ----
        $.MisUrls.urls({
            _ObtenerHistorialPreciosVenta: '@Url.Action("ObtenerHistorial", "PreciosVenta")',
            _GuardarPrecioVenta: '@Url.Action("Guardar", "PreciosVenta")',
            _EliminarPrecioVenta: '@Url.Action("Eliminar", "PreciosVenta")'
        });

        // ---- REPORTE ----
        $.MisUrls.urls({
            _ObtenerReporteProducto: '@Url.Action("ObtenerProducto", "Reporte")',
            _ObtenerReporteVenta:    '@Url.Action("ObtenerVenta",   "Reporte")',
            _ObtenerReporteBajas:    '@Url.Action("ObtenerBajas",   "Reporte")'
        });

        // ---- CLIENTE ----
        $.MisUrls.urls({
            _ObtenerClientes: '@Url.Action("Obtener", "Cliente")',
            _GuardarCliente: '@Url.Action("Guardar", "Cliente")',
            _EliminarCliente: '@Url.Action("Eliminar", "Cliente")'
        });

        // ---- MOVIMIENTOS CAJA ----
        $.MisUrls.urls({
            _BuscarMovimientosCaja: '@Url.Action("BuscarCompras", "ConsultarCajaCompra")',
            _PagarMovimiento: '@Url.Action("Pagar", "ConsultarCajaCompra")',
            _CancelarMovimiento: '@Url.Action("Cancelar", "ConsultarCajaCompra")'
        });

        // ---- INVENTARIO ----
        $.MisUrls.urls({
            _RegistrarTraslado:                 '@Url.Action("RegistrarTraslado",             "Inventario")',
            _ObtenerHistorialTraslados:         '@Url.Action("ObtenerHistorialTraslados",     "Inventario")',
            _BajarStock:                        '@Url.Action("BajarStock",                    "Inventario")',
            _ObtenerProductosPorTiendaBaja:     '@Url.Action("ObtenerProductosPorTiendaBaja","Inventario")',
            _ObtenerProductosPorTiendaTraslado: '@Url.Action("ObtenerProductosPorTienda",    "Inventario")',
            _ObtenerStock:                      '@Url.Action("ObtenerStock",                  "Inventario")',
            _ObtenerMotivosBaja:                '@Url.Action("Obtener",                       "MotivoBaja")'
        });

        // ---- DATATABLES ----
        $.MisUrls.urls({
            Url_datatable_spanish: '@Url.Content("~/content/plugins/datatables/js/datatable_spanish.json")'
        });
    </script>

    <script>
        function activarMenu(menuactivo) {
            $("ul.navbar-nav li.nav-item").each(function () {
                var li = $(this);
                var dropdown = li.find("div.dropdown-menu");
                if (dropdown.length) {
                    dropdown.find("a.dropdown-item").each(function () {
                        if ($(this).attr("name") == menuactivo) li.addClass("active");
                    });
                } else {
                    var a = li.find("a.nav-link");
                    if (a.attr("name") == menuactivo) li.addClass("active");
                }
            });
        }
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>
