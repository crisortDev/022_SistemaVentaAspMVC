@{
    ViewBag.Title = "Home Page";
}
<div class="container-fluid py-5" style="background: linear-gradient(135deg, #74b9ff, #55efc4); min-height: 100vh;">
    <div class="row justify-content-center mb-4">
        <div class="col-lg-8 text-center text-white">
            <h1 class="display-4 fw-bold animate__animated animate__fadeInDown">Bienvenido, @ViewBag.NombreUsuario</h1>
            <p class="lead animate__animated animate__fadeIn mt-2">ROL: @ViewBag.RolUsuario</p>
            <p class="mb-0 fs-5 animate__animated animate__fadeIn mt-2">Sistema de Gestión <span class="fw-bold">CompuSpace</span></p>
        </div>
    </div>

    <div class="row justify-content-center mt-5">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 p-4 animate__animated animate__fadeInUp">
                <h4 class="fw-bold text-center mb-3">Fecha y Hora Actual</h4>
                <p class="text-center fs-5" id="reloj"></p>
            </div>
        </div>
    </div>

    <div class="row justify-content-center mt-4">
        <div class="col-lg-8 text-center text-white-50">
            <p>&copy; 2025 CompuSpace. Todos los derechos reservados.</p>
        </div>
    </div>
</div>

@section scripts{
    <script src="https://cdn.jsdelivr.net/npm/animate.css@4.1.1/animate.min.css"></script>
    <script type="text/javascript">
        function actualizarReloj() {
            const ahora = new Date();
            const opciones = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit' };
            document.getElementById('reloj').textContent = ahora.toLocaleDateString('es-PY', opciones);
        }
        setInterval(actualizarReloj, 1000);
        actualizarReloj();
    </script>
}
