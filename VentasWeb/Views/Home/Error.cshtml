@{
    ViewBag.Title = "Error del servidor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-sm-8 col-md-6 text-center">

            <div class="card border-danger shadow">
                <div class="card-body py-5 px-4">

                    <i class="fas fa-exclamation-circle text-danger" style="font-size:4rem;"></i>

                    <h2 class="mt-3 font-weight-bold text-danger">Error inesperado</h2>
                    <p class="text-muted mt-2">
                        Ocurrió un problema al procesar tu solicitud.<br />
                        El equipo técnico fue notificado automáticamente.
                    </p>

                    <hr />

                    <div class="mt-3">
                        <a href="javascript:history.back()" class="btn btn-outline-secondary mr-2">
                            <i class="fas fa-arrow-left mr-1"></i> Volver
                        </a>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
                            <i class="fas fa-home mr-1"></i> Ir al inicio
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
