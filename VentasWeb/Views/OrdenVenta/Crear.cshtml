@{
    ViewBag.Title = "Registrar Pre-venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Venta</a></li>
        <li class="breadcrumb-item active">Registrar Pre-venta</li>
    </ol>
</nav>

<div class="row">
    <div class="col-sm-12">
        <div class="card border-info">
            <div class="card-header bg-info text-white">
                <i class="fas fa-clipboard-list mr-1"></i> Registrar Pre-venta / Presupuesto
            </div>
            <div class="card-body p-2">

                <!-- Cliente + Vencimiento -->
                <div class="row">
                    <div class="col-sm-6">
                        <div class="card border-info">
                            <div class="card-body p-2">
                                <h6 class="card-title mb-1 text-info">Cliente <span class="text-danger">*</span></h6>
                                <div class="row align-items-end">
                                    <input type="hidden" id="hdnIdCliente" value="0" />
                                    <div class="col-sm-4">
                                        <label class="col-form-label col-form-label-sm">Documento:</label>
                                        <input type="text" class="form-control form-control-sm" readonly id="txtDocumentoCliente" placeholder="—">
                                    </div>
                                    <div class="col-sm-5">
                                        <label class="col-form-label col-form-label-sm">Nombre:</label>
                                        <input type="text" class="form-control form-control-sm" readonly id="txtNombreCliente" placeholder="Sin especificar">
                                    </div>
                                    <div class="col-sm-3">
                                        <label class="col-form-label col-form-label-sm invisible">.</label>
                                        <div class="btn-group btn-block" role="group">
                                            <button type="button" class="btn btn-sm btn-info" onclick="buscarCliente()" title="Buscar cliente registrado">
                                                <i class="fas fa-search"></i> Buscar
                                            </button>
                                            <a href="@Url.Action("Crear","Cliente")" target="_blank"
                                               class="btn btn-sm btn-outline-info" title="Registrar nuevo cliente (abre en nueva pestaña)">
                                                <i class="fas fa-user-plus"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="card border-info">
                            <div class="card-body p-2">
                                <h6 class="card-title mb-1 text-info">Cabecera</h6>
                                <div class="row align-items-end">
                                    <div class="col-sm-4">
                                        <label class="col-form-label col-form-label-sm">Fecha Vencimiento: <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control form-control-sm datepicker" id="txtFechaVencimiento" autocomplete="off" placeholder="dd/mm/aaaa">
                                    </div>
                                    <div class="col-sm-8">
                                        <label class="col-form-label col-form-label-sm">Observación:</label>
                                        <input type="text" class="form-control form-control-sm" id="txtObservacion" maxlength="500">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Agregar productos -->
                <div class="row mt-2 align-items-end">
                    <div class="col-sm-3">
                        <button type="button" class="btn btn-info btn-sm btn-block" onclick="abrirModalProductos()">
                            <i class="fas fa-plus-circle"></i> Agregar Productos
                        </button>
                    </div>
                    <div class="col-sm-9 d-flex align-items-end pb-1">
                        <small class="text-muted">
                            <i class="fas fa-info-circle text-info"></i>
                            Solo se pueden agregar productos con disponibilidad. El cajero gestiona el cobro al facturar.
                        </small>
                    </div>
                </div>

                <hr />

                <!-- Tabla detalle -->
                <div class="table-responsive-sm">
                    <table id="tbDetalle" class="table table-striped table-bordered table-sm" style="width:100%">
                        <thead>
                            <tr>
                                <th style="width:40px"></th>
                                <th style="width:80px">Código</th>
                                <th>Producto</th>
                                <th style="width:90px" class="text-center">Cantidad</th>
                                <th style="width:90px" class="text-center">Desc.%</th>
                                <th style="width:130px" class="text-right">Precio Unit. (Gs.)</th>
                                <th style="width:60px" class="text-center">IVA%</th>
                                <th style="width:120px" class="text-right">Total (Gs.)</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                        <tfoot>
                            <tr class="font-weight-bold bg-light">
                                <td colspan="3" class="text-right">Totales:</td>
                                <td class="text-center" id="tfCantidad">0</td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td class="text-right" id="tfTotal">Gs. 0</td>
                            </tr>
                            <tr>
                                <td colspan="6" class="text-right text-muted small">IVA 10% (inc.):</td>
                                <td colspan="2" class="text-right small" id="tfIva10">0</td>
                            </tr>
                            <tr>
                                <td colspan="6" class="text-right text-muted small">IVA 5% (inc.):</td>
                                <td colspan="2" class="text-right small" id="tfIva5">0</td>
                            </tr>
                            <tr class="table-info">
                                <td colspan="6" class="text-right font-weight-bold">TOTAL ESTIMADO:</td>
                                <td colspan="2" class="text-right font-weight-bold h5 mb-0" id="tfTotalFinal">Gs. 0</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

            </div>
            <div class="card-footer bg-white border-info d-flex justify-content-between align-items-center">
                <small class="text-muted" id="lblValidacion"></small>
                <button id="btnGuardar" class="btn btn-info" onclick="guardarPreVenta()">
                    <i class="fas fa-save"></i> Guardar Pre-venta
                </button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL CLIENTE -->
<div class="modal fade" id="modalCliente" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white py-2">
                <h5 class="modal-title"><i class="fas fa-user-tag mr-1"></i> Seleccionar Cliente</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body py-2">
                <table id="tbCliente" class="table table-striped table-bordered table-sm" style="width:100%">
                    <thead>
                        <tr><th style="width:50px"></th><th>Documento</th><th>Nombre</th><th>Teléfono</th></tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- MODAL PRODUCTO -->
<div class="modal fade" id="modalProducto" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white py-2">
                <h5 class="modal-title"><i class="fas fa-box-open mr-1"></i> Seleccionar Producto</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body py-2">
                <table id="tbProducto" class="table table-striped table-bordered table-sm" style="width:100%">
                    <thead>
                        <tr>
                            <th style="width:50px"></th>
                            <th>Código</th>
                            <th>Producto</th>
                            <th class="text-right">Precio Sugerido (Gs.)</th>
                            <th class="text-center">Margen%</th>
                            <th class="text-center">Disponibilidad</th>
                            <th class="text-center">IVA%</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="modal-footer py-2">
                <small class="text-muted mr-auto"><i class="fas fa-info-circle text-info"></i> Podés agregar múltiples productos.</small>
                <button type="button" class="btn btn-info btn-sm" data-dismiss="modal"><i class="fas fa-check"></i> Listo</button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script src="@Url.Content("~/Scripts/Views/OrdenVenta_Crear.js?v=" + DateTime.Now.Ticks)" type="text/javascript"></script>
}
