@{
    ViewBag.Title = "Gestión de Inventarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool esSuperAdmin = Session["EsSuperAdmin"] != null && (bool)Session["EsSuperAdmin"];
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Existencia</a></li>
        <li class="breadcrumb-item active">Inventarios</li>
    </ol>
</nav>

<div class="card border-primary">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <span><i class="fas fa-clipboard-check mr-1"></i> Gestión de inventarios</span>
        <button class="btn btn-sm btn-light" id="btnNuevoInventario">
            <i class="fas fa-plus mr-1"></i> Nuevo inventario
        </button>
    </div>
    <div class="card-body">
        <div class="row align-items-end mb-2">
            <div class="col-sm-3">
                <label class="col-form-label-sm font-weight-bold">Estado:</label>
                <select id="ddlEstado" class="form-control form-control-sm">
                    <option value="Pendiente de Aprobación">Pendientes de aprobación</option>
                    <option value="En Progreso">En progreso</option>
                    <option value="Abierto">Abiertos</option>
                    <option value="En Corrección">En corrección</option>
                    <option value="Aprobado">Aprobados</option>
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-sm-2">
                <button id="btnBuscar" class="btn btn-sm btn-primary btn-block">
                    <i class="fas fa-search"></i> Buscar
                </button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-sm table-bordered table-hover">
                <thead class="thead-light">
                    <tr>
                        <th>Número</th>
                        <th>Sucursal</th>
                        <th>Supervisor</th>
                        <th>Operador(es)</th>
                        <th>Apertura</th>
                        <th>Fin de conteo</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tbodyInv"></tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Nuevo inventario (sucursal + operador + observación en un solo paso) -->
<div class="modal fade" id="modalNuevo" tabindex="-1" role="dialog" aria-modal="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header py-2 bg-primary text-white">
                <h6 class="modal-title"><i class="fas fa-clipboard-list mr-1"></i> Nuevo inventario</h6>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">

                @if (esSuperAdmin) {
                    <div class="form-group">
                        <label class="col-form-label-sm font-weight-bold">Sucursal: <span class="text-danger">*</span></label>
                        <select id="cboTiendaNuevo" class="form-control form-control-sm">
                            <option value="">-- Seleccione sucursal --</option>
                        </select>
                    </div>
                } else {
                    <input type="hidden" id="cboTiendaNuevo" value="" />
                    <div class="form-group">
                        <label class="col-form-label-sm font-weight-bold">Sucursal:</label>
                        <div class="form-control form-control-sm bg-light text-info font-weight-bold" id="lblTiendaNuevo"
                             style="pointer-events:none"></div>
                    </div>
                }

                <div class="form-group">
                    <label class="col-form-label-sm font-weight-bold">
                        Repositor a cargo: <span class="text-danger">*</span>
                        <small class="text-muted font-weight-normal">(rol Repositor)</small>
                    </label>
                    <select id="cboOperadorNuevo" class="form-control form-control-sm">
                        <option value="">@(esSuperAdmin ? "-- Seleccione sucursal primero --" : "-- Cargando repositores... --")</option>
                    </select>
                </div>

                <div class="form-group mb-0">
                    <label class="col-form-label-sm font-weight-bold">Observación: <span class="text-danger">*</span></label>
                    <input type="text" id="txtObsNuevo" class="form-control form-control-sm" maxlength="500"
                           placeholder="Ej: Conteo mensual de stock — turno mañana" />
                </div>
            </div>
            <div class="modal-footer py-2">
                <button class="btn btn-sm btn-secondary" data-dismiss="modal">Cancelar</button>
                <button class="btn btn-sm btn-primary" id="btnConfirmarNuevo">
                    <i class="fas fa-save mr-1"></i> Crear y asignar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Asignar operador adicional (desde tabla, inventarios ya existentes) -->
<div class="modal fade" id="modalAsignar" tabindex="-1" role="dialog" aria-modal="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header py-2 bg-info text-white">
                <h6 class="modal-title">
                    <i class="fas fa-user-plus mr-1"></i> Asignar operador —
                    <span id="lblNumAsignar"></span>
                </h6>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="form-group mb-0">
                    <label class="col-form-label-sm font-weight-bold">Operador:</label>
                    <select id="cboOperador" class="form-control form-control-sm">
                        <option value="">-- Seleccione usuario --</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button class="btn btn-sm btn-secondary" data-dismiss="modal">Cerrar</button>
                <button class="btn btn-sm btn-info" id="btnConfirmarAsignar">
                    <i class="fas fa-user-check mr-1"></i> Asignar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Detalle / Reporte de diferencias -->
<div class="modal fade" id="modalDetalle" tabindex="-1" role="dialog" aria-modal="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title">
                    <i class="fas fa-chart-bar mr-1"></i> Reporte de diferencias —
                    <span id="lblNumDetalle"></span>
                </h6>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <table class="table table-sm table-bordered">
                    <thead class="thead-light">
                        <tr>
                            <th>Categoría</th>
                            <th>Producto</th>
                            <th class="text-center">Stock Sistema</th>
                            <th class="text-center">Cantidad Contada</th>
                            <th class="text-center">Diferencia</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyDet"></tbody>
                </table>
                <div id="resumenDiferencias" class="mt-2 small text-muted"></div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/Views/Inventario_Inventarios.js?v=" + DateTime.Now.Ticks)"></script>
}
