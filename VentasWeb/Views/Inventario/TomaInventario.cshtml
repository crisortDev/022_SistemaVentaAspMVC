@{
    ViewBag.Title = "Toma de Inventario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Existencia</a></li>
        <li class="breadcrumb-item active">Toma de Inventario</li>
    </ol>
</nav>

@* ── Panel A: Lista de inventarios asignados al operador ── *@
<div id="panelLista">
    <div class="card border-info mb-3">
        <div class="card-header bg-info text-white">
            <i class="fas fa-clipboard-list mr-1"></i> Mis inventarios asignados
        </div>
        <div class="card-body p-2">
            <div class="table-responsive">
                <table class="table table-sm table-bordered table-hover mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th>Número</th>
                            <th>Sucursal</th>
                            <th>Asignado</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center">Acción</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyAsignados">
                        <tr><td colspan="5" class="text-center text-muted">Cargando...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* ── Panel B: Conteo físico (DataTable con todos los productos) ── *@
<div id="panelConteo" style="display:none;">
    <div class="card border-warning">
        <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
            <span>
                <i class="fas fa-pencil-alt mr-1"></i> Conteo físico —
                <strong id="lblNumeroConteo"></strong>
            </span>
            <button class="btn btn-sm btn-outline-dark" id="btnVolver">
                <i class="fas fa-arrow-left mr-1"></i> Volver
            </button>
        </div>
        <div class="card-body">

            @* Aviso de corrección *@
            <div id="alertaCorreccion" class="alert alert-warning d-none mb-3">
                <i class="fas fa-exclamation-triangle mr-1"></i>
                <strong>Este inventario fue devuelto para corrección.</strong>
                <div id="textoMotivo" class="mt-1 small"></div>
            </div>

            @* Instrucción *@
            <p class="text-muted small mb-2">
                <i class="fas fa-info-circle mr-1"></i>
                Ingrese la cantidad física contada para cada producto. Solo se registrarán los productos con cantidad mayor a <strong>0</strong>.
                Use el buscador de la tabla para filtrar por categoría o producto.
            </p>

            <input type="hidden" id="hdnIdInventarioActivo" />
            <input type="hidden" id="hdnIdTiendaConteo" />

            @* Resumen del conteo *@
            <div class="mb-3">
                <h6 class="font-weight-bold border-bottom pb-1 mb-2">
                    <i class="fas fa-chart-bar mr-1"></i> Resumen del Conteo
                </h6>
                <table class="table table-sm table-bordered" style="max-width:420px; font-size:13px;">
                    <thead class="thead-dark">
                        <tr>
                            <th>Concepto</th>
                            <th class="text-center" style="width:100px;">Resultado</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Total productos a revisar</td>
                            <td class="text-center font-weight-bold" id="resumenTotal">—</td>
                        </tr>
                        <tr class="table-success">
                            <td><i class="fas fa-check-circle text-success mr-1"></i> Productos encontrados</td>
                            <td class="text-center font-weight-bold text-success" id="resumenEncontrados">—</td>
                        </tr>
                        <tr class="table-danger">
                            <td><i class="fas fa-times-circle text-danger mr-1"></i> Productos sin existencia</td>
                            <td class="text-center font-weight-bold text-danger" id="resumenSinExistencia">—</td>
                        </tr>
                        <tr class="table-warning">
                            <td><i class="fas fa-clock text-warning mr-1"></i> Productos pendientes</td>
                            <td class="text-center font-weight-bold" style="color:#856404;" id="resumenPendientes">—</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            @* DataTable de productos *@
            <div class="table-responsive">
                <table id="tblConteo" class="table table-sm table-bordered table-hover w-100">
                    <thead class="thead-light">
                        <tr>
                            <th>Categoría</th>
                            <th>Código</th>
                            <th>Producto</th>
                            <th class="text-center" style="width:160px;">Cantidad Contada</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyConteo"></tbody>
                </table>
            </div>

            <div class="row mt-3">
                <div class="col-sm-6">
                    <label class="col-form-label-sm font-weight-bold">Observación: <span class="text-danger">*</span></label>
                    <input type="text" id="txtObservacion" class="form-control form-control-sm" maxlength="500" placeholder="Ej: Conteo turno mañana, sin novedades" />
                </div>
                <div class="col-sm-6 d-flex align-items-end justify-content-end">
                    <span class="text-muted small mr-3" id="lblCantItems"></span>
                    <button id="btnFinalizar" class="btn btn-success">
                        <i class="fas fa-check-circle mr-1"></i> Finalizar inventario
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/Views/Inventario_TomaInventario.js?v=" + DateTime.Now.Ticks)"></script>
}
