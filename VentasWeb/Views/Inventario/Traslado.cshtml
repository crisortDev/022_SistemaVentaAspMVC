@{
    ViewBag.Title = "Traslado entre Sucursales";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Inventario</a></li>
        <li class="breadcrumb-item active">Traslado entre Sucursales</li>
    </ol>
</nav>

<!-- ══ TABS ═══════════════════════════════════════════════════ -->
<ul class="nav nav-tabs mb-3" id="tabTraslado" role="tablist">
    <li class="nav-item">
        <a class="nav-link active" data-toggle="tab" href="#panel-solicitar">
            <i class="fas fa-paper-plane mr-1 text-warning"></i> Solicitar
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" id="tabDespachar" data-toggle="tab" href="#panel-despachar">
            <i class="fas fa-truck mr-1 text-primary"></i> Despachar
            <span class="badge badge-primary ml-1" id="badgeDespachar" style="display:none;"></span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" id="tabRecepcionar" data-toggle="tab" href="#panel-recepcionar">
            <i class="fas fa-box-open mr-1 text-success"></i> Recepcionar
            <span class="badge badge-success ml-1" id="badgeRecepcionar" style="display:none;"></span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-toggle="tab" href="#panel-historial">
            <i class="fas fa-history mr-1 text-secondary"></i> Historial
        </a>
    </li>
</ul>

<div class="tab-content">

    <!-- ══ PASO 1: SOLICITAR ══════════════════════════════════ -->
    <div class="tab-pane fade show active" id="panel-solicitar">
        <div class="card border-warning">
            <div class="card-header bg-warning">
                <i class="fas fa-paper-plane mr-1"></i>
                Paso 1 — Solicitar productos a otra sucursal
            </div>
            <div class="card-body">
                <div class="form-row align-items-end mb-3">
                    <div class="col-sm-4">
                        <label class="col-form-label-sm font-weight-bold">Sucursal Origen <small class="text-muted">(de dónde vienen)</small>:</label>
                        <select id="cboTiendaOrigen" class="form-control form-control-sm">
                            <option value="">-- Seleccioná la sucursal --</option>
                        </select>
                    </div>
                    <div class="col-sm-4">
                        <label class="col-form-label-sm font-weight-bold">Sucursal Destino <small class="text-muted">(mi sucursal)</small>:</label>
                        <input type="text" id="txtMiSucursal" class="form-control form-control-sm bg-light" readonly />
                    </div>
                </div>

                <!-- Placeholder sin tienda seleccionada -->
                <div id="divSinTienda" class="alert alert-info py-2 mb-2">
                    <i class="fas fa-info-circle mr-1"></i> Seleccioná una sucursal origen para ver sus productos disponibles.
                </div>

                <!-- Tabla productos de la tienda origen -->
                <div id="divTablaProductos" style="display:none;">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small" id="lblTotalProductos"></span>
                        <input type="text" id="txtBuscarProducto" class="form-control form-control-sm w-25"
                               placeholder="Buscar producto..." oninput="filtrarProductos(this.value)" />
                    </div>
                    <div class="table-responsive" style="max-height:300px;overflow-y:auto;">
                        <table class="table table-sm table-bordered table-hover">
                            <thead class="thead-dark sticky-top">
                                <tr>
                                    <th>Código</th>
                                    <th>Producto</th>
                                    <th class="text-center">Stock disponible</th>
                                    <th class="text-center" style="width:110px">Acción</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyProductos"></tbody>
                        </table>
                    </div>
                </div>

                <!-- Carrito de productos seleccionados -->
                <div id="divCarrito" style="display:none;" class="mt-3">
                    <h6 class="font-weight-bold border-top pt-2">
                        <i class="fas fa-shopping-cart mr-1 text-warning"></i> Productos seleccionados para solicitar:
                    </h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered">
                            <thead class="thead-light">
                                <tr>
                                    <th>Código</th>
                                    <th>Producto</th>
                                    <th class="text-center" style="width:150px">Cantidad a solicitar</th>
                                    <th class="text-center" style="width:90px">Stock origen</th>
                                    <th class="text-center" style="width:50px"></th>
                                </tr>
                            </thead>
                            <tbody id="tbodyCarrito"></tbody>
                        </table>
                    </div>
                    <div class="form-group">
                        <label class="col-form-label-sm font-weight-bold">Observaciones <span class="text-danger">*</span>:</label>
                        <textarea id="txtObservaciones" class="form-control form-control-sm" rows="2"
                                  placeholder="Indicá el motivo del traslado..."></textarea>
                    </div>
                    <button class="btn btn-warning" onclick="enviarSolicitud()">
                        <i class="fas fa-paper-plane mr-1"></i> Enviar Solicitud al Supervisor de Origen
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ PASO 3: DESPACHAR ══════════════════════════════════ -->
    <div class="tab-pane fade" id="panel-despachar">
        <div class="card border-primary">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <span><i class="fas fa-truck mr-1"></i> Paso 3 — Pedidos aprobados a despachar desde mi sucursal</span>
                <button class="btn btn-outline-light btn-sm" onclick="cargarDespachar()">
                    <i class="fas fa-sync-alt"></i>
                </button>
            </div>
            <div class="card-body p-2">
                <div id="divDespacharVacio" class="alert alert-info py-2 mb-0" style="display:none;">
                    <i class="fas fa-check-circle mr-1"></i> No hay pedidos aprobados pendientes de despacho.
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered table-hover mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>N°</th>
                                <th>Fecha solicitud</th>
                                <th>Destino</th>
                                <th>Solicitó</th>
                                <th>Supervisor aprobó</th>
                                <th class="text-center">Ítems / Unid.</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyDespachar"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ PASO 4: RECEPCIONAR ════════════════════════════════ -->
    <div class="tab-pane fade" id="panel-recepcionar">
        <div class="card border-success">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                <span><i class="fas fa-box-open mr-1"></i> Paso 4 — Mercadería en camino a mi sucursal</span>
                <button class="btn btn-outline-light btn-sm" onclick="cargarRecepcionar()">
                    <i class="fas fa-sync-alt"></i>
                </button>
            </div>
            <div class="card-body p-2">
                <div id="divRecepcionarVacio" class="alert alert-info py-2 mb-0" style="display:none;">
                    <i class="fas fa-check-circle mr-1"></i> No hay mercadería en tránsito hacia tu sucursal.
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered table-hover mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>N°</th>
                                <th>Fecha solicitud</th>
                                <th>Origen</th>
                                <th>Despachó</th>
                                <th>Fecha despacho</th>
                                <th class="text-center">Ítems / Unid.</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyRecepcionar"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ HISTORIAL ══════════════════════════════════════════ -->
    <div class="tab-pane fade" id="panel-historial">
        <div class="card border-secondary">
            <div class="card-header bg-secondary text-white">
                <i class="fas fa-history mr-1"></i> Historial de Traslados
            </div>
            <div class="card-body">
                <div class="form-row align-items-end mb-3">
                    <div class="col-sm-3">
                        <label class="col-form-label-sm font-weight-bold">Desde:</label>
                        <input type="text" id="txtFechaInicio" class="form-control form-control-sm" />
                    </div>
                    <div class="col-sm-3">
                        <label class="col-form-label-sm font-weight-bold">Hasta:</label>
                        <input type="text" id="txtFechaFin" class="form-control form-control-sm" />
                    </div>
                    <div class="col-sm-2">
                        <label class="col-form-label-sm font-weight-bold">Estado:</label>
                        <select id="ddlEstadoHistorial" class="form-control form-control-sm">
                            <option value="">Todos</option>
                            <option value="Solicitado">Solicitado</option>
                            <option value="Aprobado">Aprobado</option>
                            <option value="Despachado">Despachado</option>
                            <option value="Completado">Completado</option>
                            <option value="Rechazado">Rechazado</option>
                        </select>
                    </div>
                    <div class="col-sm-2">
                        <button class="btn btn-sm btn-secondary btn-block" onclick="buscarHistorial()">
                            <i class="fas fa-search"></i> Buscar
                        </button>
                    </div>
                </div>
                <div class="table-responsive">
                    <table id="tbHistorial" class="table table-sm table-bordered table-hover" style="width:100%">
                        <thead class="thead-dark">
                            <tr>
                                <th>N°</th>
                                <th>Fecha</th>
                                <th>Origen</th>
                                <th>Destino</th>
                                <th>Solicitó</th>
                                <th class="text-center">Ítems</th>
                                <th class="text-center">Unid.</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center"></th>
                            </tr>
                        </thead>
                        <tbody id="tbodyHistorial"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div><!-- /tab-content -->

<!-- ══ MODAL DETALLE ÍTEMS ════════════════════════════════════ -->
<div class="modal fade" id="modalDetalle" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white py-2">
                <h6 class="modal-title">
                    <i class="fas fa-list-ul mr-1"></i> Detalle — Traslado <span id="lblNumeroDetalle" class="badge badge-light ml-1"></span>
                </h6>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body p-2">
                <table class="table table-sm table-bordered mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th>Código</th>
                            <th>Producto</th>
                            <th class="text-center">Cantidad solicitada</th>
                            <th class="text-center">Stock actual (origen)</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyDetalle"></tbody>
                </table>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/Views/Inventario_Traslado.js?v=" + DateTime.Now.Ticks)"></script>
}
