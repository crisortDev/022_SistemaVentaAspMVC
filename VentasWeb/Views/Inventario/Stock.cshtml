@{
    ViewBag.Title = "Stock por Tienda";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.5/css/dataTables.bootstrap4.min.css" />
<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Inventario</a></li>
        <li class="breadcrumb-item active">Stock por Tienda</li>
    </ol>
</nav>

<div class="card border-success">
    <div class="card-header bg-success text-white">
        <i class="fas fa-boxes"></i> Consulta de Stock por Tienda
    </div>
    <div class="card-body">
        <!-- Filtros -->
        <div class="row mb-3">
            <div class="col-sm-4">
                <label>Tienda</label>
                <select id="cboTienda" class="form-control form-control-sm">
                    <option value="0">-- Todas las tiendas --</option>
                </select>
            </div>
            <div class="col-sm-4 d-flex align-items-end">
                <button onclick="buscarStock()" class="btn btn-success btn-sm">
                    <i class="fas fa-search"></i> Consultar
                </button>
            </div>
        </div>

        <!-- Leyenda de estados -->
        <div class="row mb-2">
            <div class="col">
                <span class="badge badge-danger mr-2">CRÍTICO</span> Stock ≤ mínimo
                <span class="badge badge-warning ml-3 mr-2">BAJO</span> Stock ≤ 1.5x mínimo
                <span class="badge badge-success ml-3 mr-2">OK</span> Stock normal
            </div>
        </div>

        <div class="table-responsive">
            <table id="tbStock" class="table table-striped table-bordered table-sm">
                <thead class="thead-dark">
                    <tr>
                        <th>Código</th>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th>Tienda</th>
                        <th>Stock</th>
                        <th>Mín.</th>
                        <th>Máx.</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/Views/Inventario_Stock.js?v=" + DateTime.Now.Ticks)" type="text/javascript"></script>
}
