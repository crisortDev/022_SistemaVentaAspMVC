@{
    ViewBag.Title = "Productos por Tienda";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section estilos{
    <style>
        #inner-right {
            max-height: 400px;
            overflow-y: auto;
        }
    </style>
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Reportes</a></li>
        <li class="breadcrumb-item active" aria-current="page">Productos por tienda</li>
    </ol>
</nav>

<div class="row">
    <div class="col-sm-12">
        <div class="card border-info">
            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                <span><i class="fas fa-boxes"></i> Reporte de productos por tienda</span>
                <button id="btnExportarPDF" class="btn btn-sm btn-light" onclick="exportarPDF()" disabled>
                    <i class="fas fa-file-pdf text-danger"></i> Exportar PDF
                </button>
            </div>
            <div class="card-body">
                <div class="row align-items-end mb-3">
                    @if (Session["EsSuperAdmin"] != null && (bool)Session["EsSuperAdmin"])
                    {
                        <div class="col-sm-2">
                            <div class="form-group mb-0">
                                <label for="cboTienda" class="col-form-label col-form-label-sm">Sucursal:</label>
                                <select class="form-control form-control-sm" id="cboTienda" name="Tienda"></select>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="col-sm-2">
                            <div class="form-group mb-0">
                                <label class="col-form-label col-form-label-sm">Sucursal:</label>
                                <div class="form-control form-control-sm bg-light" style="line-height:1.8;">
                                    <i class="fas fa-store text-info mr-1"></i>
                                    <strong>@(ViewBag.NombreTiendaActual ?? "Mi sucursal")</strong>
                                </div>
                                <input type="hidden" id="cboTienda" name="Tienda" value="@(Session["TiendaActiva"] ?? 0)" />
                            </div>
                        </div>
                    }
                    <div class="col-sm-2">
                        <div class="form-group mb-0">
                            <label for="txtCodigoProducto" class="col-form-label col-form-label-sm">Código Producto:</label>
                            <input type="text" class="form-control form-control-sm" id="txtCodigoProducto"
                                   name="codigoproducto" autocomplete="off" placeholder="Opcional">
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="form-group mb-0">
                            <button id="btnBuscar" type="button" class="btn btn-sm btn-primary btn-block">
                                <i class="fas fa-search"></i> Buscar
                            </button>
                        </div>
                    </div>
                </div>
                <hr />
                <div id="inner-right">
                    <table id="tbReporte" class="table table-striped table-bordered table-sm table-responsive-sm" style="width:100%">
                        <thead class="thead-dark">
                            <tr>
                                <th>Nombre Tienda</th>
                                <th>RUC Tienda</th>
                                <th>Dirección</th>
                                <th>Código</th>
                                <th>Producto</th>
                                <th>Descripción</th>
                                <th class="text-center">Stock</th>
                                <th class="text-right">P. Compra</th>
                                <th class="text-right">P. Venta</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td colspan="9" class="text-muted text-center py-3">Seleccioná una sucursal y presioná <strong>Buscar</strong>.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@* Formulario oculto para POST del PDF *@
@using (Html.BeginForm("DescargarPDFProductos", "Reporte", FormMethod.Post, new { id = "frmPDFProd" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" id="hProdIdTienda"  name="idtienda"        />
    <input type="hidden" id="hProdCodigo"    name="codigoproducto"  />
}

@section scripts{
    <script src="@Url.Content("~/Scripts/Views/Reporte_Producto.js?v=" + DateTime.Now.Ticks)" type="text/javascript"></script>
}
