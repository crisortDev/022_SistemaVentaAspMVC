@{
    ViewBag.Title = "Reporte Gerencial de Productos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Reportes</a></li>
        <li class="breadcrumb-item active">Reporte Gerencial de Productos</li>
    </ol>
</nav>

@* ── Filtros ──────────────────────────────────────────────────────────────────── *@
<div class="card border-info mb-3">
    <div class="card-header bg-info text-white">
        <i class="fas fa-sliders-h mr-1"></i> Filtros
    </div>
    <div class="card-body py-2">
        <div class="form-row align-items-end">
            @if (Session["EsAdminGlobal"] != null && (bool)Session["EsAdminGlobal"])
            {
                <div class="col-sm-3">
                    <label class="col-form-label col-form-label-sm">Sucursal</label>
                    <select id="cboTienda" class="form-control form-control-sm">
                        <option value="0">-- Todas las sucursales --</option>
                    </select>
                </div>
            }
            else
            {
                <div class="col-sm-3">
                    <label class="col-form-label col-form-label-sm">Sucursal</label>
                    <div class="form-control form-control-sm bg-light" style="line-height:1.8; font-size:0.78rem;">
                        <i class="fas fa-store text-info mr-1"></i>
                        <strong>@(ViewBag.NombreTiendaActual ?? "Mi sucursal")</strong>
                    </div>
                    <input type="hidden" id="cboTienda" value="@(Session["TiendaActiva"] ?? 0)" />
                </div>
            }
            <div class="col-sm-2">
                <label class="col-form-label col-form-label-sm">Código Producto</label>
                <input type="text" id="txtCodigoProducto" class="form-control form-control-sm"
                       placeholder="Opcional" autocomplete="off" />
            </div>
            <div class="col-sm-2">
                <label class="col-form-label col-form-label-sm">Stock</label>
                <select id="cboFiltroStock" class="form-control form-control-sm">
                    <option value="">-- Todos --</option>
                    <option value="con">Con stock</option>
                    <option value="sin">Sin stock</option>
                    <option value="critico">Stock crítico (≤ 5)</option>
                </select>
            </div>
            <div class="col-sm-1 d-flex align-items-end">
                <button id="btnBuscar" class="btn btn-sm btn-info btn-block mt-4">
                    <i class="fas fa-search"></i> Buscar
                </button>
            </div>
        </div>
    </div>
</div>

@* ── Reporte principal ────────────────────────────────────────────────────────── *@
<div class="card border-info">
    <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
        <span><i class="fas fa-boxes mr-1"></i> Reporte Gerencial de Productos</span>
        <button id="btnExportarPDF" class="btn btn-sm btn-dark" onclick="exportarPDF()" disabled>
            <i class="fas fa-file-pdf text-danger"></i> Exportar PDF
        </button>
    </div>
    <div class="card-body">

        @* ── 8 KPI Cards ──────────────────────────────────────────────────────── *@
        <div id="panelKPI" class="d-none mb-3">
            <div class="row text-center mb-2">
                <div class="col-md-3 mb-2">
                    <div class="card border-info h-100 shadow-sm">
                        <div class="card-body py-2">
                            <div class="text-muted" style="font-size:.7rem;">Total Productos</div>
                            <div id="kpiTotalProductos" class="h3 font-weight-bold text-info mb-0">—</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-2">
                    <div class="card border-primary h-100 shadow-sm">
                        <div class="card-body py-2">
                            <div class="text-muted" style="font-size:.7rem;">Stock Total</div>
                            <div id="kpiStockTotal" class="h3 font-weight-bold text-primary mb-0">—</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-2">
                    <div class="card border-success h-100 shadow-sm">
                        <div class="card-body py-2">
                            <div class="text-muted" style="font-size:.7rem;">Valor a Costo</div>
                            <div id="kpiValorCosto" class="h6 font-weight-bold text-success mb-0">—</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-2">
                    <div class="card border-warning h-100 shadow-sm">
                        <div class="card-body py-2">
                            <div class="text-muted" style="font-size:.7rem;">Potencial de Venta</div>
                            <div id="kpiPotencialVenta" class="h6 font-weight-bold text-warning mb-0">—</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row text-center">
                <div class="col-md-3 mb-2">
                    <div class="card border-danger h-100 shadow-sm">
                        <div class="card-body py-2">
                            <div class="text-muted" style="font-size:.7rem;">Sin Stock</div>
                            <div id="kpiSinStock" class="h3 font-weight-bold text-danger mb-0">—</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-2">
                    <div class="card border-warning h-100 shadow-sm">
                        <div class="card-body py-2">
                            <div class="text-muted" style="font-size:.7rem;">Stock Crítico (≤ 5)</div>
                            <div id="kpiStockCritico" class="h3 font-weight-bold" style="color:#856404;">—</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-2">
                    <div class="card border-info h-100 shadow-sm">
                        <div class="card-body py-2">
                            <div class="text-muted" style="font-size:.7rem;">Margen Promedio</div>
                            <div id="kpiMargenPromedio" class="h4 font-weight-bold text-info mb-0">—</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-2">
                    <div class="card border-success h-100 shadow-sm">
                        <div class="card-body py-2">
                            <div class="text-muted" style="font-size:.7rem;">Ganancia Potencial</div>
                            <div id="kpiGanancia" class="h6 font-weight-bold text-success mb-0">—</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ── Paneles de Análisis ───────────────────────────────────────────────── *@
        <div id="panelAnalisis" class="d-none mb-3">
            <div class="row">
                <div class="col-md-7 mb-3">
                    <h6 class="font-weight-bold text-info border-bottom pb-1">
                        <i class="fas fa-trophy mr-1"></i> Top Productos por Stock
                    </h6>
                    <div id="tablaTopStock"></div>
                </div>
                <div class="col-md-5 mb-3">
                    <h6 class="font-weight-bold text-danger border-bottom pb-1">
                        <i class="fas fa-exclamation-triangle mr-1"></i> Productos Sin Stock
                    </h6>
                    <div id="tablaSinStock"></div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <h6 class="font-weight-bold text-info border-bottom pb-1">
                        <i class="fas fa-tag mr-1"></i> Distribución por Rango de Precio
                    </h6>
                    <div id="tablaRangoPrecios"></div>
                </div>
                <div class="col-md-6 mb-3">
                    <h6 class="font-weight-bold text-info border-bottom pb-1">
                        <i class="fas fa-chart-line mr-1"></i> Top Productos por Margen
                    </h6>
                    <div id="tablaMargen"></div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 mb-3">
                    <h6 class="font-weight-bold text-info border-bottom pb-1">
                        <i class="fas fa-clipboard-check mr-1"></i> Análisis Gerencial
                    </h6>
                    <div id="tablaAnalisis"></div>
                </div>
            </div>
        </div>

        @* ── Tabla detalle ─────────────────────────────────────────────────────── *@
        <div id="contenedorProductos">
            <p class="text-muted text-center mt-4">
                Seleccioná una sucursal y presioná <strong>Buscar</strong>.
            </p>
        </div>

    </div>
</div>

@* Formulario oculto POST para PDF *@
@using (Html.BeginForm("DescargarPDFProductos", "Reporte", FormMethod.Post, new { id = "frmPDFProd" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" id="hProdIdTienda"     name="idtienda"       />
    <input type="hidden" id="hProdCodigo"       name="codigoproducto" />
}

@section scripts {
    <script src="@Url.Content("~/Scripts/Views/Reporte_Producto.js?v=" + DateTime.Now.Ticks)" type="text/javascript"></script>
}
