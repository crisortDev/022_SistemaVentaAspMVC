@{
    ViewBag.Title = "Reporte de Bajas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Reportes</a></li>
        <li class="breadcrumb-item active" aria-current="page">Bajas de Productos</li>
    </ol>
</nav>

<div class="row">
    <div class="col-sm-12">

        <!-- FILTROS -->
        <div class="card border-info mb-3">
            <div class="card-header bg-info text-white">Filtros</div>
            <div class="card-body">
                <div class="form-row align-items-end">
                    <div class="col-sm-3">
                        <label class="col-form-label col-form-label-sm">Fecha Inicio</label>
                        <input type="date" id="txtFechaInicio" class="form-control form-control-sm" />
                    </div>
                    <div class="col-sm-3">
                        <label class="col-form-label col-form-label-sm">Fecha Fin</label>
                        <input type="date" id="txtFechaFin" class="form-control form-control-sm" />
                    </div>
                    @if (Session["EsSuperAdmin"] != null && (bool)Session["EsSuperAdmin"])
                    {
                        <div class="col-sm-3">
                            <label class="col-form-label col-form-label-sm">Sucursal</label>
                            <select id="cboTienda" class="form-control form-control-sm">
                                <option value="0">-- Todas las sucursales --</option>
                            </select>
                        </div>
                    }
                    else
                    {
                        <div class="col-sm-3">
                            <label class="col-form-label col-form-label-sm">Sucursal</label>
                            <div class="form-control form-control-sm bg-light" style="line-height:1.8;">
                                <i class="fas fa-store text-info mr-1"></i>
                                <strong>@(ViewBag.NombreTiendaActual ?? "Mi sucursal")</strong>
                            </div>
                            <input type="hidden" id="cboTienda" value="@(Session["TiendaActiva"] ?? 0)" />
                        </div>
                    }
                    <div class="col-sm-3 d-flex" style="gap:6px">
                        <button id="btnBuscar" class="btn btn-sm btn-info btn-block">
                            <i class="fas fa-search"></i> Buscar
                        </button>
                        <button class="btn btn-sm btn-secondary btn-block" onclick="printData()">
                            <i class="fas fa-print"></i> Imprimir
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- TABLA -->
        <div class="card border-info">
            <div class="card-header bg-info text-white">Resultado</div>
            <div class="card-body p-2">
                <div class="table-responsive">
                    <table id="tbReporte" class="table table-striped table-bordered table-sm" style="width:100%">
                        <thead class="thead-dark">
                            <tr>
                                <th>Fecha</th>
                                <th>Tienda</th>
                                <th>Código</th>
                                <th>Producto</th>
                                <th>Cantidad</th>
                                <th>Observaciones</th>
                                <th>RUC Tienda</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="7" class="text-center text-muted">
                                    Seleccione un rango de fechas y presione Buscar.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/Views/Reporte_Bajas.js?v=" + DateTime.Now.Ticks)" type="text/javascript"></script>
}
