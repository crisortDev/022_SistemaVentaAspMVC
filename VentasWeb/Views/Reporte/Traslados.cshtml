@{
    ViewBag.Title = "Reporte Gerencial de Traslados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Reportes</a></li>
        <li class="breadcrumb-item active">Reporte Gerencial de Traslados entre Tiendas</li>
    </ol>
</nav>

<div class="card border-info mb-3">
    <div class="card-header bg-info text-white">
        <i class="fas fa-sliders-h mr-1"></i> Filtros
    </div>
    <div class="card-body py-2">
        <div class="form-row align-items-end">
            <div class="col-sm-2">
                <label class="col-form-label col-form-label-sm">Fecha Inicio</label>
                <input type="date" id="txtFechaInicio" class="form-control form-control-sm" />
            </div>
            <div class="col-sm-2">
                <label class="col-form-label col-form-label-sm">Fecha Fin</label>
                <input type="date" id="txtFechaFin" class="form-control form-control-sm" />
            </div>
            @if (Session["EsSuperAdmin"] != null && (bool)Session["EsSuperAdmin"])
            {
                <div class="col-sm-2">
                    <label class="col-form-label col-form-label-sm">Sucursal (Origen o Destino)</label>
                    <select id="cboTienda" class="form-control form-control-sm">
                        <option value="0">-- Todas las sucursales --</option>
                    </select>
                </div>
            }
            else
            {
                <div class="col-sm-2">
                    <label class="col-form-label col-form-label-sm">Sucursal</label>
                    <div class="form-control form-control-sm bg-light" style="line-height:1.8;">
                        <i class="fas fa-store text-info mr-1"></i>
                        <strong>@(ViewBag.NombreTiendaActual ?? "Mi sucursal")</strong>
                    </div>
                    <input type="hidden" id="cboTienda" value="@(Session["TiendaActiva"] ?? 0)" />
                </div>
            }
            <div class="col-sm-2">
                <label class="col-form-label col-form-label-sm">Estado</label>
                <select id="cboEstado" class="form-control form-control-sm">
                    <option value="">-- Todos --</option>
                    <option value="Pendiente">Pendiente</option>
                    <option value="Aprobada">Aprobada</option>
                    <option value="Rechazada">Rechazada</option>
                </select>
            </div>
            <div class="col-sm-2">
                <button id="btnBuscar" class="btn btn-sm btn-info btn-block mt-4">
                    <i class="fas fa-search"></i> Buscar
                </button>
            </div>
        </div>
    </div>
</div>

<div class="card border-info">
    <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
        <span><i class="fas fa-exchange-alt mr-1"></i> Reporte Gerencial de Traslados entre Tiendas</span>
        <button id="btnExportarPDF" class="btn btn-sm btn-light" onclick="exportarPDF()" disabled>
            <i class="fas fa-file-pdf text-danger"></i> Exportar PDF
        </button>
    </div>
    <div class="card-body">

        @* ── 3 KPI Cards ──────────────────────────────────────────────────── *@
        <div id="panelKPI" class="d-none mb-3">
            <div class="row text-center">
                <div class="col-md-4 mb-2">
                    <div class="card border-info h-100 shadow-sm">
                        <div class="card-body py-2">
                            <div class="text-muted" style="font-size:.7rem;">Traslados Registrados</div>
                            <div id="kpiTraslados" class="h4 font-weight-bold text-info mb-0">—</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-2">
                    <div class="card border-primary h-100 shadow-sm">
                        <div class="card-body py-2">
                            <div class="text-muted" style="font-size:.7rem;">Productos Movilizados</div>
                            <div id="kpiProductos" class="h4 font-weight-bold text-primary mb-0">—</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-2">
                    <div class="card border-secondary h-100 shadow-sm">
                        <div class="card-body py-2">
                            <div class="text-muted" style="font-size:.7rem;">Sucursales Involucradas</div>
                            <div id="kpiSucursales" class="h4 font-weight-bold text-secondary mb-0">—</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ── Análisis ──────────────────────────────────────────────────────── *@
        <div id="panelAnalisis" class="d-none mb-3">
            <div class="row">
                <div class="col-md-5 mb-3">
                    <h6 class="font-weight-bold text-info border-bottom pb-1">
                        <i class="fas fa-tasks mr-1"></i> Estado de Traslados
                    </h6>
                    <div id="tablaEstado"></div>
                </div>
                <div class="col-md-7 mb-3">
                    <h6 class="font-weight-bold text-info border-bottom pb-1">
                        <i class="fas fa-store mr-1"></i> Sucursales que más Envían
                    </h6>
                    <div id="tablaSucursales"></div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 mb-3">
                    <h6 class="font-weight-bold text-info border-bottom pb-1">
                        <i class="fas fa-boxes mr-1"></i> Productos más Trasladados (Top 5)
                    </h6>
                    <div id="tablaTopProductos"></div>
                </div>
            </div>
        </div>

        @* ── Detalle ──────────────────────────────────────────────────────── *@
        <div id="contenedorTraslados">
            <p class="text-muted text-center mt-4">
                Seleccioná un rango de fechas y presioná <strong>Buscar</strong>.
            </p>
        </div>

    </div>
</div>

@* Formulario oculto para POST del PDF *@
@using (Html.BeginForm("DescargarPDFTraslados", "Reporte", FormMethod.Post, new { id = "frmPDFTraslados" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" id="hTrasladoFechaInicio" name="fechainicio"    />
    <input type="hidden" id="hTrasladoFechaFin"    name="fechafin"       />
    <input type="hidden" id="hTrasladoIdTienda"    name="idtienda"       />
    <input type="hidden" id="hTrasladoEstado"      name="estadotraslado" />
}

@section scripts{
    <script src="@Url.Content("~/Scripts/Views/Reporte_Traslados.js?v=" + DateTime.Now.Ticks)" type="text/javascript"></script>
}
