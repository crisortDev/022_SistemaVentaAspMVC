@{
    ViewBag.Title = "Reporte de Ventas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section estilos {
<style>
    .badge-efectiva { background:#059669; color:#fff; }
    .badge-anulada  { background:#dc2626; color:#fff; }
    .badge-estado   { font-size:.72rem; padding:2px 7px; border-radius:4px; white-space:nowrap; }
    .info-bar        { background:#f0f4ff; border:1px solid #c7d4f0;
                       border-radius:6px; padding:.5rem 1rem; margin-bottom:.8rem;
                       font-size:.85rem; }
    .info-bar strong { color:#1a3566; }
    #spinner         { display:none; }
    #divReporte      { display:none; }
</style>
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Reportes</a></li>
        <li class="breadcrumb-item active">Ventas</li>
    </ol>
</nav>

<!-- Filtros -->
<div class="card border-primary mb-3">
    <div class="card-header bg-primary text-white py-2 d-flex justify-content-between align-items-center">
        <span><i class="fas fa-cash-register mr-1"></i> Reporte de Ventas</span>
        <div id="spinner" class="spinner-border spinner-border-sm text-light" role="status"></div>
    </div>
    <div class="card-body p-2">
        <div class="row align-items-end">
            <div class="col-sm-2">
                <label class="col-form-label col-form-label-sm font-weight-bold">Fecha Inicio</label>
                <input type="text" id="txtFechaInicio" class="form-control form-control-sm"
                       placeholder="dd/mm/aaaa" autocomplete="off" />
            </div>
            <div class="col-sm-2">
                <label class="col-form-label col-form-label-sm font-weight-bold">Fecha Fin</label>
                <input type="text" id="txtFechaFin" class="form-control form-control-sm"
                       placeholder="dd/mm/aaaa" autocomplete="off" />
            </div>
            <div class="col-sm-2">
                <label class="col-form-label col-form-label-sm font-weight-bold">Sucursal</label>
                <select id="cboTienda" class="form-control form-control-sm"></select>
            </div>
            <div class="col-sm-2">
                <label class="col-form-label col-form-label-sm font-weight-bold">Estado</label>
                <select id="cboEstado" class="form-control form-control-sm">
                    <option value="Efectiva">Efectiva</option>
                    <option value="">Todos</option>
                    <option value="Anulada">Anulada</option>
                </select>
            </div>
            <div class="col-sm-2">
                <label class="col-form-label col-form-label-sm d-block">&nbsp;</label>
                <button class="btn btn-primary btn-sm btn-block" onclick="buscarVentas()">
                    <i class="fas fa-search mr-1"></i> Buscar
                </button>
            </div>
            <div class="col-sm-2">
                <label class="col-form-label col-form-label-sm d-block">&nbsp;</label>
                <button class="btn btn-danger btn-sm btn-block" id="btnPDF" onclick="descargarPDF()" disabled>
                    <i class="fas fa-file-pdf mr-1"></i> Descargar PDF
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Reporte en pantalla -->
<div id="divReporte">

    <!-- Info panel: Tienda y RUC en el encabezado (no en columnas) -->
    <div class="info-bar d-flex justify-content-between align-items-center flex-wrap">
        <div>
            <i class="fas fa-store text-primary mr-1"></i>
            <strong id="lblTienda">—</strong>
            <span class="text-muted ml-3 mr-1">RUC:</span>
            <strong id="lblRuc">—</strong>
        </div>
        <div class="text-muted small" id="lblPeriodo"></div>
    </div>

    <!-- Tabla de ventas -->
    <div class="table-responsive">
        <table class="table table-sm table-bordered table-hover mb-1" id="tbReporte">
            <thead class="thead-dark">
                <tr>
                    <th>Fecha</th>
                    <th>Nro Documento</th>
                    <th class="text-center">Tipo</th>
                    <th class="text-center">Estado</th>
                    <th>Cliente</th>
                    <th>Forma Cobro</th>
                    <th>Empleado</th>
                    <th class="text-right">Unidades</th>
                    <th class="text-right">Total (Gs.)</th>
                </tr>
            </thead>
            <tbody id="tbodyVentas"></tbody>
            <tfoot>
                <tr class="font-weight-bold bg-light">
                    <td colspan="7" class="text-right text-muted small">Total del período:</td>
                    <td class="text-right" id="tfUnidades">—</td>
                    <td class="text-right" id="tfTotal">—</td>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- Resumen rápido -->
    <div class="d-flex justify-content-end mb-4 small text-muted">
        <span class="mr-3">Efectivas: <strong class="text-success" id="cntEfectivas">0</strong></span>
        <span>Anuladas: <strong class="text-danger" id="cntAnuladas">0</strong></span>
    </div>
</div>

<!-- Formulario oculto POST para PDF -->
@using (Html.BeginForm("DescargarPDFVenta", "Reporte", FormMethod.Post, new { id = "frmPDF" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" id="hFechaInicio" name="fechainicio" />
    <input type="hidden" id="hFechaFin"    name="fechafin"    />
    <input type="hidden" id="hIdTienda"    name="idtienda"    />
    <input type="hidden" id="hEstado"      name="estado"      />
}

@section scripts {
    <script src="@Url.Content("~/Scripts/Views/Reporte_Venta.js?v=" + DateTime.Now.Ticks)"></script>
}
