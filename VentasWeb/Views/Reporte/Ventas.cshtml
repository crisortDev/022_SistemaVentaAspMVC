@{
    ViewBag.Title = "Reporte Gerencial de Ventas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Reportes</a></li>
        <li class="breadcrumb-item active">Reporte Gerencial de Ventas</li>
    </ol>
</nav>

@* ── Filtros ──────────────────────────────────────────────────────────────────── *@
<div class="card border-primary mb-3">
    <div class="card-header bg-primary text-white">
        <i class="fas fa-sliders-h mr-1"></i> Filtros
    </div>
    <div class="card-body py-2">
        <div class="form-row align-items-end">
            <div class="col-sm-2">
                <label class="col-form-label col-form-label-sm font-weight-bold">Fecha Inicio</label>
                <input type="text" id="txtFechaInicio" class="form-control form-control-sm"
                       placeholder="dd/mm/aaaa" autocomplete="off" />
            </div>
            <div class="col-sm-2">
                <label class="col-form-label col-form-label-sm font-weight-bold">Fecha Fin</label>
                <input type="text" id="txtFechaFin" class="form-control form-control-sm"
                       placeholder="dd/mm/aaaa" autocomplete="off" />
            </div>
            @if (Session["EsAdminGlobal"] != null && (bool)Session["EsAdminGlobal"])
            {
                <div class="col-sm-2">
                    <label class="col-form-label col-form-label-sm font-weight-bold">Sucursal</label>
                    <select id="cboTienda" class="form-control form-control-sm"></select>
                </div>
            }
            else
            {
                <div class="col-sm-2">
                    <label class="col-form-label col-form-label-sm font-weight-bold">Sucursal</label>
                    <div class="form-control form-control-sm bg-light" style="line-height:1.8;">
                        <i class="fas fa-store text-primary mr-1"></i>
                        <strong>@(ViewBag.NombreTiendaActual ?? "Mi sucursal")</strong>
                    </div>
                    <input type="hidden" id="cboTienda" value="@(Session["TiendaActiva"] ?? 0)" />
                </div>
            }
            <div class="col-sm-2">
                <label class="col-form-label col-form-label-sm font-weight-bold">Estado</label>
                <select id="cboEstado" class="form-control form-control-sm">
                    <option value="">-- Todos --</option>
                    <option value="Efectiva">Efectiva</option>
                    <option value="Anulada">Anulada</option>
                </select>
            </div>
            <div class="col-sm-2">
                <label class="col-form-label col-form-label-sm font-weight-bold">Forma de Cobro</label>
                <select id="cboFormaCobro" class="form-control form-control-sm">
                    <option value="">-- Todas --</option>
                </select>
            </div>
            <div class="col-sm-1 d-flex align-items-end">
                <button id="btnBuscar" class="btn btn-sm btn-primary btn-block mt-4"
                        onclick="buscarVentas()">
                    <i class="fas fa-search"></i> Buscar
                </button>
            </div>
            <div class="col-sm-1 d-flex align-items-end">
                <button id="btnPDF" class="btn btn-sm btn-danger btn-block mt-4"
                        onclick="descargarPDF()" disabled>
                    <i class="fas fa-file-pdf"></i> PDF
                </button>
            </div>
        </div>
    </div>
</div>

@* ── Reporte principal ────────────────────────────────────────────────────────── *@
<div class="card border-primary">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <span><i class="fas fa-cash-register mr-1"></i> Reporte Gerencial de Ventas</span>
        <div id="spinner" class="spinner-border spinner-border-sm text-light d-none" role="status"></div>
    </div>
    <div class="card-body">

        @* ── 8 KPI Cards ──────────────────────────────────────────────────────── *@
        <div id="panelKPI" class="d-none mb-3">
            <div class="row text-center mb-2">
                <div class="col-md-3 mb-2">
                    <div class="card border-primary h-100 shadow-sm">
                        <div class="card-body py-2">
                            <div class="text-muted" style="font-size:.7rem;">Total Ventas</div>
                            <div id="kpiTotalVentas" class="h3 font-weight-bold text-primary mb-0">—</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-2">
                    <div class="card border-success h-100 shadow-sm">
                        <div class="card-body py-2">
                            <div class="text-muted" style="font-size:.7rem;">Monto Total</div>
                            <div id="kpiMontoTotal" class="h5 font-weight-bold text-success mb-0">—</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-2">
                    <div class="card border-success h-100 shadow-sm">
                        <div class="card-body py-2">
                            <div class="text-muted" style="font-size:.7rem;">Efectivas</div>
                            <div id="kpiEfectivas" class="h3 font-weight-bold text-success mb-0">—</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-2">
                    <div class="card border-danger h-100 shadow-sm">
                        <div class="card-body py-2">
                            <div class="text-muted" style="font-size:.7rem;">Anuladas</div>
                            <div id="kpiAnuladas" class="h3 font-weight-bold text-danger mb-0">—</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row text-center">
                <div class="col-md-3 mb-2">
                    <div class="card border-secondary h-100 shadow-sm">
                        <div class="card-body py-2">
                            <div class="text-muted" style="font-size:.7rem;">Promedio por Venta</div>
                            <div id="kpiPromedio" class="h5 font-weight-bold text-secondary mb-0">—</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-2">
                    <div class="card border-primary h-100 shadow-sm">
                        <div class="card-body py-2">
                            <div class="text-muted" style="font-size:.7rem;">Total Unidades</div>
                            <div id="kpiUnidades" class="h3 font-weight-bold text-primary mb-0">—</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-2">
                    <div class="card border-warning h-100 shadow-sm">
                        <div class="card-body py-2">
                            <div class="text-muted" style="font-size:.7rem;">Mayor Venta</div>
                            <div id="kpiMayorVenta" class="h5 font-weight-bold text-warning mb-0">—</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-2">
                    <div class="card border-info h-100 shadow-sm">
                        <div class="card-body py-2">
                            <div class="text-muted" style="font-size:.7rem;">Empleado Estrella</div>
                            <div id="kpiEmpleadoTop" class="small font-weight-bold text-info mb-0"
                                 style="min-height:2rem; display:flex; align-items:center; justify-content:center; text-align:center;">—</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ── Paneles de Análisis ───────────────────────────────────────────────── *@
        <div id="panelAnalisis" class="d-none mb-3">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <h6 class="font-weight-bold text-primary border-bottom pb-1">
                        <i class="fas fa-tasks mr-1"></i> Estado de Ventas
                    </h6>
                    <div id="tablaEstado"></div>
                </div>
                <div class="col-md-8 mb-3">
                    <h6 class="font-weight-bold text-primary border-bottom pb-1">
                        <i class="fas fa-user-tie mr-1"></i> Top Empleados por Monto
                    </h6>
                    <div id="tablaEmpleados"></div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-5 mb-3">
                    <h6 class="font-weight-bold text-primary border-bottom pb-1">
                        <i class="fas fa-wallet mr-1"></i> Distribución por Forma de Cobro
                    </h6>
                    <div id="tablaFormaCobro"></div>
                </div>
                <div class="col-md-7 mb-3">
                    <h6 class="font-weight-bold text-primary border-bottom pb-1">
                        <i class="fas fa-users mr-1"></i> Top Clientes por Monto
                    </h6>
                    <div id="tablaClientes"></div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 mb-3">
                    <h6 class="font-weight-bold text-primary border-bottom pb-1">
                        <i class="fas fa-clipboard-check mr-1"></i> Análisis Gerencial
                    </h6>
                    <div id="tablaAnalisis"></div>
                </div>
            </div>
        </div>

        @* ── Detalle ──────────────────────────────────────────────────────────── *@
        <div id="contenedorVentas">
            <p class="text-muted text-center mt-4">
                Seleccioná un rango de fechas y presioná <strong>Buscar</strong>.
            </p>
        </div>

    </div>
</div>

@* Formulario oculto POST para PDF *@
@using (Html.BeginForm("DescargarPDFVenta", "Reporte", FormMethod.Post, new { id = "frmPDF" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" id="hFechaInicio" name="fechainicio" />
    <input type="hidden" id="hFechaFin"    name="fechafin"    />
    <input type="hidden" id="hIdTienda"    name="idtienda"    />
    <input type="hidden" id="hEstado"      name="estado"      />
}

@section scripts {
    <script src="@Url.Content("~/Scripts/Views/Reporte_Venta.js?v=" + DateTime.Now.Ticks)"></script>
}
