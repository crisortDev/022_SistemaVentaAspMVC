@{
    ViewBag.Title = "Reporte NC";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Reporte</a></li>
        <li class="breadcrumb-item active">Reporte NC Asociadas</li>
    </ol>
</nav>

<div class="card border-warning">
    <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
        <span><i class="fas fa-file-invoice-dollar"></i> Reporte de Notas de Crédito Asociadas</span>
        <button id="btnExportarPDF" class="btn btn-sm btn-dark" onclick="exportarPDF()" disabled>
            <i class="fas fa-file-pdf text-danger"></i> Exportar PDF
        </button>
    </div>
    <div class="card-body">

        @* Filtros *@
        <div class="row mb-3">
            <div class="col-sm-2">
                <label class="col-form-label col-form-label-sm">Fecha Desde</label>
                <input type="date" id="txtFechaInicio" class="form-control form-control-sm" />
            </div>
            <div class="col-sm-2">
                <label class="col-form-label col-form-label-sm">Fecha Hasta</label>
                <input type="date" id="txtFechaFin" class="form-control form-control-sm" />
            </div>
            <div class="col-sm-3">
                <label class="col-form-label col-form-label-sm">Proveedor</label>
                <select id="cboProveedor" class="form-control form-control-sm">
                    <option value="0">-- Todos los proveedores --</option>
                </select>
            </div>
            <div class="col-sm-2">
                <label class="col-form-label col-form-label-sm">Tienda</label>
                <select id="cboTienda" class="form-control form-control-sm">
                    <option value="0">-- Todas --</option>
                </select>
            </div>
            <div class="col-sm-2">
                <label class="col-form-label col-form-label-sm">Estado</label>
                <select id="cboEstado" class="form-control form-control-sm">
                    <option value="">-- Todos --</option>
                    <option value="Pendiente">Pendiente</option>
                    <option value="Recibida">Recibida</option>
                    <option value="Rechazada">Rechazada</option>
                </select>
            </div>
            <div class="col-sm-1 d-flex align-items-end">
                <button onclick="buscarNC()" class="btn btn-warning btn-sm">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </div>

        @* Leyenda *@
        <div class="mb-2 small">
            <span class="badge badge-secondary mr-2">Pendiente</span> NC generada, sin documento físico &nbsp;
            <span class="badge badge-success mr-2">Recibida</span> Documento confirmado &nbsp;
            <span class="badge badge-danger mr-2">Rechazada</span> NC rechazada &nbsp;
            <span class="badge badge-warning text-dark mr-2"><i class="fas fa-exclamation-triangle"></i> Morosa</span> Pendiente &gt; 30 días
        </div>

        @* Tabla *@
        <div id="contenedorNC">
            <p class="text-muted text-center mt-4">Seleccioná un rango de fechas y presioná <i class="fas fa-search"></i> para cargar.</p>
        </div>

        @* Panel totales *@
        <div id="panelTotalesNC" class="d-none mt-3">
            <table class="table table-sm table-bordered w-auto ml-auto">
                <tbody>
                    <tr class="table-dark">
                        <th>Total NCs</th>
                        <td id="tdTotalNCs" class="text-center font-weight-bold"></td>
                    </tr>
                    <tr class="table-warning">
                        <th>Monto total NCs</th>
                        <td id="tdMontoTotal" class="text-center font-weight-bold"></td>
                    </tr>
                    <tr class="table-secondary">
                        <th>NCs Pendientes</th>
                        <td id="tdPendientes" class="text-center font-weight-bold"></td>
                    </tr>
                    <tr class="table-danger">
                        <th>NCs Morosas</th>
                        <td id="tdMorosas" class="text-center font-weight-bold"></td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>
</div>

@section scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>
    <script src="@Url.Content("~/Scripts/Views/Reporte_NotaCredito.js?v=" + DateTime.Now.Ticks)" type="text/javascript"></script>
}
