@{
    ViewBag.Title = "Reporte Gerencial de Proveedores";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Reporte</a></li>
        <li class="breadcrumb-item active">Reporte Gerencial de Proveedores</li>
    </ol>
</nav>

<div class="card border-info">
    <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
        <span><i class="fas fa-truck"></i> Reporte Gerencial de Proveedores</span>
        <button id="btnExportarPDF" class="btn btn-sm btn-light" onclick="exportarPDF()" disabled>
            <i class="fas fa-file-pdf text-danger"></i> Exportar PDF
        </button>
    </div>
    <div class="card-body">

        @* Filtros *@
        <div class="row mb-3">
            <div class="col-sm-2">
                <label class="col-form-label col-form-label-sm">Fecha Desde</label>
                <input type="date" id="txtFechaInicio" class="form-control form-control-sm" />
            </div>
            <div class="col-sm-2">
                <label class="col-form-label col-form-label-sm">Fecha Hasta</label>
                <input type="date" id="txtFechaFin" class="form-control form-control-sm" />
            </div>
            @if (Session["EsAdminGlobal"] != null && (bool)Session["EsAdminGlobal"])
            {
                <div class="col-sm-3">
                    <label class="col-form-label col-form-label-sm">Sucursal</label>
                    <select id="cboTienda" class="form-control form-control-sm">
                        <option value="0">-- Todas las sucursales --</option>
                    </select>
                </div>
            }
            else
            {
                <div class="col-sm-3">
                    <label class="col-form-label col-form-label-sm">Sucursal</label>
                    <div class="form-control form-control-sm bg-light" style="line-height:1.8;">
                        <i class="fas fa-store text-info mr-1"></i>
                        <strong>@(ViewBag.NombreTiendaActual ?? "Mi sucursal")</strong>
                    </div>
                    <input type="hidden" id="cboTienda" value="@(Session["TiendaActiva"] ?? 0)" />
                </div>
            }
            <div class="col-sm-3">
                <label class="col-form-label col-form-label-sm">Filtrar</label>
                <select id="cboFiltro" class="form-control form-control-sm">
                    <option value="0">Todos los proveedores</option>
                    <option value="1">Solo con NC pendiente</option>
                </select>
            </div>
            <div class="col-sm-2 d-flex align-items-end">
                <button onclick="buscarProveedores()" class="btn btn-info btn-sm text-white w-100">
                    <i class="fas fa-search"></i> Consultar
                </button>
            </div>
        </div>

        @* ── 6 KPI Cards ──────────────────────────────────────────────────── *@
        <div id="panelKPI" class="d-none mb-3">
            <div class="row text-center">
                <div class="col-6 col-md-2 mb-2">
                    <div class="card border-primary h-100 shadow-sm">
                        <div class="card-body py-2 px-2">
                            <div class="text-muted" style="font-size:.7rem;">Proveedores</div>
                            <div id="kpiProveedores" class="h4 font-weight-bold text-primary mb-0">—</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2 mb-2">
                    <div class="card border-secondary h-100 shadow-sm">
                        <div class="card-body py-2 px-2">
                            <div class="text-muted" style="font-size:.7rem;">Compras</div>
                            <div id="kpiCompras" class="h4 font-weight-bold text-secondary mb-0">—</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2 mb-2">
                    <div class="card border-info h-100 shadow-sm">
                        <div class="card-body py-2 px-2">
                            <div class="text-muted" style="font-size:.7rem;">Monto Comprado</div>
                            <div id="kpiMontoComprado" class="h6 font-weight-bold text-info mb-0">—</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2 mb-2">
                    <div class="card border-warning h-100 shadow-sm">
                        <div class="card-body py-2 px-2">
                            <div class="text-muted" style="font-size:.7rem;">Notas de Crédito</div>
                            <div id="kpiNC" class="h4 font-weight-bold text-warning mb-0">—</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2 mb-2">
                    <div class="card border-danger h-100 shadow-sm">
                        <div class="card-body py-2 px-2">
                            <div class="text-muted" style="font-size:.7rem;">Monto NC</div>
                            <div id="kpiMontoNC" class="h6 font-weight-bold text-danger mb-0">—</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2 mb-2">
                    <div class="card border-success h-100 shadow-sm">
                        <div class="card-body py-2 px-2">
                            <div class="text-muted" style="font-size:.7rem;">Saldo Neto</div>
                            <div id="kpiSaldoNeto" class="h6 font-weight-bold text-success mb-0">—</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ── Análisis gerencial ────────────────────────────────────────────── *@
        <div id="panelAnalisis" class="d-none">

            @* Fila: Estado Financiero | Top Proveedores *@
            <div class="row mb-3">
                <div class="col-md-5 mb-3">
                    <h6 class="font-weight-bold text-info border-bottom pb-1">
                        <i class="fas fa-balance-scale mr-1"></i> Estado Financiero de Proveedores
                    </h6>
                    <div id="tablaEstadoFinanciero"></div>
                </div>
                <div class="col-md-7 mb-3">
                    <h6 class="font-weight-bold text-info border-bottom pb-1">
                        <i class="fas fa-trophy mr-1"></i> Top Proveedores por Monto Comprado
                    </h6>
                    <div id="tablaTopProveedores"></div>
                </div>
            </div>

            @* Fila: Distribución NC | Análisis Gerencial *@
            <div class="row mb-3">
                <div class="col-md-6 mb-3">
                    <h6 class="font-weight-bold text-warning border-bottom pb-1">
                        <i class="fas fa-undo mr-1"></i> Distribución de Notas de Crédito
                    </h6>
                    <div id="tablaDistribucionNC"></div>
                </div>
                <div class="col-md-6 mb-3">
                    <h6 class="font-weight-bold border-bottom pb-1">
                        <i class="fas fa-briefcase mr-1"></i> Análisis Gerencial
                    </h6>
                    <div id="tablaAnalisis"></div>
                </div>
            </div>

        </div>

        @* ── Detalle de proveedores ────────────────────────────────────────── *@
        <div id="contenedorProveedores">
            <p class="text-muted text-center mt-4">Seleccioná un rango de fechas y presioná <strong>Consultar</strong>.</p>
        </div>

    </div>
</div>

@* Formulario oculto para POST del PDF *@
@using (Html.BeginForm("DescargarPDFProveedores", "Reporte", FormMethod.Post, new { id = "frmPDFProv" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" id="hProvFechaInicio" name="fechainicio" />
    <input type="hidden" id="hProvFechaFin"    name="fechafin"    />
    <input type="hidden" id="hProvIdTienda"    name="idtienda"    />
    <input type="hidden" id="hProvSoloDeuda"   name="solodeuda"   />
}

@section scripts {
    <script src="@Url.Content("~/Scripts/Views/Reporte_Proveedores.js?v=" + DateTime.Now.Ticks)" type="text/javascript"></script>
}
