@{
    ViewBag.Title = "Consultar Ventas";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var usuarioActualV = Session["Usuario"] as CapaModelo.Usuario;
    bool esSuperAdminV = Session["EsSuperAdmin"] is bool saV && saV;
    int idRolActualV = usuarioActualV?.IdRol ?? 0;
    // Anular una venta es una operación sensible: solo Admin (1) y SuperAdmin (14).
    // El Cajero puede consultar y facturar, pero no anular.
    bool puedeAnularVenta = esSuperAdminV || idRolActualV == 1;
}
<input type="hidden" id="hdnPuedeAnularVenta" value="@(puedeAnularVenta ? "1" : "0")" />

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Venta</a></li>
        <li class="breadcrumb-item active">Consultar Ventas</li>
    </ol>
</nav>

<div class="row">
    <div class="col-sm-12">
        <div class="card border-success">
            <div class="card-header bg-success text-white">
                <i class="fas fa-list mr-1"></i> Consultar Ventas
            </div>
            <div class="card-body p-2">
                <!-- Filtros -->
                <div class="row align-items-end">
                    <div class="col-sm-2">
                        <label class="col-form-label col-form-label-sm">Fecha Inicio:</label>
                        <input type="text" class="form-control form-control-sm datepicker" id="txtFechaInicio" autocomplete="off">
                    </div>
                    <div class="col-sm-2">
                        <label class="col-form-label col-form-label-sm">Fecha Fin:</label>
                        <input type="text" class="form-control form-control-sm datepicker" id="txtFechaFin" autocomplete="off">
                    </div>
                    <div class="col-sm-2">
                        <label class="col-form-label col-form-label-sm">Nº Factura:</label>
                        <input type="text" class="form-control form-control-sm" id="txtNumeroFactura" placeholder="001-001-0000001">
                    </div>
                    <div class="col-sm-2">
                        <label class="col-form-label col-form-label-sm">Flujo:</label>
                        <select class="form-control form-control-sm" id="cboTipoFlujo">
                            <option value="">-- Todos --</option>
                            <option value="Directa">Venta Directa</option>
                            <option value="PreVenta">Pre-venta</option>
                        </select>
                    </div>
                    <div class="col-sm-2">
                        <label class="col-form-label col-form-label-sm">Estado:</label>
                        <select class="form-control form-control-sm" id="cboEstado">
                            <option value="">-- Todos --</option>
                            <option value="Activa">Activa</option>
                            <option value="Anulada">Anulada</option>
                        </select>
                    </div>
                    <div class="col-sm-2">
                        <label class="col-form-label col-form-label-sm invisible">.</label>
                        <button type="button" class="btn btn-success btn-sm btn-block" onclick="buscarVentas()">
                            <i class="fas fa-search"></i> Buscar
                        </button>
                    </div>
                </div>

                <hr />

                <div class="table-responsive-sm mt-1">
                    <table id="tbVentas" class="table table-striped table-bordered table-sm" style="width:100%">
                        <thead>
                            <tr>
                                <th style="width:40px"></th>
                                <th>Nº Factura</th>
                                <th>Flujo</th>
                                <th>Cliente</th>
                                <th>Forma Cobro</th>
                                <th class="text-right">Total (Gs.)</th>
                                <th>Cajero</th>
                                <th>Tienda</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL ANULAR -->
<div class="modal fade" id="modalAnular" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white py-2">
                <h5 class="modal-title"><i class="fas fa-ban mr-1"></i> Anular Venta</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="hdnIdVentaAnular" value="0" />
                <p>Factura: <strong id="lblFacturaAnular"></strong></p>
                <div class="form-group">
                    <label class="col-form-label col-form-label-sm">Motivo de Anulación: <span class="text-danger">*</span></label>
                    <textarea class="form-control form-control-sm" id="txtMotivoAnulacion" rows="3" maxlength="500" placeholder="Ingrese el motivo..."></textarea>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger btn-sm" onclick="confirmarAnular()">
                    <i class="fas fa-ban"></i> Anular
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script src="@Url.Content("~/Scripts/Views/Venta_Consultar.js?v=" + DateTime.Now.Ticks)" type="text/javascript"></script>
}
