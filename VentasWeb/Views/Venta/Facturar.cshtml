@model CapaModelo.OrdenVenta
@{
    ViewBag.Title = "Facturar Pre-venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var dt = ViewBag.DatosTributarios as CapaModelo.DatosTributarios;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="@Url.Action("Consultar","OrdenVenta")">Pre-ventas</a></li>
        <li class="breadcrumb-item active">Facturar Pre-venta</li>
    </ol>
</nav>

<input type="hidden" id="hdnIdOrdenVenta" value="@Model.IdOrdenVenta" />
<input type="hidden" id="hdnProximaFactura" value="@(dt?.ProximoNumeroFactura)" />
<input type="hidden" id="hdnMontoAperturaFondo" value="@(ViewBag.MontoAperturaFondo ?? 0)" />

<div class="row">
    <div class="col-sm-12">
        <div class="card border-primary">
            <div class="card-header bg-primary text-white">
                <i class="fas fa-file-invoice-dollar mr-1"></i> Facturar Pre-venta: <strong>@Model.NumeroOV</strong>
                <span class="float-right small">
                    Próxima Factura: <strong>@(dt?.ProximoNumeroFactura ?? "—")</strong>
                </span>
            </div>
            <div class="card-body p-2">

                <!-- Resumen de la pre-venta -->
                <div class="row mb-2">
                    <div class="col-sm-4">
                        <div class="card border-primary">
                            <div class="card-body p-2">
                                <h6 class="card-title mb-1 text-primary">Datos de la Pre-venta</h6>
                                <div><small class="text-muted">Registrada por:</small> <strong>@Model.NombreUsuario</strong></div>
                                <div><small class="text-muted">Tienda:</small> <strong>@Model.NombreTienda</strong></div>
                                <div><small class="text-muted">Vencimiento OV:</small>
                                    <strong class="@(Model.AlertaVencimiento == "VENCIDA" ? "text-danger" : Model.AlertaVencimiento == "VENCE HOY" ? "text-warning" : "")">
                                        @Model.FechaVencimiento
                                        @if (!string.IsNullOrEmpty(Model.AlertaVencimiento))
                                        {
                                            <span class="badge badge-@(Model.AlertaVencimiento == "VENCIDA" ? "danger" : "warning")">@Model.AlertaVencimiento</span>
                                        }
                                    </strong>
                                </div>
                                @if (!string.IsNullOrEmpty(Model.Observacion))
                                {
                                    <div><small class="text-muted">Obs:</small> @Model.Observacion</div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="card border-primary">
                            <div class="card-body p-2">
                                <h6 class="card-title mb-1 text-primary">Cliente</h6>
                                <input type="hidden" id="hdnIdCliente" value="@(Model.IdCliente ?? 0)" />
                                @{
                                    bool sinCliente = (Model.IdCliente == null || Model.IdCliente == 0)
                                                   && string.IsNullOrEmpty(Model.NombreCliente);
                                }
                                @if (sinCliente)
                                {
                                    <div class="alert alert-warning py-1 px-2 mb-1" style="font-size:12px;">
                                        <i class="fas fa-exclamation-triangle"></i>
                                        Esta pre-venta no tiene cliente asignado. <strong>Seleccioná uno antes de facturar.</strong>
                                    </div>
                                }
                                <div><small class="text-muted">Doc.:</small> <strong>@(string.IsNullOrEmpty(Model.DocumentoCliente) ? "—" : Model.DocumentoCliente)</strong></div>
                                <div><small class="text-muted">Nombre:</small> <strong id="lblNombreCliente">@(string.IsNullOrEmpty(Model.NombreCliente) ? "Sin cliente" : Model.NombreCliente)</strong></div>
                                <div class="mt-1">
                                    <button type="button" class="btn btn-sm @(sinCliente ? "btn-warning" : "btn-outline-primary")" onclick="cambiarCliente()">
                                        <i class="fas fa-exchange-alt"></i> @(sinCliente ? "Seleccionar cliente" : "Cambiar cliente")
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="card border-primary">
                            <div class="card-body p-2">
                                <h6 class="card-title mb-1 text-primary">Cobro</h6>

                                <!-- Modalidad de pago -->
                                <div class="form-group mb-1">
                                    <label class="col-form-label col-form-label-sm font-weight-bold">Modalidad de Pago:</label>
                                    <div class="d-flex flex-wrap" style="gap:10px;">
                                        <div class="custom-control custom-radio">
                                            <input type="radio" id="rdoEfectivo" name="modalidadPago" class="custom-control-input" value="Efectivo" checked onchange="toggleModalidad()">
                                            <label class="custom-control-label" for="rdoEfectivo"><i class="fas fa-money-bill-wave"></i> Efectivo</label>
                                        </div>
                                        <div class="custom-control custom-radio">
                                            <input type="radio" id="rdoTransferencia" name="modalidadPago" class="custom-control-input" value="Transferencia" onchange="toggleModalidad()">
                                            <label class="custom-control-label" for="rdoTransferencia"><i class="fas fa-university"></i> Transferencia</label>
                                        </div>
                                        <div class="custom-control custom-radio">
                                            <input type="radio" id="rdoCredito" name="modalidadPago" class="custom-control-input" value="Crédito" onchange="toggleModalidad()">
                                            <label class="custom-control-label" for="rdoCredito"><i class="fas fa-calendar-alt"></i> Crédito</label>
                                        </div>
                                    </div>
                                </div>

                                <!-- Nro. de transferencia (solo Transferencia) -->
                                <div class="form-group mb-1" id="divTransferencia" style="display:none;">
                                    <label class="col-form-label col-form-label-sm">Nro. de Transferencia / Comprobante: <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control form-control-sm" id="txtNumeroTransferencia"
                                           placeholder="Ingrese el número de transacción" maxlength="100">
                                </div>

                                <!-- Plan de cuotas (solo Crédito) -->
                                <div class="form-group mb-1" id="divCuotas" style="display:none;">
                                    <label class="col-form-label col-form-label-sm">Plan de Financiación:</label>
                                    <select class="form-control form-control-sm" id="cboCuotas" onchange="calcularCuotas()">
                                        <option value="">-- Seleccionar plan --</option>
                                        <option value="3">3 cuotas (Recargo 5%)</option>
                                        <option value="6">6 cuotas (Recargo 10%)</option>
                                        <option value="12">12 cuotas (Recargo 20%)</option>
                                        <option value="18">18 cuotas (Recargo 35%)</option>
                                    </select>
                                    <!-- Calculadora de cuotas -->
                                    <div id="divResumenCuotas" class="mt-1 p-2 border rounded bg-light" style="display:none;font-size:12px;">
                                        <div class="row">
                                            <div class="col-6">Total Venta: <strong id="lblTotalVenta">—</strong></div>
                                            <div class="col-6">Recargo: <strong id="lblRecargo">—</strong></div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6">Monto Financiado: <strong id="lblMontoFinanciado" class="text-primary">—</strong></div>
                                            <div class="col-6">Valor de Cuota: <strong id="lblValorCuota" class="text-success">—</strong></div>
                                        </div>
                                        <div class="text-muted mt-1" id="lblAjusteCuota" style="display:none;">
                                            <i class="fas fa-info-circle"></i> La última cuota absorbe el ajuste por redondeo.
                                        </div>
                                    </div>
                                </div>

                                <!-- Importe/Cambio (Efectivo y Transferencia) -->
                                <div id="divImporte">
                                    <div class="row align-items-end">
                                        <div class="col-6">
                                            <label class="col-form-label col-form-label-sm">Importe Recibido:</label>
                                            <input type="number" class="form-control form-control-sm" id="txtImporteRecibido" value="0" min="0" oninput="calcularCambio()">
                                        </div>
                                        <div class="col-6">
                                            <label class="col-form-label col-form-label-sm">Cambio:</label>
                                            <input type="text" class="form-control form-control-sm text-success font-weight-bold" readonly id="txtCambio" value="0">
                                        </div>
                                    </div>
                                </div>

                                <!-- Aviso crédito -->
                                <div id="divAvisoCredito" class="alert alert-info py-1 px-2 mt-1 mb-0" style="display:none;font-size:11px;">
                                    <i class="fas fa-info-circle"></i> Venta a crédito: se generarán las cuotas automáticamente con fechas de vencimiento al último día hábil de cada mes.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Detalle de productos (readonly) -->
                <div class="section-title font-weight-bold mb-1">Detalle de Productos</div>
                <div class="table-responsive-sm">
                    <table class="table table-striped table-bordered table-sm" style="width:100%">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Producto</th>
                                <th class="text-center">Cantidad</th>
                                <th class="text-right">Precio Unit. (Gs.)</th>
                                <th class="text-center">IVA%</th>
                                <th class="text-right">Total (Gs.)</th>
                                <th class="text-center">Disponibilidad</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.oDetalle != null)
                            {
                                foreach (var item in Model.oDetalle)
                                {
                                    <tr class="@(item.StockDisponible < item.Cantidad ? "table-warning" : "")">
                                        <td>@item.Codigo</td>
                                        <td>@item.NombreProducto</td>
                                        <td class="text-center">@item.Cantidad</td>
                                        <td class="text-right">@item.PrecioUnidad.ToString("N0")</td>
                                        <td class="text-center">@item.IvaPorcentaje.ToString("N2")%</td>
                                        <td class="text-right">@item.TotalLinea.ToString("N0")</td>
                                        <td class="text-center">
                                            @if (item.StockDisponible >= item.Cantidad)
                                            {
                                                <span class="badge badge-success"><i class="fas fa-check-circle"></i> Disponible</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-danger"><i class="fas fa-times-circle"></i> No disponible</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-primary font-weight-bold">
                                <td colspan="5" class="text-right">TOTAL:</td>
                                <td class="text-right h6 mb-0">Gs. @Model.TotalEstimado.ToString("N0")</td>
                                <td></td>
                            </tr>
                            <tr>
                                <td colspan="5" class="text-right text-muted small">IVA 10% (inc.):</td>
                                <td class="text-right small">Gs. @Model.IVA10.ToString("N0")</td>
                                <td></td>
                            </tr>
                            <tr>
                                <td colspan="5" class="text-right text-muted small">IVA 5% (inc.):</td>
                                <td class="text-right small">Gs. @Model.IVA5.ToString("N0")</td>
                                <td></td>
                            </tr>
                            <tr>
                                <td colspan="5" class="text-right text-muted small">Exento:</td>
                                <td class="text-right small">Gs. @Model.Exento0.ToString("N0")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <p id="lblStockAlerta" class="text-warning d-none">
                    <i class="fas fa-exclamation-triangle"></i> Algunos productos tienen stock insuficiente. Verificar antes de facturar.
                </p>

            </div>
            <div class="card-footer bg-white border-primary d-flex justify-content-between align-items-center">
                <a href="@Url.Action("Consultar","OrdenVenta")" class="btn btn-secondary btn-sm">
                    <i class="fas fa-arrow-left"></i> Volver
                </a>
                <button id="btnFacturar" class="btn btn-primary" onclick="facturar()">
                    <i class="fas fa-file-invoice-dollar"></i> Confirmar y Facturar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL CAMBIAR CLIENTE -->
<div class="modal fade" id="modalCliente" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white py-2">
                <h5 class="modal-title">Cambiar Cliente</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body py-2">
                <table id="tbCliente" class="table table-striped table-bordered table-sm" style="width:100%">
                    <thead>
                        <tr><th style="width:50px"></th><th>Documento</th><th>Nombre</th><th>Teléfono</th></tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script src="@Url.Content("~/Scripts/Views/Venta_Facturar.js?v=" + DateTime.Now.Ticks)" type="text/javascript"></script>
}
