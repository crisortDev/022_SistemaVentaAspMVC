@model CapaModelo.Compra
@{
    Layout = null;
    var items     = Model.oListaDetalleCompra ?? new List<CapaModelo.DetalleCompra>();
    var proveedor = Model.oProveedor          ?? new CapaModelo.Proveedor();
    var tienda    = Model.oTienda             ?? new CapaModelo.Tienda();
    bool tieneNC  = Model.MontoNotaCredito.HasValue && Model.MontoNotaCredito > 0;
    // Bruto = cantidad PEDIDA × precio (lo que figura en la factura del proveedor).
    // NO usar TotalCosto (= CantidadRecibida × Precio) porque la NC cubre la diferencia,
    // y restar NC sobre "recibido" da negativo.
    // Ejemplo: pedido 3×80.000 + 2×200.000 = 640.000; NC 360.000; neto = 280.000 ✓
    decimal subtotalBruto = tieneNC
        ? items.Sum(i => i.Cantidad * i.PrecioUnitarioCompra)
        : items.Sum(i => i.TotalCosto);
    string badgeEstado = Model.Estado == "Confirmada" ? "badge-success"
                       : Model.Estado == "Anulada"    ? "badge-danger"
                       : "badge-warning";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Factura de Compra — @Model.Codigo</title>
    @Styles.Render("~/Content/PluginsCSS")
    <style>
        /* ── Base ── */
        body { font-family: 'Segoe UI', Arial, sans-serif; font-size: 12px; color: #1a1a2e; background: #f4f7fb; margin: 0; padding: 20px; }

        /* ── Contenedor principal ── */
        .doc-wrap { max-width: 760px; margin: 0 auto; background: #fff; border-radius: 8px; box-shadow: 0 2px 18px rgba(26,53,102,.13); overflow: hidden; }

        /* ── Barra de acciones (no imprime) ── */
        .doc-actions { background: #1a3566; color: #fff; padding: 10px 20px; display: flex; align-items: center; justify-content: space-between; }
        .doc-actions h6 { margin: 0; font-size: 13px; }
        .btn-print { background: #fff; color: #1a3566; border: none; border-radius: 4px; padding: 6px 16px; font-size: 12px; font-weight: 600; cursor: pointer; }
        .btn-print:hover { background: #dbeafe; }

        /* ── Header del documento ── */
        .doc-header { background: linear-gradient(135deg, #0c1a35 0%, #1a3566 100%); color: #fff; padding: 22px 28px; display: flex; justify-content: space-between; align-items: flex-start; }
        .doc-header .empresa h2 { margin: 0 0 4px 0; font-size: 17px; font-weight: 700; letter-spacing: .5px; }
        .doc-header .empresa p  { margin: 0; font-size: 11px; opacity: .8; }
        .doc-header .factura-box { background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.25); border-radius: 6px; padding: 12px 18px; text-align: center; min-width: 180px; }
        .doc-header .factura-box .label { font-size: 10px; text-transform: uppercase; letter-spacing: 1px; opacity: .75; }
        .doc-header .factura-box .value { font-size: 14px; font-weight: 700; margin: 2px 0; }
        .doc-header .factura-box .value-sm { font-size: 11px; opacity: .85; }

        /* ── Sección info ── */
        .doc-body { padding: 22px 28px; }
        .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 18px; }
        .info-card { border: 1px solid #e2e8f0; border-radius: 6px; padding: 12px 14px; }
        .info-card .card-title { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .8px; color: #1a3566; border-bottom: 1px solid #e2e8f0; padding-bottom: 6px; margin-bottom: 8px; }
        .info-row { display: flex; justify-content: space-between; margin-bottom: 4px; }
        .info-row .field { color: #64748b; }
        .info-row .val   { font-weight: 600; text-align: right; max-width: 60%; }

        /* ── Estado y OC ── */
        .estado-bar { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; }
        .badge { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; }
        .badge-success { background: #d1fae5; color: #065f46; }
        .badge-warning { background: #fef3c7; color: #92400e; }
        .badge-danger  { background: #fee2e2; color: #991b1b; }
        .badge-nc      { background: #fef9c3; color: #854d0e; border: 1px solid #fde047; }

        /* ── Tabla productos ── */
        .productos-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .8px; color: #1a3566; margin-bottom: 8px; }
        table.productos { width: 100%; border-collapse: collapse; font-size: 11.5px; }
        table.productos thead tr { background: #1a3566; color: #fff; }
        table.productos thead th { padding: 8px 10px; font-weight: 600; text-align: left; }
        table.productos thead th.right { text-align: right; }
        table.productos thead th.center { text-align: center; }
        table.productos tbody tr:nth-child(even) { background: #f8fafc; }
        table.productos tbody tr:hover { background: #eff6ff; }
        table.productos tbody td { padding: 7px 10px; border-bottom: 1px solid #e2e8f0; }
        table.productos tbody td.right  { text-align: right; }
        table.productos tbody td.center { text-align: center; }
        .linea-nc   { color: #92400e; font-size: 10px; }
        .diff-neg   { color: #dc2626; font-weight: 700; }

        /* ── Totales ── */
        .totales-wrap { display: flex; justify-content: flex-end; margin-top: 14px; }
        .totales-box  { min-width: 240px; border: 1px solid #e2e8f0; border-radius: 6px; overflow: hidden; }
        .totales-row  { display: flex; justify-content: space-between; padding: 6px 14px; border-bottom: 1px solid #e2e8f0; font-size: 12px; }
        .totales-row:last-child { border-bottom: none; }
        .totales-row.total-final { background: #1a3566; color: #fff; font-weight: 700; font-size: 13px; }
        .totales-row.nc-row { background: #fef3c7; color: #92400e; }

        /* ── Footer ── */
        .doc-footer { background: #f8fafc; border-top: 1px solid #e2e8f0; padding: 12px 28px; display: flex; justify-content: space-between; font-size: 10.5px; color: #64748b; }

        /* ── Impresión ── */
        @@media print {
            body { background: #fff; padding: 0; }
            .doc-actions { display: none !important; }
            .doc-wrap { box-shadow: none; border-radius: 0; }
        }
    </style>
</head>
<body>

<div class="doc-wrap">

    @* Barra de acciones *@
    <div class="doc-actions no-print">
        <h6><i class="fas fa-file-invoice"></i> Documento de Factura de Compra</h6>
        <button class="btn-print" onclick="window.print()">
            <i class="fas fa-print"></i> Imprimir
        </button>
    </div>

    @* Encabezado *@
    <div class="doc-header">
        <div class="empresa">
            <h2>COMPU SPACE</h2>
            <p>@tienda.Nombre</p>
            <p>@tienda.Direccion</p>
            <p>RUC: @tienda.RUC</p>
        </div>
        <div class="factura-box">
            <div class="label">Factura de Compra</div>
            <div class="value">N° @Model.NumeroFactura</div>
            <div class="value-sm">Timbrado: @Model.NumeroTimbrado</div>
            <div class="value-sm">Venc. Timbrado: @Model.FechaVencimientoTimbrado</div>
        </div>
    </div>

    <div class="doc-body">

        @* Estado y OC *@
        <div class="estado-bar">
            <span>Estado:</span>
            <span class="badge @badgeEstado">@(string.IsNullOrEmpty(Model.Estado) ? "—" : Model.Estado)</span>
            @if (!string.IsNullOrEmpty(Model.NumeroOrden))
            {
                <span class="badge badge-warning"><i class="fas fa-file-alt"></i> OC: @Model.NumeroOrden</span>
            }
            @if (tieneNC)
            {
                string numNC = ViewBag.NumeroNC as string;
                string estNC = ViewBag.EstadoNC as string;
                <span class="badge badge-nc">
                    <i class="fas fa-file-invoice-dollar"></i>
                    NC aplicada: Gs. @string.Format("{0:N0}", Model.MontoNotaCredito).Replace(",", ".")
                    @if (!string.IsNullOrEmpty(numNC))
                    {
                        <text> — N° @numNC</text>
                    }
                    @if (!string.IsNullOrEmpty(estNC))
                    {
                        <text> (@estNC)</text>
                    }
                </span>
            }
        </div>

        @* Info proveedor / fechas *@
        <div class="info-grid">
            <div class="info-card">
                <div class="card-title"><i class="fas fa-truck"></i> Datos del Proveedor</div>
                <div class="info-row"><span class="field">Razón Social</span><span class="val">@proveedor.RazonSocial</span></div>
                <div class="info-row"><span class="field">RUC</span><span class="val">@proveedor.Ruc</span></div>
                @if (!string.IsNullOrEmpty(proveedor.Telefono))
                {
                    <div class="info-row"><span class="field">Teléfono</span><span class="val">@proveedor.Telefono</span></div>
                }
                @if (!string.IsNullOrEmpty(proveedor.Correo))
                {
                    <div class="info-row"><span class="field">Correo</span><span class="val">@proveedor.Correo</span></div>
                }
            </div>
            <div class="info-card">
                <div class="card-title"><i class="fas fa-calendar-alt"></i> Fechas</div>
                <div class="info-row"><span class="field">Fecha Factura</span><span class="val">@(string.IsNullOrEmpty(Model.FechaFactura) ? Model.FechaCompra : Model.FechaFactura)</span></div>
                <div class="info-row"><span class="field">Fecha Entrega</span><span class="val">@(string.IsNullOrEmpty(Model.FechaEntrega) ? "—" : Model.FechaEntrega)</span></div>
                <div class="info-row"><span class="field">Registrado</span><span class="val">@Model.FechaCompra</span></div>
            </div>
        </div>

        @* Tabla de productos *@
        <div class="productos-title"><i class="fas fa-boxes"></i> Detalle de Productos</div>
        <table class="productos">
            <thead>
                <tr>
                    <th style="width:5%">#</th>
                    <th style="width:35%">Producto</th>
                    <th class="center" style="width:10%">Pedido</th>
                    <th class="center" style="width:10%">Recibido</th>
                    <th class="right"  style="width:15%">P. Unitario</th>
                    <th class="right"  style="width:15%">Total</th>
                    <th class="center" style="width:10%">Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (!items.Any())
                {
                    <tr><td colspan="7" style="text-align:center; color:#64748b; padding:14px;">Sin líneas de detalle.</td></tr>
                }
                else
                {
                    int i = 1;
                    foreach (var item in items)
                    {
                        decimal pedido   = item.Cantidad;
                        decimal recibido = item.CantidadRecibida > 0 ? item.CantidadRecibida : pedido;
                        decimal diff     = pedido - recibido;
                        <tr>
                            <td>@(i++)</td>
                            <td>@(item.oProducto != null ? item.oProducto.Nombre : "—")</td>
                            <td class="center">@pedido</td>
                            <td class="center">
                                @recibido
                                @if (diff > 0)
                                {
                                    <span class="diff-neg"> (-@diff)</span>
                                }
                            </td>
                            <td class="right">Gs. @string.Format("{0:N0}", item.PrecioUnitarioCompra).Replace(",",".")</td>
                            <td class="right">Gs. @string.Format("{0:N0}", tieneNC ? item.Cantidad * item.PrecioUnitarioCompra : item.TotalCosto).Replace(",",".")</td>
                            <td class="center">
                                @{
                                    string lineBadge = item.EstadoLinea == "Aceptada"  ? "badge-success"
                                                     : item.EstadoLinea == "NC"        ? "badge-warning"
                                                     : item.EstadoLinea == "Rechazada" ? "badge-danger"
                                                     : "badge-warning";
                                }
                                <span class="badge @lineBadge">@(string.IsNullOrEmpty(item.EstadoLinea) ? "—" : item.EstadoLinea)</span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        @* Totales *@
        <div class="totales-wrap">
            <div class="totales-box">
                @if (tieneNC)
                {
                    // Bruto = suma de líneas; NC = monto aplicado; Neto = Bruto - NC
                    decimal montoNC = Model.MontoNotaCredito ?? 0;
                    decimal neto    = subtotalBruto - montoNC;
                    <div class="totales-row">
                        <span>Subtotal (bruto)</span>
                        <span>Gs. @string.Format("{0:N0}", subtotalBruto).Replace(",",".")</span>
                    </div>
                    <div class="totales-row nc-row">
                        <span><i class="fas fa-minus"></i> Nota de Crédito</span>
                        <span>- Gs. @string.Format("{0:N0}", montoNC).Replace(",",".")</span>
                    </div>
                    <div class="totales-row total-final">
                        <span>Total Neto a Pagar</span>
                        <span>Gs. @string.Format("{0:N0}", neto).Replace(",",".")</span>
                    </div>
                }
                else
                {
                    <div class="totales-row total-final">
                        <span>Total</span>
                        <span>Gs. @string.Format("{0:N0}", subtotalBruto).Replace(",",".")</span>
                    </div>
                }
            </div>
        </div>

    </div>@* /doc-body *@

    @* Footer *@
    <div class="doc-footer">
        <span>Compra N° @Model.Codigo</span>
        <span>Sistema de Ventas — COMPU SPACE</span>
        <span>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
    </div>

</div>@* /doc-wrap *@

@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/Content/PluginsJS")
</body>
</html>
