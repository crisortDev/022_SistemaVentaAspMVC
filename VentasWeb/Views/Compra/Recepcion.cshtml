@model CapaModelo.Compra
@{
    ViewBag.Title = "Recepción de Mercadería";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var motivosNC = ViewBag.MotivosNC as List<CapaModelo.MotivoNotaCredito> ?? new List<CapaModelo.MotivoNotaCredito>();
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Compras</a></li>
        <li class="breadcrumb-item active" aria-current="page">Recepción de Mercadería</li>
    </ol>
</nav>

<div class="row">
    <div class="col-sm-12">
        <div class="card border-info">
            <div class="card-header bg-info text-white">
                Recepción de Mercadería
            </div>
            <div class="card-body p-2">

                @* ── FASE 1: Buscar OC ── *@
                <div id="panelBuscarOC">
                    <div class="row align-items-end mb-2">
                        <div class="col-sm-3">
                            <label class="col-form-label col-form-label-sm">N° Orden de Compra:</label>
                            <input type="number" id="txtIdOrdenCompra" class="form-control form-control-sm"
                                   placeholder="ID de la OC aprobada" min="1" />
                        </div>
                        <div class="col-sm-2">
                            <button id="btnBuscarOC" class="btn btn-sm btn-info mt-1">
                                <i class="fas fa-search"></i> Buscar OC
                            </button>
                        </div>
                    </div>
                </div>

                @* ── FASE 1: Panel principal (se muestra al encontrar la OC) ── *@
                <div id="panelRecepcion" class="d-none">

                    @* Datos de la OC *@
                    <div class="row mb-2">
                        <div class="col-sm-3">
                            <label class="col-form-label col-form-label-sm">Proveedor:</label>
                            <input type="text" id="txtProveedor" class="form-control form-control-sm" readonly />
                        </div>
                        <div class="col-sm-2">
                            <label class="col-form-label col-form-label-sm">N° Orden:</label>
                            <input type="text" id="txtNumeroOrden" class="form-control form-control-sm" readonly />
                        </div>
                        <div class="col-sm-2">
                            <label class="col-form-label col-form-label-sm">Tienda:</label>
                            <input type="text" id="txtTienda" class="form-control form-control-sm" readonly />
                        </div>
                    </div>

                    @* Datos fiscales de la factura del proveedor *@
                    <div class="card border-secondary mb-2">
                        <div class="card-header bg-secondary text-white py-1">
                            <i class="fas fa-file-invoice"></i> Datos de la Factura del Proveedor
                        </div>
                        <div class="card-body py-2">
                            <div class="row align-items-end">
                                <div class="col-sm-2">
                                    <label class="col-form-label col-form-label-sm">N° Factura <span class="text-danger">*</span></label>
                                    <input type="text" id="txtNumeroFactura" class="form-control form-control-sm"
                                           placeholder="001-001-0000001" />
                                </div>
                                <div class="col-sm-2">
                                    <label class="col-form-label col-form-label-sm">N° Timbrado <span class="text-danger">*</span></label>
                                    <input type="text" id="txtNumeroTimbrado" class="form-control form-control-sm"
                                           placeholder="12345678" />
                                </div>
                                <div class="col-sm-2">
                                    <label class="col-form-label col-form-label-sm">Venc. Timbrado <span class="text-danger">*</span></label>
                                    <input type="text" id="txtFechaVencTimbrado" class="form-control form-control-sm datepicker"
                                           autocomplete="off" />
                                </div>
                                <div class="col-sm-2">
                                    <label class="col-form-label col-form-label-sm">Fecha Factura <span class="text-danger">*</span></label>
                                    <input type="text" id="txtFechaFactura" class="form-control form-control-sm datepicker"
                                           autocomplete="off" />
                                </div>
                                <div class="col-sm-2">
                                    <label class="col-form-label col-form-label-sm">Fecha Entrega</label>
                                    <input type="text" id="txtFechaEntrega" class="form-control form-control-sm datepicker"
                                           autocomplete="off" />
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Detalle de líneas *@
                    <div class="table-responsive mb-2">
                        <table class="table table-sm table-bordered table-hover" id="tblLineas">
                            <thead class="thead-light">
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-center">Cant. Ordenada</th>
                                    <th class="text-center">Cant. Recibida</th>
                                    <th class="text-center">Precio Unit.</th>
                                    <th class="text-center">Total Línea</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyLineas"></tbody>
                            <tfoot>
                                <tr class="table-info font-weight-bold">
                                    <td colspan="4" class="text-right">Total Compra:</td>
                                    <td class="text-center" id="tdTotalCompra">Gs. 0</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    @* Botón guardar recepción — solo visible antes de guardar *@
                    <div id="panelGuardar" class="mb-2">
                        <button id="btnGuardarRecepcion" class="btn btn-sm btn-primary">
                            <i class="fas fa-save"></i> Guardar Recepción
                        </button>
                    </div>

                    @* ── FASE 2: acciones post-guardado (ocultas hasta guardar) ── *@
                    <div id="panelFase2" class="d-none">

                        @* Nota de Crédito — solo visible si hubo diferencia en cantidades *@
                        <div id="panelNC" class="card border-warning mb-2 d-none">
                            <div class="card-header bg-warning text-dark py-1">
                                <i class="fas fa-file-invoice-dollar"></i>
                                Nota de Crédito — se detectó diferencia entre lo pedido y lo recibido
                            </div>
                            <div class="card-body py-2">
                                <div class="row align-items-end">
                                    <div class="col-sm-4">
                                        <label class="col-form-label col-form-label-sm">Motivo NC:</label>
                                        <select id="cboMotivoNC" class="form-control form-control-sm">
                                            <option value="0">-- Seleccione un motivo --</option>
                                            @foreach (var m in motivosNC)
                                            {
                                                <option value="@m.IdMotivoNotaCredito">@m.Descripcion</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-sm-2">
                                        <button id="btnNC" class="btn btn-sm btn-warning mt-1">
                                            <i class="fas fa-file-invoice-dollar"></i> Generar NC
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* Aviso de siguiente paso — Segregación O&M *@
                        <div class="alert alert-success py-2 mb-2" role="alert">
                            <i class="fas fa-check-circle"></i>
                            <strong>Recepción guardada correctamente.</strong>
                            La factura quedó en estado <strong>Pendiente de revisión</strong>.
                            <hr class="my-1" />
                            <small>
                                <i class="fas fa-info-circle text-success"></i>
                                <strong>Próximo paso — Segregación O&amp;M:</strong>
                                Un supervisor o administrador diferente debe ingresar a
                                <strong>Compras → Revisión de Compras</strong>
                                para confirmar o anular.
                                Si recibiste <em>menos unidades de las ordenadas</em>,
                                se mostrará el botón <span class="badge badge-warning">NC</span>
                                — generá la Nota de Crédito primero y luego podrás confirmar.
                            </small>
                        </div>
                        <a href="@Url.Action("Revision","Compra")"
                           class="btn btn-sm btn-outline-success">
                            <i class="fas fa-clipboard-check"></i>
                            Ir a Revisión de Compras
                        </a>

                    </div><!-- /panelFase2 -->

                </div><!-- /panelRecepcion -->

            </div><!-- /card-body -->
        </div>
    </div>
</div>

@section scripts {
<script>
    var idCompraActual   = 0;
    var idOCActual       = 0;
</script>
<script src="@Url.Content("~/Scripts/Views/Compra_Recepcion.js?v=" + DateTime.Now.Ticks)" type="text/javascript"></script>
}
