@model CapaModelo.Compra
@{
    ViewBag.Title = "Recepción de Compra";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var motivosNC = ViewBag.MotivosNC as List<CapaModelo.MotivoNotaCredito> ?? new List<CapaModelo.MotivoNotaCredito>();
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Compras</a></li>
        <li class="breadcrumb-item active" aria-current="page">Recepción</li>
    </ol>
</nav>

<div class="row">
    <div class="col-sm-12">
        <div class="card border-info">
            <div class="card-header bg-info text-white">
                Recepción de Mercadería
            </div>
            <div class="card-body p-2">

                @* Buscar compra  *@
                <div class="row align-items-end mb-2">
                    <div class="col-sm-3">
                        <label class="col-form-label col-form-label-sm">N° Factura / ID Compra:</label>
                        <input type="number" id="txtIdCompra" class="form-control form-control-sm"
                               placeholder="ID de compra" min="1" />
                    </div>
                    <div class="col-sm-2">
                        <button id="btnBuscarCompra" class="btn btn-sm btn-info mt-1">
                            <i class="fas fa-search"></i> Buscar
                        </button>
                    </div>
                </div>

                @* Datos de la compra  *@
                <div id="panelCompra" class="@(Model.IdCompra > 0 ? "" : "d-none")">
                    <div class="row mb-2">
                        <div class="col-sm-3">
                            <label class="col-form-label col-form-label-sm">Proveedor:</label>
                            <input type="text" id="txtProveedor" class="form-control form-control-sm" readonly />
                        </div>
                        <div class="col-sm-2">
                            <label class="col-form-label col-form-label-sm">Fecha Factura:</label>
                            <input type="text" id="txtFechaFactura" class="form-control form-control-sm datepicker"
                                   autocomplete="off" />
                        </div>
                        <div class="col-sm-2">
                            <label class="col-form-label col-form-label-sm">Fecha Entrega:</label>
                            <input type="text" id="txtFechaEntrega" class="form-control form-control-sm datepicker"
                                   autocomplete="off" />
                        </div>
                        <div class="col-sm-2">
                            <label class="col-form-label col-form-label-sm">Estado:</label>
                            <input type="text" id="txtEstado" class="form-control form-control-sm" readonly />
                        </div>
                    </div>

                    @* Detalle de líneas  *@
                    <div class="table-responsive mb-2">
                        <table class="table table-sm table-bordered table-hover" id="tblLineas">
                            <thead class="thead-light">
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-center">Cant. Facturada</th>
                                    <th class="text-center">Cant. Recibida</th>
                                    <th class="text-center">Estado Línea</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyLineas"></tbody>
                        </table>
                    </div>

                    @* Nota de Crédito  *@
                    <div class="card border-warning mb-2" id="panelNC">
                        <div class="card-header bg-warning text-dark py-1">
                            Nota de Crédito (opcional)
                        </div>
                        <div class="card-body py-2">
                            <div class="row align-items-end">
                                <div class="col-sm-4">
                                    <label class="col-form-label col-form-label-sm">Motivo NC:</label>
                                    <select id="cboMotivoNC" class="form-control form-control-sm">
                                        <option value="0">-- Sin nota de crédito --</option>
                                        @foreach (var m in motivosNC)
                                        {
                                            <option value="@m.IdMotivoNotaCredito">@m.Descripcion</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-sm-2">
                                    <button id="btnNC" class="btn btn-sm btn-warning mt-1">
                                        <i class="fas fa-file-invoice-dollar"></i> Generar NC
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Botones de acción  *@
                    <div class="row">
                        <div class="col-sm-12">
                            <button id="btnGuardarRecepcion" class="btn btn-sm btn-primary mr-1">
                                <i class="fas fa-save"></i> Guardar Recepción
                            </button>
                            <button id="btnConfirmar" class="btn btn-sm btn-success mr-1">
                                <i class="fas fa-check-circle"></i> Confirmar Compra
                            </button>
                            <button id="btnGenerarOP" class="btn btn-sm btn-dark">
                                <i class="fas fa-file-alt"></i> Generar Orden de Pago
                            </button>
                        </div>
                    </div>
                </div><!-- /panelCompra -->

            </div><!-- /card-body -->
        </div>
    </div>
</div>

@section scripts {
<script>
    // Expone el id inicial al JS externo (patrón del proyecto)
    var idCompraInicial = @(Model.IdCompra > 0 ? Model.IdCompra.ToString() : "0");
</script>
<script src="@Url.Content("~/Scripts/Views/Compra_Recepcion.js?v=" + DateTime.Now.Ticks)" type="text/javascript"></script>
}
