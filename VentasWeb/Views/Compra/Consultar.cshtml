@{
    ViewBag.Title = "Consultar Compras";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Compras</a></li>
        <li class="breadcrumb-item active" aria-current="page">Consultar Compras</li>
    </ol>
</nav>

<div class="row">
    <div class="col-sm-12">
        <div class="card border-info">
            <div class="card-header bg-info text-white">
                <i class="fas fa-search"></i>
                Consultar Facturas de Compra
            </div>
            <div class="card-body p-2">

                @* Filtros *@
                <div class="row align-items-end">
                    <div class="col-sm-2">
                        <div class="form-group mb-0">
                            <label class="col-form-label col-form-label-sm">Fecha Inicio:</label>
                            <input type="text" class="form-control form-control-sm" id="txtFechaInicio" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="form-group mb-0">
                            <label class="col-form-label col-form-label-sm">Fecha Fin:</label>
                            <input type="text" class="form-control form-control-sm" id="txtFechaFin" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="form-group mb-0">
                            <label class="col-form-label col-form-label-sm">Proveedor:</label>
                            <select class="form-control form-control-sm" id="cboProveedor"></select>
                        </div>
                    </div>
                    <div class="col-sm-2" id="divFiltroTienda">
                        <div class="form-group mb-0">
                            <label class="col-form-label col-form-label-sm">Tienda:</label>
                            <select class="form-control form-control-sm" id="cboTienda"></select>
                        </div>
                    </div>
                    <div class="col-sm-1">
                        <div class="form-group mb-0">
                            <label class="col-form-label col-form-label-sm">Estado:</label>
                            <select class="form-control form-control-sm" id="cboEstado">
                                <option value="Todos">Todos</option>
                                <option value="Pendiente">Pendiente</option>
                                <option value="Confirmada">Confirmada</option>
                                <option value="Anulada">Anulada</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-sm-1">
                        <button type="button" class="btn btn-sm btn-primary btn-block" onclick="buscar()">
                            <i class="fas fa-search"></i> Buscar
                        </button>
                    </div>
                </div>

                <hr class="mt-2 mb-2" />

                @* Leyenda *@
                <div class="d-flex align-items-center mb-2" style="gap:12px; font-size:0.82rem;">
                    <span><i class="fas fa-plus-circle text-secondary mr-1"></i> Click en <strong>+</strong> para ver el detalle de productos de cada factura</span>
                    <span class="badge badge-warning ml-3"><i class="fas fa-file-invoice-dollar"></i> Tiene Nota de Crédito</span>
                    <span class="badge badge-success ml-1">Confirmada</span>
                    <span class="badge badge-warning ml-1">Pendiente</span>
                    <span class="badge badge-danger ml-1">Anulada</span>
                </div>

                <div class="row mt-1">
                    <div class="col-sm-12">
                        <table id="tbCompras"
                               class="table table-striped table-bordered nowrap compact"
                               style="width:100%">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>N° Compra</th>
                                    <th>N° Factura</th>
                                    <th>Proveedor</th>
                                    <th>Tienda</th>
                                    <th>F. Factura</th>
                                    <th>OC Vinculada</th>
                                    <th>Total (Gs.)</th>
                                    <th>Nota de Crédito</th>
                                    <th>Estado</th>
                                    <th>Registrado por</th>
                                    <th>Documento</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section scripts{
    <script src="@Url.Content("~/Scripts/Views/Compra_Consultar.js?v=" + DateTime.Now.Ticks)"
            type="text/javascript"></script>
}
