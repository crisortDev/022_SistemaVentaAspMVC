@{
    ViewBag.Title = "Crear";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .historial-precio-wrapper {
        max-height: 200px;
        overflow-y: auto;
        overflow-x: hidden;
    }

    #tbHistorialPrecio {
        table-layout: fixed;
        width: auto;
        min-width: 480px;
    }

        #tbHistorialPrecio th,
        #tbHistorialPrecio td {
            white-space: nowrap;
            text-overflow: ellipsis;
            overflow: hidden;
            padding: 4px 8px;
            font-size: 0.875rem;
        }
</style>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Compras</a></li>
        <li class="breadcrumb-item active" aria-current="page">Registrar Compra</li>
    </ol>
</nav>

<div class="row">
    <input type="hidden" id="hdnIdUsuario" value="@ViewBag.IdUsuario" />
    <div class="col-sm-12">
        <div class="card border-info">
            <div class="card-header bg-info text-white">
                Registrar Compra
            </div>
            <div class="card-body card-compra p-2">
                <div class="row">

                    <!-- Detalle Proveedor -->
                    <div class="col-sm-6">
                        <div class="card border-info">
                            <div class="card-body p-2">
                                <h6 class="card-title mb-1 text-info">Detalle Proveedor Origen</h6>
                                <div class="row align-items-end">
                                    <input id="txtIdProveedor" type="hidden" value="0" />
                                    <div class="col-sm-4">
                                        <div class="form-group mb-0">
                                            <label for="txtRucProveedor" class="col-form-label col-form-label-sm">RUC:</label>
                                            <input type="text" class="form-control form-control-sm model" readonly id="txtRucProveedor" name="RUC">
                                        </div>
                                    </div>
                                    <div class="col-sm-4">
                                        <div class="form-group mb-0">
                                            <label for="txtRazonSocialProveedor" class="col-form-label col-form-label-sm">Razon Social:</label>
                                            <input type="text" class="form-control form-control-sm model" readonly id="txtRazonSocialProveedor" name="RazonSocial">
                                        </div>
                                    </div>
                                    <div class="col-sm-4">
                                        <div class="form-group mb-0">
                                            <button id="btnBuscarProveedor" type="button" class="btn btn-sm btn-success btn-block" onclick="buscarProveedor()">
                                                <i class="fas fa-search"></i> Buscar
                                            </button>
                                        </div>
                                    </div>
                                    <div class="col-sm-4 mt-2">
                                        <div class="form-group mb-0">
                                            <label for="txtNumeroFactura" class="col-form-label col-form-label-sm">N° Factura:</label>
                                            <input type="text" class="form-control form-control-sm model" id="txtNumeroFactura" name="NumeroFactura">
                                        </div>
                                    </div>
                                    <div class="col-sm-4 mt-2">
                                        <div class="form-group mb-0">
                                            <label for="txtNumeroTimbrado" class="col-form-label col-form-label-sm">N° Timbrado:</label>
                                            <input type="text" class="form-control form-control-sm model" id="txtNumeroTimbrado" name="NumeroTimbrado">
                                        </div>
                                    </div>
                                    <div class="col-sm-4 mt-2">
                                        <div class="form-group mb-0">
                                            <label for="txtFechaVencimientoTimbrado" class="col-form-label col-form-label-sm">Venc. Timbrado:</label>
                                            <input type="date" class="form-control form-control-sm model" id="txtFechaVencimientoTimbrado" name="FechaVencimientoTimbrado">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Detalle Orden de Compra -->
                    <div class="col-sm-6">
                        <div class="card border-info">
                            <div class="card-body p-2">
                                <h6 class="card-title mb-1 text-info">Orden de Compra Base <span class="text-danger">*</span></h6>
                                <div class="row align-items-end">
                                    <input id="txtIdOrdenCompra" type="hidden" value="0" />
                                    <div class="col-sm-4">
                                        <div class="form-group mb-0">
                                            <label for="txtNumeroOrden" class="col-form-label col-form-label-sm">N° Orden:</label>
                                            <input type="text" class="form-control form-control-sm model" readonly id="txtNumeroOrden" name="NumeroOrden">
                                        </div>
                                    </div>
                                    <div class="col-sm-4">
                                        <div class="form-group mb-0">
                                            <label for="txtEstadoOrden" class="col-form-label col-form-label-sm">Estado:</label>
                                            <input type="text" class="form-control form-control-sm model" readonly id="txtEstadoOrden" name="EstadoOrden">
                                        </div>
                                    </div>
                                    <div class="col-sm-4">
                                        <div class="form-group mb-0">
                                            <button id="btnBuscarOrdenCompra" type="button" class="btn btn-sm btn-success btn-block" onclick="buscarOrdenCompra()">
                                                <i class="fas fa-search"></i> Buscar
                                            </button>
                                        </div>
                                    </div>
                                    <div class="col-sm-12 mt-2">
                                        <div class="form-group mb-0">
                                            <label for="txtObservacionOrden" class="col-form-label col-form-label-sm">Observación:</label>
                                            <textarea class="form-control form-control-sm model" readonly id="txtObservacionOrden" name="ObservacionOrden" rows="2"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 🆕 NUEVA SECCIÓN: PRODUCTOS DE LA ORDEN -->
                    <div class="col-sm-12">
                        <div class="card border-info">
                            <div class="card-body p-2">
                                <h6 class="card-title mb-1 text-info">Productos de la Orden (Auto-cargados)</h6>
                                <div class="table-responsive-sm">
                                    <table id="tbProductosOrden" class="table table-striped table-bordered table-sm" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th style="width: 25%;">Producto</th>
                                                <th style="width: 12%; text-align: center;">Ordenado</th>
                                                <th style="width: 12%; text-align: center;">Facturado</th>
                                                <th style="width: 12%; text-align: center;">Disponible</th>
                                                <th style="width: 14%; text-align: center;">A Facturar</th>
                                                <th style="width: 12%; text-align: right;">Precio Unit.</th>
                                                <th style="width: 13%; text-align: right;">Total</th>
                                            </tr>
                                        </thead>
                                        <tbody id="tbProductosOrdenBody">
                                            <!-- Se carga automáticamente con JavaScript -->
                                        </tbody>
                                    </table>
                                </div>
                                <small class="text-muted">
                                    <i class="fas fa-info-circle"></i> Los productos se cargan automáticamente al seleccionar una orden de compra aprobada.
                                </small>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Fila Tienda (segunda fila) -->
                <div class="row mt-2">

                    <!-- Detalle Tienda -->
                    <div class="col-sm-6">
                        <div class="card border-info">
                            <div class="card-body p-2">
                                <h6 class="card-title mb-1 text-info">Detalle Tienda Destino</h6>
                                <div class="row align-items-end">
                                    <input id="txtIdTienda" type="hidden" value="0" />
                                    <div class="col-sm-4">
                                        <div class="form-group mb-0">
                                            <label for="txtRucTienda" class="col-form-label col-form-label-sm">RUC:</label>
                                            <input type="text" class="form-control form-control-sm model" readonly id="txtRucTienda" name="RUC">
                                        </div>
                                    </div>
                                    <div class="col-sm-4">
                                        <div class="form-group mb-0">
                                            <label for="txtNombreTienda" class="col-form-label col-form-label-sm">Nombre:</label>
                                            <input type="text" class="form-control form-control-sm model" readonly id="txtNombreTienda" name="NombreTienda">
                                        </div>
                                    </div>
                                    <!-- Botón buscar tienda: solo visible para SuperAdmin -->
                                    <div class="col-sm-4" id="divBtnBuscarTienda">
                                        <div class="form-group mb-0">
                                            <button id="btnBuscarTienda" type="button" class="btn btn-sm btn-success btn-block" onclick="buscarTienda()">
                                                <i class="fas fa-search"></i> Buscar
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>


                <!-- Resumen de totales -->
                <div class="row mt-3">
                    <div class="col-sm-12">
                        <h6 class="text-info mb-2">📊 Resumen Total de Compra</h6>
                        <div class="card border-secondary">
                            <div class="card-body p-3">
                                <div class="row text-center">
                                    <div class="col-sm-3">
                                        <h6 class="text-muted mb-1">Cantidad Total</h6>
                                        <h4 class="text-primary mb-0">
                                            <span id="totalCantidad">0</span> unidades
                                        </h4>
                                    </div>
                                    <div class="col-sm-3">
                                        <h6 class="text-muted mb-1">Subtotal</h6>
                                        <h4 class="text-primary mb-0">
                                            <span id="totalCompra">0</span> Gs.
                                        </h4>
                                    </div>
                                    <div class="col-sm-3">
                                        <h6 class="text-muted mb-1">IVA Total</h6>
                                        <h4 class="text-warning mb-0">
                                            <span id="totalIva">0</span> Gs.
                                        </h4>
                                    </div>
                                    <div class="col-sm-3">
                                        <h6 class="text-muted mb-1">TOTAL CON IVA</h6>
                                        <h3 class="text-success mb-0" style="font-weight: bold;">
                                            <span id="totalCompraFinal">0</span> Gs.
                                        </h3>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="card-footer bg-white border-info">
                <button id="btnTerminarGuardarCompra" class="btn btn-primary btn-sm float-right">
                    <i class="fas fa-tags"></i> Terminar y Guardar Compra
                </button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL SELECCIONAR PROVEEDOR -->
<div class="modal fade" id="modalProveedor" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Seleccionar Proveedor</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <table id="tbProveedor" class="table table-striped table-bordered nowrap table-sm" style="width:100%">
                    <thead>
                        <tr>
                            <th></th>
                            <th>RUC</th>
                            <th>Razón Social</th>
                            <th>Dirección</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- MODAL TIENDA — solo usado por SuperAdmin -->
<div class="modal fade" id="modalTienda" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Seleccionar Tienda</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <table id="tbTienda" class="table table-striped table-bordered nowrap table-sm" style="width:100%">
                    <thead>
                        <tr>
                            <th></th>
                            <th>RUC</th>
                            <th>Nombre</th>
                            <th>Dirección</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- MODAL PRODUCTO -->
<div class="modal fade" id="modalProducto" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Seleccionar Producto</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <table id="tbProducto" class="table table-striped table-bordered nowrap table-sm" style="width:100%">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Código</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Categoría</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- MODAL ORDEN DE COMPRA -->
<div class="modal fade" id="modalOrdenCompra" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Seleccionar Orden de Compra Aprobada</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <table id="tbOrdenCompra" class="table table-striped table-bordered nowrap table-sm" style="width:100%">
                    <thead>
                        <tr>
                            <th></th>
                            <th>N° Orden</th>
                            <th>Proveedor</th>
                            <th>Tienda</th>
                            <th>Fecha Orden</th>
                            <th>Total Estimado</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script type="text/javascript">
        $.MisUrls = { url: {} };
        $.MisUrls.urls = function (urls) { $.extend($.MisUrls.url, urls); };

        $.MisUrls.urls({
            _ObtenerProveedores: '@Url.Action("ObtenerProveedores", "Compra")',
            _GuardarProveedor: '@Url.Action("Guardar", "Proveedor")',
            _EliminarProveedor: '@Url.Action("Eliminar", "Proveedor")',
            _ObtenerTiendas: '@Url.Action("Obtener", "Tienda")',
            _ObtenerProductosPorTienda: '@Url.Action("ObtenerPorTienda", "Producto")',
            _ObtenerProductos: '@Url.Action("Obtener", "Producto")',
            _GuardarCompra: '@Url.Action("Guardar", "Compra")',
            _ObtenerHistorialPrecio: '@Url.Action("ObtenerHistorialPrecio", "Compra")',
            _ObtenerOrdenesCompraAprobadas: '@Url.Action("ObtenerOrdenesAprobadas", "OrdenCompra")',
            _ObtenerDetalleOrdenCompra: '@Url.Action("ObtenerDetalleOrdenCompra", "OrdenCompra")'
        });
    </script>

    <script src="@Url.Content("~/Scripts/Views/Compra_Crear.js?v=" + DateTime.Now.Ticks) type="text/javascript"></script>
}
