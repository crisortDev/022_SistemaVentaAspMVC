@{
    ViewBag.Title = "Proveedores";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Compras</a></li>
        <li class="breadcrumb-item active" aria-current="page">Proveedores</li>
    </ol>
</nav>

<div class="row">
    <div class="col-sm-12">
        <div class="card border-info">
            <div class="card-header bg-info text-white">
                Lista Proveedores
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-4">
                        <button type="button" class="btn btn-sm btn-success" onclick="abrirPopUpForm(null)">
                            <i class="fa fa-plus" aria-hidden="true"></i> Agregar Nuevo
                        </button>
                    </div>
                </div>
                <hr />
                <div class="row mt-3">
                    <div class="col-sm-12">
                        <div style="width:100%; overflow-x:auto;">
                            <table id="tbdata" class="table table-striped table-bordered nowrap compact">
                                <thead>
                                    <tr>
                                        <th>RUC</th>
                                        <th>Razón Social</th>
                                        <th>Teléfono</th>
                                        <th>Correo</th>
                                        <th>Ciudad</th>
                                        <th>Estado</th>
                                        <th>Ubicación</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===== MODAL DETALLE ===== -->
<div class="modal fade" id="ModalDetalle" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-md" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-eye mr-2"></i>Detalle del Proveedor</h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body p-0">
                <table class="table table-sm table-bordered mb-0">
                    <tbody>
                        <tr><th class="bg-light" style="width:35%">RUC</th><td id="detRuc"></td></tr>
                        <tr><th class="bg-light">Razón Social</th><td id="detRazonSocial"></td></tr>
                        <tr><th class="bg-light">Teléfono</th><td id="detTelefono"></td></tr>
                        <tr><th class="bg-light">Correo</th><td id="detCorreo"></td></tr>
                        <tr><th class="bg-light">Dirección</th><td id="detDireccion"></td></tr>
                        <tr><th class="bg-light">Ciudad</th><td id="detCiudad"></td></tr>
                        <tr><th class="bg-light">Barrio</th><td id="detBarrio"></td></tr>
                        <tr><th class="bg-light">Calle</th><td id="detCalle"></td></tr>
                        <tr><th class="bg-light">Referencia</th><td id="detReferencia"></td></tr>
                        <tr><th class="bg-light">Estado</th><td id="detEstado"></td></tr>
                        <tr><th class="bg-light">Geolocalización</th><td id="detGeo"></td></tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- ===== MODAL FORMULARIO ===== -->
<div class="modal fade" id="FormModal" tabindex="-1" role="dialog" data-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">Proveedor</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="form">
                    <input id="txtid" value="0" type="hidden" />
                    <div class="form-group row">
                        <label for="txtRuc" class="col-sm-2 col-form-label col-form-label-sm">RUC <span class="text-danger">*</span></label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control form-control-sm model" id="txtRuc" name="RUC"
                                   maxlength="20" placeholder="Ej: 80012345-6" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="txtRazonSocial" class="col-sm-2 col-form-label col-form-label-sm">Razón Social <span class="text-danger">*</span></label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control form-control-sm model" id="txtRazonSocial" name="RazonSocial"
                                   maxlength="200" placeholder="Nombre legal de la empresa" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="txtTelefono" class="col-sm-2 col-form-label col-form-label-sm">Teléfono <span class="text-danger">*</span></label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control form-control-sm model" id="txtTelefono" name="Telefono"
                                   maxlength="20" placeholder="Ej: 0981123456" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="txtCorreo" class="col-sm-2 col-form-label col-form-label-sm">Correo <span class="text-danger">*</span></label>
                        <div class="col-sm-10">
                            <input type="email" class="form-control form-control-sm model" id="txtCorreo" name="Correo"
                                   maxlength="100" placeholder="ejemplo@empresa.com" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="txtDireccion" class="col-sm-2 col-form-label col-form-label-sm">Dirección <span class="text-danger">*</span></label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control form-control-sm model" id="txtDireccion" name="Direccion"
                                   maxlength="200" placeholder="Dirección principal del proveedor" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="cboEstado" class="col-sm-2 col-form-label col-form-label-sm">Activo</label>
                        <div class="col-sm-10">
                            <select class="form-control form-control-sm model" id="cboEstado" name="Activo">
                                <option value="1">Activo</option>
                                <option value="0">No Activo</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="txtCiudad" class="col-sm-2 col-form-label col-form-label-sm">Ciudad <span class="text-danger">*</span></label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control form-control-sm model" id="txtCiudad" name="Ciudad"
                                   maxlength="100" placeholder="Ej: Asunción" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="txtBarrio" class="col-sm-2 col-form-label col-form-label-sm">Barrio</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control form-control-sm model" id="txtBarrio" name="Barrio"
                                   maxlength="100" placeholder="Opcional" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="txtCalle" class="col-sm-2 col-form-label col-form-label-sm">Calle</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control form-control-sm model" id="txtCalle" name="Calle"
                                   maxlength="100" placeholder="Opcional" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="txtReferencia" class="col-sm-2 col-form-label col-form-label-sm">Referencia</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control form-control-sm model" id="txtReferencia" name="Referencia"
                                   maxlength="200" placeholder="Opcional - punto de referencia" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="txtGeolocalizacion" class="col-sm-2 col-form-label col-form-label-sm">Geolocalización</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control form-control-sm model" id="txtGeolocalizacion" name="Geolocalizacion" readonly />
                            <div style="margin-top:10px">
                                <button type="button" class="btn btn-primary btn-sm" onclick="abrirMapa()">Seleccionar Ubicación</button>
                            </div>
                            <div id="mapForm" style="height:300px; margin-top:10px"></div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-danger" data-dismiss="modal">Cerrar</button>
                <button id="btnGuardarCambios" type="button" class="btn btn-sm btn-primary" onclick="Guardar()">Guardar</button>
            </div>
        </div>
    </div>
</div>

@section estilos{
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" crossorigin="" />
    <style>
        /* ── Columna izquierda fija (RUC) usando sticky nativo ── */
        #tbdata thead th:first-child,
        #tbdata tbody td:first-child {
            position: sticky;
            left: 0;
            z-index: 3;
            background-color: #fff;
        }

        #tbdata.table-striped tbody tr:nth-child(odd) td:first-child {
            background-color: #f9f9f9;
        }

        #tbdata thead th:first-child {
            background-color: #17a2b8 !important;
            color: #fff !important;
            z-index: 4;
        }

        /* ── Columna derecha fija (Acciones) ── */
        #tbdata thead th:last-child,
        #tbdata tbody td:last-child {
            position: sticky;
            right: 0;
            z-index: 3;
            background-color: #fff;
        }

        #tbdata.table-striped tbody tr:nth-child(odd) td:last-child {
            background-color: #f9f9f9;
        }

        #tbdata thead th:last-child {
            background-color: #17a2b8 !important;
            color: #fff !important;
            z-index: 4;
        }

        /* ── Sombras decorativas ── */
        #tbdata tbody td:first-child {
            box-shadow: 3px 0 6px rgba(0,0,0,0.07);
        }

        #tbdata tbody td:last-child {
            box-shadow: -3px 0 6px rgba(0,0,0,0.07);
        }

        /* ── Fix overflow para que sticky funcione ── */
        .dataTables_scrollBody {
            overflow-x: auto !important;
        }

        /* ── RUC bloqueado en modo edición ── */
        #txtRuc[readonly] {
            background-color: #e9ecef;
            cursor: not-allowed;
        }
    </style>
}

@section scripts{
    <script src="https://unpkg.com/leaflet/dist/leaflet.js" crossorigin=""></script>
    <script>
        // Permiso de eliminación física — solo SuperAdmin; inyectado server-side
        window.esSuperAdmin = @(ViewBag.EsSuperAdmin == true ? "true" : "false");
    </script>
    <script src="@Url.Content("~/Scripts/Views/Proveedor_Crear.js?v=" + DateTime.Now.Ticks")?v=@DateTime.Now.Ticks" type="text/javascript"></script>
}