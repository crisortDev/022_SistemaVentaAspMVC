@using CapaModelo
@{
    ViewBag.Title = "Cuentas por Cobrar";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var formasCobro = ViewBag.FormasCobro as List<FormaCobro> ?? new List<FormaCobro>();
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Caja</a></li>
        <li class="breadcrumb-item active">Cuentas por Cobrar</li>
    </ol>
</nav>

<!-- ── Alerta informativa ─────────────────────────────────────────────────── -->
<div class="alert alert-info alert-dismissible fade show py-2 mb-3">
    <i class="fas fa-info-circle mr-1"></i>
    Solo se muestran <strong>facturas a crédito pendientes de cobro</strong> de tu sucursal.
    Las facturas al contado ya cobradas aparecen en el historial de Comprobantes de Cobro.
    <button type="button" class="close py-2" data-dismiss="alert">&times;</button>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="card border-warning">
            <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                <span><i class="fas fa-dollar-sign mr-1"></i> Facturas a Crédito Pendientes</span>
                <div>
                    <div class="custom-control custom-switch d-inline-block mr-2">
                        <input type="checkbox" class="custom-control-input" id="chkSoloVencidas">
                        <label class="custom-control-label" for="chkSoloVencidas">Solo vencidas</label>
                    </div>
                    <button class="btn btn-sm btn-outline-dark" onclick="buscarCXC()">
                        <i class="fas fa-sync-alt"></i> Actualizar
                    </button>
                </div>
            </div>
            <div class="card-body p-2">

                <!-- Tarjetas resumen -->
                <div class="row mb-3" id="panelResumen">
                    <div class="col-sm-3">
                        <div class="card border-secondary text-center py-2">
                            <div class="text-muted small">TOTAL PENDIENTE</div>
                            <div class="font-weight-bold text-dark" style="font-size:18px;" id="lblTotalPendiente">Gs. 0</div>
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <div class="card border-danger text-center py-2">
                            <div class="text-muted small">VENCIDAS</div>
                            <div class="font-weight-bold text-danger" style="font-size:18px;" id="lblTotalVencidas">Gs. 0</div>
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <div class="card border-warning text-center py-2">
                            <div class="text-muted small">POR VENCER (≤ 7 días)</div>
                            <div class="font-weight-bold text-warning" style="font-size:18px;" id="lblTotalPorVencer">Gs. 0</div>
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <div class="card border-success text-center py-2">
                            <div class="text-muted small">AL DÍA (> 7 días)</div>
                            <div class="font-weight-bold text-success" style="font-size:18px;" id="lblTotalAlDia">Gs. 0</div>
                        </div>
                    </div>
                </div>

                <div class="table-responsive-sm">
                    <table id="tbCXC" class="table table-striped table-bordered table-sm" style="width:100%">
                        <thead>
                            <tr>
                                <th>Nº Cobro</th>
                                <th>Nº Factura</th>
                                <th>Cliente</th>
                                <th>Documento</th>
                                <th>Teléfono</th>
                                <th class="text-right">Total (Gs.)</th>
                                <th>Plazo</th>
                                <th>Vencimiento</th>
                                <th>Estado</th>
                                <th>Tienda</th>
                                <th>Emisión</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- ════════════════════════════════════════════════════════════════════════ -->
<!-- MODAL: REGISTRAR COBRO                                                  -->
<!-- ════════════════════════════════════════════════════════════════════════ -->
<div class="modal fade" id="modalCobrar" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success text-white py-2">
                <h5 class="modal-title"><i class="fas fa-dollar-sign mr-1"></i> Registrar Cobro</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="hdnIdCompCobro" />

                <!-- Datos de la factura -->
                <div class="alert alert-light border py-2 mb-3" id="infoFactura">
                    <div class="row">
                        <div class="col-6">
                            <div class="text-muted small">Factura</div>
                            <div class="font-weight-bold" id="infoNumeroFactura">—</div>
                        </div>
                        <div class="col-6">
                            <div class="text-muted small">Cliente</div>
                            <div class="font-weight-bold" id="infoCliente">—</div>
                        </div>
                    </div>
                    <div class="row mt-1">
                        <div class="col-6">
                            <div class="text-muted small">Total a cobrar</div>
                            <div class="font-weight-bold text-danger" id="infoMontoTotal">Gs. 0</div>
                        </div>
                        <div class="col-6">
                            <div class="text-muted small">Vencimiento</div>
                            <div class="font-weight-bold" id="infoVencimiento">—</div>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-form-label col-form-label-sm font-weight-bold">
                        Forma de Cobro <span class="text-danger">*</span>
                    </label>
                    <select id="ddlFormaCobro" class="form-control form-control-sm">
                        <option value="0">-- Seleccioná --</option>
                        @foreach (var fc in formasCobro)
                        {
                            <option value="@fc.IdFormaCobro">@fc.Nombre</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label class="col-form-label col-form-label-sm font-weight-bold">
                        Monto Recibido (Gs.) <span class="text-danger">*</span>
                    </label>
                    <input type="number" id="txtMontoRecibido" class="form-control form-control-sm"
                           min="0" placeholder="0" oninput="calcularCambio()" />
                </div>

                <div class="alert alert-info py-2 mb-2" id="alertCambio" style="display:none;">
                    Cambio a entregar: <strong id="lblCambio">Gs. 0</strong>
                </div>

                <div class="form-group mb-0">
                    <label class="col-form-label col-form-label-sm">Observación (opcional):</label>
                    <textarea id="txtObservacion" class="form-control form-control-sm" rows="2" maxlength="500"></textarea>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success btn-sm" onclick="confirmarCobro()">
                    <i class="fas fa-check"></i> Confirmar Cobro
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/Views/CuentasPorCobrar_Index.js?v=" + DateTime.Now.Ticks)"></script>
}
