@using CapaModelo
@{
    ViewBag.Title = "Cuentas por Cobrar";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var formasCobro = ViewBag.FormasCobro as List<FormaCobro> ?? new List<FormaCobro>();
    decimal montoAperturaFondo = ViewBag.MontoAperturaFondo != null ? (decimal)ViewBag.MontoAperturaFondo : 0m;
}
<input type="hidden" id="hdnMontoAperturaFondo" value="@montoAperturaFondo" />

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Caja</a></li>
        <li class="breadcrumb-item active">Cuentas por Cobrar</li>
    </ol>
</nav>

<!-- ── Tarjetas resumen ──────────────────────────────────────────────────────── -->
<div class="row mb-3" id="panelResumen">
    <div class="col-6 col-sm-3 mb-2">
        <div class="card border-secondary text-center py-2 h-100">
            <div class="text-muted small">TOTAL PENDIENTE</div>
            <div class="font-weight-bold text-dark h5 mb-0" id="lblTotalPendiente">Gs. 0</div>
            <div class="text-muted" style="font-size:11px;" id="lblCantPendiente">0 cuotas</div>
        </div>
    </div>
    <div class="col-6 col-sm-3 mb-2">
        <div class="card border-danger text-center py-2 h-100">
            <div class="text-muted small">VENCIDAS</div>
            <div class="font-weight-bold text-danger h5 mb-0" id="lblTotalVencidas">Gs. 0</div>
            <div class="text-muted" style="font-size:11px;" id="lblCantVencidas">0 cuotas</div>
        </div>
    </div>
    <div class="col-6 col-sm-3 mb-2">
        <div class="card border-warning text-center py-2 h-100">
            <div class="text-muted small">POR VENCER <span class="d-none d-sm-inline">(≤ 7 días)</span></div>
            <div class="font-weight-bold text-warning h5 mb-0" id="lblTotalPorVencer">Gs. 0</div>
            <div class="text-muted" style="font-size:11px;" id="lblCantPorVencer">0 cuotas</div>
        </div>
    </div>
    <div class="col-6 col-sm-3 mb-2">
        <div class="card border-success text-center py-2 h-100">
            <div class="text-muted small">AL DÍA <span class="d-none d-sm-inline">(> 7 días)</span></div>
            <div class="font-weight-bold text-success h5 mb-0" id="lblTotalAlDia">Gs. 0</div>
            <div class="text-muted" style="font-size:11px;" id="lblCantAlDia">0 cuotas</div>
        </div>
    </div>
</div>

<!-- ── Panel principal ───────────────────────────────────────────────────────── -->
<div class="card border-warning">
    <div class="card-header bg-warning text-dark py-2">
        <i class="fas fa-hand-holding-usd mr-1"></i>
        <strong>Cuentas por Cobrar</strong>
        <button class="btn btn-sm btn-outline-dark float-right ml-2" onclick="buscarCXC()">
            <i class="fas fa-sync-alt"></i> Actualizar
        </button>
    </div>
    <div class="card-body p-2">

        <!-- ── Filtros ──────────────────────────────────────────────────────── -->
        <div class="card bg-light border-0 mb-2">
            <div class="card-body py-2 px-3">
                <div class="form-row align-items-end">
                    <div class="col-12 col-sm-4 mb-2 mb-sm-0">
                        <label class="col-form-label col-form-label-sm font-weight-bold mb-0">
                            <i class="fas fa-user mr-1"></i>Cliente
                        </label>
                        <input type="text" id="txtFiltroCliente" class="form-control form-control-sm"
                               placeholder="Nombre o documento..." oninput="filtrarTabla()">
                    </div>
                    <div class="col-12 col-sm-3 mb-2 mb-sm-0">
                        <label class="col-form-label col-form-label-sm font-weight-bold mb-0">
                            <i class="fas fa-file-invoice mr-1"></i>Nº Factura
                        </label>
                        <input type="text" id="txtFiltroFactura" class="form-control form-control-sm"
                               placeholder="001-001-0000001" oninput="filtrarTabla()">
                    </div>
                    <div class="col-6 col-sm-2 mb-2 mb-sm-0">
                        <label class="col-form-label col-form-label-sm font-weight-bold mb-0">
                            <i class="fas fa-filter mr-1"></i>Estado
                        </label>
                        <select id="cboFiltroEstado" class="form-control form-control-sm" onchange="filtrarTabla()">
                            <option value="">Todos</option>
                            <option value="Pendiente">Pendiente</option>
                            <option value="Vencida">Vencida</option>
                        </select>
                    </div>
                    <div class="col-6 col-sm-3">
                        <button class="btn btn-sm btn-secondary btn-block" onclick="limpiarFiltros()">
                            <i class="fas fa-times"></i> Limpiar filtros
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Tabla ────────────────────────────────────────────────────────── -->
        <div class="table-responsive-sm">
            <table id="tbCXC" class="table table-striped table-bordered table-sm" style="width:100%">
                <thead class="thead-light">
                    <tr>
                        <th>Factura / Cuota</th>
                        <th>Cliente</th>
                        <th>Teléfono</th>
                        <th class="text-right">Monto (Gs.)</th>
                        <th>Vencimiento</th>
                        <th>Estado</th>
                        <th>Tienda</th>
                        <th>Emisión</th>
                        <!-- columnas ocultas para filtrado -->
                        <th class="d-none">_cliente_buscar</th>
                        <th class="d-none">_factura_buscar</th>
                        <th class="d-none">_estado_buscar</th>
                        <th class="text-center">Acción</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

    </div>
</div>

<!-- ══════════════════════════════════════════════════════════════════════════ -->
<!-- MODAL: REGISTRAR COBRO                                                    -->
<!-- ══════════════════════════════════════════════════════════════════════════ -->
<div class="modal fade" id="modalCobrar" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success text-white py-2">
                <h5 class="modal-title">
                    <i class="fas fa-dollar-sign mr-1"></i> Registrar Cobro
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="hdnIdCompCobro" />

                <!-- Resumen de la cuota/factura -->
                <div class="card bg-light border mb-3">
                    <div class="card-body py-2 px-3">
                        <div class="row">
                            <div class="col-6">
                                <div class="text-muted" style="font-size:11px;">FACTURA</div>
                                <div class="font-weight-bold" id="infoNumeroFactura">—</div>
                            </div>
                            <div class="col-6">
                                <div class="text-muted" style="font-size:11px;">CUOTA / TIPO</div>
                                <div id="infoCuota">—</div>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-6">
                                <div class="text-muted" style="font-size:11px;">CLIENTE</div>
                                <div class="font-weight-bold" id="infoCliente">—</div>
                            </div>
                            <div class="col-6">
                                <div class="text-muted" style="font-size:11px;">VENCIMIENTO</div>
                                <div class="font-weight-bold" id="infoVencimiento">—</div>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-12">
                                <div class="text-muted" style="font-size:11px;">MONTO A COBRAR</div>
                                <div class="font-weight-bold text-danger h5 mb-0" id="infoMontoTotal">Gs. 0</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-form-label col-form-label-sm font-weight-bold">
                        Forma de Cobro <span class="text-danger">*</span>
                    </label>
                    <select id="ddlFormaCobro" class="form-control form-control-sm">
                        <option value="0">-- Seleccioná --</option>
                        @foreach (var fc in formasCobro)
                        {
                            <option value="@fc.IdFormaCobro">@fc.Nombre</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label class="col-form-label col-form-label-sm font-weight-bold">
                        Monto Recibido (Gs.) <span class="text-danger">*</span>
                    </label>
                    <input type="number" id="txtMontoRecibido" class="form-control form-control-sm"
                           min="0" placeholder="0" oninput="calcularCambio()" />
                </div>

                <div class="alert alert-info py-2 mb-2" id="alertCambio" style="display:none;">
                    Cambio a entregar: <strong id="lblCambio">Gs. 0</strong>
                </div>

                <div class="form-group mb-0">
                    <label class="col-form-label col-form-label-sm">Observación (opcional):</label>
                    <textarea id="txtObservacion" class="form-control form-control-sm" rows="2" maxlength="500"></textarea>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success" onclick="confirmarCobro()" id="btnConfirmarCobro">
                    <i class="fas fa-check"></i> Confirmar Cobro
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/Views/CuentasPorCobrar_Index.js?v=" + DateTime.Now.Ticks)"></script>
}
