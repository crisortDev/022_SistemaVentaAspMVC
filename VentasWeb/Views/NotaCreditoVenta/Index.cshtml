@{
    ViewBag.Title = "Notas de Crédito de Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var tiendas = ViewBag.Tiendas as List<CapaModelo.Tienda> ?? new List<CapaModelo.Tienda>();
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Venta</a></li>
        <li class="breadcrumb-item active">Notas de Crédito de Venta</li>
    </ol>
</nav>

<div class="row">
    <div class="col-sm-12">
        <div class="card border-warning">
            <div class="card-header bg-warning text-dark">
                <i class="fas fa-file-alt mr-1"></i> Notas de Crédito de Venta
            </div>
            <div class="card-body p-2">
                <!-- Filtros -->
                <div class="row align-items-end mb-2">
                    <div class="col-sm-2">
                        <label class="col-form-label col-form-label-sm">Fecha Inicio:</label>
                        <input type="text" class="form-control form-control-sm datepicker" id="txtFechaInicio" autocomplete="off">
                    </div>
                    <div class="col-sm-2">
                        <label class="col-form-label col-form-label-sm">Fecha Fin:</label>
                        <input type="text" class="form-control form-control-sm datepicker" id="txtFechaFin" autocomplete="off">
                    </div>
                    <div class="col-sm-2">
                        <label class="col-form-label col-form-label-sm">Estado:</label>
                        <select class="form-control form-control-sm" id="cboEstado">
                            <option value="">-- Todos --</option>
                            <option value="Pendiente">Pendiente</option>
                            <option value="Aprobada">Aprobada</option>
                            <option value="Rechazada">Rechazada</option>
                        </select>
                    </div>
                    <div class="col-sm-3">
                        <label class="col-form-label col-form-label-sm invisible">.</label>
                        <button type="button" class="btn btn-warning btn-sm btn-block" onclick="buscarNCV()">
                            <i class="fas fa-search"></i> Buscar
                        </button>
                    </div>
                    <div class="col-sm-3">
                        <label class="col-form-label col-form-label-sm invisible">.</label>
                        <button type="button" class="btn btn-outline-warning btn-sm btn-block" onclick="abrirModalRegistrar()">
                            <i class="fas fa-plus-circle"></i> Nueva Nota de Crédito
                        </button>
                    </div>
                </div>

                <div class="table-responsive-sm">
                    <table id="tbNCV" class="table table-striped table-bordered table-sm" style="width:100%">
                        <thead>
                            <tr>
                                <th style="width:80px"></th>
                                <th>Nº NCV</th>
                                <th>Nº Factura</th>
                                <th>Cliente</th>
                                <th>Motivo</th>
                                <th class="text-right">Monto (Gs.)</th>
                                <th>Registrado por</th>
                                <th>Tienda</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL REGISTRAR NC -->
<div class="modal fade" id="modalRegistrar" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark py-2">
                <h5 class="modal-title"><i class="fas fa-plus-circle mr-1"></i> Nueva Nota de Crédito de Venta</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="col-form-label col-form-label-sm">Nº Factura Venta: <span class="text-danger">*</span></label>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control form-control-sm" id="txtBuscarFactura" placeholder="001-001-0000001">
                        <div class="input-group-append">
                            <button class="btn btn-warning btn-sm" type="button" onclick="buscarVentaParaNC()">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>
                    <div id="infoVentaNC" class="mt-1 d-none">
                        <small class="text-muted">Cliente: <strong id="lblClienteNC"></strong> | Total: <strong id="lblTotalNC"></strong></small>
                        <input type="hidden" id="hdnIdVentaNC" value="0" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-form-label col-form-label-sm">Motivo: <span class="text-danger">*</span></label>
                    <select class="form-control form-control-sm" id="cboMotivoNC">
                        <option value="0">-- Seleccionar --</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="col-form-label col-form-label-sm">Monto (Gs.): <span class="text-danger">*</span></label>
                    <input type="number" class="form-control form-control-sm" id="txtMontoNC" value="0" min="1">
                </div>
                <div class="form-group">
                    <label class="col-form-label col-form-label-sm">Observación:</label>
                    <textarea class="form-control form-control-sm" id="txtObservacionNC" rows="2" maxlength="500"></textarea>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-warning btn-sm" onclick="registrarNC()">
                    <i class="fas fa-save"></i> Registrar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL APROBAR/RECHAZAR -->
<div class="modal fade" id="modalAprobacion" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header py-2" id="modalAprobacionHeader">
                <h5 class="modal-title" id="lblTituloAprobacion">Aprobar / Rechazar NC</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="hdnIdNCV" value="0" />
                <input type="hidden" id="hdnAccionNCV" value="" />
                <p>NCV: <strong id="lblNcvAprobacion"></strong></p>
                <p>Venta: <strong id="lblVentaAprobacion"></strong> | Monto: <strong id="lblMontoAprobacion"></strong></p>
                <div class="form-group d-none" id="divMotivoRechazo">
                    <label class="col-form-label col-form-label-sm">Motivo de Rechazo: <span class="text-danger">*</span></label>
                    <textarea class="form-control form-control-sm" id="txtMotivoRechazo" rows="3" maxlength="500"></textarea>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary btn-sm" id="btnConfirmarAprobacion" onclick="confirmarAprobacion()">
                    <i class="fas fa-check"></i> Confirmar
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script src="@Url.Content("~/Scripts/Views/NotaCreditoVenta_Index.js?v=" + DateTime.Now.Ticks)" type="text/javascript"></script>
}
