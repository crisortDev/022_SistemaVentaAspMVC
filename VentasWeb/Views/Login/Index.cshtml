@{
    Layout = null;
}
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Login</title>
    @Styles.Render("~/Content/css")
</head>
<body class="bg-info">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="d-flex align-items-center min-vh-100">
                    <div class="w-100 d-block my-5">
                        <div class="row justify-content-center">
                            <div class="col-md-8 col-lg-5">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="text-center mb-4 mt-3">
                                            <a href="#">
                                                <span>
                                                    <img src="@Url.Content("~/Imagenes/tienda.png")" alt="Logo" height="100">
                                                </span>
                                            </a>
                                        </div>

                                        <!-- Campo oculto para pasar error al JS -->
                                        @if (ViewBag.Error != null)
                                        {
                                            <input type="hidden" id="errorMessage" value="@ViewBag.Error" />
                                        }

                                        <form action="@Url.Content("~/Login/Index")" method="post" class="p-2">
                                            <div class="form-group">
                                                <label for="correo">Correo</label>
                                                <input class="form-control"
                                                       type="email"
                                                       id="correo"
                                                       name="correo"
                                                       required
                                                       autocomplete="off"
                                                       value="admin@gmail.com" />
                                            </div>
                                            <div class="form-group">
                                                <label for="clave">Contraseña</label>
                                                <input class="form-control"
                                                       type="password"
                                                       id="clave"
                                                       name="clave"
                                                       required
                                                       autocomplete="off" />
                                            </div>

                                            <div class="mb-3 text-center">
                                                <button class="btn btn-primary btn-block" type="submit">Ingresar</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    <!-- Librería SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- JS propio -->
    <script src="@Url.Content("~/Scripts/Views/Index_login.js")"></script>
</body>
</html>
