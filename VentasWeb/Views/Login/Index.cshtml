@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login</title>
    @Styles.Render("~/Content/css")
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(135deg, #6c5ce7, #00b894);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-card {
            border-radius: 1rem;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
            background-color: #fff;
            overflow: hidden;
            transition: transform 0.3s ease;
        }

            .login-card:hover {
                transform: translateY(-5px);
            }

            .login-card img {
                width: 120px;
                margin-bottom: 1rem;
            }

        .form-control:focus {
            border-color: #6c5ce7;
            box-shadow: 0 0 8px rgba(108, 92, 231, 0.4);
        }

        .btn-login {
            background: #6c5ce7;
            border: none;
            transition: background 0.3s ease;
        }

            .btn-login:hover {
                background: #341f97;
            }

        .login-footer {
            font-size: 0.85rem;
            color: #636e72;
            text-align: center;
            margin-top: 1rem;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-4">
                <div class="card login-card p-4">
                    <div class="text-center">
                        <img src="@Url.Content("~/Imagenes/tienda.png")" alt="Logo">
                        <h3 class="mb-3 text-primary">Bienvenido</h3>
                        <p class="text-muted mb-4">Inicia sesión para continuar</p>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <input type="hidden" id="errorMessage" value="@ViewBag.Error" />
                    }

                    <form action="@Url.Content("~/Login/Index")" method="post">
                        <div class="mb-3">
                            <label for="correo" class="form-label">Correo</label>
                            <input type="email" class="form-control" id="correo" name="correo" required autocomplete="off" value="admin@gmail.com">
                        </div>

                        <div class="mb-3">
                            <label for="clave" class="form-label">Contraseña</label>
                            <input type="password" class="form-control" id="clave" name="clave" required autocomplete="off">
                        </div>

                        <div class="d-grid mb-3">
                            <button class="btn btn-login btn-lg" type="submit">Ingresar</button>
                        </div>
                    </form>

                    <div class="login-footer">
                        ¿No tienes cuenta? <a href="#">Regístrate aquí</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="@Url.Content("~/Scripts/Views/Index_login.js")"></script>
</body>
</html>
