@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acceso al Sistema</title>
    @Styles.Render("~/Content/css")
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <style>
        :root {
            --navy:       #0c1a35;
            --navy-mid:   #1a3566;
            --accent:     #2563eb;
            --accent-lt:  #60a5fa;
            --bg:         #f4f7fb;
            --border:     #e2e8f0;
            --field-bg:   #f1f5f9;
            --muted:      #94a3b8;
            --ink:        #0f172a;
            --success:    #059669;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: var(--bg);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            position: relative;
        }

        /* Blobs decorativos — mismos tonos que el banner del home */
        .blob {
            position: fixed;
            border-radius: 50%;
            filter: blur(90px);
            opacity: 0.13;
            pointer-events: none;
        }

        .blob-1 {
            width: 480px;
            height: 480px;
            background: var(--accent);
            top: -160px;
            right: -120px;
            animation: drift 14s ease-in-out infinite alternate;
        }

        .blob-2 {
            width: 320px;
            height: 320px;
            background: var(--navy);
            bottom: -100px;
            left: -80px;
            animation: drift 18s ease-in-out infinite alternate-reverse;
        }

        @@keyframes drift {
            from { transform: translate(0,0) scale(1); }
            to   { transform: translate(25px,18px) scale(1.06); }
        }

        /* Card principal */
        .login-wrapper {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 520px;
            padding: 1rem;
        }

        .card-shell {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 8px 32px rgba(12,26,53,0.16);
            animation: slideUp 0.45s cubic-bezier(0.16,1,0.3,1) both;
        }

        @@keyframes slideUp {
            from { opacity:0; transform:translateY(28px); }
            to   { opacity:1; transform:translateY(0);    }
        }

        /* Header — mismo gradiente que .home-banner */
        .card-header-custom {
            background: linear-gradient(100deg, #0c1a35 0%, #1a3566 55%, #2563eb 100%);
            padding: 28px 32px 24px;
            position: relative;
            overflow: hidden;
        }

        .card-header-custom::before {
            content: '';
            position: absolute;
            width: 280px; height: 280px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
            top: -120px; right: -60px;
            pointer-events: none;
        }

        .brand-line {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 14px;
        }

        .brand-logo {
            height: 36px;
            width: auto;
            object-fit: contain;
            opacity: 0.95;
        }

        .brand-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: rgba(255,255,255,0.12);
            border: 1px solid rgba(255,255,255,0.22);
            color: #93c5fd;
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 4px 12px;
            border-radius: 999px;
            margin-bottom: 10px;
        }

        .card-title {
            font-size: 1.55rem;
            font-weight: 800;
            color: #fff;
            margin-bottom: 4px;
            line-height: 1.2;
        }

        .card-subtitle {
            color: rgba(255,255,255,0.6);
            font-size: 0.84rem;
        }

        /* Cuerpo del formulario */
        .card-body-custom {
            padding: 28px 32px 40px;
            max-height: 75vh;
            overflow-y: auto;
        }

        .card-body-custom::-webkit-scrollbar { width: 5px; }
        .card-body-custom::-webkit-scrollbar-track { background: var(--field-bg); }
        .card-body-custom::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

        /* Campos */
        .field-group { margin-bottom: 18px; }

        .field-label {
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--muted);
            margin-bottom: 7px;
            display: block;
        }

        .field-wrap { position: relative; }

        .field-wrap .field-icon {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--muted);
            font-size: 14px;
            pointer-events: none;
        }

        .field-control {
            width: 100%;
            background: var(--field-bg);
            border: 1.5px solid var(--border);
            border-radius: 8px;
            padding: 11px 13px 11px 40px;
            font-size: 0.93rem;
            color: var(--ink);
            transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
            outline: none;
        }

        .field-control:focus {
            border-color: var(--accent);
            background: #fff;
            box-shadow: 0 0 0 3px rgba(37,99,235,0.12);
        }

        .field-control.is-valid   { border-color: var(--success); }
        .field-control.is-invalid { border-color: #ef4444; }

        /* Toggle password */
        .toggle-pass {
            position: absolute;
            right: 11px; top: 50%;
            transform: translateY(-50%);
            background: none; border: none;
            color: var(--muted);
            cursor: pointer; padding: 4px;
            font-size: 13px;
            transition: color 0.2s;
        }
        .toggle-pass:hover { color: var(--ink); }

        /* Password strength */
        .strength-bar { display: flex; gap: 4px; margin-top: 8px; }
        .strength-seg {
            flex: 1; height: 3px;
            background: var(--border);
            border-radius: 2px;
            transition: background 0.3s;
        }
        .strength-seg.active-1 { background: #ef4444; }
        .strength-seg.active-2 { background: #f97316; }
        .strength-seg.active-3 { background: #eab308; }
        .strength-seg.active-4 { background: var(--success); }
        .strength-label { font-size: 0.7rem; color: var(--muted); margin-top: 4px; }

        /* Match indicator */
        .match-hint { font-size: 0.74rem; margin-top: 5px; height: 16px; }
        .match-ok  { color: var(--success); }
        .match-err { color: #ef4444; }

        /* Req list */
        .req-list { list-style: none; margin-top: 10px; padding: 0; }
        .req-list li {
            font-size: 0.77rem;
            color: var(--muted);
            display: flex; align-items: center; gap: 6px;
            margin-bottom: 4px;
            transition: color 0.2s;
        }
        .req-list li .dot {
            width: 6px; height: 6px;
            border-radius: 50%;
            background: var(--border);
            flex-shrink: 0;
            transition: background 0.2s;
        }
        .req-list li.met { color: var(--success); }
        .req-list li.met .dot { background: var(--success); }

        /* Botón principal */
        .btn-main {
            width: 100%;
            background: linear-gradient(90deg, var(--navy) 0%, var(--accent) 100%);
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 13px;
            font-weight: 700;
            font-size: 0.9rem;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            cursor: pointer;
            transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
            position: relative;
            overflow: hidden;
            margin-top: 8px;
            box-shadow: 0 4px 14px rgba(37,99,235,0.3);
        }
        .btn-main:hover {
            opacity: 0.9;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(37,99,235,0.4);
        }
        .btn-main:active { transform: translateY(0); box-shadow: none; }
        .btn-main:disabled {
            background: var(--border);
            color: var(--muted);
            cursor: not-allowed;
            transform: none; box-shadow: none;
        }

        .btn-main .spinner {
            display: none;
            width: 15px; height: 15px;
            border: 2px solid rgba(255,255,255,0.35);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin 0.6s linear infinite;
            vertical-align: middle;
            margin-right: 6px;
        }
        @@keyframes spin { to { transform: rotate(360deg); } }
        .btn-main.loading .spinner   { display: inline-block; }
        .btn-main.loading .btn-text  { opacity: 0.7; }

        /* Alertas */
        .alert-inline {
            display: none;
            background: #fef2f2;
            border: 1px solid #fca5a5;
            border-left: 4px solid #ef4444;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 0.84rem;
            color: #b91c1c;
            margin-bottom: 16px;
            animation: fadeIn 0.3s ease;
        }

        @@keyframes fadeIn {
            from { opacity:0; transform:translateY(-5px); }
            to   { opacity:1; transform:translateY(0);    }
        }

        .alert-success-inline {
            display: none;
            background: #f0fdf4;
            border: 1px solid #86efac;
            border-left: 4px solid var(--success);
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 0.84rem;
            color: #166534;
            margin-bottom: 16px;
        }

        /* Badge primer acceso */
        .first-login-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #fffbeb;
            border: 1px solid #fcd34d;
            color: #92400e;
            border-radius: 8px;
            padding: 7px 13px;
            font-size: 0.78rem;
            font-weight: 500;
            margin-bottom: 20px;
            width: 100%;
        }

        /* Footer */
        .card-footer-custom {
            padding: 14px 32px 18px;
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .footer-link {
            font-size: 0.8rem;
            color: var(--muted);
            text-decoration: none;
            transition: color 0.2s;
        }
        .footer-link:hover { color: var(--accent); }
        .footer-link span  { font-weight: 600; color: var(--accent); }

        /* Steps */
        .steps { display: flex; gap: 8px; align-items: center; margin-bottom: 22px; }
        .step-dot {
            width: 8px; height: 8px;
            border-radius: 50%;
            background: var(--border);
            transition: all 0.3s;
        }
        .step-dot.active { background: var(--accent); width: 22px; border-radius: 4px; }
        .step-dot.done   { background: var(--success); }

        /* Panel transitions */
        .panel { display: none; }
        .panel.active {
            display: block;
            animation: panelIn 0.32s cubic-bezier(0.16,1,0.3,1) both;
        }
        @@keyframes panelIn {
            from { opacity:0; transform:translateX(16px); }
            to   { opacity:1; transform:translateX(0);    }
        }

        .divider { height: 1px; background: var(--border); margin: 18px 0; }
    </style>
</head>
<body>
    @* Token CSRF — usado por el interceptor AJAX de más abajo *@
    @Html.AntiForgeryToken()

    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>

    <div class="login-wrapper">
        <div class="card-shell">

            <!-- HEADER -->
            <div class="card-header-custom">
                <div class="brand-line">
                    <img src="@Url.Content("~/Imagenes/tiendalogo.png")" class="brand-logo" alt="CompuSpace" />
                </div>
                <div class="brand-badge">
                    <i class="fas fa-building" style="font-size:.6rem"></i>
                    Sistema de Gestión
                </div>
                <h1 class="card-title" id="panelTitle">Iniciar sesión</h1>
                <p class="card-subtitle" id="panelSubtitle">Ingresá tus credenciales para continuar</p>
            </div>

            <!-- BODY -->
            <div class="card-body-custom">

                <!-- ===== PANEL LOGIN ===== -->
                <div class="panel active" id="panelLogin">

                    <div class="alert-inline" id="loginError">
                        ⚠️ <span id="loginErrorMsg">Usuario o contraseña incorrecta</span>
                    </div>
                    <div class="alert-success-inline" id="loginOk"></div>

                    <form id="formLogin" action="@Url.Content("~/Login/Index")" method="post" novalidate>

                        <div class="field-group">
                            <label class="field-label" for="correo">Correo electrónico</label>
                            <div class="field-wrap">
                                <span class="field-icon">✉</span>
                                <input type="email" class="field-control" id="correo" name="correo"
                                       placeholder="usuario@empresa.com"
                                       value="admin@gmail.com" required autocomplete="email">
                            </div>
                        </div>

                        <div class="field-group">
                            <label class="field-label" for="clave">Contraseña</label>
                            <div class="field-wrap">
                                <span class="field-icon">🔒</span>
                                <input type="password" class="field-control" id="clave" name="clave"
                                       placeholder="Tu contraseña" required autocomplete="current-password">
                                <button type="button" class="toggle-pass" onclick="toggleVis('clave', this)" title="Mostrar/ocultar">👁</button>
                            </div>
                        </div>

                        <button type="submit" class="btn-main" id="btnLogin">
                            <span class="spinner"></span>
                            <span class="btn-text">Ingresar →</span>
                        </button>
                    </form>
                </div>

                <!-- ===== PANEL CAMBIO DE CONTRASEÑA (primer acceso) ===== -->
                <div class="panel" id="panelCambio">

                    <div class="first-login-badge">
                        🔑 Primer acceso detectado — debes crear tu contraseña personal
                    </div>

                    <div class="steps">
                        <div class="step-dot done"></div>
                        <div class="step-dot active"></div>
                        <div class="step-dot"></div>
                    </div>

                    <div class="alert-inline" id="cambioError"></div>
                    <div class="alert-success-inline" id="cambioOk"></div>

                    <div class="field-group">
                        <label class="field-label" for="nuevaClave">Nueva contraseña</label>
                        <div class="field-wrap">
                            <span class="field-icon">🔑</span>
                            <input type="password" class="field-control" id="nuevaClave"
                                   placeholder="Mínimo 8 caracteres" autocomplete="new-password"
                                   oninput="evalStrength(this.value)">
                            <button type="button" class="toggle-pass" onclick="toggleVis('nuevaClave', this)" title="Mostrar">👁</button>
                        </div>
                        <!-- Barra de fortaleza -->
                        <div class="strength-bar">
                            <div class="strength-seg" id="seg1"></div>
                            <div class="strength-seg" id="seg2"></div>
                            <div class="strength-seg" id="seg3"></div>
                            <div class="strength-seg" id="seg4"></div>
                        </div>
                        <div class="strength-label" id="strengthLabel">Ingresa una contraseña</div>
                        <!-- Requisitos -->
                        <ul class="req-list" id="reqList">
                            <li id="reqLen"><span class="dot"></span>Mínimo 8 caracteres</li>
                            <li id="reqUpper"><span class="dot"></span>Al menos una mayúscula</li>
                            <li id="reqNum"><span class="dot"></span>Al menos un número</li>
                            <li id="reqSpecial"><span class="dot"></span>Al menos un carácter especial</li>
                        </ul>
                    </div>

                    <div class="field-group">
                        <label class="field-label" for="confirmarClave">Confirmar contraseña</label>
                        <div class="field-wrap">
                            <span class="field-icon">🔒</span>
                            <input type="password" class="field-control" id="confirmarClave"
                                   placeholder="Repite tu nueva contraseña" autocomplete="new-password"
                                   oninput="checkMatch()">
                            <button type="button" class="toggle-pass" onclick="toggleVis('confirmarClave', this)" title="Mostrar">👁</button>
                        </div>
                        <div class="match-hint" id="matchHint"></div>
                    </div>

                    <button type="button" class="btn-main" id="btnGuardar" onclick="guardarClave()" disabled>
                        <span class="spinner"></span>
                        <span class="btn-text">Guardar contraseña →</span>
                    </button>
                </div>

                <!-- ===== PANEL OLVIDE PASSWORD ===== -->
                <div class="panel" id="panelOlvide">

                    <div class="first-login-badge" style="background:#e8f4fd;border-color:#90c8f0;color:#1a5c8a">
                        📧 Ingresá tu correo y te enviamos una contraseña temporal
                    </div>

                    <div class="alert-inline" id="olvideError"></div>
                    <div class="alert-success-inline" id="olvideOk"></div>

                    <form id="formOlvide" novalidate>
                        <div class="field-group">
                            <label class="field-label" for="correoReset">Correo electrónico</label>
                            <div class="field-wrap">
                                <span class="field-icon">✉</span>
                                <input type="email" class="field-control" id="correoReset"
                                       placeholder="tu@correo.com" required autocomplete="email">
                            </div>
                        </div>
                        <button type="submit" class="btn-main" id="btnEnviarReset">
                            <span class="spinner"></span>
                            <span class="btn-text">Enviar contraseña temporal →</span>
                        </button>
                    </form>

                    <button type="button" id="btnVolverLogin"
                            style="width:100%;margin-top:12px;background:none;border:none;color:var(--muted);font-size:.85rem;cursor:pointer;padding:8px">
                        ← Volver al inicio de sesión
                    </button>
                </div>

            </div><!-- /card-body -->
            <!-- FOOTER -->
            <div class="card-footer-custom" style="justify-content:center">
                <a href="#" class="footer-link" id="linkOlvide">¿Olvidaste tu contraseña?</a>
            </div>

        </div><!-- /card-shell -->
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Interceptor CSRF — agrega el token antiforgery a toda petición AJAX que modifique datos -->
    <script>
        (function () {
            var token = $('input[name="__RequestVerificationToken"]').val();
            $(document).ajaxSend(function (event, jqxhr, settings) {
                var metodo = (settings.type || 'GET').toUpperCase();
                if (metodo !== 'GET' && token) {
                    jqxhr.setRequestHeader('RequestVerificationToken', token);
                }
            });
        })();
    </script>

    <script src="@Url.Content("~/Scripts/Views/Index_login.js?v=" + DateTime.Now.Ticks)"></script>
</body>
</html>
