@{
    Layout = null;
}
<div class="container mt-5">
    <h3>Cambiar contraseña</h3>
    <form method="post" action="@Url.Action("CambiarPassword","Login")">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label>Nueva Contraseña</label>
            <input type="password" class="form-control" name="nuevaClave" required />
        </div>
        <button type="submit" class="btn btn-primary">Guardar</button>
    </form>
</div>