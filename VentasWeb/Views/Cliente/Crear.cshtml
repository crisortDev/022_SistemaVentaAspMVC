@{
    ViewBag.Title = "Crear";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Clientes</a></li>
        <li class="breadcrumb-item active" aria-current="page">Registrar</li>
    </ol>
</nav>

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-header bg-info text-white">
                Lista de Clientes
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-4">
                        <button type="button" class="btn btn-sm btn-success" onclick="abrirPopUpForm(null)">
                            <i class="fa fa-plus" aria-hidden="true"></i> Agregar Nuevo
                        </button>
                    </div>
                </div>
                <hr />
                <div class="row mt-3">
                    <div class="col-sm-12">
                        <div style="overflow-x:auto;">
                            <table id="tbdata" class="table table-striped table-bordered nowrap" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>Tipo Documento</th>
                                        <th>Numero Documento</th>
                                        <th>Nombre</th>
                                        <th>Direccion</th>
                                        <th>Telefono</th>
                                        <th>Ciudad</th>
                                        <th>Barrio</th>
                                        <th>Calle</th>
                                        <th>Numero Casa</th>
                                        <th>Referencia</th>
                                        <th>Geolocalizacion</th>
                                        <th>Estado</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer">
            </div>
        </div>
    </div>
</div>

<!-- Modal para formulario Cliente -->
<div class="modal fade" id="FormModal" tabindex="-1" role="dialog" data-backdrop="static" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="exampleModalLabel">Cliente</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="form">
                    <input id="txtid" class="model" value="0" type="hidden" />
                    <div class="form-group row">
                        <label for="cboclientetipodocumento" class="col-sm-2 col-form-label col-form-label-sm">Tipo Documento</label>
                        <div class="col-sm-10">
                            <select class="form-control form-control-sm model" id="cboclientetipodocumento">
                                <option value="DNI">CI</option>
                                <option value="Carnet Extranjeria">Carnet Extranjeria</option>
                                <option value="RUC">RUC</option>
                                <option value="CI">CI</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="txtNumeroDocumento" class="col-sm-2 col-form-label col-form-label-sm">Numero Documento <span class="error"></span></label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control form-control-sm required" id="txtNumeroDocumento" name="numerodocumento" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="txtNombres" class="col-sm-2 col-form-label col-form-label-sm">Nombres <span class="error"></span></label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control form-control-sm required" id="txtNombres" name="nombres" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="txtDireccion" class="col-sm-2 col-form-label col-form-label-sm">Direccion <span class="error"></span></label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control form-control-sm required" id="txtDireccion" name="direccion" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="txtTelefono" class="col-sm-2 col-form-label col-form-label-sm">Telefono <span class="error"></span></label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control form-control-sm required" id="txtTelefono" name="telefono" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="txtCiudad" class="col-sm-2 col-form-label col-form-label-sm">Ciudad</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control form-control-sm" id="txtCiudad" name="Ciudad" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="txtBarrio" class="col-sm-2 col-form-label col-form-label-sm">Barrio</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control form-control-sm" id="txtBarrio" name="Barrio" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="txtCalle" class="col-sm-2 col-form-label col-form-label-sm">Calle</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control form-control-sm" id="txtCalle" name="Calle" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="txtNumeroCasa" class="col-sm-2 col-form-label col-form-label-sm">Numero Casa</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control form-control-sm" id="txtNumeroCasa" name="NumeroCasa" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="txtReferencia" class="col-sm-2 col-form-label col-form-label-sm">Referencia</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control form-control-sm" id="txtReferencia" name="Referencia" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="cboEstado" class="col-sm-2 col-form-label col-form-label-sm">Activo</label>
                        <div class="col-sm-10">
                            <select class="form-control form-control-sm model" id="cboEstado" name="Activo">
                                <option value="1">Activo</option>
                                <option value="0">No Activo</option>
                            </select>
                        </div>
                    </div>

                    <!-- Geolocalización con mapa -->
                    <div class="form-group row">
                        <label for="txtGeolocalizacion" class="col-sm-2 col-form-label col-form-label-sm">Geolocalización <span class="error"></span></label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control form-control-sm model" id="txtGeolocalizacion" name="Geolocalizacion" readonly />
                            <div style="margin-top: 10px;">
                                <button type="button" class="btn btn-primary btn-sm" onclick="abrirMapa()">Seleccionar Ubicación</button>
                            </div>
                            <div id="mapForm" style="height: 300px; margin-top: 10px; display:none;"></div>
                        </div>
                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-danger" data-dismiss="modal">Cerrar</button>
                <button id="btnGuardarCambios" type="button" class="btn btn-sm btn-primary" onclick="Guardar()">Guardar</button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script src="@Url.Content("~/Scripts/Views/Cliente_Crear.js")" type="text/javascript"></script>

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.3/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.3/dist/leaflet.js"></script>
}
