
@{
    ViewBag.Title = "Crear";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Ventas</a></li>
        <li class="breadcrumb-item active" aria-current="page">Tiendas</li>
    </ol>
</nav>


<div class="row">
    <div class="col-sm-12">
        <div class="card border-info">
            <div class="card-header bg-info text-white">
                Lista Tiendas
            </div>
            <div class="card-body">
                @{
                    bool esSuperAdminTienda = Session["EsSuperAdmin"] is bool sa && sa;
                }
                <input type="hidden" id="hdnSoloLectura" value="@(esSuperAdminTienda ? "0" : "1")" />
                <div class="row">
                    <div class="col-sm-4">
                        @if (esSuperAdminTienda)
                        {
                            <button type="button" class="btn btn-sm btn-success" onclick="abrirPopUpForm(null)"><i class="fa fa-plus" aria-hidden="true"></i>  Agregar Nuevo</button>
                        }
                        else
                        {
                            <span class="badge badge-info"><i class="fas fa-eye mr-1"></i> Solo consulta — las tiendas son administradas por el SuperAdmin.</span>
                        }
                    </div>
                </div>
                <hr />
                <div class="row mt-3">
                    <div class="col-sm-12">
                        <table id="tbTienda" class="table table-striped table-bordered nowrap compact" style="width:100%">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>RUC</th>
                                    <th>Direccion</th>
                                    <th>Telefono</th>
                                    <th>Estado</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Ver (solo lectura) -->
<div class="modal fade" id="VerModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fa fa-eye mr-1"></i> Detalle de Tienda</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="form-group row mb-2">
                    <label class="col-sm-4 col-form-label font-weight-bold text-muted small">ID</label>
                    <div class="col-sm-8"><p class="form-control-plaintext ver-text" id="verId"></p></div>
                </div>
                <div class="form-group row mb-2">
                    <label class="col-sm-4 col-form-label font-weight-bold text-muted small">Nombre</label>
                    <div class="col-sm-8"><p class="form-control-plaintext ver-text font-weight-bold" id="verNombre"></p></div>
                </div>
                <div class="form-group row mb-2">
                    <label class="col-sm-4 col-form-label font-weight-bold text-muted small">RUC</label>
                    <div class="col-sm-8"><p class="form-control-plaintext ver-text" id="verRuc"></p></div>
                </div>
                <div class="form-group row mb-2">
                    <label class="col-sm-4 col-form-label font-weight-bold text-muted small">Dirección</label>
                    <div class="col-sm-8"><p class="form-control-plaintext ver-text" id="verDireccion"></p></div>
                </div>
                <div class="form-group row mb-2">
                    <label class="col-sm-4 col-form-label font-weight-bold text-muted small">Teléfono</label>
                    <div class="col-sm-8"><p class="form-control-plaintext ver-text" id="verTelefono"></p></div>
                </div>
                <div class="form-group row mb-0">
                    <label class="col-sm-4 col-form-label font-weight-bold text-muted small">Estado</label>
                    <div class="col-sm-8 d-flex align-items-center"><span id="verEstado"></span></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal">
                    <i class="fa fa-times"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="FormModal" tabindex="-1" role="dialog" data-backdrop="static" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="exampleModalLabel">Tienda</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="form">
                    <input id="txtid" class="model" name="IdUsuario" value="0" type="hidden" />
                    <div class="form-group row">
                        <label for="staticEmail" class="col-sm-2 col-form-label col-form-label-sm">Nombre <span class="error"></span></label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control form-control-sm model" id="txtNombre" name="RazonSocial">
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="staticEmail" class="col-sm-2 col-form-label col-form-label-sm">Ruc <span class="error"></span></label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control form-control-sm model" id="txtRuc" name="RUC">
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="inputPassword" class="col-sm-2 col-form-label col-form-label-sm">Direccion <span class="error"></span></label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control form-control-sm model" id="txtDireccion" name="Direccion">
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="staticEmail" class="col-sm-2 col-form-label col-form-label-sm">Telefono <span class="error"></span></label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control form-control-sm model" id="txtTelefono" name="Telefono">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="inputPassword" class="col-sm-2 col-form-label col-form-label-sm">Activo</label>
                        <div class="col-sm-10">
                            <select class="form-control form-control-sm model" id="cboEstado" name="Activo">
                                <option value="1">Activo</option>
                                <option value="0">No Activo</option>
                            </select>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-danger" data-dismiss="modal">Cerrar</button>
                <button id="btnGuardarCambios" type="button" class="btn btn-sm btn-primary" onclick="Guardar()">Guardar Cambios</button>
            </div>
        </div>
    </div>
</div>


@section scripts{
    <script src="@Url.Content("~/Scripts/Views/Tienda_Crear.js?v=" + DateTime.Now.Ticks)"></script>
}

