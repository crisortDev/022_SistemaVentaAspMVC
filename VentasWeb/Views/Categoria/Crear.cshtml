@{
    ViewBag.Title = "Categorías";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.5/css/dataTables.bootstrap4.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.4.1/css/responsive.bootstrap4.min.css" />

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Mantenedor</a></li>
        <li class="breadcrumb-item active">Categorías</li>
    </ol>
</nav>

<div class="card border-info">
    <div class="card-header bg-info text-white">
        <i class="fa fa-tags mr-1"></i> Lista de Categorías
    </div>
    <div class="card-body">

        <button type="button" class="btn btn-sm btn-success mb-3" onclick="abrirPopUpForm(null)">
            <i class="fa fa-plus"></i> Agregar Nueva
        </button>

        <div class="table-responsive">
            <table id="tbdata" class="table table-striped table-bordered table-sm" style="width:100%">
                <thead class="thead-light">
                    <tr>
                        <th>Descripción</th>
                        <th style="width:110px">% Ganancia</th>
                        <th style="width:90px">Unidad</th>
                        <th style="width:110px">Desc. Máx.</th>
                        <th style="width:90px">Estado</th>
                        <th style="width:130px">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

    </div>
</div>

<!-- ══════════ MODAL VER (solo lectura) ══════════ -->
<div class="modal fade" id="VerModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fa fa-eye mr-1"></i> Detalle de Categoría</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="form-group row mb-2">
                    <label class="col-sm-5 col-form-label font-weight-bold text-muted small">Descripción</label>
                    <div class="col-sm-7"><p class="form-control-plaintext ver-text font-weight-bold" id="verDescripcion"></p></div>
                </div>
                <div class="form-group row mb-2">
                    <label class="col-sm-5 col-form-label font-weight-bold text-muted small">% Ganancia</label>
                    <div class="col-sm-7">
                        <p class="form-control-plaintext ver-text">
                            <span id="verPorcentaje"></span>
                            <span class="text-muted">%</span>
                        </p>
                    </div>
                </div>
                <div class="form-group row mb-2">
                    <label class="col-sm-5 col-form-label font-weight-bold text-muted small">Unidad de Medida</label>
                    <div class="col-sm-7"><p class="form-control-plaintext ver-text" id="verUnidadMedida"></p></div>
                </div>
                <div class="form-group row mb-2">
                    <label class="col-sm-5 col-form-label font-weight-bold text-muted small">Desc. Máx. Permitido</label>
                    <div class="col-sm-7">
                        <p class="form-control-plaintext ver-text">
                            <span id="verDescuentoMax"></span>
                            <span class="text-muted">%</span>
                        </p>
                    </div>
                </div>
                <div class="form-group row mb-2">
                    <label class="col-sm-5 col-form-label font-weight-bold text-muted small">Estado</label>
                    <div class="col-sm-7 d-flex align-items-center"><span id="verEstado"></span></div>
                </div>

                <!-- ── Auditoría ── -->
                <hr class="my-2" />
                <p class="text-muted small mb-1 font-weight-bold">Auditoría</p>
                <div class="form-group row mb-2">
                    <label class="col-sm-5 col-form-label font-weight-bold text-muted small">Últ. modificación</label>
                    <div class="col-sm-7"><p class="form-control-plaintext ver-text small" id="verFechaModificacion"></p></div>
                </div>
                <div class="form-group row mb-0">
                    <label class="col-sm-5 col-form-label font-weight-bold text-muted small">Usuario</label>
                    <div class="col-sm-7"><p class="form-control-plaintext ver-text small" id="verUsuarioModificacion"></p></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal">
                    <i class="fa fa-times"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ══════════ MODAL EDITAR / CREAR ══════════ -->
<div class="modal fade" id="FormModal" tabindex="-1" role="dialog"
     data-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="tituloModal">
                    <i class="fa fa-tag mr-1"></i> Categoría
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <form id="form" novalidate>
                    <input id="txtid" name="IdCategoria" value="0" type="hidden" />

                    <div class="form-group">
                        <label for="txtDescripcion" class="font-weight-bold">
                            Descripción <span class="text-danger">*</span>
                        </label>
                        <input type="text" class="form-control form-control-sm"
                               id="txtDescripcion" name="Descripcion"
                               maxlength="50" placeholder="Ej: ELECTRÓNICA" autocomplete="off">
                        <small class="text-muted">Máx. 50 caracteres</small>
                    </div>

                    <div class="form-group">
                        <label for="txtPorcentaje" class="font-weight-bold">
                            % Ganancia
                            <small class="text-muted font-weight-normal">(opcional)</small>
                        </label>
                        <div class="input-group input-group-sm">
                            <input type="number" class="form-control form-control-sm"
                                   id="txtPorcentaje" name="PorcentajeGanancia"
                                   min="0" max="999.99" step="0.01"
                                   placeholder="0.00">
                            <div class="input-group-append">
                                <span class="input-group-text">%</span>
                            </div>
                        </div>
                        <small class="text-muted">
                            Ej: 25 → precio venta = costo × 1.25
                        </small>
                    </div>

                    <div class="form-group">
                        <label for="cboUnidadMedida" class="font-weight-bold">Unidad de Medida</label>
                        <select class="form-control form-control-sm" id="cboUnidadMedida" name="UnidadMedida">
                            <option value="Unidad">Unidad</option>
                            <option value="Metro">Metro</option>
                            <option value="Kg">Kilogramo (Kg)</option>
                            <option value="Litro">Litro</option>
                        </select>
                        <small class="text-muted">Define cómo se contabiliza la cantidad al vender.</small>
                    </div>

                    <div class="form-group">
                        <label for="txtDescuentoMax" class="font-weight-bold">
                            % Descuento Máximo Permitido
                            <small class="text-muted font-weight-normal">(opcional)</small>
                        </label>
                        <div class="input-group input-group-sm">
                            <input type="number" class="form-control form-control-sm"
                                   id="txtDescuentoMax" name="DescuentoMaxPermitido"
                                   min="0" max="100" step="0.01" placeholder="0.00">
                            <div class="input-group-append">
                                <span class="input-group-text">%</span>
                            </div>
                        </div>
                        <small class="text-muted">Al superar este % en una venta, el sistema emite advertencia.</small>
                    </div>

                    <div class="form-group">
                        <label for="cboEstado" class="font-weight-bold">Estado</label>
                        <select class="form-control form-control-sm" id="cboEstado" name="Activo">
                            <option value="1">Activo</option>
                            <option value="0">Inactivo</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer d-flex justify-content-between align-items-center">
                <!-- Botón toggle estado — solo visible al editar -->
                <button type="button" id="btnToggleEstado" class="btn btn-sm d-none"
                        onclick="toggleEstadoDesdeModal()">
                </button>
                <div>
                    <button type="button" class="btn btn-sm btn-secondary mr-1" data-dismiss="modal">
                        <i class="fa fa-times"></i> Cerrar
                    </button>
                    <button type="button" class="btn btn-sm btn-primary" onclick="Guardar()">
                        <i class="fa fa-save"></i> Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.datatables.net/responsive/2.4.1/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.4.1/js/responsive.bootstrap4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="@Url.Content("~/Scripts/Views/Categoria_Crear.js?v=" + DateTime.Now.Ticks)" type="text/javascript"></script>
}
