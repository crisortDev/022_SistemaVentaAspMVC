@{
    ViewBag.Title = "Crear Usuario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Mantenedor</a></li>
        <li class="breadcrumb-item active" aria-current="page">Usuarios</li>
    </ol>
</nav>

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-header bg-info text-white">
                Lista de Usuarios
            </div>
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-sm-4">
                        <button type="button" class="btn btn-sm btn-success" onclick="abrirPopUpForm(null)">
                            <i class="fa fa-plus" aria-hidden="true"></i> Agregar Nuevo
                        </button>
                    </div>
                </div>

                <table id="tbdata" class="table table-striped table-bordered nowrap compact" style="width:100%">
                    <thead>
                        <tr>
                            <th>Rol</th>
                            <th>Nombres</th>
                            <th>Apellidos</th>
                            <th>Correo</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<!-- Modal -->
<div class="modal fade" id="FormModal" tabindex="-1" role="dialog" data-backdrop="static" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="modalTitle">Usuario</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info mb-2">
                    Nota: Al crear un usuario, debes asociarlo a un empleado existente.
                </div>

                <form id="form">
                    <input id="txtid" type="hidden" value="0" />

                    <!-- Empleado (Solo para creación) -->
                    <div class="form-group row" id="empleadoGroup">
                        <label class="col-sm-3 col-form-label col-form-label-sm">Empleado *</label>
                        <div class="col-sm-9">
                            <div class="input-group">
                                <input type="text" id="txtCIEmpleado" class="form-control form-control-sm" placeholder="Ingrese CI o RUC">
                                <div class="input-group-append">
                                    <button type="button" id="btnBuscarEmpleado" class="btn btn-primary btn-sm">Buscar</button>
                                </div>
                            </div>
                            <select id="cboEmpleado" class="form-control form-control-sm mt-2" name="IdEmpleado" required>
                                <option value="">Seleccione un empleado</option>
                            </select>
                            <small class="text-muted">Busque por CI o RUC para cargar el empleado</small>
                        </div>
                    </div>

                    <!-- Campos del usuario -->
                    <div id="camposUsuario" style="display: none;">
                        <!-- Persona física -->
                        <div class="form-group row" id="fisicaGroup">
                            <label class="col-sm-3 col-form-label col-form-label-sm">Nombres *</label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control form-control-sm" id="txtNombres" name="Nombres" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group row" id="fisicaApellidosGroup">
                            <label class="col-sm-3 col-form-label col-form-label-sm">Apellidos *</label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control form-control-sm" id="txtApellidos" name="Apellidos" maxlength="50">
                            </div>
                        </div>

                        <!-- Persona jurídica -->
                        <div class="form-group row" id="razonSocialGroup" style="display:none;">
                            <label class="col-sm-3 col-form-label col-form-label-sm">Razón Social *</label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control form-control-sm" id="txtRazonSocial" name="RazonSocial" maxlength="100">
                            </div>
                        </div>

                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label col-form-label-sm">CI / RUC *</label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control form-control-sm" id="txtCI" name="CI" maxlength="15">
                            </div>
                        </div>

                        <!-- Clave opcional, solo para edición -->
                        <div class="form-group row" id="claveGroup" style="display:none;">
                            <label class="col-sm-3 col-form-label col-form-label-sm">Contraseña *</label>
                            <div class="col-sm-9">
                                <input type="password" class="form-control form-control-sm" id="txtClave" name="Clave" maxlength="8">
                                <small class="text-muted">Será definida por el usuario tras confirmar OTP</small>
                            </div>
                        </div>
                    </div>

                    <!-- Correo, Tienda, Rol, Estado -->
                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label col-form-label-sm">Correo *</label>
                        <div class="col-sm-9">
                            <input type="email" class="form-control form-control-sm" id="txtCorreo" name="Correo" maxlength="50">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label col-form-label-sm">Tienda *</label>
                        <div class="col-sm-9">
                            <select class="form-control form-control-sm" id="cboTienda" name="IdTienda" required>
                                <option value="">Seleccione una tienda</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label col-form-label-sm">Rol *</label>
                        <div class="col-sm-9">
                            <select class="form-control form-control-sm" id="cboRol" name="IdRol" required>
                                <option value="">Seleccione un rol</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label col-form-label-sm">Estado</label>
                        <div class="col-sm-9">
                            <select class="form-control form-control-sm" id="cboEstado" name="Activo">
                                <option value="1">Activo</option>
                                <option value="0">Inactivo</option>
                            </select>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-danger" data-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-sm btn-primary" onclick="Guardar()">Guardar</button>
            </div>
        </div>
    </div>
</div>


@section scripts{
    <script src="@Url.Content("~/Scripts/jquery.validate.min.js")"></script>
    <script src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>
    <script src="@Url.Content("~/Scripts/Views/Usuario_Crear.js")?v=@DateTime.Now.Ticks" type="text/javascript"></script>
}
