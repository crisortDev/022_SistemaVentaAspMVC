@{
    ViewBag.Title = "Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Mantenedor</a></li>
        <li class="breadcrumb-item active" aria-current="page">Usuarios</li>
    </ol>
</nav>

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.5/css/dataTables.bootstrap4.min.css" />
<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />

<style>
    /* Campos bloqueados tras búsqueda — visualmente distintos pero legibles */
    .campo-bloqueado {
        background-color: #f8f9fa !important;
        color: #495057 !important;
        border-color: #ced4da !important;
        cursor: not-allowed;
    }
</style>

<div class="row">
    <div class="col-sm-12">
        <div class="card border-info">
            <div class="card-header bg-info text-white">
                Lista de Usuarios
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-2">
                        <button type="button" id="btnAgregarUsuario" class="btn btn-sm btn-success">
                            <i class="fa fa-plus" aria-hidden="true"></i> Agregar Nuevo
                        </button>
                    </div>
                </div>
                <hr />
                <div class="row mt-3">
                    <div class="col-sm-12">
                        <table id="tbUsuarios" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>Nombres</th>
                                    <th>Apellidos</th>
                                    <th>Correo</th>
                                    <th>Rol</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════ -->
<!--  MODAL — Ver Usuario (solo lectura)                  -->
<!-- ═══════════════════════════════════════════════════ -->
<div class="modal fade" id="VerModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fa fa-eye mr-1"></i> Detalle de Usuario</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="form-group row mb-2">
                    <label class="col-sm-5 col-form-label font-weight-bold text-muted small">Nombres</label>
                    <div class="col-sm-7"><p class="form-control-plaintext ver-text font-weight-bold" id="verNombres"></p></div>
                </div>
                <div class="form-group row mb-2">
                    <label class="col-sm-5 col-form-label font-weight-bold text-muted small">Apellidos</label>
                    <div class="col-sm-7"><p class="form-control-plaintext ver-text" id="verApellidos"></p></div>
                </div>
                <div class="form-group row mb-2">
                    <label class="col-sm-5 col-form-label font-weight-bold text-muted small">Correo</label>
                    <div class="col-sm-7"><p class="form-control-plaintext ver-text small" id="verCorreo"></p></div>
                </div>
                <div class="form-group row mb-2">
                    <label class="col-sm-5 col-form-label font-weight-bold text-muted small">Rol</label>
                    <div class="col-sm-7"><p class="form-control-plaintext ver-text" id="verRol"></p></div>
                </div>
                <div class="form-group row mb-0">
                    <label class="col-sm-5 col-form-label font-weight-bold text-muted small">Estado</label>
                    <div class="col-sm-7 d-flex align-items-center"><span id="verEstado"></span></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal">
                    <i class="fa fa-times"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════ -->
<!--  MODAL — Crear Usuario                              -->
<!-- ═══════════════════════════════════════════════════ -->
<div class="modal fade" id="FormUsuario" tabindex="-1" role="dialog"
     data-backdrop="static" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">

            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">Nuevo Usuario</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">

                <!-- Nota informativa -->
                <div class="alert alert-info py-2 mb-3">
                    <small>
                        <i class="fa fa-info-circle"></i>
                        Al crear un usuario, debes asociarlo a un empleado existente.
                    </small>
                </div>

                <form id="formUsuario" autocomplete="off">

                    <!-- ID oculto del empleado seleccionado -->
                    <input type="hidden" id="txtIdEmpleadoUsuario" value="0" />

                    <!-- ── Buscar Empleado ─────────────────────── -->
                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label">
                            Empleado <span class="text-danger">*</span>
                        </label>
                        <div class="col-sm-6">
                            <input type="text"
                                   class="form-control form-control-sm"
                                   id="txtDocumentoUsuario"
                                   name="documento"
                                   placeholder="Ingrese CI o RUC" />
                        </div>
                        <div class="col-sm-3">
                            <button type="button" id="btnBuscarEmpleado"
                                    class="btn btn-sm btn-info btn-block">
                                <i class="fa fa-search"></i> Buscar
                            </button>
                        </div>
                    </div>

                    <!-- ── Nombres — readonly tras búsqueda ───── -->
                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label">
                            Nombres <span class="text-danger">*</span>
                        </label>
                        <div class="col-sm-9">
                            <input type="text"
                                   class="form-control form-control-sm"
                                   id="txtNombresUsuario"
                                   readonly />
                        </div>
                    </div>

                    <!-- ── Apellidos — readonly tras búsqueda ─── -->
                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label">
                            Apellidos <span class="text-danger">*</span>
                        </label>
                        <div class="col-sm-9">
                            <input type="text"
                                   class="form-control form-control-sm"
                                   id="txtApellidosUsuario"
                                   readonly />
                        </div>
                    </div>

                    <!-- ── CI / RUC — readonly, se rellena al buscar ── -->
                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label">
                            CI / RUC <span class="text-danger">*</span>
                        </label>
                        <div class="col-sm-9">
                            <input type="text"
                                   class="form-control form-control-sm"
                                   id="txtCIRUCUsuario"
                                   readonly />
                        </div>
                    </div>

                    <!-- ── Correo — readonly, viene de Persona ── -->
                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label">
                            Correo <span class="text-danger">*</span>
                        </label>
                        <div class="col-sm-9">
                            <input type="email"
                                   class="form-control form-control-sm"
                                   id="txtCorreoUsuario"
                                   readonly />
                            <small class="text-muted">
                                <i class="fa fa-lock"></i>
                                Correo registrado en Persona — será utilizado para el inicio de sesión
                            </small>
                        </div>
                    </div>

                    <!-- ── Tienda ─────────────────────────────── -->
                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label">
                            Tienda <span class="text-danger">*</span>
                        </label>
                        <div class="col-sm-9">
                            <select id="cboTiendaUsuario" name="idTienda"
                                    class="form-control form-control-sm">
                                <option value="">-- Seleccione Tienda --</option>
                            </select>
                        </div>
                    </div>

                    <!-- ── Rol ───────────────────────────────── -->
                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label">
                            Rol <span class="text-danger">*</span>
                        </label>
                        <div class="col-sm-9">
                            <select id="cboRolUsuario" name="idRol"
                                    class="form-control form-control-sm">
                                <option value="">-- Seleccione Rol --</option>
                            </select>
                        </div>
                    </div>

                    <!-- ── Estado — selector con default Activo ─ -->
                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label">Estado</label>
                        <div class="col-sm-9">
                            <select id="ddlEstadoUsuario"
                                    class="form-control form-control-sm">
                                <option value="1" selected>Activo</option>
                                <option value="0">Inactivo</option>
                            </select>
                        </div>
                    </div>

                    <!-- NOTA: El campo Contraseña fue eliminado.
                         La contraseña es definida por el usuario al confirmar el OTP
                         enviado a su correo tras la creación de la cuenta. -->

                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-danger"
                        data-dismiss="modal">
                    Cerrar
                </button>
                <button type="button" id="btnGuardarUsuario"
                        class="btn btn-sm btn-primary">
                    Guardar
                </button>
            </div>

        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Esto ya está bien — DateTime.Now.Ticks cambia en cada request -->
    <script src="@Url.Content("~/Scripts/Views/Usuario_Crear.js?v=" + DateTime.Now.Ticks)"></script>
}
