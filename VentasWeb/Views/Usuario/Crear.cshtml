@{
    ViewBag.Title = "Crear Usuario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Mantenedor</a></li>
        <li class="breadcrumb-item active" aria-current="page">Usuarios</li>
    </ol>
</nav>

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-header bg-info text-white">
                Lista de Usuarios
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-4">
                        <button type="button" class="btn btn-sm btn-success" onclick="abrirPopUpForm(null)">
                            <i class="fa fa-plus" aria-hidden="true"></i> Agregar Nuevo
                        </button>
                    </div>
                </div>
                <hr />
                <div class="row mt-3">
                    <div class="col-sm-12">
                        <table id="tbdata" class="table table-striped table-bordered nowrap compact" style="width:100%">
                            <thead>
                                <tr>
                                    <th>Rol</th>
                                    <th>Nombres</th>
                                    <th>Apellidos</th>
                                    <th>Correo</th>
                                    <th>Estado</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="card-footer"></div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="FormModal" tabindex="-1" role="dialog" data-backdrop="static" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">Usuario</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info mb-2">
                    Nota: Al crear un usuario, si la cédula ingresada no existe, se registrará automáticamente como empleado.
                </div>

                <form id="form">
                    <input id="txtid" type="hidden" value="0" />

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label col-form-label-sm">Nombres</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control form-control-sm" id="txtNombres" name="Nombres" maxlength="50">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label col-form-label-sm">Apellidos</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control form-control-sm" id="txtApellidos" name="Apellidos" maxlength="50">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label col-form-label-sm">Cédula</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control form-control-sm" id="txtCI" name="CI" maxlength="15" readonly>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label col-form-label-sm">Correo</label>
                        <div class="col-sm-10">
                            <input type="email" class="form-control form-control-sm" id="txtCorreo" name="Correo" maxlength="30">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label col-form-label-sm">Contraseña</label>
                        <div class="col-sm-10">
                            <input type="password" class="form-control form-control-sm" id="txtClave" name="Clave" maxlength="8">
                            <small class="text-muted">Entre 6 y 8 caracteres</small>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label col-form-label-sm">Tienda</label>
                        <div class="col-sm-10">
                            <select class="form-control form-control-sm" id="cboTienda" name="Tienda"></select>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label col-form-label-sm">Rol</label>
                        <div class="col-sm-10">
                            <select class="form-control form-control-sm" id="cboRol" name="Rol"></select>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label col-form-label-sm">Activo</label>
                        <div class="col-sm-10">
                            <select class="form-control form-control-sm" id="cboEstado" name="Activo">
                                <option value="1">Activo</option>
                                <option value="0">No Activo</option>
                            </select>
                        </div>
                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-danger" data-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-sm btn-primary" onclick="Guardar()">Guardar</button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script src="@Url.Content("~/Scripts/Views/Usuario_Crear.js")?v=@DateTime.Now.Ticks" type="text/javascript"></script>
}
