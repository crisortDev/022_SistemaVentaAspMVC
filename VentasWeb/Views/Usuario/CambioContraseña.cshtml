@{
    ViewBag.Title = "Cambio de Contraseña";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Configuración</a></li>
        <li class="breadcrumb-item active" aria-current="page">Cambio de Contraseña</li>
    </ol>
</nav>

<div class="row">
    <div class="col-sm-6 offset-sm-3">
        <div class="card">
            <div class="card-header bg-info text-white">
                Cambiar Contraseña
            </div>
            <div class="card-body">
                <form id="formCambioClave">
                    @* Input oculto con ID de usuario *@
                    <input type="hidden" id="UsuarioId" value="@((Session["Usuario"] as CapaModelo.Usuario)?.IdUsuario ?? 0)" />

                    <div class="form-group">
                        <label>Contraseña Actual</label>
                        <input type="password" class="form-control form-control-sm" id="txtClaveActual" />
                    </div>
                    <div class="form-group">
                        <label>Nueva Contraseña</label>
                        <input type="password" class="form-control form-control-sm" id="txtClaveNueva" />
                    </div>
                    <div class="form-group">
                        <label>Confirmar Contraseña</label>
                        <input type="password" class="form-control form-control-sm" id="txtClaveConfirmar" />
                    </div>
                </form>
            </div>
            <div class="card-footer text-right">
                <button type="button" class="btn btn-sm btn-primary" onclick="GuardarCambio()">Guardar</button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script src="@Url.Content("~/Scripts/Views/Usuario_Contrasena.js?v=" + DateTime.Now.Ticks) type="text/javascript"></script>
}
