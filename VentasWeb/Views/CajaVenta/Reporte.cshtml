@{
    ViewBag.Title = "Reporte de Caja";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int idCaja = ViewBag.IdCaja ?? 0;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="@Url.Action("Index","CajaVenta")">Caja de Ventas</a></li>
        <li class="breadcrumb-item active">Reporte de Caja #@idCaja</li>
    </ol>
</nav>

<div class="card mb-3">
    <div class="card-header bg-primary text-white py-2">
        <i class="fas fa-chart-bar mr-1"></i> Reporte de Caja &mdash; Operación por Operación
        <button class="btn btn-outline-light btn-sm float-right" onclick="window.print()">
            <i class="fas fa-print"></i> Imprimir
        </button>
    </div>
    <div class="card-body p-3">

        <!-- Resumen por forma de cobro -->
        <div class="row mb-3" id="resumenFormas"></div>

        <!-- Total general -->
        <div class="d-flex justify-content-end mb-3">
            <div class="border border-primary p-2 text-right" style="min-width:250px;">
                <div class="text-muted small">TOTAL VENTAS ACTIVAS</div>
                <div class="font-weight-bold text-primary" style="font-size:22px;" id="lblTotalReporte">Gs. 0</div>
            </div>
        </div>

        <!-- Detalle operación por operación -->
        <div class="section-title mb-2 font-weight-bold">Detalle de Operaciones</div>
        <div class="table-responsive">
            <table class="table table-bordered table-sm table-striped" id="tbReporte" style="width:100%">
                <thead class="thead-dark">
                    <tr>
                        <th>#</th>
                        <th>Fecha/Hora</th>
                        <th>Nº Factura</th>
                        <th>Cliente</th>
                        <th>Forma Cobro</th>
                        <th class="text-right">Monto (Gs.)</th>
                        <th class="text-right">Recibido (Gs.)</th>
                        <th class="text-right">Cambio (Gs.)</th>
                        <th>Cajero</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody id="tbodyReporte"></tbody>
                <tfoot>
                    <tr class="font-weight-bold bg-light">
                        <td colspan="5" class="text-right">TOTAL:</td>
                        <td class="text-right" id="tfTotalReporte">Gs. 0</td>
                        <td colspan="4"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<input type="hidden" id="hdnIdCajaReporte" value="@idCaja" />

@section scripts {
    <script src="@Url.Content("~/Scripts/Views/CajaVenta_Reporte.js?v=" + DateTime.Now.Ticks)"></script>
}
