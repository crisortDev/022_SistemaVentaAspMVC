@{
    ViewBag.Title = "Gestión de Precios y Vigencias";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Precios</a></li>
        <li class="breadcrumb-item active" aria-current="page">Gestión de Precios y Vigencias</li>
    </ol>
</nav>

<div class="row">
    <div class="col-sm-12">
        <h3>Gestión de Precios y Vigencias</h3>

        <!-- Lista de productos con paginación -->
        <div class="card border-info mb-3">
            <div class="card-header bg-info text-white">
                Lista de Productos
            </div>
            <div class="card-body">
                <table id="tbProductos" class="table table-striped table-bordered nowrap compact" style="width:100%">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Nombre</th>
                            <th>Seleccionar</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Se llena dinámicamente -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Selección Producto (con búsqueda por código) -->
        <div class="card border-info mb-3">
            <div class="card-header bg-info text-white">
                Seleccionar Producto por Código
            </div>
            <div class="card-body">
                <div class="form-row align-items-end">
                    <input id="txtIdProducto" type="hidden" value="0" />
                    <div class="col-sm-3">
                        <label for="txtCodigo" class="col-form-label">Código</label>
                        <input type="text" class="form-control" id="txtCodigo" autocomplete="off" placeholder="Código producto">
                    </div>
                    <div class="col-sm-4">
                        <label for="txtNombre" class="col-form-label">Nombre</label>
                        <input type="text" class="form-control" id="txtNombre" readonly placeholder="Nombre producto">
                    </div>
                    <div class="col-sm-2">
                        <button id="btnBuscarProducto" class="btn btn-success btn-block" type="button">
                            <i class="fas fa-search"></i> Buscar
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Historial Precios con botón agregar y formulario para guardar múltiples -->
        <div class="card border-info mb-3">
            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                <span>Historial de Precios y Vigencias</span>
                <button id="btnAgregarPrecio" class="btn btn-success btn-sm">Agregar Precio</button>
            </div>
            <div class="card-body">
                <form id="formPrecios">
                    <table id="tbHistorialPrecios" class="table table-striped table-bordered nowrap compact" style="width:100%">
                        <thead>
                            <tr>
                                <th>Precio</th>
                                <th>Fecha Inicio Vigencia</th>
                                <th>Fecha Fin Vigencia</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Filas dinámicas cargadas por JS -->
                        </tbody>
                    </table>
                    <button type="submit" class="btn btn-primary">Guardar Todos Cambios</button>
                </form>
            </div>
        </div>

    </div>
</div>

<!-- Modal Editar Precio -->
<div class="modal fade" id="modalEditarPrecio" tabindex="-1" role="dialog" aria-labelledby="modalEditarPrecioLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <form id="formEditarPrecio">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalEditarPrecioLabel">Editar Precio</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editIdPrecioVenta" name="IdPrecioVenta" />

                    <div class="form-group">
                        <label for="editPrecioVenta">Precio</label>
                        <input type="number" min="0" step="0.01" class="form-control" id="editPrecioVenta" name="PrecioUnidadVenta" required />
                    </div>
                    <div class="form-group">
                        <label for="editFechaInicio">Fecha Inicio Vigencia</label>
                        <input type="date" class="form-control" id="editFechaInicio" name="FechaInicioVigencia" required />
                    </div>
                    <div class="form-group">
                        <label for="editFechaFin">Fecha Fin Vigencia</label>
                        <input type="date" class="form-control" id="editFechaFin" name="FechaFinVigencia" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/Views/Precio_Venta.js")" type="text/javascript"></script>
}
