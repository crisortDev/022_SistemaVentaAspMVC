@{
    ViewBag.Title = "Consultar Órdenes de Compra";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Compras</a></li>
        <li class="breadcrumb-item active" aria-current="page">Consultar Órdenes de Compra</li>
    </ol>
</nav>

<div class="row">
    <div class="col-sm-12">
        <div class="card border-info">
            <div class="card-header bg-info text-white">
                Consultar Órdenes de Compra
            </div>
            <div class="card-body p-2">
                <div class="row align-items-end">
                    <div class="col-sm-2">
                        <div class="form-group mb-0">
                            <label class="col-form-label col-form-label-sm">Fecha Inicio:</label>
                            <input type="text" class="form-control form-control-sm" id="txtFechaInicio" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="form-group mb-0">
                            <label class="col-form-label col-form-label-sm">Fecha Fin:</label>
                            <input type="text" class="form-control form-control-sm" id="txtFechaFin" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="form-group mb-0">
                            <label class="col-form-label col-form-label-sm">Proveedor:</label>
                            <select class="form-control form-control-sm" id="cboProveedor"></select>
                        </div>
                    </div>
                    <div class="col-sm-2" id="divFiltroTienda">
                        <div class="form-group mb-0">
                            <label class="col-form-label col-form-label-sm">Tienda:</label>
                            <select class="form-control form-control-sm" id="cboTienda"></select>
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="form-group mb-0">
                            <label class="col-form-label col-form-label-sm">Estado:</label>
                            <select class="form-control form-control-sm" id="cboEstado">
                                <option value="">-- Todos --</option>
                                <option value="Pendiente">Pendiente</option>
                                <option value="Aprobada">Aprobada</option>
                                <option value="Rechazada">Rechazada</option>
                                <option value="Facturada">Facturada</option>
                                <option value="Cerrada">Cerrada</option>
                                <option value="Anulada">Anulada</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="form-group mb-0">
                            <button type="button" class="btn btn-sm btn-primary btn-block" onclick="buscar()">
                                <i class="fas fa-search"></i> Buscar
                            </button>
                        </div>
                    </div>
                </div>

                <hr />

                <div class="row mt-3">
                    <div class="col-sm-12">
                        <table id="tbOrdenes" class="table table-striped table-bordered nowrap compact" style="width:100%">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Nº Orden</th>
                                    <th>Proveedor</th>
                                    <th>Tienda</th>
                                    <th>Fecha Orden</th>
                                    <th>F. Entrega</th>
                                    <th>Total Estimado</th>
                                    <th>Estado</th>
                                    <th>Usuario</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script src="@Url.Content("~/Scripts/Views/OrdenCompra_Consultar.js?v=" + DateTime.Now.Ticks) type="text/javascript"></script>
}
