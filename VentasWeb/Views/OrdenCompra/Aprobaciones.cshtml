@{
    ViewBag.Title = "Aprobar Órdenes de Compra";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var motivosRechazo = ViewBag.MotivosRechazo as List<CapaModelo.MotivoRechazoOC> ?? new List<CapaModelo.MotivoRechazoOC>();
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Compras</a></li>
        <li class="breadcrumb-item active" aria-current="page">Aprobar Órdenes de Compra</li>
    </ol>
</nav>

<div class="row">
    <div class="col-sm-12">
        <div class="card border-warning">
            <div class="card-header bg-warning text-dark">
                <i class="fas fa-clipboard-check"></i> Órdenes de Compra Pendientes de Aprobación
            </div>
            <div class="card-body p-2">
                <div class="row align-items-end">
                    <div class="col-sm-2">
                        <div class="form-group mb-0">
                            <label class="col-form-label col-form-label-sm">Fecha Inicio:</label>
                            <input type="text" class="form-control form-control-sm" id="txtFechaInicio" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="form-group mb-0">
                            <label class="col-form-label col-form-label-sm">Fecha Fin:</label>
                            <input type="text" class="form-control form-control-sm" id="txtFechaFin" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="form-group mb-0">
                            <label class="col-form-label col-form-label-sm">Proveedor:</label>
                            <select class="form-control form-control-sm" id="cboProveedor"></select>
                        </div>
                    </div>
                    <div class="col-sm-2" id="divFiltroTienda">
                        <div class="form-group mb-0">
                            <label class="col-form-label col-form-label-sm">Tienda:</label>
                            <select class="form-control form-control-sm" id="cboTienda"></select>
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="form-group mb-0">
                            <button type="button" class="btn btn-sm btn-primary btn-block" onclick="buscar()">
                                <i class="fas fa-search"></i> Buscar
                            </button>
                        </div>
                    </div>
                </div>

                <hr />

                <div class="row mt-3">
                    <div class="col-sm-12">
                        <table id="tbOrdenes" class="table table-striped table-bordered nowrap compact" style="width:100%">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Nº Orden</th>
                                    <th>Proveedor</th>
                                    <th>Tienda</th>
                                    <th>Fecha Orden</th>
                                    <th>F. Entrega</th>
                                    <th>Total Estimado</th>
                                    <th>Usuario</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL RECHAZO -->
<div class="modal fade" id="modalRechazo" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Rechazar Orden de Compra</h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="hdnIdRechazo" value="0" />
                <div class="form-group mb-2">
                    <label class="col-form-label col-form-label-sm">Motivo <span class="text-danger">*</span>:</label>
                    <select class="form-control form-control-sm" id="cboMotivoRechazo">
                        <option value="0">-- Seleccione un motivo --</option>
                        @foreach (var m in motivosRechazo)
                        {
                            <option value="@m.IdMotivoRechazo">@m.Descripcion</option>
                        }
                    </select>
                </div>
                <div class="form-group mb-0">
                    <label class="col-form-label col-form-label-sm">Observación adicional (opcional):</label>
                    <textarea class="form-control form-control-sm" id="txtMotivoRechazo" rows="2" maxlength="500"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger btn-sm" onclick="confirmarRechazo()">
                    <i class="fas fa-times"></i> Confirmar Rechazo
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script src="@Url.Content("~/Scripts/Views/OrdenCompra_Aprobaciones.js?v=" + DateTime.Now.Ticks)" type="text/javascript"></script>
}
