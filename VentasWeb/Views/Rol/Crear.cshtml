@{
    ViewBag.Title = "Roles y Permisos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ── Variables ───────────────────────────────────── */
    :root {
        --info: #17a2b8;
        --info-dk: #117a8b;
        --success: #28a745;
        --light: #f8f9fa;
        --border: #dee2e6;
        --text-muted: #6c757d;
    }

    /* ── Layout dos columnas ─────────────────────────── */
    .rol-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        align-items: start;
    }

    @@media (max-width: 900px) {
        .rol-layout {
            grid-template-columns: 1fr;
        }
    }

    /* ── Cards ───────────────────────────────────────── */
    .panel {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: .6rem;
        box-shadow: 0 2px 8px rgba(0,0,0,.07);
        overflow: hidden;
    }

    .panel-header {
        background: var(--info);
        color: #fff;
        padding: .75rem 1.25rem;
        font-weight: 600;
        font-size: .95rem;
        display: flex;
        align-items: center;
        gap: .5rem;
    }

    .panel-body {
        padding: 1.25rem;
    }

    /* ── Permisos grid ───────────────────────────────── */
    .permisos-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: .4rem .8rem;
        max-height: 320px;
        overflow-y: auto;
        padding: .5rem;
        border: 1px solid var(--border);
        border-radius: .4rem;
        background: var(--light);
    }

        .permisos-grid .form-check-label {
            font-size: .87rem;
            cursor: pointer;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .permisos-grid .form-check-input:checked {
            background-color: var(--info);
            border-color: var(--info);
        }

    /* ── Tabla permisos ──────────────────────────────── */
    #tblPermisos thead th {
        background: var(--info);
        color: #fff;
    }

    /* ── Seleccionar todos ───────────────────────────── */
    .select-all-bar {
        display: flex;
        align-items: center;
        gap: .5rem;
        margin-bottom: .5rem;
        font-size: .85rem;
        color: var(--text-muted);
    }

    /* ── Badge estado ────────────────────────────────── */
    .badge-activo {
        background: #d4edda;
        color: #155724;
        padding: 3px 8px;
        border-radius: 4px;
        font-size: .8rem;
    }

    .badge-inactivo {
        background: #f8d7da;
        color: #721c24;
        padding: 3px 8px;
        border-radius: 4px;
        font-size: .8rem;
    }
</style>

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Mantenedor</a></li>
        <li class="breadcrumb-item active">Roles y Permisos</li>
    </ol>
</nav>

<div class="rol-layout">

    <!-- ═══════════════════════════════════════════════ -->
    <!--  PANEL IZQUIERDO — Crear Rol + asignar permisos -->
    <!-- ═══════════════════════════════════════════════ -->
    <div class="panel">
        <div class="panel-header">
            <i class="fa fa-plus-circle"></i> Crear Nuevo Rol
        </div>
        <div class="panel-body">

            <!-- Nombre del rol -->
            <div class="form-group mb-3">
                <label class="font-weight-bold">Nombre del Rol <span class="text-danger">*</span></label>
                <input type="text" id="txtDescripcionRol" class="form-control form-control-sm"
                       placeholder="Ej: Vendedor, Supervisor...">
            </div>

            <!-- Permisos disponibles -->
            <div class="form-group mb-3">
                <label class="font-weight-bold">Permisos a asignar</label>

                <div class="select-all-bar">
                    <input type="checkbox" id="chkTodos" />
                    <label for="chkTodos" style="cursor:pointer;margin:0">Seleccionar / Deseleccionar todos</label>
                    <span id="lblContador" class="ml-auto text-info font-weight-bold">0 seleccionados</span>
                </div>

                <div id="divPermisosCheckbox" class="permisos-grid">
                    <div class="text-center text-muted w-100 py-2">
                        <i class="fa fa-spinner fa-spin"></i> Cargando permisos...
                    </div>
                </div>
            </div>

            <button id="btnGuardarRol" class="btn btn-info btn-sm btn-block">
                <i class="fa fa-save"></i> Guardar Rol con Permisos
            </button>

        </div>
    </div>

    <!-- ═══════════════════════════════════════════════ -->
    <!--  PANEL DERECHO — Ver permisos de un rol         -->
    <!-- ═══════════════════════════════════════════════ -->
    <div class="panel">
        <div class="panel-header">
            <i class="fa fa-shield-alt"></i> Permisos por Rol
        </div>
        <div class="panel-body">

            <!-- Selector de rol -->
            <div class="form-group mb-3">
                <label class="font-weight-bold">Seleccione un Rol</label>
                <select id="cboRol" class="form-control form-control-sm">
                    <option value="">-- Seleccione --</option>
                </select>
            </div>

            <!-- Tabla de permisos -->
            <div class="table-responsive">
                <table class="table table-sm table-bordered table-hover" id="tblPermisos">
                    <thead>
                        <tr>
                            <th>Submenú</th>
                            <th class="text-center" style="width:90px">Estado</th>
                        </tr>
                    </thead>
                    <!-- Las filas de cabecera de menú se insertan dinámicamente desde el JS -->
                    <tbody id="tbodyPermisos">
                        <tr>
                            <td colspan="2" class="text-center text-muted py-3">
                                <i class="fa fa-info-circle"></i>
                                Seleccione un rol para ver sus permisos
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/Views/Rol_Crear.js?v=" + DateTime.Now.Ticks)"
            type="text/javascript"></script>
}
