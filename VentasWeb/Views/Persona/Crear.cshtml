@{
    ViewBag.Title = "Personas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Mantenedor</a></li>
        <li class="breadcrumb-item active" aria-current="page">Personas</li>
    </ol>
</nav>
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.5/css/dataTables.bootstrap4.min.css" />
<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />

<div class="row">
    <div class="col-sm-12">
        <div class="card border-info">
            <div class="card-header bg-info text-white">
                Lista Personas
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-2">
                        <button type="button" id="btnAgregarNueva" class="btn btn-sm btn-success">
                            <i class="fa fa-plus" aria-hidden="true"></i> Agregar Nueva
                        </button>
                    </div>
                </div>
                <hr />
                <div class="row mt-3">
                    <div class="col-sm-12">
                        <table id="tbdata" class="table table-striped table-bordered compact" style="width:100%">
                            <thead>
                                <tr>
                                    <th>Nombres</th>
                                    <th>Apellidos</th>
                                    <th>Razon Social</th>
                                    <th>Correo</th>
                                    <th>Teléfono</th>
                                    <th>Calle Principal</th>
                                    <th>Calle Secundaria</th>
                                    <th>Ciudad</th>
                                    <th>Barrio</th>
                                    <th>Tipo Documento</th>
                                    <th>Documento</th>
                                    <th>Activo</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="FormModal" tabindex="-1" role="dialog" data-backdrop="static" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">Persona</h5>
                <span id="lblEstado" class="ml-3"></span>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="form">
                    <input id="txtid" name="IdPersona" type="hidden" value="0" />

                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label">Tipo Persona <span class="text-danger">(*)</span></label>
                        <div class="col-sm-9">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="tipoPersona" id="personaFisica" value="F" checked>
                                <label class="form-check-label" for="personaFisica">Física</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="tipoPersona" id="personaJuridica" value="J">
                                <label class="form-check-label" for="personaJuridica">Jurídica</label>
                            </div>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="cboTipoDocumento" class="col-sm-3 col-form-label">Tipo Documento <span class="text-danger">(*)</span></label>
                        <div class="col-sm-9">
                            <select id="cboTipoDocumento" class="form-control form-control-sm model" name="TipoDocumento">
                                <option value="CI">CI</option>
                                <option value="RUC">RUC</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="txtDocumento" class="col-sm-3 col-form-label">Documento <span class="text-danger">(*)</span></label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control form-control-sm model" id="txtDocumento" name="Documento">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="txtNombres" class="col-sm-3 col-form-label">Nombres <span class="text-danger">(*)</span></label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control form-control-sm model" id="txtNombres" name="Nombres">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="txtApellidos" class="col-sm-3 col-form-label">Apellidos <span class="text-danger">(*)</span></label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control form-control-sm model" id="txtApellidos" name="Apellidos">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="txtRazonSocial" class="col-sm-3 col-form-label">Razon Social</label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control form-control-sm model" id="txtRazonSocial" name="RazonSocial">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="txtCorreo" class="col-sm-3 col-form-label">Correo</label>
                        <div class="col-sm-9">
                            <input type="email" class="form-control form-control-sm model" id="txtCorreo" name="Correo">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="txtTelefono" class="col-sm-3 col-form-label">Teléfono</label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control form-control-sm model" id="txtTelefono" name="Telefono">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="txtCallePrincipal" class="col-sm-3 col-form-label">Calle Principal</label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control form-control-sm model" id="txtCallePrincipal" name="CallePrincipal">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="txtCalleSecundaria" class="col-sm-3 col-form-label">Calle Secundaria</label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control form-control-sm model" id="txtCalleSecundaria" name="CalleSecundaria">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="txtCiudad" class="col-sm-3 col-form-label">Ciudad</label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control form-control-sm model" id="txtCiudad" name="Ciudad">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="txtBarrio" class="col-sm-3 col-form-label">Barrio</label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control form-control-sm model" id="txtBarrio" name="Barrio">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="ddlEstado" class="col-sm-3 col-form-label">Estado</label>
                        <div class="col-sm-9">
                            <select id="ddlEstado" name="Activo" class="form-control form-control-sm model">
                                <option value="1">Activo</option>
                                <option value="0">Inactivo</option>
                            </select>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-danger" data-dismiss="modal">Cerrar</button>
                <button type="button" id="btnGuardarPersona" class="btn btn-sm btn-primary">Guardar</button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="@Url.Content("~/Scripts/Views/Persona_Crear.js")" type="text/javascript"></script>
}
<style>
    .text-wrap {
        white-space: normal !important;
    }

    .no-wrap {
        white-space: nowrap !important;
    }
</style>
