@{
    ViewBag.Title = "Personas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.5/css/dataTables.bootstrap4.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.4.1/css/responsive.bootstrap4.min.css" />

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Mantenedor</a></li>
        <li class="breadcrumb-item active">Personas</li>
    </ol>
</nav>

<div class="card border-info">
    <div class="card-header bg-info text-white">
        <i class="fa fa-id-card mr-1"></i> Lista de Personas
    </div>
    <div class="card-body">
        <button type="button" id="btnAgregarNueva" class="btn btn-sm btn-success mb-3">
            <i class="fa fa-plus"></i> Agregar Nueva
        </button>
        <div class="table-responsive">
            <table id="tbdata" class="table table-striped table-bordered table-sm" style="width:100%">
                <thead class="thead-light">
                    <tr>
                        <th>Nombres</th>
                        <th>Apellidos</th>
                        <th>Razón Social</th>
                        <th>Tipo Doc.</th>
                        <th>Documento</th>
                        <th>Correo</th>
                        <th>Teléfono</th>
                        <th>Calle Principal</th>
                        <th>Calle Secundaria</th>
                        <th>Ciudad</th>
                        <th>Barrio</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<!-- ══════════════ MODAL VER (solo lectura) ══════════════ -->
<div class="modal fade" id="VerModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fa fa-eye mr-1"></i> Detalle de Persona</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group row mb-2">
                            <label class="col-sm-5 col-form-label font-weight-bold text-muted small">Tipo Doc.</label>
                            <div class="col-sm-7"><p class="form-control-plaintext ver-text" id="verTipoDocumento"></p></div>
                        </div>
                        <div class="form-group row mb-2">
                            <label class="col-sm-5 col-form-label font-weight-bold text-muted small">Documento</label>
                            <div class="col-sm-7"><p class="form-control-plaintext ver-text font-weight-bold" id="verDocumento"></p></div>
                        </div>
                        <div class="form-group row mb-2">
                            <label class="col-sm-5 col-form-label font-weight-bold text-muted small">Nombres</label>
                            <div class="col-sm-7"><p class="form-control-plaintext ver-text" id="verNombres"></p></div>
                        </div>
                        <div class="form-group row mb-2">
                            <label class="col-sm-5 col-form-label font-weight-bold text-muted small">Apellidos</label>
                            <div class="col-sm-7"><p class="form-control-plaintext ver-text" id="verApellidos"></p></div>
                        </div>
                        <div class="form-group row mb-2">
                            <label class="col-sm-5 col-form-label font-weight-bold text-muted small">Razón Social</label>
                            <div class="col-sm-7"><p class="form-control-plaintext ver-text" id="verRazonSocial"></p></div>
                        </div>
                        <div class="form-group row mb-2">
                            <label class="col-sm-5 col-form-label font-weight-bold text-muted small">Estado</label>
                            <div class="col-sm-7 d-flex align-items-center"><span id="verEstado"></span></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group row mb-2">
                            <label class="col-sm-5 col-form-label font-weight-bold text-muted small">Correo</label>
                            <div class="col-sm-7"><p class="form-control-plaintext ver-text small" id="verCorreo"></p></div>
                        </div>
                        <div class="form-group row mb-2">
                            <label class="col-sm-5 col-form-label font-weight-bold text-muted small">Teléfono</label>
                            <div class="col-sm-7"><p class="form-control-plaintext ver-text" id="verTelefono"></p></div>
                        </div>
                        <hr class="my-2" />
                        <p class="text-muted small mb-1 font-weight-bold"><i class="fa fa-map-marker mr-1"></i> Dirección</p>
                        <div class="form-group row mb-2">
                            <label class="col-sm-5 col-form-label font-weight-bold text-muted small">Calle Principal</label>
                            <div class="col-sm-7"><p class="form-control-plaintext ver-text" id="verCalle1"></p></div>
                        </div>
                        <div class="form-group row mb-2">
                            <label class="col-sm-5 col-form-label font-weight-bold text-muted small">Calle Secundaria</label>
                            <div class="col-sm-7"><p class="form-control-plaintext ver-text" id="verCalle2"></p></div>
                        </div>
                        <div class="form-group row mb-2">
                            <label class="col-sm-5 col-form-label font-weight-bold text-muted small">Ciudad</label>
                            <div class="col-sm-7"><p class="form-control-plaintext ver-text" id="verCiudad"></p></div>
                        </div>
                        <div class="form-group row mb-0">
                            <label class="col-sm-5 col-form-label font-weight-bold text-muted small">Barrio</label>
                            <div class="col-sm-7"><p class="form-control-plaintext ver-text" id="verBarrio"></p></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal">
                    <i class="fa fa-times"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════ MODAL ══════════════ -->
<div class="modal fade" id="FormModal" tabindex="-1" role="dialog" data-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fa fa-user mr-1"></i> Persona</h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <form id="form" novalidate>
                    <input id="txtid" name="IdPersona" type="hidden" value="0" />

                    <!-- Tipo Persona -->
                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label font-weight-bold">
                            Tipo Persona <span class="text-danger">*</span>
                        </label>
                        <div class="col-sm-9 d-flex align-items-center">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="tipoPersona"
                                       id="personaFisica" value="F" checked>
                                <label class="form-check-label" for="personaFisica">Física</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="tipoPersona"
                                       id="personaJuridica" value="J">
                                <label class="form-check-label" for="personaJuridica">Jurídica</label>
                            </div>
                        </div>
                    </div>

                    <!-- Tipo Documento -->
                    <div class="form-group row">
                        <label for="cboTipoDocumento" class="col-sm-3 col-form-label font-weight-bold">
                            Tipo Documento <span class="text-danger">*</span>
                        </label>
                        <div class="col-sm-4">
                            <select id="cboTipoDocumento" class="form-control form-control-sm" name="TipoDocumento">
                                <option value="CI">CI</option>
                                <option value="RUC">RUC</option>
                            </select>
                        </div>
                    </div>

                    <!-- Documento -->
                    <div class="form-group row">
                        <label for="txtDocumento" class="col-sm-3 col-form-label font-weight-bold">
                            Documento <span class="text-danger">*</span>
                        </label>
                        <div class="col-sm-5">
                            <input type="text" class="form-control form-control-sm"
                                   id="txtDocumento" name="Documento"
                                   placeholder="Ej: 1234567 o 80012345-1" maxlength="15">
                            <div class="invalid-feedback"></div>
                            <small class="text-muted" id="hintDocumento">CI: 6-8 dígitos numéricos</small>
                        </div>
                    </div>

                    <!-- Nombres (Física) -->
                    <div class="form-group row" id="divNombres">
                        <label for="txtNombres" class="col-sm-3 col-form-label font-weight-bold">
                            Nombres <span class="text-danger">*</span>
                        </label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control form-control-sm"
                                   id="txtNombres" name="Nombres" maxlength="100">
                            <div class="invalid-feedback"></div>
                        </div>
                    </div>

                    <!-- Apellidos (Física) -->
                    <div class="form-group row" id="divApellidos">
                        <label for="txtApellidos" class="col-sm-3 col-form-label font-weight-bold">
                            Apellidos <span class="text-danger">*</span>
                        </label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control form-control-sm"
                                   id="txtApellidos" name="Apellidos" maxlength="100">
                            <div class="invalid-feedback"></div>
                        </div>
                    </div>

                    <!-- Razón Social (Jurídica) -->
                    <div class="form-group row" id="divRazonSocial" style="display:none">
                        <label for="txtRazonSocial" class="col-sm-3 col-form-label font-weight-bold">
                            Razón Social <span class="text-danger">*</span>
                        </label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control form-control-sm"
                                   id="txtRazonSocial" name="RazonSocial" maxlength="150">
                            <div class="invalid-feedback"></div>
                        </div>
                    </div>

                    <hr class="my-2" />

                    <!-- Correo -->
                    <div class="form-group row">
                        <label for="txtCorreo" class="col-sm-3 col-form-label">Correo</label>
                        <div class="col-sm-9">
                            <input type="email" class="form-control form-control-sm"
                                   id="txtCorreo" name="Correo" maxlength="100"
                                   placeholder="ejemplo@correo.com">
                            <div class="invalid-feedback"></div>
                        </div>
                    </div>

                    <!-- Teléfono -->
                    <div class="form-group row">
                        <label for="txtTelefono" class="col-sm-3 col-form-label">Teléfono</label>
                        <div class="col-sm-6">
                            <input type="text" class="form-control form-control-sm"
                                   id="txtTelefono" name="Telefono"
                                   placeholder="+595XXXXXXXXX" maxlength="20">
                            <div class="invalid-feedback"></div>
                            <small class="text-muted">Formato: +595 seguido del número</small>
                        </div>
                    </div>

                    <hr class="my-2" />
                    <p class="text-muted small mb-2"><i class="fa fa-map-marker mr-1"></i> Dirección (opcional)</p>

                    <!-- Calles en misma fila -->
                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label">Calle Principal</label>
                        <div class="col-sm-4">
                            <input type="text" class="form-control form-control-sm"
                                   id="txtCallePrincipal" name="Calle1" maxlength="100">
                        </div>
                        <label class="col-sm-2 col-form-label">Calle Secundaria</label>
                        <div class="col-sm-3">
                            <input type="text" class="form-control form-control-sm"
                                   id="txtCalleSecundaria" name="Calle2" maxlength="100">
                        </div>
                    </div>

                    <!-- Ciudad y Barrio en misma fila -->
                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label">Ciudad</label>
                        <div class="col-sm-4">
                            <input type="text" class="form-control form-control-sm"
                                   id="txtCiudad" name="Ciudad" maxlength="80">
                        </div>
                        <label class="col-sm-2 col-form-label">Barrio</label>
                        <div class="col-sm-3">
                            <input type="text" class="form-control form-control-sm"
                                   id="txtBarrio" name="Barrio" maxlength="80">
                        </div>
                    </div>

                    <!-- Estado -->
                    <div class="form-group row">
                        <label for="ddlEstado" class="col-sm-3 col-form-label">Estado</label>
                        <div class="col-sm-4">
                            <select id="ddlEstado" name="Activo" class="form-control form-control-sm">
                                <option value="1">Activo</option>
                                <option value="0">Inactivo</option>
                            </select>
                        </div>
                    </div>

                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal">
                    <i class="fa fa-times"></i> Cerrar
                </button>
                <button type="button" id="btnGuardarPersona" class="btn btn-sm btn-primary">
                    <i class="fa fa-save"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.datatables.net/responsive/2.4.1/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.4.1/js/responsive.bootstrap4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="@Url.Content("~/Scripts/Views/Persona_Crear.js?v=" + DateTime.Now.Ticks)" type="text/javascript"></script>
}

<style>
    /* Hint de documento según tipo */
    #hintDocumento {
        font-size: .78rem;
    }

    /* Documento readonly en edición */
    #txtDocumento[readonly] {
        background-color: #e9ecef;
        cursor: not-allowed;
    }

    /* Radios deshabilitados en edición */
    input[name='tipoPersona']:disabled + label {
        opacity: .5;
    }
</style>
