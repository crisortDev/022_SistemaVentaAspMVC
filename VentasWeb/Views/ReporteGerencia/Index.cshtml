@{
    ViewBag.Title = "Reporte de Compras — Alta Gerencia";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var tiendas = ViewBag.Tiendas as List<CapaModelo.Tienda> ?? new List<CapaModelo.Tienda>();
    bool esSuperAdmin = Session["EsAdminGlobal"] != null && (bool)Session["EsAdminGlobal"];
}

@section estilos {
<style>
    .kpi-grid        { display:grid; grid-template-columns:repeat(4,1fr); gap:.6rem; margin-bottom:1rem; }
    .kpi-card        { border-radius:8px; padding:.8rem 1rem; color:#fff; }
    .kpi-card .kpi-lbl { font-size:.75rem; opacity:.85; }
    .kpi-card .kpi-val { font-size:1.3rem; font-weight:700; line-height:1.3; }
    .kpi-card .kpi-sub { font-size:.7rem; opacity:.75; }
    .kpi-azul   { background:linear-gradient(135deg,#1a3566,#2563eb); }
    .kpi-verde  { background:linear-gradient(135deg,#059669,#10b981); }
    .kpi-cyan   { background:linear-gradient(135deg,#0891b2,#06b6d4); }
    .kpi-ambar  { background:linear-gradient(135deg,#b45309,#f59e0b); }
    .kpi-rojo   { background:linear-gradient(135deg,#991b1b,#ef4444); }
    .kpi-morado { background:linear-gradient(135deg,#7c3aed,#a78bfa); }
    .kpi-gris   { background:linear-gradient(135deg,#374151,#6b7280); }
    .kpi-teal   { background:linear-gradient(135deg,#0f766e,#14b8a6); }
    .sec-title  { font-size:.85rem; font-weight:700; color:#1a3566;
                  border-left:3px solid #1a3566; padding-left:.5rem;
                  margin:1rem 0 .4rem; }
    #spinner    { display:none; }
</style>
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Reportes</a></li>
        <li class="breadcrumb-item active">Reporte de Compras — Gerencia</li>
    </ol>
</nav>

<!-- Filtros -->
<div class="card border-info mb-3">
    <div class="card-header bg-info text-white py-2 d-flex justify-content-between align-items-center">
        <span><i class="fas fa-shopping-cart mr-1"></i> Reporte de Compras — Alta Gerencia</span>
        <div id="spinner" class="spinner-border spinner-border-sm text-light" role="status"></div>
    </div>
    <div class="card-body p-2">
        <div class="row align-items-end">
            <div class="col-sm-2">
                <label class="col-form-label col-form-label-sm font-weight-bold">Fecha Inicio</label>
                <input type="text" id="txtFechaInicio" class="form-control form-control-sm"
                       placeholder="dd/mm/aaaa" autocomplete="off" />
            </div>
            <div class="col-sm-2">
                <label class="col-form-label col-form-label-sm font-weight-bold">Fecha Fin</label>
                <input type="text" id="txtFechaFin" class="form-control form-control-sm"
                       placeholder="dd/mm/aaaa" autocomplete="off" />
            </div>
            @if (esSuperAdmin)
            {
                <div class="col-sm-3">
                    <label class="col-form-label col-form-label-sm font-weight-bold">Sucursal</label>
                    <select id="cboTienda" class="form-control form-control-sm">
                        <option value="0">Todas las sucursales</option>
                        @foreach (var t in tiendas)
                        {
                            <option value="@t.IdTienda">@t.Nombre</option>
                        }
                    </select>
                </div>
            }
            else
            {
                <input type="hidden" id="cboTienda" value="@(Session["TiendaActiva"] ?? 0)" />
                <div class="col-sm-3">
                    <label class="col-form-label col-form-label-sm font-weight-bold">Sucursal</label>
                    <div class="form-control form-control-sm bg-light" style="line-height:1.8;">
                        <i class="fas fa-store text-info mr-1"></i>
                        <strong>@(ViewBag.NombreTiendaActual ?? "Mi sucursal")</strong>
                    </div>
                </div>
            }
            <div class="col-sm-2">
                <button class="btn btn-info btn-sm btn-block" onclick="generarReporte()">
                    <i class="fas fa-search mr-1"></i> Generar
                </button>
            </div>
            <div class="col-sm-2">
                <button class="btn btn-danger btn-sm btn-block" id="btnPDF" onclick="descargarPDF()" disabled>
                    <i class="fas fa-file-pdf mr-1"></i> Descargar PDF
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Reporte en pantalla -->
<div id="divReporte" style="display:none;">

    <!-- KPIs fila 1 (4 col) -->
    <div class="kpi-grid">
        <div class="kpi-card kpi-azul">
            <div class="kpi-lbl">Total Compras (Gs.)</div>
            <div class="kpi-val" id="kpiMonto">—</div>
        </div>
        <div class="kpi-card kpi-verde">
            <div class="kpi-lbl">Órdenes Emitidas</div>
            <div class="kpi-val" id="kpiTotalOC">—</div>
        </div>
        <div class="kpi-card kpi-cyan">
            <div class="kpi-lbl">Compras Recepcionadas</div>
            <div class="kpi-val" id="kpiRecepcionadas">—</div>
        </div>
        <div class="kpi-card kpi-ambar">
            <div class="kpi-lbl">OC Pendientes</div>
            <div class="kpi-val" id="kpiPendientes">—</div>
        </div>
        <div class="kpi-card kpi-teal">
            <div class="kpi-lbl">Gasto Promedio / Compra</div>
            <div class="kpi-val" id="kpiGastoPromedio">—</div>
        </div>
        <div class="kpi-card kpi-morado">
            <div class="kpi-lbl">Proveedores Activos</div>
            <div class="kpi-val" id="kpiProveedores">—</div>
        </div>
        <div class="kpi-card kpi-gris">
            <div class="kpi-lbl">Productos Comprados</div>
            <div class="kpi-val" id="kpiProductos">—</div>
        </div>
        <div class="kpi-card kpi-rojo">
            <div class="kpi-lbl">OC Anuladas / Rechazadas</div>
            <div class="kpi-val" id="kpiAnuladas">—</div>
        </div>
    </div>

    <!-- Compras por mes -->
    <div class="sec-title"><i class="fas fa-calendar-alt mr-1"></i> Compras por Mes</div>
    <div class="table-responsive mb-3">
        <table class="table table-sm table-bordered table-hover">
            <thead class="thead-dark">
                <tr><th>Año</th><th>Mes</th><th class="text-right">Cantidad</th><th class="text-right">Monto Total (Gs.)</th></tr>
            </thead>
            <tbody id="tbodyMes"></tbody>
        </table>
    </div>

    <!-- Top Proveedores -->
    <div class="sec-title"><i class="fas fa-truck mr-1"></i> Top 10 Proveedores con Mayor Volumen de Compras</div>
    <div class="table-responsive mb-3">
        <table class="table table-sm table-bordered table-hover">
            <thead class="thead-dark">
                <tr><th>#</th><th>Proveedor</th><th class="text-right">Compras</th><th class="text-right">Monto Total (Gs.)</th><th class="text-center">NC</th></tr>
            </thead>
            <tbody id="tbodyProveedores"></tbody>
        </table>
    </div>

    <!-- Productos más comprados -->
    <div class="sec-title"><i class="fas fa-boxes mr-1"></i> Top 10 Productos más Comprados</div>
    <div class="table-responsive mb-3">
        <table class="table table-sm table-bordered table-hover">
            <thead class="thead-dark">
                <tr><th>#</th><th>Código</th><th>Producto</th><th>Categoría</th><th class="text-right">Cantidad</th><th class="text-right">Monto Total (Gs.)</th></tr>
            </thead>
            <tbody id="tbodyProductos"></tbody>
        </table>
    </div>

    <!-- Estado de OC -->
    <div class="sec-title"><i class="fas fa-clipboard-list mr-1"></i> Estado de las Órdenes de Compra</div>
    <div class="table-responsive mb-3">
        <table class="table table-sm table-bordered table-hover">
            <thead class="thead-dark">
                <tr><th>Estado</th><th class="text-right">Cantidad</th><th class="text-right">Monto Estimado (Gs.)</th></tr>
            </thead>
            <tbody id="tbodyEstadoOC"></tbody>
        </table>
    </div>

    <!-- Compras por tienda -->
    <div class="sec-title"><i class="fas fa-store mr-1"></i> Compras por Sucursal</div>
    <div class="table-responsive mb-3">
        <table class="table table-sm table-bordered table-hover">
            <thead class="thead-dark">
                <tr><th>Sucursal</th><th class="text-right">Compras</th><th class="text-right">Monto Total (Gs.)</th><th class="text-center">% del Total</th></tr>
            </thead>
            <tbody id="tbodyTiendas"></tbody>
        </table>
    </div>

    <!-- Relación Compras vs Ventas -->
    <div class="sec-title"><i class="fas fa-balance-scale mr-1"></i> Relación Compras vs Ventas</div>
    <div class="table-responsive mb-3">
        <table class="table table-sm table-bordered">
            <thead class="thead-dark">
                <tr><th>Concepto</th><th class="text-right">Total (Gs.)</th><th class="text-right">Relación</th></tr>
            </thead>
            <tbody id="tbodyRelacion"></tbody>
        </table>
    </div>

    <!-- Resumen NC -->
    <div class="sec-title"><i class="fas fa-file-invoice-dollar mr-1"></i> Resumen de Notas de Crédito (Compras)</div>
    <div class="table-responsive mb-3">
        <table class="table table-sm table-bordered">
            <thead class="thead-dark">
                <tr><th>Indicador</th><th class="text-right">Valor</th></tr>
            </thead>
            <tbody id="tbodyNC"></tbody>
        </table>
    </div>

    <!-- Botón PDF al pie -->
    <div class="text-right mb-4">
        <button class="btn btn-danger" onclick="descargarPDF()">
            <i class="fas fa-file-pdf mr-1"></i> Descargar PDF
        </button>
    </div>
</div>

<!-- Formulario oculto para POST del PDF -->
@using (Html.BeginForm("DescargarPDF", "ReporteGerencia", FormMethod.Post, new { id = "frmPDF" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" id="hFechaInicio" name="fechainicio" />
    <input type="hidden" id="hFechaFin"    name="fechafin"    />
    <input type="hidden" id="hIdTienda"    name="idtienda"    />
}

@section scripts {
    <script src="@Url.Content("~/Scripts/Views/ReporteGerencia_Index.js?v=" + DateTime.Now.Ticks)"></script>
}
