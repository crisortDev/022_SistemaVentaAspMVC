@{
    ViewBag.Title = "Órdenes de Pago";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Compras</a></li>
        <li class="breadcrumb-item active" aria-current="page">Órdenes de Pago</li>
    </ol>
</nav>

<div class="row">
    <div class="col-sm-12">
        <div class="card border-info">
            <div class="card-header bg-info text-white">
                Consultar Órdenes de Pago
            </div>
            <div class="card-body p-2">

                <div class="row align-items-end mb-2">
                    <div class="col-sm-2">
                        <label class="col-form-label col-form-label-sm">Fecha Inicio:</label>
                        <input type="text" id="txtFechaInicio" class="form-control form-control-sm datepicker" autocomplete="off" />
                    </div>
                    <div class="col-sm-2">
                        <label class="col-form-label col-form-label-sm">Fecha Fin:</label>
                        <input type="text" id="txtFechaFin" class="form-control form-control-sm datepicker" autocomplete="off" />
                    </div>
                    <div class="col-sm-2">
                        <label class="col-form-label col-form-label-sm">Estado:</label>
                        <select id="cboEstado" class="form-control form-control-sm">
                            <option value="">Todos</option>
                            <option value="Pendiente">Pendiente</option>
                            <option value="Pagada">Pagada</option>
                            <option value="Anulada">Anulada</option>
                        </select>
                    </div>
                    <div class="col-sm-2">
                        <button id="btnBuscar" class="btn btn-sm btn-info mt-1">
                            <i class="fas fa-search"></i> Buscar
                        </button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm table-bordered table-hover" id="tblOP">
                        <thead class="thead-light">
                            <tr>
                                <th>N° OP</th>
                                <th>Proveedor</th>
                                <th>Sucursal</th>
                                <th class="text-right">Monto</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Fecha Emisión</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyOP"></tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>

@section scripts {
<script src="@Url.Content("~/Scripts/Views/OrdenPago_Consultar.js?v=" + DateTime.Now.Ticks)" type="text/javascript"></script>
}
