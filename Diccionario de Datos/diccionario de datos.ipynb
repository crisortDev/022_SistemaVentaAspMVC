ma='dbo']/ForeignKey[@Name='FK_TRASLADO_TiendaOrigen']","object_type":"ForeignKey"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["ALTER TABLE [dbo].[TRASLADO]  WITH CHECK ADD  CONSTRAINT [FK_TRASLADO_TiendaOrigen] FOREIGN KEY([IdTiendaOrigen])\r\nREFERENCES [dbo].[TIENDA] ([IdTienda])\r\n","GO\r\n","ALTER TABLE [dbo].[TRASLADO] CHECK CONSTRAINT [FK_TRASLADO_TiendaOrigen]\r\n","GO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/Table[@Name='TRASLADO' and @Schema='dbo']/ForeignKey[@Name='FK_TRASLADO_TiendaOrigen']","object_type":"ForeignKey"}},{"cell_type":"markdown","source":["# [FK_TRASLADO_Usuario]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/Table[@Name='TRASLADO' and @Schema='dbo']/ForeignKey[@Name='FK_TRASLADO_Usuario']","object_type":"ForeignKey"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["ALTER TABLE [dbo].[TRASLADO]  WITH CHECK ADD  CONSTRAINT [FK_TRASLADO_Usuario] FOREIGN KEY([IdUsuario])\r\nREFERENCES [dbo].[USUARIO] ([IdUsuario])\r\n","GO\r\n","ALTER TABLE [dbo].[TRASLADO] CHECK CONSTRAINT [FK_TRASLADO_Usuario]\r\n","GO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/Table[@Name='TRASLADO' and @Schema='dbo']/ForeignKey[@Name='FK_TRASLADO_Usuario']","object_type":"ForeignKey"}},{"cell_type":"markdown","source":["# [FK__USUARIO__IdRol__48CFD27E]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/Table[@Name='USUARIO' and @Schema='dbo']/ForeignKey[@Name='FK__USUARIO__IdRol__48CFD27E']","object_type":"ForeignKey"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["ALTER TABLE [dbo].[USUARIO]  WITH CHECK ADD FOREIGN KEY([IdRol])\r\nREFERENCES [dbo].[ROL] ([IdRol])\r\n","GO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/Table[@Name='USUARIO' and @Schema='dbo']/ForeignKey[@Name='FK__USUARIO__IdRol__48CFD27E']","object_type":"ForeignKey"}},{"cell_type":"markdown","source":["# [FK__USUARIO__IdTiend__47DBAE45]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/Table[@Name='USUARIO' and @Schema='dbo']/ForeignKey[@Name='FK__USUARIO__IdTiend__47DBAE45']","object_type":"ForeignKey"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["ALTER TABLE [dbo].[USUARIO]  WITH CHECK ADD FOREIGN KEY([IdTienda])\r\nREFERENCES [dbo].[TIENDA] ([IdTienda])\r\n","GO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/Table[@Name='USUARIO' and @Schema='dbo']/ForeignKey[@Name='FK__USUARIO__IdTiend__47DBAE45']","object_type":"ForeignKey"}},{"cell_type":"markdown","source":["# [FK_Usuario_Empleado]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/Table[@Name='USUARIO' and @Schema='dbo']/ForeignKey[@Name='FK_Usuario_Empleado']","object_type":"ForeignKey"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["ALTER TABLE [dbo].[USUARIO]  WITH CHECK ADD  CONSTRAINT [FK_Usuario_Empleado] FOREIGN KEY([IdEmpleado])\r\nREFERENCES [dbo].[EMPLEADO] ([IdEmpleado])\r\nON UPDATE CASCADE\r\n","GO\r\n","ALTER TABLE [dbo].[USUARIO] CHECK CONSTRAINT [FK_Usuario_Empleado]\r\n","GO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/Table[@Name='USUARIO' and @Schema='dbo']/ForeignKey[@Name='FK_Usuario_Empleado']","object_type":"ForeignKey"}},{"cell_type":"markdown","source":["# [FK__VENTA__IdCliente__7D439ABD]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/Table[@Name='VENTA' and @Schema='dbo']/ForeignKey[@Name='FK__VENTA__IdCliente__7D439ABD']","object_type":"ForeignKey"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["ALTER TABLE [dbo].[VENTA]  WITH CHECK ADD FOREIGN KEY([IdCliente])\r\nREFERENCES [dbo].[CLIENTE] ([IdCliente])\r\n","GO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/Table[@Name='VENTA' and @Schema='dbo']/ForeignKey[@Name='FK__VENTA__IdCliente__7D439ABD']","object_type":"ForeignKey"}},{"cell_type":"markdown","source":["# [FK__VENTA__IdTienda__7B5B524B]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/Table[@Name='VENTA' and @Schema='dbo']/ForeignKey[@Name='FK__VENTA__IdTienda__7B5B524B']","object_type":"ForeignKey"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["ALTER TABLE [dbo].[VENTA]  WITH CHECK ADD FOREIGN KEY([IdTienda])\r\nREFERENCES [dbo].[TIENDA] ([IdTienda])\r\n","GO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/Table[@Name='VENTA' and @Schema='dbo']/ForeignKey[@Name='FK__VENTA__IdTienda__7B5B524B']","object_type":"ForeignKey"}},{"cell_type":"markdown","source":["# [FK__VENTA__IdUsuario__7C4F7684]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/Table[@Name='VENTA' and @Schema='dbo']/ForeignKey[@Name='FK__VENTA__IdUsuario__7C4F7684']","object_type":"ForeignKey"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["ALTER TABLE [dbo].[VENTA]  WITH CHECK ADD FOREIGN KEY([IdUsuario])\r\nREFERENCES [dbo].[USUARIO] ([IdUsuario])\r\n","GO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/Table[@Name='VENTA' and @Schema='dbo']/ForeignKey[@Name='FK__VENTA__IdUsuario__7C4F7684']","object_type":"ForeignKey"}},{"cell_type":"markdown","source":["# [dbo].[sp_ActualizarPrecioVenta]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='sp_ActualizarPrecioVenta' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[sp_ActualizarPrecioVenta]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","CREATE PROCEDURE [dbo].[sp_ActualizarPrecioVenta]\r\n(\r\n    @IdPrecioVenta INT,\r\n    @PrecioVenta INT,\r\n    @FechaInicio DATE,\r\n    @FechaFin DATE = NULL,\r\n    @FilasAfectadas INT OUTPUT\r\n)\r\nAS\r\nBEGIN\r\n    SET NOCOUNT ON;\r\n\r\n    IF NOT EXISTS (SELECT 1 FROM Precio_Venta WHERE IdPrecioVenta = @IdPrecioVenta AND Activo = 1)\r\n    BEGIN\r\n        RAISERROR('Registro no encontrado o inactivo.', 16, 1);\r\n        SET @FilasAfectadas = 0;\r\n        RETURN;\r\n    END\r\n\r\n    -- Validar que las fechas no se solapen con otro precio vigente para el mismo producto\r\n    DECLARE @IdProducto INT;\r\n\r\n    SELECT @IdProducto = IdProducto FROM Precio_Venta WHERE IdPrecioVenta = @IdPrecioVenta;\r\n\r\n    DECLARE @Conflictos INT;\r\n\r\n    SELECT @Conflictos = COUNT(*)\r\n    FROM Precio_Venta\r\n    WHERE IdProducto = @IdProducto\r\n      AND IdPrecioVenta <> @IdPrecioVenta\r\n      AND Activo = 1\r\n      AND (\r\n            (@FechaInicio BETWEEN FechaInicio AND ISNULL(FechaFin, '99991231'))\r\n         OR (@FechaFin IS NOT NULL AND @FechaFin BETWEEN FechaInicio AND ISNULL(FechaFin, '99991231'))\r\n         OR (FechaInicio BETWEEN @FechaInicio AND ISNULL(@FechaFin, '99991231'))\r\n         OR (FechaFin IS NOT NULL AND FechaFin BETWEEN @FechaInicio AND ISNULL(@FechaFin, '99991231'))\r\n          );\r\n\r\n    IF @Conflictos > 0\r\n    BEGIN\r\n        RAISERROR('Las fechas de vigencia se solapan con otro precio.', 16, 1);\r\n        SET @FilasAfectadas = 0;\r\n        RETURN;\r\n    END\r\n\r\n    -- Actualizar el precio anterior si ya existe uno con fecha fin NULL\r\n    UPDATE Precio_Venta\r\n    SET FechaFin = DATEADD(DAY, -1, @FechaInicio)\r\n    WHERE IdProducto = @IdProducto\r\n      AND Activo = 1\r\n      AND IdPrecioVenta <> @IdPrecioVenta\r\n      AND (FechaFin IS NULL OR FechaFin >= @FechaInicio)\r\n      AND FechaInicio < @FechaInicio;\r\n\r\n    -- Actualizar el precio actual\r\n    BEGIN TRY\r\n        UPDATE Precio_Venta\r\n        SET \r\n            PrecioVenta = @PrecioVenta,\r\n            FechaInicio = @FechaInicio,\r\n            FechaFin = @FechaFin,\r\n            FechaRegistro = GETDATE()\r\n        WHERE IdPrecioVenta = @IdPrecioVenta;\r\n\r\n        SET @FilasAfectadas = CASE WHEN @@ROWCOUNT > 0 THEN 1 ELSE 0 END;\r\n    END TRY\r\n    BEGIN CATCH\r\n        SET @FilasAfectadas = 0;\r\n    END CATCH\r\nEND\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='sp_ActualizarPrecioVenta' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[sp_ObtenerHistorialPrecioCompra]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='sp_ObtenerHistorialPrecioCompra' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[sp_ObtenerHistorialPrecioCompra]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","CREATE PROCEDURE [dbo].[sp_ObtenerHistorialPrecioCompra]\r\n    @IdProducto INT\r\nAS\r\nBEGIN\r\n    SET NOCOUNT ON;\r\n\r\n    SELECT \r\n        IdHistoricoPrecio,\r\n        IdProducto,\r\n        PrecioCompra,\r\n        FechaRegistro,\r\n        ISNULL(IdCompra, 0) AS IdCompra,\r\n        ISNULL(Observaciones, '') AS Observaciones\r\n    FROM\r\n        HISTORIAL_PRECIO_COMPRA\r\n    WHERE\r\n        IdProducto = @IdProducto\r\n    ORDER BY\r\n        FechaRegistro DESC;\r\nEND;\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='sp_ObtenerHistorialPrecioCompra' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[SP_RegistrarUsuario]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='SP_RegistrarUsuario' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[SP_RegistrarUsuario]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","CREATE PROCEDURE [dbo].[SP_RegistrarUsuario]\r\n    @Documento        VARCHAR(50),\r\n    @Correo           VARCHAR(150),\r\n    @IdRol            INT,\r\n    @IdTienda         INT,\r\n    @Clave            VARCHAR(200) = NULL  -- puede venir null si después generás OTP\r\nAS\r\nBEGIN\r\n    SET NOCOUNT ON;\r\n\r\n    DECLARE @IdPersona INT,\r\n            @IdEmpleado INT,\r\n            @IdUsuario INT,\r\n            @OTP VARCHAR(10),\r\n            @FechaExpira DATETIME;\r\n\r\n    -- 1. Buscar persona\r\n    SELECT @IdPersona = IdPersona\r\n    FROM Persona\r\n    WHERE Documento = @Documento AND Activo = 1;\r\n\r\n    IF @IdPersona IS NULL\r\n    BEGIN\r\n        SELECT 'ERROR' AS TipoMensaje, 'La persona con documento no existe. Regístrela primero.' AS Mensaje;\r\n        RETURN;\r\n    END\r\n\r\n    -- 2. Buscar empleado\r\n    SELECT @IdEmpleado = IdEmpleado\r\n    FROM Empleado\r\n    WHERE IdPersona = @IdPersona AND Activo = 1;\r\n\r\n    IF @IdEmpleado IS NULL\r\n    BEGIN\r\n        INSERT INTO Empleado (Nombres, Apellidos, IdTienda, Activo, FechaRegistro, IdPersona)\r\n        SELECT Nombres, Apellidos, @IdTienda, 1, GETDATE(), IdPersona\r\n        FROM Persona\r\n        WHERE IdPersona = @IdPersona;\r\n\r\n        SET @IdEmpleado = SCOPE_IDENTITY();\r\n    END\r\n\r\n    -- 3. Verificar usuario\r\n    SELECT @IdUsuario = IdUsuario\r\n    FROM Usuario\r\n    WHERE IdEmpleado = @IdEmpleado AND Activo = 1;\r\n\r\n    IF @IdUsuario IS NOT NULL\r\n    BEGIN\r\n        SELECT 'ERROR' AS TipoMensaje, 'Ya existe un usuario para este empleado.' AS Mensaje;\r\n        RETURN;\r\n    END\r\n\r\n    -- 4. Generar OTP (6 dígitos) y fecha de expiración\r\n    SET @OTP = RIGHT('000000' + CAST(CAST(RAND() * 1000000 AS INT) AS VARCHAR(6)), 6);\r\n    SET @FechaExpira = DATEADD(MINUTE, 15, GETDATE());\r\n\r\n    -- 5. Insertar usuario\r\n    INSERT INTO Usuario (Nombres, Apellidos, Correo, Clave, IdTienda, IdRol, Activo, FechaRegistro, IdEmpleado, EstadoUsuario, TokenActivacion, FechaExpiracionToken)\r\n    SELECT \r\n        p.Nombres,\r\n        p.Apellidos,\r\n        @Correo,\r\n        HASHBYTES('SHA2_256', ISNULL(@Clave, '123456')), -- si no viene clave, asigno 123456\r\n        @IdTienda,\r\n        @IdRol,\r\n        1,\r\n        GETDATE(),\r\n        @IdEmpleado,\r\n        0,                -- EstadoUsuario = inactivo hasta OTP\r\n        @OTP,\r\n        @FechaExpira\r\n    FROM Persona p\r\n    WHERE p.IdPersona = @IdPersona;\r\n\r\n    SET @IdUsuario = SCOPE_IDENTITY();\r\n\r\n    -- 6. Retornar éxito con datos\r\n    SELECT 'OK' AS TipoMensaje, \r\n           'Usuario creado correctamente. Revise su correo para activar la cuenta.' AS Mensaje,\r\n           @IdUsuario AS IdUsuario,\r\n           @OTP AS OTP,\r\n           @FechaExpira AS Expira;\r\nEND\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='SP_RegistrarUsuario' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ActualizarPermisos]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ActualizarPermisos' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ActualizarPermisos]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n--PROCEDIMIENTO PARA ACTUALIZAR PERMISOS\r\ncreate procedure [dbo].[usp_ActualizarPermisos](\r\n@Detalle xml,\r\n@Resultado bit output\r\n)\r\nas\r\nbegin\r\nbegin try\r\n\r\n\tBEGIN TRANSACTION\r\n\tdeclare @permisos table(idpermisos int,activo bit)\r\n\r\n\tinsert into @permisos(idpermisos,activo)\r\n\tselect \r\n\tidpermisos = Node.Data.value('(IdPermisos)[1]','int'),\r\n\tactivo = Node.Data.value('(Activo)[1]','bit')\r\n\tFROM @Detalle.nodes('/DETALLE/PERMISO') Node(Data)\r\n\r\n\tselect * from @permisos\r\n\r\n\tupdate p set p.Activo = pe.activo from PERMISOS p\r\n\tinner join @permisos pe on pe.idpermisos = p.IdPermisos\r\n\r\n\tCOMMIT\r\n\tset @Resultado = 1\r\n\r\nend try\r\nbegin catch\r\n\tROLLBACK\r\n\tset @Resultado = 0\r\nend catch\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ActualizarPermisos' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_BajaStockProductoTienda]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_BajaStockProductoTienda' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_BajaStockProductoTienda]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","-- =============================================\r\n-- Modificar SP para guardar IdMotivoBaja\r\n-- =============================================\r\nCREATE PROCEDURE [dbo].[usp_BajaStockProductoTienda]\r\n    @IdProductoTienda INT,\r\n    @Cantidad         INT,\r\n    @Motivo           VARCHAR(255),\r\n    @IdProducto       INT,\r\n    @IdMotivoBaja     INT = NULL   -- nuevo parámetro opcional\r\nAS\r\nBEGIN\r\n    SET NOCOUNT ON;\r\n\r\n    DECLARE @StockActual BIGINT;\r\n\r\n    SELECT @StockActual = pt.Stock\r\n    FROM PRODUCTO_TIENDA pt\r\n    WHERE pt.IdProductoTienda = @IdProductoTienda AND pt.IdProducto = @IdProducto;\r\n\r\n    IF @StockActual >= @Cantidad\r\n    BEGIN\r\n        UPDATE PRODUCTO_TIENDA\r\n        SET Stock = Stock - @Cantidad\r\n        WHERE IdProductoTienda = @IdProductoTienda AND IdProducto = @IdProducto;\r\n\r\n        UPDATE PRODUCTO_DEPOSITO\r\n        SET Stock = Stock - @Cantidad\r\n        WHERE IdProducto = @IdProducto;\r\n\r\n        -- Insertar con IdMotivoBaja\r\n        INSERT INTO HISTORIAL_MOVIMIENTO\r\n            (IdProductoDeposito, Estado, Cantidad, FechaMovimiento, Observaciones, idProducto, IdMotivoBaja)\r\n        SELECT\r\n            pd.IdProductoDeposito,\r\n            'Baja',\r\n            @Cantidad,\r\n            GETDATE(),\r\n            @Motivo,\r\n            @IdProducto,\r\n            @IdMotivoBaja\r\n        FROM PRODUCTO_DEPOSITO pd\r\n        WHERE pd.IdProducto = @IdProducto;\r\n\r\n        SELECT 'Stock reducido correctamente' AS Resultado;\r\n    END\r\n    ELSE\r\n    BEGIN\r\n        SELECT 'No se puede reducir mas stock del disponible' AS Resultado;\r\n    END\r\nEND\r\n","GO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_BajaStockProductoTienda' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ControlarStock]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ControlarStock' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ControlarStock]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n--PROCEDIMIENTO PARA STOCK PRODUCTO_TIENDA\r\n\r\nCREATE PROCEDURE [dbo].[usp_ControlarStock](\r\n@IdProducto int,\r\n@IdTienda int,\r\n@Cantidad int,\r\n@Restar bit,\r\n@Resultado bit output)\r\nas\r\nbegin\r\n\tset @Resultado = 1\r\n\tbegin try\r\n\t\tif(@Restar = 1)\r\n\t\t\tupdate PRODUCTO_TIENDA set Stock = Stock - @Cantidad where IdProducto = @IdProducto and IdTienda = @IdTienda and Iniciado = 1\r\n\t\telse\r\n\t\t\tupdate PRODUCTO_TIENDA set Stock = Stock + @Cantidad where IdProducto = @IdProducto and IdTienda = @IdTienda and Iniciado = 1\r\n\tend try\r\n\tbegin catch\r\n\t\tset @Resultado = 0\r\n\tend catch\r\nend\r\n\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ControlarStock' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_DesactivarProducto]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_DesactivarProducto' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_DesactivarProducto]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\nCREATE PROCEDURE [dbo].[usp_DesactivarProducto]\r\n    @IdProducto INT,\r\n    @Resultado  BIT OUTPUT\r\nAS\r\nBEGIN\r\n    SET NOCOUNT ON;\r\n    SET @Resultado = 0;\r\n\r\n    UPDATE PRODUCTO\r\n    SET    Activo = 0\r\n    WHERE  IdProducto = @IdProducto;\r\n\r\n    IF @@ROWCOUNT > 0\r\n        SET @Resultado = 1;\r\nEND\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_DesactivarProducto' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_EliminarCategoria]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_EliminarCategoria' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_EliminarCategoria]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n--PROCEDIMIENTO PARA ELIMINAR CATEGORIA\r\ncreate procedure [dbo].[usp_EliminarCategoria](\r\n@IdCategoria int,\r\n@Resultado bit output\r\n)\r\nas\r\nbegin\r\n\tSET @Resultado = 1\r\n\r\n\t--validamos que ninguna categoria este relacionada a un producto\r\n\tIF not EXISTS (select * from CATEGORIA c\r\n\tinner join PRODUCTO p on c.IdCategoria  = p.IdCategoria\r\n\twhere c.IdCategoria = @IdCategoria)\r\n\r\n\t\tdelete from CATEGORIA where IdCategoria = @IdCategoria\r\n\r\n\tELSE\r\n\t\tSET @Resultado = 0\r\n\r\nend\r\n\r\n\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_EliminarCategoria' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_EliminarCliente]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_EliminarCliente' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_EliminarCliente]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n--PROCEDIMIENTO PARA ELIMINAR CLIENTE\r\ncreate procedure [dbo].[usp_EliminarCliente](\r\n@IdCliente int,\r\n@Resultado bit output\r\n)\r\nas\r\nbegin\r\n\tset @Resultado = 1\r\n\tbegin try\r\n\t\tdelete from CLIENTE where IdCliente = @IdCliente\r\n\r\n\tend try\r\n\tbegin catch\r\n\t\tset @Resultado = 0\r\n\tend catch\r\nend\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_EliminarCliente' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_EliminarMotivoBaja]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_EliminarMotivoBaja' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_EliminarMotivoBaja]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\nCREATE PROC [dbo].[usp_EliminarMotivoBaja]\n    @IdMotivoBaja INT,\n    @Resultado    BIT OUTPUT\nAS\nBEGIN\n    -- Bloquear eliminación si está en uso en algún movimiento\n    IF EXISTS (\n        SELECT 1 FROM HISTORIAL_MOVIMIENTO\n        WHERE IdMotivoBaja = @IdMotivoBaja\n    )\n    BEGIN\n        SET @Resultado = 0; RETURN\n    END\n    DELETE FROM MotivoBaja WHERE IdMotivoBaja = @IdMotivoBaja\n    SET @Resultado = CAST(@@ROWCOUNT AS BIT)\nEND\n\r\n","GO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_EliminarMotivoBaja' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_EliminarProducto]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_EliminarProducto' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_EliminarProducto]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n--PROCEDIMIENTO PARA ELIMINAR PRODUCTO\r\ncreate procedure [dbo].[usp_EliminarProducto](\r\n@IdProducto int,\r\n@Resultado bit output\r\n)\r\nas\r\nbegin\r\n\tSET @Resultado = 1\r\n\r\n\t--validamos que ningun producto se encuentre relacionado a una tienda\r\n\tIF not EXISTS (select top 1 * from PRODUCTO_TIENDA PT\r\nINNER JOIN PRODUCTO P ON P.IdProducto = PT.IdProducto\r\nWHERE P.IdProducto = @IdProducto)\r\n\t\tdelete from PRODUCTO where IdProducto = @IdProducto\r\n\r\n\tELSE\r\n\t\tSET @Resultado = 0\r\n\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_EliminarProducto' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_EliminarProductoTienda]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_EliminarProductoTienda' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_EliminarProductoTienda]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n--PROCEDIMIENTO PARA ELIMINAR PRODUCTO_TIENDA\r\ncreate procedure [dbo].[usp_EliminarProductoTienda](\r\n@IdProductoTienda int,\r\n@Resultado bit output\r\n)\r\nas\r\nbegin\r\n\tSET @Resultado = 1\r\n\r\n\tIF NOT EXISTS (SELECT * FROM PRODUCTO_TIENDA WHERE IdProductoTienda = @IdProductoTienda and Iniciado = 1 )\r\n\r\n\t\tdelete from PRODUCTO_TIENDA where IdProductoTienda = @IdProductoTienda\r\n\r\n\tELSE\r\n\t\tSET @Resultado = 0\r\n\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_EliminarProductoTienda' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_EliminarProveedor]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_EliminarProveedor' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_EliminarProveedor]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n--PROCEDIMIENTO PARA ELIMINAR PROVEEDOR\r\ncreate procedure [dbo].[usp_EliminarProveedor](\r\n@IdProveedor int,\r\n@Resultado bit output\r\n)\r\nas\r\nbegin\r\n\tSET @Resultado = 1\r\n\t--validamos que ningun proveedor se encuentre asignado a una compra\r\n\tIF not EXISTS (select top 1 * from COMPRA c\r\ninner join PROVEEDOR p on p.IdProveedor = c.IdProveedor\r\nwhere p.IdProveedor = @IdProveedor)\r\n\r\n\t\tdelete from PROVEEDOR where IdProveedor = @IdProveedor\r\n\tELSE\r\n\t\tSET @Resultado = 0\r\n\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_EliminarProveedor' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_EliminarRol]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_EliminarRol' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_EliminarRol]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n--PROCEDIMIENTO PARA ELIMINAR ROL\r\ncreate procedure [dbo].[usp_EliminarRol](\r\n@IdRol int,\r\n@Resultado bit output\r\n)\r\nas\r\nbegin\r\n\tSET @Resultado = 1\r\n\r\n\t--validamos que el rol no se encuentre asignado a algun usuario\r\n\tIF not EXISTS (select * from USUARIO u\r\n\tinner join ROL r on r.IdRol  = u.IdRol\r\n\twhere r.IdRol = @IdRol)\r\n\tbegin\t\r\n\t\tdelete from PERMISOS where IdRol = @IdRol\r\n\t\tdelete from ROL where IdRol = @IdRol\r\n\tend\r\n\tELSE\r\n\t\tSET @Resultado = 0\r\n\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_EliminarRol' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_EliminarTienda]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_EliminarTienda' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_EliminarTienda]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","--PROCEDIMIENTO PARA ELIMINAR TIENDA\r\ncreate procedure [dbo].[usp_EliminarTienda](\r\n@IdTienda int,\r\n@Resultado bit output\r\n)\r\nas\r\nbegin\r\n\tSET @Resultado = 1\r\n\r\n\t--validamos que la tienda no se encuentre asignada a un usuario y una venta\r\n\tIF not EXISTS (select * from USUARIO u\r\n\tinner join TIENDA t on t.IdTienda = u.IdTienda\r\n\twhere t.IdTienda = @IdTienda)\r\n\r\n\t\tdelete from TIENDA where IdTienda = @IdTienda\r\n\r\n\tELSE\r\n\t\tSET @Resultado = 0\r\n\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_EliminarTienda' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_EliminarUsuario]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_EliminarUsuario' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_EliminarUsuario]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n--PROCEDIMIENTO PARA ELIMINAR USUARIO\r\ncreate procedure [dbo].[usp_EliminarUsuario](\r\n@IdUsuario int,\r\n@Resultado bit output\r\n)\r\nas\r\nbegin\r\n\tSET @Resultado = 1\r\n\r\n\t--validamos que ningun usuario se encuentre relacionado a una tienda\r\n\tIF (not EXISTS (select c.* from COMPRA c \r\n\t\tinner join USUARIO u on u.IdUsuario = c.IdUsuario \r\n\t\twhere u.IdUsuario = @IdUsuario\r\n\t\t) and \r\n\t\tnot EXISTS (select v.* from VENTA v \r\n\t\tinner join USUARIO u on u.IdUsuario = v.IdUsuario \r\n\t\twhere u.IdUsuario = @IdUsuario\r\n\t\t)\r\n\t)\r\n\t\tdelete from USUARIO where IdUsuario = @IdUsuario\r\n\tELSE\r\n\t\tSET @Resultado = 0\r\n\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_EliminarUsuario' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_InsertarPrecioVentaConControl]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_InsertarPrecioVentaConControl' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_InsertarPrecioVentaConControl]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","CREATE PROCEDURE [dbo].[usp_InsertarPrecioVentaConControl]\r\n(\r\n    @IdProducto INT,\r\n    @PrecioVenta INT,\r\n    @FechaInicio DATE,\r\n    @FechaFin DATE = NULL,\r\n    @Resultado BIT OUTPUT\r\n)\r\nAS\r\nBEGIN\r\n    SET NOCOUNT ON;\r\n\r\n    -- Si la fecha de inicio es hoy o anterior, cerrar vigencia anterior\r\n    IF @FechaInicio <= CAST(GETDATE() AS DATE)\r\n    BEGIN\r\n        UPDATE Precio_Venta\r\n        SET FechaFin = DATEADD(DAY, -1, @FechaInicio)\r\n        WHERE IdProducto = @IdProducto\r\n          AND FechaFin IS NULL\r\n          AND Activo = 1;\r\n    END\r\n\r\n    -- Insertar el nuevo precio\r\n    INSERT INTO Precio_Venta\r\n    (\r\n        PrecioVenta,\r\n        IdProducto,\r\n        FechaInicio,\r\n        FechaFin,\r\n        Activo,\r\n        FechaRegistro\r\n    )\r\n    VALUES\r\n    (\r\n        @PrecioVenta,\r\n        @IdProducto,\r\n        @FechaInicio,\r\n        @FechaFin,\r\n        1,\r\n        GETDATE()\r\n    );\r\n\r\n    SET @Resultado = CASE WHEN @@ROWCOUNT > 0 THEN 1 ELSE 0 END;\r\nEND\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_InsertarPrecioVentaConControl' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_LoginUsuario]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_LoginUsuario' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_LoginUsuario]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n--PROCEDMIENTO PARA OBTENER USUARIO\r\n\r\ncreate procedure [dbo].[usp_LoginUsuario](\r\n@Correo varchar(60),\r\n@Clave varchar(100),\r\n@IdUsuario int output\r\n)\r\nas\r\nbegin\r\n\tset @IdUsuario = 0\r\n\tif exists(select * from USUARIO where Correo COLLATE Latin1_General_CS_AS = @Correo and Clave COLLATE Latin1_General_CS_AS = @Clave and Activo = 1)\r\n\t\tset @IdUsuario = (select top 1 IdUsuario from USUARIO where Correo  COLLATE Latin1_General_CS_AS = @Correo and Clave COLLATE Latin1_General_CS_AS = @Clave and Activo = 1)\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_LoginUsuario' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ModificarCategoria]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ModificarCategoria' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ModificarCategoria]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n--PROCEDIMIENTO PARA MODIFICAR CATEGORIA\r\ncreate procedure [dbo].[usp_ModificarCategoria](\r\n@IdCategoria int,\r\n@Descripcion varchar(60),\r\n@Activo bit,\r\n@Resultado bit output\r\n)\r\nas\r\nbegin\r\n\tSET @Resultado = 1\r\n\tIF NOT EXISTS (SELECT * FROM CATEGORIA WHERE Descripcion =@Descripcion and IdCategoria != @IdCategoria)\r\n\t\t\r\n\t\tupdate CATEGORIA set \r\n\t\tDescripcion = @Descripcion,\r\n\t\tActivo = @Activo\r\n\t\twhere IdCategoria = @IdCategoria\r\n\tELSE\r\n\t\tSET @Resultado = 0\r\n\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ModificarCategoria' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ModificarCliente]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ModificarCliente' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ModificarCliente]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","--PROCEDIMIENTO PARA MODIFICAR CLIENTE\r\nCREATE PROC [dbo].[usp_ModificarCliente](\r\n@IdCliente int,\r\n@TipoDocumento varchar(100),\r\n@NumeroDocumento varchar(100),\r\n@Nombre varchar(100),\r\n@Direccion varchar(100),\r\n@Telefono varchar(100),\r\n@Activo bit,\r\n@Resultado bit output\r\n)as\r\nbegin\r\n\tSET @Resultado = 1\r\n\tIF NOT EXISTS (SELECT * FROM CLIENTE WHERE NumeroDocumento = @NumeroDocumento and IdCliente != @IdCliente)\r\n\tbegin\r\n\t\tupdate CLIENTE set \r\n\t\tTipoDocumento = @TipoDocumento,\r\n\t\tNumeroDocumento = @NumeroDocumento,\r\n\t\tNombre = @Nombre,\r\n\t\tDireccion = @Direccion,\r\n\t\tTelefono = @Telefono,\r\n\t\tActivo = @Activo\r\n\t\twhere IdCliente = @IdCliente\r\n\tend\r\n\tELSE\r\n\t\tSET @Resultado = 0\r\n\t\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ModificarCliente' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ModificarMotivoBaja]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ModificarMotivoBaja' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ModificarMotivoBaja]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\nCREATE PROC [dbo].[usp_ModificarMotivoBaja]\n    @IdMotivoBaja INT,\n    @Descripcion  VARCHAR(100),\n    @Activo       BIT,\n    @Resultado    BIT OUTPUT\nAS\nBEGIN\n    IF EXISTS (\n        SELECT 1 FROM MotivoBaja\n        WHERE Descripcion = @Descripcion AND IdMotivoBaja <> @IdMotivoBaja\n    )\n    BEGIN\n        SET @Resultado = 0; RETURN\n    END\n    UPDATE MotivoBaja\n       SET Descripcion = @Descripcion, Activo = @Activo\n     WHERE IdMotivoBaja = @IdMotivoBaja\n    SET @Resultado = 1\nEND\n\r\n","GO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ModificarMotivoBaja' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ModificarPrecioVenta]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ModificarPrecioVenta' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ModificarPrecioVenta]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","CREATE PROCEDURE [dbo].[usp_ModificarPrecioVenta]\r\n    @IdPrecioVenta INT,\r\n    @IdProducto INT,\r\n    @PrecioVenta INT,\r\n    @FechaInicioVigencia DATE,\r\n    @FechaFinVigencia DATE = NULL,\r\n    @Resultado BIT OUTPUT\r\nAS\r\nBEGIN\r\n    SET NOCOUNT ON;\r\n\r\n    -- Validar solapamientos igual que antes\r\n    DECLARE @Conflictos INT;\r\n\r\n    SELECT @Conflictos = COUNT(*)\r\n    FROM Precio_Venta\r\n    WHERE IdProducto = @IdProducto\r\n      AND IdPrecioVenta <> @IdPrecioVenta\r\n      AND Activo = 1\r\n      AND (\r\n            (@FechaInicioVigencia BETWEEN FechaInicio AND ISNULL(FechaFin, '99991231'))\r\n         OR (@FechaFinVigencia IS NOT NULL AND @FechaFinVigencia BETWEEN FechaInicio AND ISNULL(FechaFin, '99991231'))\r\n         OR (FechaInicio BETWEEN @FechaInicioVigencia AND ISNULL(@FechaFinVigencia, '99991231'))\r\n         OR (FechaFin IS NOT NULL AND FechaFin BETWEEN @FechaInicioVigencia AND ISNULL(@FechaFinVigencia, '99991231'))\r\n          );\r\n\r\n    IF @Conflictos > 0\r\n    BEGIN\r\n        THROW 50000, 'Las fechas de vigencia se solapan con otro precio.', 1;\r\n    END\r\n\r\n    BEGIN TRY\r\n        -- Actualizar el precio anterior al nuevo inicio si es distinto\r\n        UPDATE Precio_Venta\r\n        SET FechaFin = DATEADD(DAY, -1, @FechaInicioVigencia)\r\n        WHERE IdProducto = @IdProducto\r\n          AND Activo = 1\r\n          AND IdPrecioVenta <> @IdPrecioVenta\r\n          AND (FechaFin IS NULL OR FechaFin >= @FechaInicioVigencia)\r\n          AND FechaInicio < @FechaInicioVigencia;\r\n\r\n        -- Actualizar el precio actual\r\n        UPDATE Precio_Venta\r\n        SET \r\n            PrecioVenta = @PrecioVenta,\r\n            FechaInicio = @FechaInicioVigencia,\r\n            FechaFin = @FechaFinVigencia,\r\n            FechaRegistro = GETDATE()\r\n        WHERE IdPrecioVenta = @IdPrecioVenta;\r\n\r\n        SET @Resultado = CASE WHEN @@ROWCOUNT > 0 THEN 1 ELSE 0 END;\r\n    END TRY\r\n    BEGIN CATCH\r\n        SET @Resultado = 0;\r\n    END CATCH\r\nEND\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ModificarPrecioVenta' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ModificarProducto]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ModificarProducto' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ModificarProducto]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n--PROCEDIMIENTO PARA MODIFICAR PRODUCTO\r\ncreate procedure [dbo].[usp_ModificarProducto](\r\n@IdProducto int,\r\n@Nombre varchar(50),\r\n@Descripcion varchar(50),\r\n@IdCategoria int,\r\n@Activo bit,\r\n@Resultado bit output\r\n)\r\nas\r\nbegin\r\n\tSET @Resultado = 1\r\n\tIF NOT EXISTS (SELECT * FROM PRODUCTO WHERE rtrim(ltrim(Nombre)) = rtrim(ltrim(@Nombre)) and IdProducto != @IdProducto)\r\n\t\t\r\n\t\tupdate PRODUCTO set\r\n\t\tNombre = @Nombre,\r\n\t\tDescripcion = @Descripcion,\r\n\t\tIdCategoria = @IdCategoria,\r\n\t\tActivo = @Activo\r\n\t\twhere IdProducto = @IdProducto\r\n\tELSE\r\n\t\tSET @Resultado = 0\r\n\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ModificarProducto' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ModificarProductoTienda]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ModificarProductoTienda' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ModificarProductoTienda]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n--PROCEDIMIENTO PARA MODIFICAR PRODUCTO_TIENDA\r\ncreate procedure [dbo].[usp_ModificarProductoTienda](\r\n@IdProductoTienda int,\r\n@IdProducto varchar(60),\r\n@IdTienda varchar(60),\r\n@Resultado bit output\r\n)\r\nas\r\nbegin\r\n\tSET @Resultado = 1\r\n\tIF NOT EXISTS (SELECT * FROM PRODUCTO_TIENDA WHERE @IdProductoTienda = @IdProductoTienda and Iniciado = 1 )\r\n\t\t\r\n\t\tupdate PRODUCTO_TIENDA set \r\n\t\tIdProducto = @IdProducto,\r\n\t\tIdTienda = @IdTienda\r\n\t\twhere IdProductoTienda = @IdProductoTienda\r\n\tELSE\r\n\t\tSET @Resultado = 0\r\n\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ModificarProductoTienda' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ModificarProveedor]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ModificarProveedor' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ModificarProveedor]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n\r\n--PROCEDIMIENTO PARA MODIFICAR PROVEEDOR\r\ncreate procedure [dbo].[usp_ModificarProveedor](\r\n@IdProveedor int,\r\n@Ruc varchar(50),\r\n@RazonSocial varchar(100),\r\n@Telefono varchar(50),\r\n@Correo varchar(50),\r\n@Direccion varchar(50),\r\n@Activo bit,\r\n@Resultado bit output\r\n)\r\nas\r\nbegin\r\n\tSET @Resultado = 1\r\n\tIF NOT EXISTS (SELECT * FROM PROVEEDOR WHERE RUC = @Ruc and IdProveedor != @IdProveedor)\r\n\t\t\r\n\t\tupdate PROVEEDOR set \r\n\t\tRUC = @Ruc,\r\n\t\tRazonSocial = @RazonSocial,\r\n\t\tTelefono = @Telefono,\r\n\t\tCorreo = @Correo,\r\n\t\tDireccion = @Direccion,\r\n\t\tActivo = @Activo\r\n\t\twhere IdProveedor = @IdProveedor\r\n\tELSE\r\n\t\tSET @Resultado = 0\r\n\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ModificarProveedor' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ModificarRol]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ModificarRol' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ModificarRol]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n--PROCEDIMIENTO PARA MODIFICAR ROLES\r\ncreate procedure [dbo].[usp_ModificarRol](\r\n@IdRol int,\r\n@Descripcion varchar(60),\r\n@Activo bit,\r\n@Resultado bit output\r\n)\r\nas\r\nbegin\r\n\tSET @Resultado = 1\r\n\tIF NOT EXISTS (SELECT * FROM ROL WHERE Descripcion =@Descripcion and IdRol != @IdRol)\r\n\t\t\r\n\t\tupdate ROL set \r\n\t\tDescripcion = @Descripcion,\r\n\t\tActivo = @Activo\r\n\t\twhere IdRol = @IdRol\r\n\tELSE\r\n\t\tSET @Resultado = 0\r\n\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ModificarRol' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ModificarTienda]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ModificarTienda' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ModificarTienda]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","--PROCEDIMIENTO PARA MODIFICAR TIENDA\r\ncreate procedure [dbo].[usp_ModificarTienda](\r\n@IdTienda int,\r\n@Nombre varchar(60),\r\n@Ruc varchar(60),\r\n@Direccion varchar(60),\r\n@Telefono varchar(60),\r\n@Activo bit,\r\n@Resultado bit output\r\n)\r\nas\r\nbegin\r\n\tSET @Resultado = 1\r\n\tIF NOT EXISTS (SELECT * FROM TIENDA WHERE Nombre =@Nombre and IdTienda != @IdTienda)\r\n\t\t\r\n\t\tupdate TIENDA set \r\n\t\tNombre = @Nombre,\r\n\t\tRUC = @Ruc,\r\n\t\tDireccion = @Direccion,\r\n\t\tTelefono = @Telefono,\r\n\t\tActivo = @Activo\r\n\t\twhere IdTienda = @IdTienda\r\n\r\n\tELSE\r\n\t\tSET @Resultado = 0\r\n\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ModificarTienda' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ModificarUsuario]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ModificarUsuario' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ModificarUsuario]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","--PROCEDIMIENTO PARA MODIFICAR USUARIO\r\nCREATE procedure [dbo].[usp_ModificarUsuario](\r\n@IdUsuario int,\r\n@Nombres varchar(50),\r\n@Apellidos varchar(50),\r\n@Correo varchar(50),\r\n@Clave varchar(50),\r\n@IdTienda int,\r\n@IdRol int,\r\n@Activo bit,\r\n@Resultado bit output\r\n)\r\nas\r\nbegin\r\n\tSET @Resultado = 1\r\n\tIF NOT EXISTS (SELECT * FROM USUARIO WHERE Correo = @Correo and IdUsuario != @IdUsuario)\r\n\t\t\r\n\t\tupdate USUARIO set \r\n\t\tNombres = @Nombres,\r\n\t\tApellidos = @Apellidos,\r\n\t\tCorreo = @Correo,\r\n\t\tIdTienda = @IdTienda,\r\n\t\tIdRol = @IdRol,\r\n\t\tActivo = @Activo\r\n\t\twhere IdUsuario = @IdUsuario\r\n\r\n\tELSE\r\n\t\tSET @Resultado = 0\r\n\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ModificarUsuario' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ObtenerCategorias]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerCategorias' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ObtenerCategorias]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n\r\n--PROCEDMIENTO PARA OBTENER CATEGORIA\r\nCREATE PROC [dbo].[usp_ObtenerCategorias]\r\nas\r\nbegin\r\n select IdCategoria,Descripcion,Activo from CATEGORIA\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerCategorias' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ObtenerCliente]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerCliente' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ObtenerCliente]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n\r\n--PROCEDMIENTO PARA OBTENER USUARIOS\r\nCREATE PROC [dbo].[usp_ObtenerCliente]\r\nas\r\nbegin\r\n  select IdCliente,TipoDocumento,NumeroDocumento,Nombre,Direccion,Telefono,Activo from CLIENTE\r\nend\r\n\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerCliente' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ObtenerDetalleCompra]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerDetalleCompra' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ObtenerDetalleCompra]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n--PROCEDMIENTO PARA OBTENER DETALLE COMPRA\r\ncreate proc [dbo].[usp_ObtenerDetalleCompra](\r\n@IdCompra int\r\n)\r\nas\r\nbegin\r\n\r\n\r\nselect  RIGHT('000000' + convert(varchar(max),c.IdCompra),6)[Codigo],\r\nCONVERT(char(10),c.FechaRegistro,103)[FechaCompra],\r\nCONVERT(decimal(10,2), c.TotalCosto)[TotalCosto],\r\n\r\n(select p.RUC,p.RazonSocial from PROVEEDOR P\r\n where p.IdProveedor = c.IdProveedor\r\nFOR XML PATH (''),TYPE) AS 'DETALLE_PROVEEDOR',\r\n\r\n(select T.RUC, T.Nombre, T.Direccion from TIENDA T\r\n where T.IdTienda = c.IdTienda\r\nFOR XML PATH (''),TYPE) AS 'DETALLE_TIENDA',\r\n\r\n(select convert(int, dc.Cantidad)[Cantidad],concat(p.Nombre,' - ',p.Descripcion)[NombreProducto],\r\nCONVERT(decimal(10,2),dc.PrecioUnitarioCompra)PrecioUnitarioCompra,\r\nCONVERT(decimal(10,2),dc.TotalCosto)[TotalCosto] \r\nfrom DETALLE_COMPRA dc\r\ninner join PRODUCTO p on p.IdProducto = dc.IdProducto\r\nwhere dc.IdCompra = c.IdCompra\r\nFOR XML PATH ('PRODUCTO'),TYPE) AS 'DETALLE_PRODUCTO'\r\n\r\nfrom COMPRA c\r\nwhere c.IdCompra =@IdCompra\r\nFOR XML PATH(''), ROOT('DETALLE_COMPRA') \r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerDetalleCompra' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ObtenerDetalleUsuario]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerDetalleUsuario' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ObtenerDetalleUsuario]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\nCREATE PROC [dbo].[usp_ObtenerDetalleUsuario](\n    @IdUsuario INT\n)\nAS\nBEGIN\n    SELECT\n        up.IdUsuario,\n        up.Nombres,\n        up.Apellidos,\n        up.Correo,\n        up.Clave,\n        up.IdRol,\n        up.IdTienda,                        -- puede ser NULL (SuperAdmin)\n        up.Activo,\n        up.FechaRegistro,\n        up.PasswordTemporalHash,\n        up.PasswordTemporalExpira,\n        up.RequiereCambioPassword,\n        up.IntentosFallidos,\n        up.FechaUltimoLogin,\n        up.FechaCambioPassword,\n\n        -- DetalleTienda: solo si tiene tienda asignada (no SuperAdmin)\n        (\n            SELECT\n                t.IdTienda,\n                t.Nombre,\n                t.RUC,\n                t.Direccion,\n                t.Telefono,\n                t.Activo,\n                t.FechaRegistro\n            FROM TIENDA t\n            WHERE t.IdTienda = up.IdTienda\n            FOR XML PATH (''), TYPE\n        ) AS 'DetalleTienda',\n\n        -- DetalleRol: siempre presente\n        (\n            SELECT\n                r.IdRol,\n                r.Descripcion,\n                r.Activo,\n                r.FechaRegistro\n            FROM ROL r\n            WHERE r.IdRol = up.IdRol\n            FOR XML PATH (''), TYPE\n        ) AS 'DetalleRol',\n\n        -- DetalleMenu: SuperAdmin (IdTienda NULL) ve todo el menú activo\n        --              Otros usuarios ven solo sus permisos asignados\n        (\n            SELECT t.NombreMenu, t.Icono,\n            (\n                SELECT sm.Nombre [NombreSubMenu], sm.Controlador, sm.Vista, sm.Icono,\n                       CAST(1 AS BIT) AS Activo\n                FROM SUBMENU sm\n                INNER JOIN MENU m ON m.IdMenu = sm.IdMenu\n                WHERE sm.IdMenu = t.IdMenu\n                  AND sm.Activo = 1\n                  AND (\n                        up.IdTienda IS NULL   -- SuperAdmin: sin filtro de permisos\n                        OR EXISTS (\n                            SELECT 1\n                            FROM PERMISOS p\n                            INNER JOIN ROL r     ON r.IdRol    = p.IdRol\n                            INNER JOIN USUARIO u ON u.IdRol    = r.IdRol\n                            WHERE p.IdSubMenu    = sm.IdSubMenu\n                              AND u.IdUsuario    = up.IdUsuario\n                              AND p.Activo       = 1\n                        )\n                  )\n                FOR XML PATH ('SubMenu'), TYPE\n            ) AS 'DetalleSubMenu'\n            FROM (\n                SELECT DISTINCT m.Nombre [NombreMenu], m.IdMenu, m.Icono\n                FROM MENU m\n                INNER JOIN SUBMENU sm ON sm.IdMenu = m.IdMenu\n                WHERE sm.Activo = 1\n                  AND (\n                        up.IdTienda IS NULL   -- SuperAdmin\n                        OR EXISTS (\n                            SELECT 1\n                            FROM PERMISOS p\n                            INNER JOIN ROL r     ON r.IdRol    = p.IdRol\n                            INNER JOIN USUARIO u ON u.IdRol    = r.IdRol\n                            WHERE p.IdSubMenu    = sm.IdSubMenu\n                              AND u.IdUsuario    = up.IdUsuario\n                              AND p.Activo       = 1\n                        )\n                  )\n            ) t\n            FOR XML PATH ('Menu'), TYPE\n        ) AS 'DetalleMenu'\n\n    FROM USUARIO up\n    WHERE up.IdUsuario = @IdUsuario\n    FOR XML PATH(''), ROOT('Usuario')\nEND\n\r\n","GO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerDetalleUsuario' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ObtenerDetalleVenta]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerDetalleVenta' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ObtenerDetalleVenta]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n--PROCEDMIENTO PARA OBTENER DETALLE VENTA\r\ncreate proc [dbo].[usp_ObtenerDetalleVenta](\r\n@IdVenta int\r\n)\r\nas\r\nbegin\r\n\r\n\r\nselect V.TipoDocumento, V.Codigo,\r\nCONVERT(decimal(10,2), V.TotalCosto)[TotalCosto],\r\nCONVERT(decimal(10,2),V.ImporteRecibido)[ImporteRecibido],\r\nCONVERT(decimal(10,2), V.ImporteCambio)[ImporteCambio],\r\nconvert(char(10),v.fechaRegistro,103)[FechaRegistro],\r\n(select u.Nombres,u.Apellidos from USUARIO U\r\n where U.IdUsuario = v.IdUsuario\r\nFOR XML PATH (''),TYPE) AS 'DETALLE_USUARIO',\r\n\r\n(select T.RUC, T.Nombre, T.Direccion from TIENDA T\r\n where T.IdTienda = V.IdTienda\r\nFOR XML PATH (''),TYPE) AS 'DETALLE_TIENDA',\r\n\r\n(select C.Nombre,C.Direccion,C.NumeroDocumento,C.Telefono from CLIENTE c\r\n where c.IdCliente = V.IdCliente\r\nFOR XML PATH (''),TYPE) AS 'DETALLE_CLIENTE',\r\n\r\n(select dv.Cantidad,concat(p.Nombre,'-',p.Descripcion)[NombreProducto],\r\nCONVERT(decimal(10,2),dv.PrecioUnidad)[PrecioUnidad],\r\nCONVERT(decimal(10,2),dv.ImporteTotal)[ImporteTotal] \r\nfrom DETALLE_VENTA dv\r\ninner join PRODUCTO p on p.IdProducto = dv.IdProducto\r\nwhere dv.IdVenta = v.IdVenta\r\nFOR XML PATH ('PRODUCTO'),TYPE) AS 'DETALLE_PRODUCTO'\r\n\r\nfrom VENTA v\r\nwhere v.IdVenta = @IdVenta\r\nFOR XML PATH(''), ROOT('DETALLE_VENTA') \r\n\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerDetalleVenta' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ObtenerHistorialPreciosVentaPorProducto]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerHistorialPreciosVentaPorProducto' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ObtenerHistorialPreciosVentaPorProducto]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","CREATE PROCEDURE [dbo].[usp_ObtenerHistorialPreciosVentaPorProducto]\r\n    @IdProducto INT\r\nAS\r\nBEGIN\r\n    SET NOCOUNT ON;\r\n\r\n    SELECT \r\n        IdPrecioVenta,\r\n        IdProducto,\r\n        PrecioVenta AS PrecioVenta,\r\n        FechaInicio AS FechaInicioVigencia,\r\n        FechaFin AS FechaFinVigencia\r\n    FROM PRECIO_VENTA\r\n    WHERE IdProducto = @IdProducto\r\n    ORDER BY FechaInicio DESC;\r\nEND\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerHistorialPreciosVentaPorProducto' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ObtenerListaCompra]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerListaCompra' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ObtenerListaCompra]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n\r\n--PROCEDMIENTO PARA OBTENER LISTA COMPRA\r\ncreate procedure [dbo].[usp_ObtenerListaCompra](\r\n@FechaInicio date,\r\n@FechaFin date,\r\n@IdProveedor int = 0 ,\r\n@IdTienda int = 0\r\n)\r\nas\r\nbegin\r\nSET DATEFORMAT dmy;\r\nselect c.IdCompra,RIGHT('000000' + convert(varchar(max),c.IdCompra),6)[NumeroCompra], p.RazonSocial,t.Nombre,\r\nconvert(char(10),c.FechaRegistro,103)[FechaCompra],c.TotalCosto from COMPRA c\r\ninner join PROVEEDOR p on p.IdProveedor = c.IdProveedor\r\ninner join TIENDA t on t.IdTienda = c.IdTienda\r\nwhere \r\nCONVERT(date,c.FechaRegistro) between @FechaInicio and @FechaFin and\r\np.IdProveedor = iif(@IdProveedor = 0,p.IdProveedor,@IdProveedor) and\r\nt.IdTienda =iif(@IdTienda = 0,t.IdTienda,@IdTienda) \r\n\r\nend\r\n\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerListaCompra' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ObtenerListaVenta]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerListaVenta' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ObtenerListaVenta]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n--PROCEDMIENTO PARA OBTENER LISTA VENTA\r\n\r\ncreate procedure [dbo].[usp_ObtenerListaVenta](\r\n@Codigo varchar(50) = '',\r\n@FechaInicio date,\r\n@FechaFin date,\r\n@NumeroDocumento varchar(50) = '',\r\n@Nombre varchar(100) = ''\r\n)\r\nas\r\nbegin\r\nSET DATEFORMAT dmy;\r\nselect v.IdVenta, v.TipoDocumento,v.Codigo,v.FechaRegistro,c.NumeroDocumento,c.Nombre,v.TotalCosto from VENTA v \r\ninner join CLIENTE c on c.IdCliente = v.IdCliente\r\nwhere \r\nv.Codigo = iif(@Codigo='',v.Codigo,@Codigo) and\r\nCONVERT(date,v.FechaRegistro) between @FechaInicio and @FechaFin and\r\nc.NumeroDocumento like CONCAT('%',@NumeroDocumento,'%') and\r\nc.Nombre like CONCAT('%',@Nombre,'%')\r\n\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerListaVenta' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ObtenerMotivosBaja]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerMotivosBaja' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ObtenerMotivosBaja]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\n-- ═══════════════════════════════════════════════════════════\n-- 3. Stored Procedures MotivoBaja\n-- ═══════════════════════════════════════════════════════════\nCREATE PROC [dbo].[usp_ObtenerMotivosBaja]\nAS\nBEGIN\n    SELECT IdMotivoBaja, Descripcion, Activo, FechaRegistro\n    FROM MotivoBaja\n    ORDER BY Descripcion\nEND\n\r\n","GO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerMotivosBaja' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ObtenerMovimientosCaja]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerMovimientosCaja' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ObtenerMovimientosCaja]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","CREATE PROCEDURE [dbo].[usp_ObtenerMovimientosCaja]\r\n    @FechaInicio DATETIME = NULL,\r\n    @FechaFin DATETIME = NULL,\r\n    @Pagina INT = 1,\r\n    @RegistrosPorPagina INT = 10\r\nAS\r\nBEGIN\r\n    SET NOCOUNT ON;\r\n\r\n    DECLARE @Inicio INT = (@Pagina - 1) * @RegistrosPorPagina;\r\n\r\n    WITH MovimientoPaginado AS (\r\n        SELECT\r\n            m.IdMovimiento,\r\n            m.NumeroFactura,\r\n            m.NumeroTimbrado,\r\n            m.FechaTransaccion,\r\n            m.MontoOperacion,\r\n            m.EstadoPago,\r\n            m.IdTienda,\r\n            m.IdUsuario,\r\n            m.IdProveedor,\r\n            ROW_NUMBER() OVER (ORDER BY m.FechaTransaccion DESC) AS Fila\r\n        FROM MOVIMIENTOS m\r\n        WHERE m.TipoOperacion = 'Compra'\r\n            AND (@FechaInicio IS NULL OR m.FechaTransaccion >= @FechaInicio)\r\n            AND (@FechaFin IS NULL OR m.FechaTransaccion <= @FechaFin)\r\n    )\r\n    SELECT \r\n        IdMovimiento,\r\n        NumeroFactura,\r\n        NumeroTimbrado,\r\n        FechaTransaccion,\r\n        MontoOperacion,\r\n        EstadoPago,\r\n        IdTienda,\r\n        IdUsuario,\r\n        IdProveedor\r\n    FROM MovimientoPaginado\r\n    WHERE Fila BETWEEN @Inicio + 1 AND (@Inicio + @RegistrosPorPagina);\r\n\r\n    SELECT COUNT(*) AS TotalRegistros\r\n    FROM MOVIMIENTOS m\r\n    WHERE m.TipoOperacion = 'Compra'\r\n        AND (@FechaInicio IS NULL OR m.FechaTransaccion >= @FechaInicio)\r\n        AND (@FechaFin IS NULL OR m.FechaTransaccion <= @FechaFin);\r\nEND\r\n\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerMovimientosCaja' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ObtenerPermisos]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerPermisos' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ObtenerPermisos]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n--PROCEDMIENTO PARA OBTENER PERMISOS\r\ncreate procedure [dbo].[usp_ObtenerPermisos](\r\n@IdRol int)\r\nas\r\nbegin\r\nselect p.IdPermisos,m.Nombre[Menu],sm.Nombre[SubMenu],p.Activo from PERMISOS p\r\ninner join SUBMENU sm on sm.IdSubMenu = p.IdSubMenu\r\ninner join MENU m on m.IdMenu = sm.IdMenu\r\nwhere p.IdRol = @IdRol\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerPermisos' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ObtenerPrecioVentaPorId]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerPrecioVentaPorId' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ObtenerPrecioVentaPorId]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","CREATE PROCEDURE [dbo].[usp_ObtenerPrecioVentaPorId]\r\n    @IdPrecioVenta INT\r\nAS\r\nBEGIN\r\n    SET NOCOUNT ON;\r\n\r\n    SELECT TOP 1\r\n        IdPrecioVenta,\r\n        PrecioVenta,\r\n        IdProducto,\r\n        FechaInicio,\r\n        FechaFin,\r\n        Activo,\r\n        FechaRegistro\r\n    FROM dbo.PRECIO_VENTA\r\n    WHERE IdPrecioVenta = @IdPrecioVenta;\r\nEND\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerPrecioVentaPorId' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ObtenerProductos]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerProductos' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ObtenerProductos]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n--PROCEMIENTO PARA OBTENER PRODUCTO\r\nCREATE PROC [dbo].[usp_ObtenerProductos]\r\nas\r\nbegin\r\n select IdProducto,Codigo,ValorCodigo,Nombre,p.Descripcion[DescripcionProducto],p.IdCategoria,p.Activo,c.Descripcion[DescripcionCategoria] from PRODUCTO p\r\n inner join CATEGORIA c on c.IdCategoria = p.IdCategoria\r\n\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerProductos' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ObtenerProductosPorTiendaBaja]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerProductosPorTiendaBaja' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ObtenerProductosPorTiendaBaja]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\nCREATE PROCEDURE [dbo].[usp_ObtenerProductosPorTiendaBaja]\r\n    @IdTienda INT\r\nAS\r\nBEGIN\r\n    SET NOCOUNT ON;\r\n\r\n    SELECT\r\n        pt.IdProductoTienda,\r\n        p.IdProducto,\r\n        p.Codigo,\r\n        p.Nombre,\r\n        pt.Stock\r\n    FROM PRODUCTO_TIENDA pt\r\n    INNER JOIN Producto p ON pt.IdProducto = p.IdProducto\r\n    WHERE pt.IdTienda = @IdTienda AND pt.Activo = 1 AND pt.Stock > 0\r\n    ORDER BY p.Nombre;\r\nEND\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerProductosPorTiendaBaja' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ObtenerProductoTienda]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerProductoTienda' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ObtenerProductoTienda]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","/********************* PRODUCTO_TIENDA **************************/\r\n\r\n\r\n--PROCEDMIENTO PARA OBTENER PRODUCTO_TIENDA\r\nCREATE PROC [dbo].[usp_ObtenerProductoTienda]\r\nas\r\nbegin\r\n select pt.IdProductoTienda,p.IdProducto,p.Codigo[CodigoProducto], p.Nombre[NombreProducto],p.Descripcion[DescripcionProducto],\r\n t.IdTienda,t.RUC,t.Nombre[NombreTienda] ,t.Direccion[DireccionTienda],pt.PrecioUnidadCompra,pt.PrecioUnidadVenta,pt.Stock,pt.Iniciado\r\n from PRODUCTO_TIENDA pt\r\n inner join PRODUCTO p on p.IdProducto = pt.IdProducto\r\n inner join TIENDA t on t.IdTienda = pt.IdTienda\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerProductoTienda' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ObtenerProveedores]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerProveedores' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ObtenerProveedores]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","--PROCEDMIENTO PARA OBTENER PROVEEDORES\r\nCREATE PROC [dbo].[usp_ObtenerProveedores]\r\nas\r\nbegin\r\n select IdProveedor,RUC,RazonSocial,Telefono,Correo,Direccion,Activo from PROVEEDOR\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerProveedores' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ObtenerRoles]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerRoles' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ObtenerRoles]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n--PROCEDMIENTO PARA OBTENER ROLES\r\nCREATE PROC [dbo].[usp_ObtenerRoles]\r\nas\r\nbegin\r\n select IdRol, Descripcion,Activo from ROL\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerRoles' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ObtenerStockPorTienda]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerStockPorTienda' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ObtenerStockPorTienda]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\nCREATE PROCEDURE [dbo].[usp_ObtenerStockPorTienda]\r\n    @IdTienda   INT = 0,  -- 0 = todas\r\n    @IdProducto INT = 0   -- 0 = todos\r\nAS\r\nBEGIN\r\n    SET NOCOUNT ON;\r\n\r\n    SELECT\r\n        pt.IdProductoTienda,\r\n        p.IdProducto,\r\n        p.Codigo,\r\n        p.Nombre            AS NombreProducto,\r\n        c.Descripcion       AS Categoria,\r\n        t.IdTienda,\r\n        t.Nombre            AS NombreTienda,\r\n        pt.Stock,\r\n        pt.StockMinimo,\r\n        pt.StockMaximo,\r\n        CASE\r\n            WHEN pt.Stock <= pt.StockMinimo THEN 'CRITICO'\r\n            WHEN pt.Stock <= (pt.StockMinimo * 1.5) THEN 'BAJO'\r\n            ELSE 'OK'\r\n        END AS EstadoStock\r\n    FROM PRODUCTO_TIENDA pt\r\n    INNER JOIN Producto  p ON pt.IdProducto = p.IdProducto\r\n    INNER JOIN Tienda    t ON pt.IdTienda   = t.IdTienda\r\n    INNER JOIN Categoria c ON p.IdCategoria = c.IdCategoria\r\n    WHERE pt.Activo = 1\r\n      AND (@IdTienda = 0   OR pt.IdTienda   = @IdTienda)\r\n      AND (@IdProducto = 0 OR pt.IdProducto = @IdProducto)\r\n    ORDER BY t.Nombre, p.Nombre;\r\nEND\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerStockPorTienda' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ObtenerTienda]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerTienda' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ObtenerTienda]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","--PROCEDMIENTO PARA OBTENER TIENDAS\r\nCREATE PROC [dbo].[usp_ObtenerTienda]\r\nas\r\nbegin\r\n select IdTienda,Nombre,RUC,Direccion,Telefono,Activo from TIENDA\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerTienda' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ObtenerTiendasActivas]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerTiendasActivas' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ObtenerTiendasActivas]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","-- Nuevo SP para obtener todas las tiendas activas\n-- Usado en formularios donde aun no existe usuario (ej: crear empleado)\nCREATE PROCEDURE [dbo].[usp_ObtenerTiendasActivas]\nAS\nBEGIN\n    SELECT IdTienda, Nombre, RUC, Direccion, Telefono, Activo\n    FROM TIENDA\n    WHERE Activo = 1\n    ORDER BY Nombre\nEND\n\r\n","GO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerTiendasActivas' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ObtenerTrasladosHistorial]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerTrasladosHistorial' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ObtenerTrasladosHistorial]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\nCREATE PROCEDURE [dbo].[usp_ObtenerTrasladosHistorial]\r\n    @FechaInicio    DATE,\r\n    @FechaFin       DATE,\r\n    @IdTienda       INT = 0  -- 0 = todas las tiendas\r\nAS\r\nBEGIN\r\n    SET NOCOUNT ON;\r\n\r\n    SELECT\r\n        t.IdTraslado,\r\n        p.Nombre            AS NombreProducto,\r\n        p.Codigo            AS CodigoProducto,\r\n        to1.Nombre          AS TiendaOrigen,\r\n        td1.Nombre          AS TiendaDestino,\r\n        t.Cantidad,\r\n        t.Observaciones,\r\n        CONCAT(u.Nombres, ' ', u.Apellidos) AS Usuario,\r\n        CONVERT(VARCHAR, t.FechaTraslado, 103) AS FechaTraslado\r\n    FROM TRASLADO t\r\n    INNER JOIN Producto   p   ON t.IdProducto       = p.IdProducto\r\n    INNER JOIN Tienda     to1 ON t.IdTiendaOrigen   = to1.IdTienda\r\n    INNER JOIN Tienda     td1 ON t.IdTiendaDestino  = td1.IdTienda\r\n    INNER JOIN Usuario    u   ON t.IdUsuario         = u.IdUsuario\r\n    WHERE CAST(t.FechaTraslado AS DATE) BETWEEN @FechaInicio AND @FechaFin\r\n      AND (@IdTienda = 0 OR t.IdTiendaOrigen = @IdTienda OR t.IdTiendaDestino = @IdTienda)\r\n    ORDER BY t.FechaTraslado DESC;\r\nEND\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerTrasladosHistorial' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ObtenerUsuario]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerUsuario' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ObtenerUsuario]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n--PROCEDMIENTO PARA OBTENER USUARIOS\r\nCREATE PROC [dbo].[usp_ObtenerUsuario]\r\nas\r\nbegin\r\n    SELECT\r\n        u.IdUsuario,\r\n        p.Documento                         AS Documento,\r\n        u.Nombres,\r\n        u.Apellidos,\r\n        u.Correo,\r\n        u.Clave,\r\n        u.IdTienda,\r\n        u.IdRol,\r\n        u.Activo,\r\n        u.FechaRegistro,\r\n        u.PasswordTemporalHash,\r\n        u.PasswordTemporalExpira,\r\n        u.RequiereCambioPassword,\r\n        u.FechaCambioPassword,\r\n        r.Descripcion                       AS DescripcionRol,\r\n        ISNULL(u.IntentosFallidos, 0)       AS IntentosFallidos,\r\n        u.FechaUltimoLogin\r\n    FROM USUARIO u\r\n    INNER JOIN EMPLEADO e   ON u.IdEmpleado = e.IdEmpleado\r\n    INNER JOIN Persona p    ON e.IdPersona  = p.IdPersona\r\n    INNER JOIN ROL r        ON r.IdRol      = u.IdRol\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerUsuario' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ObtenerUsuarioPorCorreo]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerUsuarioPorCorreo' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ObtenerUsuarioPorCorreo]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n--PROCEDIMIENTO PARA OBTENER USUARIO POR CORREO (optimizado para login)\r\nCREATE PROC [dbo].[usp_ObtenerUsuarioPorCorreo]\r\n    @Correo VARCHAR(100)\r\nAS\r\nBEGIN\r\n    SELECT TOP 1\r\n        u.IdUsuario,\r\n        p.Documento                         AS Documento,\r\n        u.Nombres,\r\n        u.Apellidos,\r\n        u.Correo,\r\n        u.Clave,\r\n        u.IdTienda,\r\n        u.IdRol,\r\n        u.Activo,\r\n        u.FechaRegistro,\r\n        u.PasswordTemporalHash,\r\n        u.PasswordTemporalExpira,\r\n        u.RequiereCambioPassword,\r\n        u.FechaCambioPassword,\r\n        r.Descripcion                       AS DescripcionRol,\r\n        ISNULL(u.IntentosFallidos, 0)       AS IntentosFallidos,\r\n        u.FechaUltimoLogin\r\n    FROM USUARIO u\r\n    INNER JOIN EMPLEADO e   ON u.IdEmpleado = e.IdEmpleado\r\n    INNER JOIN Persona p    ON e.IdPersona  = p.IdPersona\r\n    INNER JOIN ROL r        ON r.IdRol      = u.IdRol\r\n    WHERE u.Correo = @Correo\r\nEND\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ObtenerUsuarioPorCorreo' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_PagarMovimiento]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_PagarMovimiento' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_PagarMovimiento]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","CREATE PROCEDURE [dbo].[usp_PagarMovimiento]\r\n    @IdMovimiento INT,\r\n    @Resultado BIT OUTPUT\r\nAS\r\nBEGIN\r\n    SET NOCOUNT ON;\r\n\r\n    IF EXISTS (\r\n        SELECT 1 FROM MOVIMIENTOS\r\n        WHERE IdMovimiento = @IdMovimiento AND EstadoPago = 'Pagado'\r\n    )\r\n    BEGIN\r\n        SET @Resultado = 0; -- Ya está pagado, no actualiza\r\n        RETURN;\r\n    END\r\n\r\n    UPDATE MOVIMIENTOS\r\n    SET EstadoPago = 'Pagado', FechaModificacion = GETDATE()\r\n    WHERE IdMovimiento = @IdMovimiento AND EstadoPago <> 'Pagado';\r\n\r\n    IF @@ROWCOUNT > 0\r\n        SET @Resultado = 1;\r\n    ELSE\r\n        SET @Resultado = 0;\r\nEND\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_PagarMovimiento' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_RegistrarCategoria]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarCategoria' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_RegistrarCategoria]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n--PROCEDIMIENTO PARA GUARDAR CATEGORIA\r\nCREATE PROC [dbo].[usp_RegistrarCategoria](\r\n@Descripcion varchar(50),\r\n@Resultado bit output\r\n)as\r\nbegin\r\n\tSET @Resultado = 1\r\n\tIF NOT EXISTS (SELECT * FROM CATEGORIA WHERE Descripcion = @Descripcion)\r\n\r\n\t\tinsert into CATEGORIA(Descripcion) values (\r\n\t\t@Descripcion\r\n\t\t)\r\n\tELSE\r\n\t\tSET @Resultado = 0\r\n\t\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarCategoria' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_RegistrarCliente]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarCliente' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_RegistrarCliente]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n--PROCEDIMIENTO PARA GUARDAR CLIENTE\r\nCREATE PROC [dbo].[usp_RegistrarCliente](\r\n@TipoDocumento varchar(100),\r\n@NumeroDocumento varchar(100),\r\n@Nombre varchar(100),\r\n@Direccion varchar(100),\r\n@Telefono varchar(100),\r\n@Resultado bit output\r\n)as\r\nbegin\r\n\tSET @Resultado = 1\r\n\tIF NOT EXISTS (SELECT * FROM CLIENTE WHERE NumeroDocumento = @NumeroDocumento)\r\n\tbegin\r\n\t\tinsert into cliente(TipoDocumento,NumeroDocumento,Nombre,Direccion,Telefono) values\r\n\t\t(@TipoDocumento,@NumeroDocumento,@Nombre,@Direccion,@Telefono)\r\n\tend\r\n\tELSE\r\n\t\tSET @Resultado = 0\r\n\t\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarCliente' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_RegistrarCompra]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarCompra' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_RegistrarCompra]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n/********************* COMPRA **************************/\r\n\r\n--PROCEDIMIENTO PARA REGITRAR COMPRA\r\ncreate procedure [dbo].[usp_RegistrarCompra](\r\n@Detalle xml,\r\n@Resultado bit output\r\n)\r\nas\r\nbegin\r\n\r\n\r\nbegin try\r\n\r\n\tBEGIN TRANSACTION\r\n\r\n\tdeclare @compra table(idusuario int,idproveedor int,idtienda int,totalcosto decimal(18,2))\r\n\tdeclare @detallecompra table(idcompra int,idproducto int,cantidad int,preciounidadcompra decimal(18,2),preciounidadventa decimal(18,2),totalcosto decimal(18,2))\r\n\tdeclare @tiendaproducto table(idtienda int,idproducto int,cantidad int,preciounidadcompra decimal(18,2),preciounidadventa decimal(18,2),totalcosto decimal(18,2))\r\n\r\n\t insert into @compra(idusuario,idproveedor,idtienda,totalcosto)\r\n\t select \r\n\t IdUsuario = Node.Data.value('(IdUsuario)[1]','int'),\r\n\t IdProveedor = Node.Data.value('(IdProveedor)[1]','int'),\r\n\t IdTienda = Node.Data.value('(IdTienda)[1]','int'),\r\n\t TotalCosto = Node.Data.value('(TotalCosto)[1]','decimal(18,2)')\r\n\t FROM @Detalle.nodes('/DETALLE/COMPRA') Node(Data)\r\n \r\n\t insert into @detallecompra(idcompra,idproducto,cantidad,preciounidadcompra,preciounidadventa,totalcosto)\r\n\t select \r\n\t IdCompra = Node.Data.value('(IdCompra)[1]','int'),\r\n\t IdProducto = Node.Data.value('(IdProducto)[1]','int'),\r\n\t Cantidad = Node.Data.value('(Cantidad)[1]','int'),\r\n\t PrecioUnidadCompra = Node.Data.value('(PrecioUnidadCompra)[1]','decimal(18,2)'),\r\n\t PrecioUnidadVenta = Node.Data.value('(PrecioUnidadVenta)[1]','decimal(18,2)'),\r\n\t TotalCosto = Node.Data.value('(TotalCosto)[1]','decimal(18,2)')\r\n\t FROM @Detalle.nodes('/DETALLE/DETALLE_COMPRA/DETALLE') Node(Data)\r\n\r\n\t insert into @tiendaproducto(idtienda,idproducto,cantidad,preciounidadcompra,preciounidadventa,totalcosto)\r\n\t select\r\n\t (select top 1 idtienda from @compra),\r\n\t idproducto,cantidad,preciounidadcompra,preciounidadventa,totalcosto\r\n\t from @detallecompra\r\n\r\n\r\n\t --******************* AREA DE TRABAJO *************************\r\n\t declare @IdCompra int = 0\r\n\r\n\t insert into COMPRA(IdUsuario,IdProveedor,IdTienda,TotalCosto)\r\n\t select idusuario,idproveedor,idtienda,totalcosto from @compra\r\n\r\n\t set @IdCompra = Scope_identity()\r\n\t update @detallecompra set idcompra = @IdCompra\r\n\r\n\t insert into DETALLE_COMPRA(IdCompra,IdProducto,Cantidad,PrecioUnitarioCompra,PrecioUnitarioVenta,TotalCosto)\r\n\t select idcompra,idproducto,cantidad,preciounidadcompra,preciounidadventa,totalcosto from @detallecompra\r\n\r\n\t update pt set \r\n\t pt.PrecioUnidadCompra = tp.preciounidadcompra, \r\n\t pt.PrecioUnidadVenta = tp.preciounidadventa,\r\n\t pt.Stock = pt.Stock + tp.cantidad,\r\n\t pt.Iniciado = 1\r\n\t from PRODUCTO_TIENDA pt\r\n\t inner join @tiendaproducto tp on tp.idtienda = pt.IdTienda and tp.idproducto = pt.IdProducto\r\n\r\n\t COMMIT\r\n\t set @Resultado = 1\r\n\r\n end try\r\n begin catch\r\n\tROLLBACK\r\n\tset @Resultado = 0\r\n end catch\r\nend\r\n\r\n\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarCompra' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_RegistrarDatosFiscales]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarDatosFiscales' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_RegistrarDatosFiscales]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","CREATE  PROCEDURE [dbo].[usp_RegistrarDatosFiscales]\r\n    @NumeroTimbrado INT,\r\n    @FechaVencimientoTimbrado DATE\r\nAS\r\nBEGIN\r\n    DECLARE @NumeroFactura INT;\r\n\r\n    BEGIN TRY\r\n        -- Verificar si ya existen registros\r\n        IF EXISTS (SELECT 1 FROM DATOS_TRIBUTARIOS)\r\n        BEGIN\r\n            -- Si ya existen registros, obtener el último número de factura\r\n            SELECT @NumeroFactura = MAX(CAST(NumeroFactura AS INT)) FROM DATOS_TRIBUTARIOS;\r\n            -- Incrementar el número de factura\r\n            SET @NumeroFactura = @NumeroFactura + 1;\r\n        END\r\n        ELSE\r\n        BEGIN\r\n            -- Si no existen registros, iniciar con el número de factura 1\r\n            SET @NumeroFactura = 1;\r\n        END\r\n\r\n        -- Verificar si el número de factura ya existe\r\n        IF EXISTS (SELECT 1 FROM DATOS_TRIBUTARIOS WHERE NumeroFactura = @NumeroFactura)\r\n        BEGIN\r\n            -- Si existe, actualizar los datos\r\n            UPDATE DATOS_TRIBUTARIOS\r\n            SET NumeroTimbrado = @NumeroTimbrado,\r\n                VencimientoTimbrado = @FechaVencimientoTimbrado\r\n            WHERE NumeroFactura = @NumeroFactura;\r\n        END\r\n        ELSE\r\n        BEGIN\r\n            -- Si no existe, insertar los datos\r\n            INSERT INTO DATOS_TRIBUTARIOS (NumeroFactura, NumeroTimbrado, VencimientoTimbrado)\r\n            VALUES (@NumeroFactura, @NumeroTimbrado, @FechaVencimientoTimbrado);\r\n        END\r\n        \r\n        -- Retornar un código de éxito\r\n        RETURN 1;\r\n    END TRY\r\n    BEGIN CATCH\r\n        -- Manejo de errores, retornar un código de error\r\n        RETURN 0;\r\n    END CATCH\r\nEND\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarDatosFiscales' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_RegistrarMotivoBaja]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarMotivoBaja' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_RegistrarMotivoBaja]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\nCREATE PROC [dbo].[usp_RegistrarMotivoBaja]\n    @Descripcion VARCHAR(100),\n    @Resultado   BIT OUTPUT\nAS\nBEGIN\n    IF EXISTS (SELECT 1 FROM MotivoBaja WHERE Descripcion = @Descripcion)\n    BEGIN\n        SET @Resultado = 0; RETURN\n    END\n    INSERT INTO MotivoBaja (Descripcion, Activo, FechaRegistro)\n    VALUES (@Descripcion, 1, GETDATE())\n    SET @Resultado = 1\nEND\n\r\n","GO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarMotivoBaja' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_RegistrarPrecioVenta]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarPrecioVenta' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_RegistrarPrecioVenta]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","CREATE PROCEDURE [dbo].[usp_RegistrarPrecioVenta]\r\n(\r\n    @IdProducto INT,\r\n    @PrecioVenta INT,\r\n    @FechaInicio DATE,\r\n    @FechaFin DATE = NULL,\r\n    @Resultado BIT OUTPUT\r\n)\r\nAS\r\nBEGIN\r\n    SET NOCOUNT ON;\r\n\r\n    BEGIN TRY\r\n        -- Actualizar el precio activo anterior, poniendo su FechaFin al día anterior de @FechaInicio\r\n        UPDATE Precio_Venta\r\n        SET FechaFin = DATEADD(DAY, -1, @FechaInicio)\r\n        WHERE IdProducto = @IdProducto\r\n          AND Activo = 1\r\n          AND (FechaFin IS NULL OR FechaFin >= @FechaInicio)\r\n          AND FechaInicio < @FechaInicio;\r\n\r\n        -- Insertar nuevo precio\r\n        INSERT INTO Precio_Venta\r\n        (\r\n            PrecioVenta,\r\n            IdProducto,\r\n            FechaInicio,\r\n            FechaFin,\r\n            Activo,\r\n            FechaRegistro\r\n        )\r\n        VALUES\r\n        (\r\n            @PrecioVenta,\r\n            @IdProducto,\r\n            @FechaInicio,\r\n            @FechaFin,\r\n            1, -- Activo\r\n            GETDATE()\r\n        );\r\n\r\n        SET @Resultado = CASE WHEN @@ROWCOUNT > 0 THEN 1 ELSE 0 END;\r\n    END TRY\r\n    BEGIN CATCH\r\n        SET @Resultado = 0;\r\n    END CATCH\r\nEND\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarPrecioVenta' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_RegistrarProducto]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarProducto' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_RegistrarProducto]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n--PROCEDIMIENTO PARA GUARDAR PRODUCTO\r\nCREATE PROC [dbo].[usp_RegistrarProducto](\r\n@Nombre varchar(50),\r\n@Descripcion varchar(50),\r\n@IdCategoria int,\r\n@Resultado bit output\r\n)as\r\nbegin\r\n\tSET @Resultado = 1\r\n\tIF NOT EXISTS (SELECT * FROM PRODUCTO WHERE rtrim(ltrim(Nombre)) = rtrim(ltrim(@Nombre)))\r\n\r\n\t\tinsert into PRODUCTO(Codigo,ValorCodigo,Nombre,Descripcion,IdCategoria) values (\r\n\t\tRIGHT('000000' + convert(varchar(max),(select isnull(max(ValorCodigo),0) + 1 from PRODUCTO)),6),(select isnull(max(ValorCodigo),0) + 1 from PRODUCTO),@Nombre,@Descripcion,@IdCategoria\r\n\t\t)\r\n\tELSE\r\n\t\tSET @Resultado = 0\r\n\t\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarProducto' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_RegistrarProductoTienda]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarProductoTienda' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_RegistrarProductoTienda]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n\r\n--PROCEDIMIENTO PARA GUARDAR PRODUCTO_TIENDA\r\nCREATE PROC [dbo].[usp_RegistrarProductoTienda](\r\n@IdProducto int,\r\n@IdTienda int,\r\n@Resultado bit output\r\n)as\r\nbegin\r\n\tSET @Resultado = 1\r\n\tIF NOT EXISTS (SELECT * FROM PRODUCTO_TIENDA WHERE IdProducto = @IdProducto and IdTienda = @IdTienda)\r\n\r\n\t\tinsert into PRODUCTO_TIENDA(IdProducto,IdTienda) values (\r\n\t\t@IdProducto,@IdTienda\r\n\t\t)\r\n\tELSE\r\n\t\tSET @Resultado = 0\r\n\t\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarProductoTienda' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_RegistrarProveedor]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarProveedor' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_RegistrarProveedor]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n\r\n--PROCEDIMIENTO PARA GUARDAR PROVEEDOR\r\nCREATE PROC [dbo].[usp_RegistrarProveedor](\r\n@Ruc varchar(50),\r\n@RazonSocial varchar(100),\r\n@Telefono varchar(50),\r\n@Correo varchar(50),\r\n@Direccion varchar(50),\r\n@Resultado bit output\r\n)as\r\nbegin\r\n\tSET @Resultado = 1\r\n\tIF NOT EXISTS (SELECT * FROM PROVEEDOR WHERE RUC = @Ruc)\r\n\r\n\t\tinsert into PROVEEDOR(RUC,RazonSocial,Telefono,Correo,Direccion)\r\n\t\tvalues(@Ruc,@RazonSocial,@Telefono,@Correo,@Direccion)\r\n\r\n\tELSE\r\n\t\tSET @Resultado = 0\r\n\t\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarProveedor' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_RegistrarRol]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarRol' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_RegistrarRol]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n--PROCEDIMIENTO PARA GUARDAR ROL\r\nCREATE PROC [dbo].[usp_RegistrarRol](\r\n@Descripcion varchar(50),\r\n@Resultado bit output\r\n)as\r\nbegin\r\n\tSET @Resultado = 1\r\n\tIF NOT EXISTS (SELECT * FROM ROL WHERE Descripcion = @Descripcion)\r\n\tbegin\r\n\t\tdeclare @idrol int = 0\r\n\t\tinsert into ROL(Descripcion) values (\r\n\t\t@Descripcion\r\n\t\t)\r\n\t\tset @idrol  = Scope_identity()\r\n\r\n\t\tinsert into PERMISOS(IdRol,IdSubMenu,Activo)\r\n\t\tselect @idrol, IdSubMenu,0 from SUBMENU\r\n\tend\r\n\tELSE\r\n\t\tSET @Resultado = 0\r\n\t\r\nend\r\n\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarRol' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_RegistrarTienda]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarTienda' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_RegistrarTienda]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","--PROCEDIMIENTO PARA GUARDAR TIENDA\r\nCREATE PROC [dbo].[usp_RegistrarTienda](\r\n@Nombre varchar(50),\r\n@Ruc varchar(50),\r\n@Direccion varchar(50),\r\n@Telefono varchar(50),\r\n@Resultado bit output\r\n)as\r\nbegin\r\n\tSET @Resultado = 1\r\n\tIF NOT EXISTS (SELECT * FROM TIENDA WHERE Nombre = @Nombre)\r\n\r\n\t\tinsert into TIENDA(Nombre,RUC,Direccion,Telefono) values (\r\n\t\t@Nombre,@Ruc,@Direccion,@Telefono\r\n\t\t)\r\n\tELSE\r\n\t\tSET @Resultado = 0\r\n\t\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarTienda' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_RegistrarTraslado]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarTraslado' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_RegistrarTraslado]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\nCREATE PROCEDURE [dbo].[usp_RegistrarTraslado]\r\n    @IdProducto         INT,\r\n    @IdTiendaOrigen     INT,\r\n    @IdTiendaDestino    INT,\r\n    @Cantidad           INT,\r\n    @Observaciones      VARCHAR(500),\r\n    @IdUsuario          INT,\r\n    @Resultado          BIT OUTPUT,\r\n    @Mensaje            VARCHAR(255) OUTPUT\r\nAS\r\nBEGIN\r\n    SET NOCOUNT ON;\r\n\r\n    DECLARE @StockOrigen INT;\r\n\r\n    -- Verificar stock disponible en tienda origen\r\n    SELECT @StockOrigen = Stock\r\n    FROM PRODUCTO_TIENDA\r\n    WHERE IdProducto = @IdProducto AND IdTienda = @IdTiendaOrigen;\r\n\r\n    IF @StockOrigen IS NULL\r\n    BEGIN\r\n        SET @Resultado = 0;\r\n        SET @Mensaje = 'El producto no existe en la tienda origen.';\r\n        RETURN;\r\n    END\r\n\r\n    IF @StockOrigen < @Cantidad\r\n    BEGIN\r\n        SET @Resultado = 0;\r\n        SET @Mensaje = 'Stock insuficiente en tienda origen. Stock disponible: ' + CAST(@StockOrigen AS VARCHAR);\r\n        RETURN;\r\n    END\r\n\r\n    IF @IdTiendaOrigen = @IdTiendaDestino\r\n    BEGIN\r\n        SET @Resultado = 0;\r\n        SET @Mensaje = 'La tienda origen y destino no pueden ser la misma.';\r\n        RETURN;\r\n    END\r\n\r\n    BEGIN TRY\r\n        BEGIN TRANSACTION;\r\n\r\n        -- Descontar de tienda origen\r\n        UPDATE PRODUCTO_TIENDA\r\n        SET Stock = Stock - @Cantidad\r\n        WHERE IdProducto = @IdProducto AND IdTienda = @IdTiendaOrigen;\r\n\r\n        -- Verificar si el producto ya existe en tienda destino\r\n        IF EXISTS (SELECT 1 FROM PRODUCTO_TIENDA WHERE IdProducto = @IdProducto AND IdTienda = @IdTiendaDestino)\r\n        BEGIN\r\n            -- Sumar en tienda destino\r\n            UPDATE PRODUCTO_TIENDA\r\n            SET Stock = Stock + @Cantidad\r\n            WHERE IdProducto = @IdProducto AND IdTienda = @IdTiendaDestino;\r\n        END\r\n        ELSE\r\n        BEGIN\r\n            -- Insertar en tienda destino copiando configuración de la tienda origen\r\n            INSERT INTO PRODUCTO_TIENDA (IdProducto, IdTienda, Stock, StockMinimo, StockMaximo, Activo, FechaRegistro)\r\n            SELECT IdProducto, @IdTiendaDestino, @Cantidad, StockMinimo, StockMaximo, 1, GETDATE()\r\n            FROM PRODUCTO_TIENDA\r\n            WHERE IdProducto = @IdProducto AND IdTienda = @IdTiendaOrigen;\r\n        END\r\n\r\n        -- Registrar en tabla TRASLADO\r\n        INSERT INTO TRASLADO (IdProducto, IdTiendaOrigen, IdTiendaDestino, Cantidad, Observaciones, IdUsuario, FechaTraslado)\r\n        VALUES (@IdProducto, @IdTiendaOrigen, @IdTiendaDestino, @Cantidad, @Observaciones, @IdUsuario, GETDATE());\r\n\r\n        COMMIT TRANSACTION;\r\n\r\n        SET @Resultado = 1;\r\n        SET @Mensaje = 'Traslado registrado correctamente.';\r\n    END TRY\r\n    BEGIN CATCH\r\n        ROLLBACK TRANSACTION;\r\n        SET @Resultado = 0;\r\n        SET @Mensaje = 'Error: ' + ERROR_MESSAGE();\r\n    END CATCH\r\nEND\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarTraslado' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_RegistrarUsuario]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarUsuario' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_RegistrarUsuario]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","--PROCEDIMIENTO PARA REGISTRAR USUARIO\r\nCREATE PROC [dbo].[usp_RegistrarUsuario](\r\n@Nombres varchar(50),\r\n@Apellidos varchar(50),\r\n@Correo varchar(50),\r\n@Clave varchar(100),\r\n@IdTienda int,\r\n@IdRol int,\r\n@Resultado bit output\r\n)as\r\nbegin\r\n\tSET @Resultado = 1\r\n\tIF NOT EXISTS (SELECT * FROM USUARIO WHERE Correo = @Correo)\r\n\r\n\t\tinsert into USUARIO(Nombres,Apellidos,Correo,Clave,IdTienda,IdRol) values (\r\n\t\t@Nombres,@Apellidos,@Correo,@Clave,@IdTienda,@IdRol\r\n\t\t)\r\n\tELSE\r\n\t\tSET @Resultado = 0\r\n\t\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarUsuario' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_RegistrarVenta]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarVenta' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_RegistrarVenta]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n/********************* VENTA **************************/\r\n\r\n--PROCEDIMIENTO PARA REGITRAR VENTA\r\ncreate procedure [dbo].[usp_RegistrarVenta](\r\n@Detalle xml,\r\n@Resultado int output\r\n)\r\nas\r\nbegin\r\n\r\n\r\nbegin try\r\n\r\n\tBEGIN TRANSACTION\r\n\t\r\n\tdeclare @cliente table (tipodocumento varchar(50),numerodocumento varchar(50),nombre varchar(100),direccion varchar(100),telefono varchar(50))\r\n\tdeclare @venta table (idtienda int,idusuario int,idcliente int default 0,tipodocumento varchar(50),cantidadproducto int,cantidadtotal int,totalcosto decimal(18,2),importerecibido decimal(18,2),importecambio decimal(18,2))\r\n\tdeclare @detalleventa table (idventa int,idproducto int,cantidad int,preciounidad decimal(18,2),importetotal decimal(18,2))\r\n\r\n\tinsert into @cliente(tipodocumento,numerodocumento,nombre,direccion,telefono)\r\n\t\t select \r\n\t\t tipodocumento = Node.Data.value('(TipoDocumento)[1]','varchar(50)'),\r\n\t\t numerodocumento = Node.Data.value('(NumeroDocumento)[1]','varchar(50)'),\r\n\t\t nombre = Node.Data.value('(Nombre)[1]','varchar(100)'),\r\n\t\t direccion = Node.Data.value('(Direccion)[1]','varchar(100)'),\r\n\t\t telefono = Node.Data.value('(Telefono)[1]','varchar(50)')\r\n\t\t FROM @Detalle.nodes('/DETALLE/DETALLE_CLIENTE/DATOS') Node(Data)\r\n\r\n\tinsert into @venta(idtienda,idusuario,idcliente,tipodocumento,cantidadproducto,cantidadtotal,totalcosto,importerecibido,importecambio)\r\n\tselect \r\n\t\t IdTienda = Node.Data.value('(IdTienda)[1]','varchar(50)'),\r\n\t\t IdUsuario = Node.Data.value('(IdUsuario)[1]','varchar(50)'),\r\n\t\t IdCliente = Node.Data.value('(IdCliente)[1]','varchar(100)'),\r\n\t\t TipoDocumento = Node.Data.value('(TipoDocumento)[1]','varchar(100)'),\r\n\t\t CantidadProducto = Node.Data.value('(CantidadProducto)[1]','varchar(50)'),\r\n\t\t CantidadTotal = Node.Data.value('(CantidadTotal)[1]','varchar(50)'),\r\n\t\t TotalCosto = Node.Data.value('(TotalCosto)[1]','decimal(18,2)'),\r\n\t\t ImporteRecibido = Node.Data.value('(ImporteRecibido)[1]','decimal(18,2)'),\r\n\t\t ImporteCambio = Node.Data.value('(ImporteCambio)[1]','decimal(18,2)')\r\n\t\t FROM @Detalle.nodes('/DETALLE/VENTA') Node(Data)\r\n\r\n\tinsert into @detalleventa(idventa,idproducto,cantidad,preciounidad,importetotal)\r\n\t\t select \r\n\t\t IdVenta = Node.Data.value('(IdVenta)[1]','int'),\r\n\t\t IdProducto = Node.Data.value('(IdProducto)[1]','int'),\r\n\t\t Cantidad = Node.Data.value('(Cantidad)[1]','int'),\r\n\t\t PrecioUnidad = Node.Data.value('(PrecioUnidad)[1]','decimal(18,2)'),\r\n\t\t ImporteTotal = Node.Data.value('(ImporteTotal)[1]','decimal(18,2)')\r\n\t\t FROM @Detalle.nodes('/DETALLE/DETALLE_VENTA/DATOS') Node(Data)\r\n\r\n\t--******************* AREA DE TRABAJO *************************\r\n\tdeclare @identity as table(ID int)\r\n\r\n\tif not exists(select * from CLIENTE where numeroDocumento = (select numerodocumento from @cliente))\r\n\tinsert into CLIENTE(TipoDocumento,NumeroDocumento,Nombre,Direccion,Telefono)\r\n\toutput inserted.IdCliente into @identity\r\n\tselect tipodocumento,numerodocumento,nombre,direccion,telefono from @cliente\r\n\telse \r\n\t insert into @identity(ID)\r\n\t select IdCliente from CLIENTE where numeroDocumento = (select numerodocumento from @cliente)\r\n\r\n\tupdate @venta set idcliente = (select ID from @identity)\r\n\tdelete from @identity\r\n\r\n\tinsert into VENTA(Codigo,ValorCodigo,IdTienda,IdUsuario,IdCliente,TipoDocumento,CantidadProducto,CantidadTotal,TotalCosto,ImporteRecibido,ImporteCambio)\r\n\toutput inserted.IdVenta into @identity\r\n\tselect \r\n\tRIGHT('000000' + convert(varchar(max),(select isnull(max(ValorCodigo),0) + 1 from VENTA) ),6),\r\n\t(select isnull(max(ValorCodigo),0) + 1 from VENTA),\r\n\tidtienda,idusuario,idcliente,tipodocumento,cantidadproducto,cantidadtotal,totalcosto,importerecibido,importecambio\r\n\tfrom @venta\r\n\r\n\tupdate @detalleventa set idventa = (select ID from @identity)\r\n\r\n\tinsert into DETALLE_VENTA(IdVenta,IdProducto,Cantidad,PrecioUnidad,ImporteTotal)\r\n\tselect idventa,idproducto,cantidad,preciounidad,importetotal from @detalleventa\r\n\r\n\r\n\t COMMIT\r\n\t set @Resultado = (select ID from @identity)\r\n\r\n end try\r\n begin catch\r\n\tROLLBACK\r\n\tset @Resultado = 0\r\n end catch\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarVenta' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_rptBajasProducto]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_rptBajasProducto' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_rptBajasProducto]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\nCREATE   PROC [dbo].[usp_rptBajasProducto]\r\n    @FechaInicio  DATE,\r\n    @FechaFin     DATE,\r\n    @IdTienda     INT = 0\r\nAS\r\nBEGIN\r\n    SET NOCOUNT ON;\r\n\r\n    SELECT\r\n        hm.IdHistorial,\r\n        CONVERT(VARCHAR(16), hm.FechaMovimiento, 120)   AS FechaMovimiento,\r\n        p.Codigo                                         AS CodigoProducto,\r\n        p.Nombre                                         AS NombreProducto,\r\n        t.Nombre                                         AS NombreTienda,\r\n        t.RUC                                            AS RucTienda,\r\n        ISNULL(hm.Observaciones, '')                     AS Observaciones,\r\n        hm.Cantidad\r\n    FROM HISTORIAL_MOVIMIENTO hm\r\n    INNER JOIN PRODUCTO          p  ON p.IdProducto          = hm.idProducto\r\n    INNER JOIN PRODUCTO_DEPOSITO pd ON pd.IdProductoDeposito = hm.IdProductoDeposito\r\n    INNER JOIN DEPOSITO          d  ON d.IdDeposito          = pd.IdDeposito\r\n    INNER JOIN TIENDA            t  ON t.IdTienda            = d.IdTienda\r\n    WHERE\r\n        hm.Estado = 'INACTIVO'\r\n        AND CAST(hm.FechaMovimiento AS DATE) BETWEEN @FechaInicio AND @FechaFin\r\n        AND (@IdTienda = 0 OR t.IdTienda = @IdTienda)\r\n    ORDER BY hm.FechaMovimiento DESC;\r\nEND\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_rptBajasProducto' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_rptProductoTienda]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_rptProductoTienda' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_rptProductoTienda]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","--PROCEDMIENTO PARA REPORTE TIENDA PRODUCTO\r\n\r\n create procedure [dbo].[usp_rptProductoTienda](\r\n @IdTienda int = 0,\r\n @Codigo varchar(50)\r\n )\r\n as\r\n begin\r\n select \r\n t.RUC[Ruc Tienda],t.Nombre[Nombre Tienda],t.Direccion[Direccion Tienda],\r\n p.Codigo[Codigo Producto],p.Nombre[Nombre Producto],p.Descripcion[Descripcion Producto],\r\n pt.Stock[Stock en tienda],convert(decimal(10,2),pt.PrecioUnidadCompra)[Precio Compra],convert(decimal(10,2),pt.PrecioUnidadVenta)[Precio Venta]\r\n from PRODUCTO_TIENDA pt\r\n inner join PRODUCTO p on p.IdProducto = pt.IdProducto\r\n inner join TIENDA t on t.IdTienda = pt.IdTienda\r\n where pt.IdTienda = iif(@IdTienda = 0,pt.IdTienda,@IdTienda) and\r\n p.Codigo like '%' + @Codigo + '%'\r\n end\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_rptProductoTienda' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_rptVenta]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_rptVenta' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_rptVenta]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n --PROCEDMIENTO PARA REPORTE VENTA\r\n\r\ncreate procedure [dbo].[usp_rptVenta] (\r\n@FechaInicio date,\r\n@FechaFin date,\r\n@IdTienda int = 0\r\n)\r\nas\r\nbegin\r\n\r\n select convert(char(10), v.FechaRegistro ,103)[Fecha Venta],v.Codigo[Numero Documento],v.TipoDocumento[Tipo Documento],\r\n t.Nombre[Nombre Tienda], t.RUC[Ruc Tienda],\r\n concat(u.Nombres,' ', u.apellidos)[Nombre Empleado],\r\n v.CantidadTotal[Cantidad Unidades Vendidas],v.CantidadProducto[Cantidad Productos],v.TotalCosto[Total Venta] \r\n from VENTA v\r\n inner join TIENDA t on t.IdTienda = v.IdTienda\r\n inner join USUARIO u on u.IdUsuario = v.IdUsuario\r\n where \r\n CONVERT(date,v.FechaRegistro) between @FechaInicio and @FechaFin \r\n and v.IdTienda = iif(@IdTienda =0 ,v.IdTienda,@IdTienda)\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_rptVenta' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ValidaStockMaximo]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ValidaStockMaximo' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ValidaStockMaximo]    Script Date: 8/4/2026 15:46:09 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","CREATE PROCEDURE [dbo].[usp_ValidaStockMaximo]\r\n    @IdProducto INT,\r\n    @Cantidad INT,\r\n    @IdTienda INT,\r\n    @Resultado INT OUTPUT,\r\n    @Mensaje VARCHAR(255) OUTPUT -- Parámetro de salida para el mensaje\r\nAS\r\nBEGIN\r\n    DECLARE @Stock INT;\r\n    DECLARE @Iniciado INT;\r\n    DECLARE @StockMaximo INT;\r\n\r\n    -- Obtenemos el stock, el estado de iniciado y el stock máximo del producto en la tienda\r\n    SELECT \r\n        @Stock = Stock,\r\n        @Iniciado = Iniciado,\r\n        @StockMaximo = StockMaximo\r\n    FROM PRODUCTO_TIENDA\r\n    WHERE IdProducto = @IdProducto AND IdTienda = @IdTienda;\r\n\r\n    -- Si el producto no ha sido iniciado, lo consideramos con stock 0\r\n    IF @Iniciado = 0\r\n    BEGIN\r\n        IF @Cantidad <= @StockMaximo\r\n        BEGIN\r\n            SET @Stock = 0;\r\n            SET @Resultado = 1; -- OK para primera compra\r\n            SET @Mensaje = 'Primera compra, stock inicial validado.';\r\n        END\r\n        ELSE \r\n        BEGIN\r\n            SET @Stock = 0;\r\n            SET @Resultado = 0; -- Supera el stock máximo\r\n            SET @Mensaje = 'Supera el stock máximo permitido.';\r\n        END\r\n        RETURN;\r\n    END\r\n\r\n    -- Si el producto ha sido iniciado, verificamos el stock máximo\r\n    IF @Iniciado = 1\r\n    BEGIN\r\n        -- Verificamos si la cantidad solicitada más el stock actual exceden el stock máximo\r\n        IF @Cantidad + @Stock > @StockMaximo\r\n        BEGIN\r\n            SET @Resultado = 3; -- Stock máximo excedido\r\n            SET @Mensaje = 'Stock máximo superado, solo puedes pedir ' + CAST(@StockMaximo - @Stock AS VARCHAR(10)) + ' unidades.';\r\n        END\r\n        ELSE\r\n        BEGIN\r\n            SET @Resultado = 1; -- Stock suficiente\r\n            SET @Mensaje = 'Stock suficiente para la cantidad solicitada.';\r\n        END\r\n    END\r\n    ELSE\r\n    BEGIN\r\n        -- Si no hay suficiente stock\r\n        SET @Resultado = 0; -- Stock insuficiente\r\n        SET @Mensaje = 'Stock insuficiente para la cantidad solicitada.';\r\n    END\r\nEND;\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ValidaStockMaximo' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [DBVENTAS_WEB]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']","object_type":"Database"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["USE [master]\r\n","GO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']","object_type":"Database"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["ALTER DATABASE [DBVENTAS_WEB] SET  READ_WRITE \r\n","GO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']","object_type":"Database"}}]}imo, StockMaximo, 1, GETDATE()\r\n            FROM PRODUCTO_TIENDA\r\n            WHERE IdProducto = @IdProducto AND IdTienda = @IdTiendaOrigen;\r\n        END\r\n\r\n        -- Registrar en tabla TRASLADO\r\n        INSERT INTO TRASLADO (IdProducto, IdTiendaOrigen, IdTiendaDestino, Cantidad, Observaciones, IdUsuario, FechaTraslado)\r\n        VALUES (@IdProducto, @IdTiendaOrigen, @IdTiendaDestino, @Cantidad, @Observaciones, @IdUsuario, GETDATE());\r\n\r\n        COMMIT TRANSACTION;\r\n\r\n        SET @Resultado = 1;\r\n        SET @Mensaje = 'Traslado registrado correctamente.';\r\n    END TRY\r\n    BEGIN CATCH\r\n        ROLLBACK TRANSACTION;\r\n        SET @Resultado = 0;\r\n        SET @Mensaje = 'Error: ' + ERROR_MESSAGE();\r\n    END CATCH\r\nEND\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarTraslado' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_RegistrarUsuario]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarUsuario' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_RegistrarUsuario]    Script Date: 8/4/2026 00:12:55 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","CREATE PROC [dbo].[usp_RegistrarUsuario](\r\n    @Nombres varchar(50),\r\n    @Apellidos varchar(50),\r\n    @Correo varchar(50),\r\n    @Clave varchar(100),\r\n    @IdTienda int,\r\n    @IdRol int,\r\n    @IdEmpleado int,\r\n    @Resultado bit OUTPUT,\r\n    @Codigo int OUTPUT,    -- 1 = OK, 2 = Correo existe, 3 = Empleado ya tiene usuario, 4 = Error\r\n    @Mensaje varchar(200) OUTPUT\r\n)\r\nAS\r\nBEGIN\r\n    SET NOCOUNT ON;\r\n    SET @Resultado = 0;\r\n    SET @Codigo = 0;\r\n    SET @Mensaje = 'Error desconocido';\r\n\r\n    BEGIN TRY\r\n        -- Verificar si el correo ya existe\r\n        IF EXISTS (SELECT 1 FROM USUARIO WHERE Correo = @Correo)\r\n        BEGIN\r\n            SET @Resultado = 0;\r\n            SET @Codigo = 2;\r\n            SET @Mensaje = 'El correo ya está registrado para otro usuario';\r\n        END\r\n        -- Verificar si el empleado ya tiene usuario\r\n        ELSE IF EXISTS (SELECT 1 FROM USUARIO WHERE IdEmpleado = @IdEmpleado)\r\n        BEGIN\r\n            SET @Resultado = 0;\r\n            SET @Codigo = 3;\r\n            SET @Mensaje = 'El empleado ya tiene un usuario asignado';\r\n        END\r\n        ELSE\r\n        BEGIN\r\n            INSERT INTO USUARIO(Nombres, Apellidos, Correo, Clave, IdTienda, IdRol, IdEmpleado)\r\n            VALUES (@Nombres, @Apellidos, @Correo, @Clave, @IdTienda, @IdRol, @IdEmpleado);\r\n\r\n            SET @Resultado = 1;\r\n            SET @Codigo = 1;\r\n            SET @Mensaje = 'Usuario registrado correctamente';\r\n        END\r\n    END TRY\r\n    BEGIN CATCH\r\n        SET @Resultado = 0;\r\n        SET @Codigo = 4;\r\n        SET @Mensaje = ERROR_MESSAGE();\r\n    END CATCH\r\nEND\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarUsuario' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_RegistrarVenta]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarVenta' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_RegistrarVenta]    Script Date: 8/4/2026 00:12:55 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n/********************* VENTA **************************/\r\n\r\n--PROCEDIMIENTO PARA REGITRAR VENTA\r\nCREATE PROCEDURE [dbo].[usp_RegistrarVenta](\r\n    @Detalle xml,\r\n    @Resultado INT OUTPUT\r\n)\r\nAS\r\nBEGIN\r\n    BEGIN TRY\r\n        BEGIN TRANSACTION\r\n\r\n        DECLARE @cliente TABLE (tipodocumento VARCHAR(50), numerodocumento VARCHAR(50), nombre VARCHAR(100), direccion VARCHAR(100), telefono VARCHAR(50))\r\n        DECLARE @venta TABLE (idtienda INT, idusuario INT, idcliente INT DEFAULT 0, tipodocumento VARCHAR(50), cantidadproducto INT, cantidadtotal INT, totalcosto DECIMAL(18,2), importerecibido DECIMAL(18,2), importecambio DECIMAL(18,2))\r\n        DECLARE @detalleventa TABLE (idventa INT, idproducto INT, cantidad INT, preciounidad DECIMAL(18,2), importetotal DECIMAL(18,2))\r\n        DECLARE @NumeroFactura VARCHAR(50), @NumeroTimbrado INT, @VencimientoTimbrado DATE;\r\n\t\tDECLARE @Secuencia INT;\r\n        -- Insertar datos del cliente\r\n        INSERT INTO @cliente(tipodocumento, numerodocumento, nombre, direccion, telefono)\r\n        SELECT \r\n            tipodocumento = Node.Data.value('(TipoDocumento)[1]', 'VARCHAR(50)'),\r\n            numerodocumento = Node.Data.value('(NumeroDocumento)[1]', 'VARCHAR(50)'),\r\n            nombre = Node.Data.value('(Nombre)[1]', 'VARCHAR(100)'),\r\n            direccion = Node.Data.value('(Direccion)[1]', 'VARCHAR(100)'),\r\n            telefono = Node.Data.value('(Telefono)[1]', 'VARCHAR(50)')\r\n        FROM @Detalle.nodes('/DETALLE/DETALLE_CLIENTE/DATOS') Node(Data)\r\n\r\n        -- Insertar datos de la venta\r\n        INSERT INTO @venta(idtienda, idusuario, idcliente, tipodocumento, cantidadproducto, cantidadtotal, totalcosto, importerecibido, importecambio)\r\n        SELECT \r\n            IdTienda = Node.Data.value('(IdTienda)[1]', 'INT'),\r\n            IdUsuario = Node.Data.value('(IdUsuario)[1]', 'INT'),\r\n            IdCliente = Node.Data.value('(IdCliente)[1]', 'INT'),\r\n            TipoDocumento = Node.Data.value('(TipoDocumento)[1]', 'VARCHAR(50)'),\r\n            CantidadProducto = Node.Data.value('(CantidadProducto)[1]', 'INT'),\r\n            CantidadTotal = Node.Data.value('(CantidadTotal)[1]', 'INT'),\r\n            TotalCosto = Node.Data.value('(TotalCosto)[1]', 'DECIMAL(18,2)'),\r\n            ImporteRecibido = Node.Data.value('(ImporteRecibido)[1]', 'DECIMAL(18,2)'),\r\n            ImporteCambio = Node.Data.value('(ImporteCambio)[1]', 'DECIMAL(18,2)')\r\n        FROM @Detalle.nodes('/DETALLE/VENTA') Node(Data)\r\n\r\n        -- Insertar datos de detalle de venta\r\n        INSERT INTO @detalleventa(idventa, idproducto, cantidad, preciounidad, importetotal)\r\n        SELECT \r\n            IdVenta = Node.Data.value('(IdVenta)[1]', 'INT'),\r\n            IdProducto = Node.Data.value('(IdProducto)[1]', 'INT'),\r\n            Cantidad = Node.Data.value('(Cantidad)[1]', 'INT'),\r\n            PrecioUnidad = Node.Data.value('(PrecioUnidad)[1]', 'DECIMAL(18,2)'),\r\n            ImporteTotal = Node.Data.value('(ImporteTotal)[1]', 'DECIMAL(18,2)')\r\n        FROM @Detalle.nodes('/DETALLE/DETALLE_VENTA/DATOS') Node(Data)\r\n\r\n\t\t-- Actualizar el stock restando la cantidad vendida\r\n\t\tUPDATE PT\r\n\t\tSET PT.Stock = PT.Stock - DV.Cantidad\r\n\t\tFROM PRODUCTO_TIENDA PT\r\n\t\tINNER JOIN @detalleventa DV ON PT.IdProducto = DV.idproducto AND PT.IdTienda = (SELECT idtienda FROM @venta)\r\n\t\tWHERE PT.Stock >= DV.Cantidad;  -- Evitar stock negativo, puedes ajustar la lógica si quieres\r\n\r\n\t\tDECLARE @IdDeposito INT = 1; -- Cambiar o extraer según tu lógica\r\n\r\n-- Actualizar stock restando la cantidad vendida en PRODUCTO_DEPOSITO\r\nUPDATE PD\r\nSET PD.Stock = PD.Stock - DV.Cantidad\r\nFROM PRODUCTO_DEPOSITO PD\r\nINNER JOIN @detalleventa DV ON PD.IdProducto = DV.idproducto\r\nWHERE PD.IdDeposito = @IdDeposito\r\n  AND PD.Stock >= DV.Cantidad;\r\n\r\n-- Insertar en HISTORIAL_MOVIMIENTO\r\nINSERT INTO HISTORIAL_MOVIMIENTO (\r\n    IdProductoDeposito,\r\n    Estado,\r\n    Cantidad,\r\n    FechaMovimiento,\r\n    Observaciones,\r\n    idProducto\r\n)\r\nSELECT \r\n    PD.IdProductoDeposito,\r\n    'Vendido',\r\n    DV.Cantidad,\r\n    GETDATE(),\r\n    'Vendido',\r\n    DV.idproducto\r\nFROM PRODUCTO_DEPOSITO PD\r\nINNER JOIN @detalleventa DV ON PD.IdProducto = DV.idproducto\r\nWHERE PD.IdDeposito = @IdDeposito;\r\n        --******************* AREA DE TRABAJO *************************\r\n        DECLARE @identity AS TABLE(ID INT)\r\n\r\n        -- Si el cliente no existe, se inserta un nuevo registro en CLIENTE\r\n        IF NOT EXISTS(SELECT * FROM CLIENTE WHERE numeroDocumento = (SELECT numerodocumento FROM @cliente))\r\n        BEGIN\r\n            INSERT INTO CLIENTE(TipoDocumento, NumeroDocumento, Nombre, Direccion, Telefono)\r\n            OUTPUT INSERTED.IdCliente INTO @identity\r\n            SELECT tipodocumento, numerodocumento, nombre, direccion, telefono FROM @cliente\r\n        END\r\n        ELSE \r\n        BEGIN\r\n            INSERT INTO @identity(ID)\r\n            SELECT IdCliente FROM CLIENTE WHERE numeroDocumento = (SELECT numerodocumento FROM @cliente)\r\n        END\r\n\r\n        -- Actualizamos el idcliente en la tabla @venta\r\n        UPDATE @venta SET idcliente = (SELECT ID FROM @identity)\r\n        DELETE FROM @identity\r\n\r\n\t\tSELECT @Secuencia = ISNULL(MAX(CAST(NumeroFactura AS INT)), 0) + 1\r\n\t\tFROM VENTA;\r\n\r\n\t\t-- Formatear el número de factura con 6 dígitos\r\n\t    SET @NumeroFactura = RIGHT('000000' + CONVERT(VARCHAR(6), @Secuencia), 6);\r\n\r\n        -- Obtener los datos tributarios (Factura) de la tabla DATOS_TRIBUTARIOS\r\n        SELECT \r\n\t\t\t@NumeroTimbrado = NumeroTimbrado,\r\n\t\t\t@VencimientoTimbrado = VencimientoTimbrado\r\n\t\t\tFROM [DBVENTAS_WEB].[dbo].[DATOS_TRIBUTARIOS]\r\n\r\n        -- Insertar venta con los datos extraídos de DATOS_TRIBUTARIOS\r\n        INSERT INTO VENTA(Codigo, ValorCodigo, IdTienda, IdUsuario, IdCliente, TipoDocumento, CantidadProducto, CantidadTotal, TotalCosto, ImporteRecibido, ImporteCambio, NumeroFactura, NumeroTimbrado, VencimientoTimbrado)\r\n        OUTPUT INSERTED.IdVenta INTO @identity\r\n        SELECT \r\n            RIGHT('000000' + CONVERT(VARCHAR(MAX), (SELECT ISNULL(MAX(ValorCodigo), 0) + 1 FROM VENTA)), 6),\r\n            (SELECT ISNULL(MAX(ValorCodigo), 0) + 1 FROM VENTA),\r\n            idtienda, idusuario, idcliente, tipodocumento, cantidadproducto, cantidadtotal, totalcosto, importerecibido, importecambio,\r\n            @NumeroFactura, @NumeroTimbrado, @VencimientoTimbrado\r\n        FROM @venta\r\n\r\n\t\t\r\n\r\n        -- Actualizamos el idventa en la tabla de detalles de venta\r\n        UPDATE @detalleventa SET idventa = (SELECT ID FROM @identity)\r\n\r\n        -- Insertar en DETALLE_VENTA\r\n        INSERT INTO DETALLE_VENTA(IdVenta, IdProducto, Cantidad, PrecioUnidad, ImporteTotal)\r\n        SELECT idventa, idproducto, cantidad, preciounidad, importetotal FROM @detalleventa\r\n\r\n\r\n\r\n        COMMIT\r\n        SET @Resultado = (SELECT ID FROM @identity)\r\n\r\n    END TRY\r\n    BEGIN CATCH\r\n        ROLLBACK\r\n        SET @Resultado = 0\r\n    END CATCH\r\nEND\r\n\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_RegistrarVenta' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_rptBajasProducto]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_rptBajasProducto' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_rptBajasProducto]    Script Date: 8/4/2026 00:12:55 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\nCREATE   PROC [dbo].[usp_rptBajasProducto]\r\n    @FechaInicio  DATE,\r\n    @FechaFin     DATE,\r\n    @IdTienda     INT = 0\r\nAS\r\nBEGIN\r\n    SET NOCOUNT ON;\r\n\r\n    SELECT\r\n        hm.IdHistorial,\r\n        CONVERT(VARCHAR(16), hm.FechaMovimiento, 120)   AS FechaMovimiento,\r\n        p.Codigo                                         AS CodigoProducto,\r\n        p.Nombre                                         AS NombreProducto,\r\n        t.Nombre                                         AS NombreTienda,\r\n        t.RUC                                            AS RucTienda,\r\n        ISNULL(hm.Observaciones, '')                     AS Observaciones,\r\n        hm.Cantidad\r\n    FROM HISTORIAL_MOVIMIENTO hm\r\n    INNER JOIN PRODUCTO          p  ON p.IdProducto          = hm.idProducto\r\n    INNER JOIN PRODUCTO_DEPOSITO pd ON pd.IdProductoDeposito = hm.IdProductoDeposito\r\n    INNER JOIN DEPOSITO          d  ON d.IdDeposito          = pd.IdDeposito\r\n    INNER JOIN TIENDA            t  ON t.IdTienda            = d.IdTienda\r\n    WHERE\r\n        hm.Estado = 'INACTIVO'\r\n        AND CAST(hm.FechaMovimiento AS DATE) BETWEEN @FechaInicio AND @FechaFin\r\n        AND (@IdTienda = 0 OR t.IdTienda = @IdTienda)\r\n    ORDER BY hm.FechaMovimiento DESC;\r\nEND\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_rptBajasProducto' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_rptProductoTienda]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_rptProductoTienda' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_rptProductoTienda]    Script Date: 8/4/2026 00:12:55 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","CREATE PROCEDURE [dbo].[usp_rptProductoTienda](\r\n    @IdTienda int = 0,\r\n    @Codigo varchar(50)\r\n)\r\nAS\r\nBEGIN\r\n    SELECT \r\n        t.RUC                                              [Ruc Tienda],\r\n        t.Nombre                                           [Nombre Tienda],\r\n        t.Direccion                                        [Direccion Tienda],\r\n        p.Codigo                                           [Codigo Producto],\r\n        p.Nombre                                           [Nombre Producto],\r\n        p.Descripcion                                      [Descripcion Producto],\r\n        pt.Stock                                           [Stock en tienda],\r\n        CONVERT(decimal(10,2), pt.PrecioUnidadCompra)      [Precio Compra],\r\n        CONVERT(decimal(10,2), ISNULL((\r\n            SELECT TOP 1 pv.PrecioVenta \r\n            FROM PRECIO_VENTA pv\r\n            WHERE pv.IdProducto = p.IdProducto\r\n              AND pv.Activo = 1\r\n              AND GETDATE() >= pv.FechaInicio\r\n              AND (pv.FechaFin IS NULL OR GETDATE() <= pv.FechaFin)\r\n            ORDER BY pv.FechaInicio DESC\r\n        ), 0))                                             [Precio Venta]\r\n    FROM PRODUCTO_TIENDA pt\r\n    INNER JOIN PRODUCTO p ON p.IdProducto = pt.IdProducto\r\n    INNER JOIN TIENDA t   ON t.IdTienda   = pt.IdTienda\r\n    WHERE pt.IdTienda = IIF(@IdTienda = 0, pt.IdTienda, @IdTienda)\r\n      AND p.Codigo LIKE '%' + @Codigo + '%'\r\nEND\r\n","GO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_rptProductoTienda' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_rptVenta]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_rptVenta' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_rptVenta]    Script Date: 8/4/2026 00:12:55 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","\r\n --PROCEDMIENTO PARA REPORTE VENTA\r\n\r\ncreate procedure [dbo].[usp_rptVenta] (\r\n@FechaInicio date,\r\n@FechaFin date,\r\n@IdTienda int = 0\r\n)\r\nas\r\nbegin\r\n\r\n select convert(char(10), v.FechaRegistro ,103)[Fecha Venta],v.Codigo[Numero Documento],v.TipoDocumento[Tipo Documento],\r\n t.Nombre[Nombre Tienda], t.RUC[Ruc Tienda],\r\n concat(u.Nombres,' ', u.apellidos)[Nombre Empleado],\r\n v.CantidadTotal[Cantidad Unidades Vendidas],v.CantidadProducto[Cantidad Productos],v.TotalCosto[Total Venta] \r\n from VENTA v\r\n inner join TIENDA t on t.IdTienda = v.IdTienda\r\n inner join USUARIO u on u.IdUsuario = v.IdUsuario\r\n where \r\n CONVERT(date,v.FechaRegistro) between @FechaInicio and @FechaFin \r\n and v.IdTienda = iif(@IdTienda =0 ,v.IdTienda,@IdTienda)\r\nend\r\n\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_rptVenta' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [dbo].[usp_ValidaStockMaximo]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ValidaStockMaximo' and @Schema='dbo']","object_type":"StoredProcedure"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["/****** Object:  StoredProcedure [dbo].[usp_ValidaStockMaximo]    Script Date: 8/4/2026 00:12:55 ******/\r\nSET ANSI_NULLS ON\r\n","GO\r\n","SET QUOTED_IDENTIFIER ON\r\n","GO\r\n","CREATE PROCEDURE [dbo].[usp_ValidaStockMaximo]\r\n    @IdProducto INT,\r\n    @Cantidad INT,\r\n    @IdTienda INT,\r\n    @Resultado INT OUTPUT,\r\n    @Mensaje VARCHAR(255) OUTPUT -- Parámetro de salida para el mensaje\r\nAS\r\nBEGIN\r\n    DECLARE @Stock INT;\r\n    DECLARE @Iniciado INT;\r\n    DECLARE @StockMaximo INT;\r\n\r\n    -- Obtenemos el stock, el estado de iniciado y el stock máximo del producto en la tienda\r\n    SELECT \r\n        @Stock = Stock,\r\n        @Iniciado = Iniciado,\r\n        @StockMaximo = StockMaximo\r\n    FROM PRODUCTO_TIENDA\r\n    WHERE IdProducto = @IdProducto AND IdTienda = @IdTienda;\r\n\r\n    -- Si el producto no ha sido iniciado, lo consideramos con stock 0\r\n    IF @Iniciado = 0\r\n    BEGIN\r\n        IF @Cantidad <= @StockMaximo\r\n        BEGIN\r\n            SET @Stock = 0;\r\n            SET @Resultado = 1; -- OK para primera compra\r\n            SET @Mensaje = 'Primera compra, stock inicial validado.';\r\n        END\r\n        ELSE \r\n        BEGIN\r\n            SET @Stock = 0;\r\n            SET @Resultado = 0; -- Supera el stock máximo\r\n            SET @Mensaje = 'Supera el stock máximo permitido.';\r\n        END\r\n        RETURN;\r\n    END\r\n\r\n    -- Si el producto ha sido iniciado, verificamos el stock máximo\r\n    IF @Iniciado = 1\r\n    BEGIN\r\n        -- Verificamos si la cantidad solicitada más el stock actual exceden el stock máximo\r\n        IF @Cantidad + @Stock > @StockMaximo\r\n        BEGIN\r\n            SET @Resultado = 3; -- Stock máximo excedido\r\n            SET @Mensaje = 'Stock máximo superado, solo puedes pedir ' + CAST(@StockMaximo - @Stock AS VARCHAR(10)) + ' unidades.';\r\n        END\r\n        ELSE\r\n        BEGIN\r\n            SET @Resultado = 1; -- Stock suficiente\r\n            SET @Mensaje = 'Stock suficiente para la cantidad solicitada.';\r\n        END\r\n    END\r\n    ELSE\r\n    BEGIN\r\n        -- Si no hay suficiente stock\r\n        SET @Resultado = 0; -- Stock insuficiente\r\n        SET @Mensaje = 'Stock insuficiente para la cantidad solicitada.';\r\n    END\r\nEND;\r\nGO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']/StoredProcedure[@Name='usp_ValidaStockMaximo' and @Schema='dbo']","object_type":"StoredProcedure"}},{"cell_type":"markdown","source":["# [DBVENTAS_WEB]"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']","object_type":"Database"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["USE [master]\r\n","GO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']","object_type":"Database"}},{"outputs":[],"execution_count":0,"cell_type":"code","source":["ALTER DATABASE [DBVENTAS_WEB] SET  READ_WRITE \r\n","GO\r\n"],"metadata":{"urn":"Server[@Name='Crisor\\SQLEXPRESS']/Database[@Name='DBVENTAS_WEB']","object_type":"Database"}}]}